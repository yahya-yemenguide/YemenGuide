                            </div>
                        </div>
                    </div>
                </div>

                <!-- ✨ التسعيرة المزدوجة للدولار -->
                <div class="col-md-6">
                    <div class="settings-card p-4 h-100">
                        <h6 class="fw-bold text-success mb-3"><i class="bi bi-currency-dollar me-2"></i> سعر صرف الدولار الأمريكي (USD)</h6>
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="form-floating border border-success border-opacity-25 rounded-3">
