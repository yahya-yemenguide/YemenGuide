@model YemenGuide.Core.Entities.SystemSetting
@{
    ViewData["Title"] = "إعدادات النظام";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var maintenanceType =
        Model.MaintenanceType switch
        {
            "ReadOnly" => "ReadOnly",
            "Partial" => "Partial",
            _ => "Full"
        };

    string FormatYemenMaintenanceInput(DateTime? value)
    {
        if (!value.HasValue)
        {
            return string.Empty;
        }

        var utcValue =
            value.Value.Kind == DateTimeKind.Local
                ? value.Value.ToUniversalTime()
                : value.Value.Kind == DateTimeKind.Utc
                    ? value.Value
                    : DateTime.SpecifyKind(value.Value, DateTimeKind.Utc);

        return utcValue
            .AddHours(3)
            .ToString(
                "yyyy-MM-ddTHH:mm",
                System.Globalization.CultureInfo.InvariantCulture
            );
    }

    var maintenanceStartInput =
        FormatYemenMaintenanceInput(
            Model.MaintenanceStartAt
        );

    var maintenanceEndInput =
        FormatYemenMaintenanceInput(
            Model.MaintenanceEndAt
        );

}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/settings.css" asp-append-version="true" />
}


    <style>
        /* ==========================================================================
           YemenGuide Admin Settings — Bilingual fields
           داخل SystemSettings.cshtml نفسه، بدون إنشاء CSS جديد.
           ========================================================================== */

        .system-settings-page {
            overflow-x: clip;
        }

        .settings-bilingual-card {
            overflow: visible;
        }

        .settings-bilingual-pair {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: 14px;
            align-items: stretch;
            width: 100%;
        }

        .settings-language-field {
            position: relative;
            min-width: 0;
            padding: 14px 12px 10px;
            border: 1px solid rgba(5, 32, 60, .08);
            border-radius: 16px;
            background: linear-gradient(180deg, #ffffff 0%, #f9fbfd 100%);
        }

        .settings-language-field--ar {
            border-inline-start: 3px solid #00a6da;
        }

        .settings-language-field--en {
            border-inline-start: 3px solid #f59e0b;
        }

        .settings-language-badge {
            position: absolute;
            top: -10px;
            inset-inline-start: 12px;
            z-index: 2;
            min-width: 34px;
            height: 21px;
            padding: 0 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            background: #05203c;
            color: #fff;
            font-size: .68rem;
            font-weight: 900;
            letter-spacing: .06em;
            box-shadow: 0 4px 12px rgba(5, 32, 60, .15);
        }

        .settings-language-field--en .settings-language-badge {
            background: #f59e0b;
            color: #3b2a00;
        }

        .settings-language-field .form-floating {
            width: 100%;
            margin: 0;
        }

        .settings-language-field .form-control,
        .settings-language-field .form-select {
            width: 100%;
            min-width: 0;
            background: #fff !important;
        }

        .settings-language-field--ar .form-control,
        .settings-language-field--ar .form-select {
            direction: rtl;
            text-align: right;
        }

        .settings-language-field--en .form-control,
        .settings-language-field--en .form-select {
            direction: ltr;
            text-align: left;
        }

        .settings-language-field--ar .form-floating > label {
            right: 0;
            left: auto;
            width: 100%;
            text-align: right;
            direction: rtl;
        }

        .settings-language-field--en .form-floating > label {
            left: 0;
            right: auto;
            width: 100%;
            text-align: left;
            direction: ltr;
        }

        .settings-bilingual-pair textarea.form-control {
            min-height: 110px;
        }

        .settings-bilingual-pair + .settings-bilingual-pair {
            margin-top: 14px;
        }

        .system-settings-page .settings-card > [class*="col-"] {
            width: 100%;
            max-width: 100%;
            padding-inline: 0;
        }

        .settings-slider-form-row--bilingual > [class*="col-"],
        .settings-wallet-form-row--bilingual > [class*="col-"] {
            min-width: 0;
        }

        .settings-slider-form-row--bilingual .form-control,
        .settings-wallet-form-row--bilingual .form-control,
        .settings-slider-form-row--bilingual .settings-slide-upload-label,
        .settings-slider-form-row--bilingual .settings-slider-add-btn,
        .settings-wallet-form-row--bilingual .settings-wallet-add-btn {
            min-height: 58px;
        }

        .system-settings-page .form-floating > label {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: calc(100% - 10px);
        }

        .maintenance-tab .settings-bilingual-card {
            min-height: 100%;
        }

        @@media (max-width: 1199.98px) {
            .settings-bilingual-pair--stack-at-lg {
                grid-template-columns: 1fr;
                gap: 16px;
            }
        }

        @@media (max-width: 767.98px) {
            .settings-bilingual-pair {
                grid-template-columns: 1fr;
                gap: 16px;
            }

            .settings-language-field {
                padding: 14px 10px 10px;
            }

            .settings-bilingual-card {
                padding: 18px !important;
            }

            .settings-slider-form-row--bilingual .settings-slider-add-btn,
            .settings-wallet-form-row--bilingual .settings-wallet-add-btn {
                width: 100%;
            }
        }

        @@media (max-width: 480px) {
            .system-settings-page {
                padding-inline: 10px !important;
            }

            .settings-main-panel {
                padding: 12px !important;
            }

            .settings-language-badge {
                inset-inline-start: 8px;
            }
        }
    </style>


    @Html.AntiForgeryToken()

    <div class="container-fluid px-4 py-3 system-settings-page" dir="rtl">
        <div class="d-flex justify-content-between align-items-center mb-4 settings-page-header">
            <div class="settings-title-block">
                <h2 class="fw-bold mb-1 settings-page-title"><i class="bi bi-gear-wide-connected text-primary me-2"></i> إعدادات النظام</h2>
                <p class="text-muted">تحكم كامل في هوية المنصة وسياساتها وإعلاناتها والمنظومة المالية.</p>
            </div>
        </div>

        <div class="settings-tabs-scroll mb-4" role="region" aria-label="تبويبات إعدادات النظام">
            <div class="custom-tabs-container d-flex justify-content-start border-bottom gap-3" role="tablist">
                <button type="button" class="tab-btn active d-flex align-items-center gap-2" data-target="branding-tab" role="tab" aria-selected="true">
                    <i class="bi bi-globe2"></i>
                    <span class="tab-label">هوية وماركة</span>
                </button>
                <button type="button" class="tab-btn d-flex align-items-center gap-2" data-target="policies-tab" role="tab" aria-selected="false">
                    <i class="bi bi-sliders2"></i>
                    <span class="tab-label">سياسات التشغيل</span>
                </button>
                <button type="button" class="tab-btn d-flex align-items-center gap-2" data-target="contact-tab" role="tab" aria-selected="false">
                    <i class="bi bi-headset"></i>
                    <span class="tab-label">التواصل والروابط</span>
                </button>
                <button type="button" class="tab-btn d-flex align-items-center gap-2" data-target="maintenance-tab" role="tab" aria-selected="false">
                    <i class="bi bi-cone-striped"></i>
                    <span class="tab-label">الصيانة والطوارئ</span>
                </button>
                <button type="button" class="tab-btn d-flex align-items-center gap-2" data-target="wallets-tab" role="tab" aria-selected="false">
                    <i class="bi bi-wallet2"></i>
                    <span class="tab-label">شبكات الدفع</span>
                </button>
            </div>
        </div>

        <div class="glass-card p-4 shadow-sm border-0 rounded-4 settings-main-panel">
            @* ============================================================================== *@
            @* 💎 1. تبويب الهوية والماركة والمواسم (تصميم VIP فائق الترتيب) 💎 *@
            @* ============================================================================== *@
            <div class="tab-pane-content branding-tab settings-tab-panel" style="display: block;">

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="settings-card p-4 h-100 rounded-4 shadow-sm border-0 settings-bilingual-card">
                            <h6 class="fw-bold text-navy mb-4">
                                <i class="bi bi-info-square me-2 text-primary"></i>
                                البيانات الأساسية
                            </h6>

                            <div class="settings-bilingual-pair">
                                <div class="settings-language-field settings-language-field--ar" dir="rtl">
                                    <span class="settings-language-badge">AR</span>
                                    <div class="form-floating">
                                        <input type="text"
                                           class="form-control rounded-3"
                                           id="siteName"
                                           placeholder="اسم المنصة"
                                           value="@Model.SiteName">
                                        <label for="siteName">اسم المنصة الرسمي</label>
                                    </div>
                                </div>

                                <div class="settings-language-field settings-language-field--en" dir="ltr">
                                    <span class="settings-language-badge">EN</span>
                                    <div class="form-floating">
                                        <input type="text"
                                           class="form-control rounded-3"
                                           id="siteNameEn"
                                           placeholder="Platform name"
                                           value="@Model.SiteNameEn"
                                           required>
                                        <label for="siteNameEn">Platform name</label>
                                    </div>
                                </div>
                            </div>

                            <div class="settings-bilingual-pair settings-bilingual-pair--textarea mt-3">
                                <div class="settings-language-field settings-language-field--ar" dir="rtl">
                                    <span class="settings-language-badge">AR</span>
                                    <div class="form-floating">
                                        <textarea class="form-control rounded-3"
                                              id="siteDescription"
                                              placeholder="وصف المنصة"
                                              style="height: 112px">@Model.SiteDescription</textarea>
                                        <label for="siteDescription">الوصف لمحركات البحث (SEO)</label>
                                    </div>
                                </div>

                                <div class="settings-language-field settings-language-field--en" dir="ltr">
                                    <span class="settings-language-badge">EN</span>
                                    <div class="form-floating">
                                        <textarea class="form-control rounded-3"
                                              id="siteDescriptionEn"
                                              placeholder="Platform description"
                                              style="height: 112px">@Model.SiteDescriptionEn</textarea>
                                        <label for="siteDescriptionEn">Platform description (SEO)</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="settings-card p-4 h-100 rounded-4 shadow-sm border-0">
                            <h6 class="fw-bold text-navy mb-4"><i class="bi bi-images me-2 text-primary"></i> الهوية البصرية (الشعارات)</h6>

                            <label for="logoFile" class="d-flex align-items-center p-3 mb-3 border rounded-3 settings-upload-label" style="cursor: pointer; background: #f8f9fa; transition: all 0.3s;">
                                <div class="bg-white p-2 rounded-3 shadow-sm border me-3">
                                    <i class="bi bi-image fs-4 text-primary"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <span class="d-block fw-bold text-dark">شعار المنصة الرئيسي (Logo)</span>
                                    <small class="text-muted">اضغط لاختيار صورة جديدة</small>
                                </div>
                            @if (!string.IsNullOrEmpty(Model.LogoPath))
                            {
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2"><i class="bi bi-check-circle me-1"></i> محفوظ</span>
                            }
                        </label>
                        <input type="file" id="logoFile" accept="image/*" class="d-none">

                        <label for="faviconFile" class="d-flex align-items-center p-3 border rounded-3 settings-upload-label" style="cursor: pointer; background: #f8f9fa; transition: all 0.3s;">
                            <div class="bg-white p-2 rounded-3 shadow-sm border me-3">
                                <i class="bi bi-browser-chrome fs-4 text-primary"></i>
                            </div>
                            <div class="flex-grow-1">
                                <span class="d-block fw-bold text-dark">أيقونة المتصفح (Favicon)</span>
                                <small class="text-muted">مربع صغير (مثال: 64x64)</small>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.FaviconPath))
                            {
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2"><i class="bi bi-check-circle me-1"></i> محفوظ</span>
                            }
                        </label>
                        <input type="file" id="faviconFile" accept="image/*" class="d-none">
                    </div>
                </div>
            </div>

            <div class="mt-5 settings-section">
                <h5 class="fw-bold mb-3 text-primary settings-section-title"><i class="bi bi-stars me-2"></i> إعدادات المواسم والترحيب</h5>

                <div class="row g-4">
                    <div class="col-lg-7">
                        <div class="settings-card p-4 h-100 rounded-4 shadow-sm border-0">
                            <h6 class="fw-bold mb-4 text-navy">عناوين الواجهة الرئيسية والثيم</h6>

                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="settings-bilingual-pair">
                                        <div class="settings-language-field settings-language-field--ar" dir="rtl">
                                            <span class="settings-language-badge">AR</span>
                                            <div class="form-floating">
                                                <input type="text"
                                                       class="form-control rounded-3"
                                                       id="heroTitleMain"
                                                       value="@(string.IsNullOrEmpty(Model.HeroTitleMain) ? "دليلك اليمني بين يديك.." : Model.HeroTitleMain)"
                                                       placeholder="العنوان">
                                                <label for="heroTitleMain">العنوان الرئيسي</label>
                                            </div>
                                        </div>

                                        <div class="settings-language-field settings-language-field--en" dir="ltr">
                                            <span class="settings-language-badge">EN</span>
                                            <div class="form-floating">
                                                <input type="text"
                                                       class="form-control rounded-3"
                                                       id="heroTitleMainEn"
                                                       value="@Model.HeroTitleMainEn"
                                                       placeholder="Main hero title"
                                                       required>
                                                <label for="heroTitleMainEn">Main hero title</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="settings-bilingual-pair">
                                        <div class="settings-language-field settings-language-field--ar" dir="rtl">
                                            <span class="settings-language-badge">AR</span>
                                            <div class="form-floating">
                                                <input type="text"
                                                       class="form-control rounded-3"
                                                       id="heroTitleSub"
                                                       value="@(string.IsNullOrEmpty(Model.HeroTitleSub) ? "اكتشف" : Model.HeroTitleSub)"
                                                       placeholder="الكلمة المساعدة">
                                                <label for="heroTitleSub">الكلمة المساعدة</label>
                                            </div>
                                        </div>

                                        <div class="settings-language-field settings-language-field--en" dir="ltr">
                                            <span class="settings-language-badge">EN</span>
                                            <div class="form-floating">
                                                <input type="text"
                                                       class="form-control rounded-3"
                                                       id="heroTitleSubEn"
                                                       value="@Model.HeroTitleSubEn"
                                                       placeholder="Discover"
                                                       required>
                                                <label for="heroTitleSubEn">Hero helper text</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 mt-4">
                                    <label class="fw-bold small text-muted mb-2 d-block">تفعيل الثيم الموسمي (المؤثرات البصرية)</label>
                                    <div class="form-floating">
                                        <select class="form-select rounded-3 border-primary border-opacity-25" id="seasonTheme" style="background-color: rgba(0, 166, 218, 0.03);">
                                            <option value="Normal" selected="@(Model.SeasonTheme == "Normal" ? "selected" : null)">إيقاف المؤثرات (وضع كلاسيكي هادئ)</option>
                                            <option value="Ramadan" selected="@(Model.SeasonTheme == "Ramadan" ? "selected" : null)">🌙 ثيم الأجواء الرمضانية</option>
                                            <option value="Eid" selected="@(Model.SeasonTheme == "Eid" ? "selected" : null)">🎉 ثيم بهجة الأعياد</option>
                                            <option value="Rain" selected="@(Model.SeasonTheme == "Rain" ? "selected" : null)">🌧️ ثيم الطبيعة والأمطار</option>
                                            <option value="Snow" selected="@(Model.SeasonTheme == "Snow" ? "selected" : null)">❄️ ثيم الثلوج الناعمة</option>
                                            <option value="Spring" selected="@(Model.SeasonTheme == "Spring" ? "selected" : null)">🌸 ثيم بتلات الورد الربيعية</option>
                                            <option value="Autumn" selected="@(Model.SeasonTheme == "Autumn" ? "selected" : null)">🍂 ثيم أوراق الخريف الدافئة</option>
                                            <option value="Gold" selected="@(Model.SeasonTheme == "Gold" ? "selected" : null)">✨ ثيم غبار الذهب المضيء</option>
                                        </select>
                                        <label for="seasonTheme">اختر الموسم الحالي</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="settings-card p-4 h-100 rounded-4 shadow-sm border-0 settings-bilingual-card"
                             style="background: linear-gradient(145deg, #ffffff, #fcfcfc);">
                            <div class="d-flex justify-content-between align-items-center mb-4 settings-page-header">
                                <h6 class="fw-bold mb-0 text-navy">شريط التهنئة العائم (VIP)</h6>
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="isBannerActive"
                                           @(Model.IsBannerActive == true ? "checked" : "")>
                                </div>
                            </div>

                            <div class="settings-bilingual-pair settings-bilingual-pair--stack-at-lg">
                                <div class="settings-language-field settings-language-field--ar" dir="rtl">
                                    <span class="settings-language-badge">AR</span>
                                    <div class="form-floating">
                                        <textarea class="form-control rounded-3"
                                                  id="bannerText"
                                                  placeholder="التهنئة"
                                                  style="height: 125px;">@(string.IsNullOrEmpty(Model.BannerText) ? "إدارة منصة دليلك اليمني تهنئكم بحلول المناسبة السعيدة، كل عام وأنتم بخير! ✨" : Model.BannerText)</textarea>
                                        <label for="bannerText">نص البنر</label>
                                    </div>
                                </div>

                                <div class="settings-language-field settings-language-field--en" dir="ltr">
                                    <span class="settings-language-badge">EN</span>
                                    <div class="form-floating">
                                        <textarea class="form-control rounded-3"
                                                  id="bannerTextEn"
                                                  placeholder="Banner text"
                                                  style="height: 125px;">@Model.BannerTextEn</textarea>
                                        <label for="bannerTextEn">Banner text</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-5 settings-section">
                <h5 class="fw-bold mb-3 text-primary settings-section-title"><i class="bi bi-display me-2"></i> استوديو العرض السينمائي (السلايدر)</h5>

                <div class="settings-card p-4 mb-4 rounded-4 shadow-sm border-primary border-opacity-10" style="background: rgba(0, 166, 218, 0.02);">
                    <form id="addHeroSlideForm" onsubmit="addHeroSlideDynamically(event)">
                        <div class="row g-3 align-items-end settings-slider-form-row settings-slider-form-row--bilingual">
                            <div class="col-xl-2 col-lg-3 col-md-6">
                                <label class="fw-bold small text-muted mb-2 d-block">النص التفاعلي — عربي</label>
                                <input type="text"
                                       class="form-control rounded-3 p-3"
                                       id="newSlideText"
                                       placeholder="مثال: أرقى الفنادق"
                                       dir="rtl"
                                       required>
                            </div>

                            <div class="col-xl-2 col-lg-3 col-md-6" dir="ltr">
                                <label class="fw-bold small text-muted mb-2 d-block">Hero text — English</label>
                                <input type="text"
                                       class="form-control rounded-3 p-3"
                                       id="newSlideTextEn"
                                       placeholder="e.g. Finest Hotels"
                                       required>
                            </div>

                            <div class="col-xl-4 col-lg-6">
                                <label class="fw-bold small text-muted mb-2 d-block">صورة أو فيديو (HD)</label>
                                <label for="newSlideImage"
                                       class="d-flex align-items-center justify-content-center p-3 border rounded-3 bg-white w-100 settings-slide-upload-label"
                                       style="cursor: pointer; height: 58px;">
                                    <i class="bi bi-cloud-arrow-up text-primary me-2 fs-5"></i>
                                    <span class="fw-bold text-dark" id="fileNameDisplay">اختر ملفاً...</span>
                                </label>
                                <input type="file"
                                       id="newSlideImage"
                                       accept="image/*, video/mp4"
                                       class="d-none"
                                       required
                                       onchange="document.getElementById('fileNameDisplay').innerText = this.files[0].name">
                            </div>

                            <div class="col-xl-2 col-lg-6">
                                <label class="fw-bold small text-muted mb-2 d-block text-center">ألوان النصوص</label>
                                <div class="d-flex justify-content-center gap-3 settings-colors-row">
                                    <div class="text-center">
                                        <input type="color"
                                               class="form-control form-control-color p-1 rounded-3 border border-2 border-secondary mb-1"
                                               id="newSlideMainTextColor"
                                               value="#ffffff"
                                               title="اختر لون العنوان الثابت">
                                        <small class="text-navy fw-bold">العنوان</small>
                                    </div>
                                    <div class="text-center">
                                        <input type="color"
                                               class="form-control form-control-color p-1 rounded-3 border border-2 border-secondary mb-1"
                                               id="newSlideAccentColor"
                                               value="#ff5a5f"
                                               title="اختر لون الكلمة المتحركة">
                                        <small class="text-orange fw-bold">المتحرك</small>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-2 col-lg-6 settings-slider-submit-column">
                                <button type="submit"
                                        class="btn btn-primary w-100 rounded-3 shadow-sm settings-slider-add-btn"
                                        style="height: 58px;">
                                    <i class="bi bi-plus-lg me-1"></i>
                                    إدراج
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="settings-card p-0 rounded-4 shadow-sm border-0 overflow-hidden">
                    <div class="table-responsive settings-table-scroll">
                        <table class="table table-hover align-middle mb-0 text-center custom-admin-table slider-admin-table" style="min-width: 1040px;">
                            <thead class="bg-light text-muted">
                                <tr>
                                    <th style="width: 8%; padding: 15px;">الترتيب</th>
                                    <th style="width: 20%; padding: 15px;">المعاينة</th>
                                    <th style="width: 12%; padding: 15px;">نوع المرفق</th>
                                    <th style="width: 28%; padding: 15px; text-align: center;">النص التفاعلي — عربي / English</th>
                                    <th style="width: 15%; padding: 15px;">الألوان</th>
                                    <th style="width: 10%; padding: 15px;">الحالة</th>
