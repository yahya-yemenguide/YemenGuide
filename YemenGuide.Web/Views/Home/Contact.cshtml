@inject YemenGuide.Data.AppDbContext _context
@{
    ViewData["Title"] = "تواصل معنا";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var settings = _context.SystemSettings.FirstOrDefault();

    string siteName = settings?.SiteName ?? "دليلك اليمني";
    string whatsappRaw = settings?.WhatsAppNumber?.Trim() ?? string.Empty;
    string whatsappNumber = System.Text.RegularExpressions.Regex.Replace(
        whatsappRaw,
        @"\D",
        string.Empty);

    string contactEmail = settings?.ContactEmail?.Trim() ?? string.Empty;

    bool hasWhatsapp = !string.IsNullOrWhiteSpace(whatsappNumber);
    bool hasEmail = !string.IsNullOrWhiteSpace(contactEmail);

    string whatsappDirectUrl = hasWhatsapp
        ? $"https://wa.me/{whatsappNumber}"
        : "#";

    string emailDirectUrl = hasEmail
        ? $"mailto:{contactEmail}"
        : "#";
}

@section Styles {
    <link rel="stylesheet"
      href="~/css/customer/contact.css"
      asp-append-version="true" />
}

    <main class="yg-contact-page"
      id="ygContactPage"
      data-whatsapp="@whatsappNumber"
      data-email="@contactEmail"
      data-site-name="@siteName">

        <!-- ============================================================= -->
        <!-- HERO                                                           -->
        <!-- ============================================================= -->
        <section class="yg-contact-hero"
             aria-labelledby="contactHeroTitle">

            <div class="yg-contact-hero-art" aria-hidden="true">
                <span class="yg-contact-grid"></span>
                <span class="yg-contact-orbit yg-contact-orbit--one"></span>
                <span class="yg-contact-orbit yg-contact-orbit--two"></span>
                <span class="yg-contact-glow yg-contact-glow--cyan"></span>
                <span class="yg-contact-glow yg-contact-glow--orange"></span>
                <span class="yg-contact-star yg-contact-star--1"></span>
                <span class="yg-contact-star yg-contact-star--2"></span>
                <span class="yg-contact-star yg-contact-star--3"></span>
                <span class="yg-contact-star yg-contact-star--4"></span>
                <span class="yg-contact-star yg-contact-star--5"></span>
                <span class="yg-contact-star yg-contact-star--6"></span>
            </div>

            <div class="container yg-contact-hero-container">
                <div class="row align-items-center g-5">

                    <div class="col-lg-7">
                        <div class="yg-contact-hero-copy" data-contact-reveal>

                            <span class="yg-contact-live-pill">
                                <span class="yg-contact-live-dot"></span>
                                <i class="bi bi-headset"></i>
                                فريق الدعم قريب منك
                            </span>

                            <span class="yg-contact-kicker">YEMENGUIDE SUPPORT</span>

                            <h1 id="contactHeroTitle">
                                رسالتك توصلنا
                                <span>بالطريقة التي تفضّلها</span>
                            </h1>

                            <p>
                                اكتب رسالتك مرة واحدة، ثم اختر واتساب أو البريد الإلكتروني.
                                سنجهّز النص لك وننقلك مباشرة إلى وسيلة التواصل الرسمية
                                المحفوظة من إعدادات الإدارة.
                            </p>

                            <div class="yg-contact-hero-badges">
                                <span><i class="bi bi-whatsapp"></i> واتساب مباشر</span>
                                <span><i class="bi bi-envelope-paper"></i> بريد إلكتروني</span>
                                <span><i class="bi bi-shield-check"></i> بيانات رسمية من الإدارة</span>
                            </div>

                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="yg-contact-signal-card" data-contact-reveal>
                            <span class="yg-signal-card-shine"></span>

                            <div class="yg-signal-radar" aria-hidden="true">
                                <span class="yg-radar-ring yg-radar-ring--1"></span>
                                <span class="yg-radar-ring yg-radar-ring--2"></span>
                                <span class="yg-radar-ring yg-radar-ring--3"></span>

                                <span class="yg-radar-core">
                                    <i class="bi bi-chat-heart-fill"></i>
                                </span>

                                <span class="yg-radar-node yg-radar-node--wa">
                                    <i class="bi bi-whatsapp"></i>
                                </span>

                                <span class="yg-radar-node yg-radar-node--mail">
                                    <i class="bi bi-envelope-fill"></i>
                                </span>
                            </div>

                            <div class="yg-signal-card-copy">
                                <small>قنوات التواصل الرسمية</small>
                                <strong>اختر، اكتب، وأرسل مباشرة</strong>
                                <span>
                                    بدون إنشاء تذكرة جديدة أو انتظار نموذج داخلي.
                                </span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>


        <!-- ============================================================= -->
        <!-- CONTACT HUB                                                    -->
        <!-- ============================================================= -->
        <section class="yg-contact-hub">
            <div class="container">

                <div class="yg-contact-section-head" data-contact-reveal>
                    <span class="yg-section-eyebrow">تواصل بالطريقة المناسبة لك</span>
                    <h2>قناتان واضحتان، ورسالة واحدة جاهزة</h2>
                    <p>
                        الرقم والإيميل في هذه الصفحة لا يتم تثبيتهما داخل الكود؛
                        يتم قراءتهما مباشرة من تبويب التواصل في إعدادات الإدارة.
                    </p>
                </div>

                <div class="row g-4 yg-contact-channel-row">

                    <div class="col-lg-6">
                        <a class="yg-channel-card yg-channel-card--whatsapp @(hasWhatsapp ? "" : "is-unavailable")"
                       href="@whatsappDirectUrl"
                       target="@(hasWhatsapp ? "_blank" : null)"
                       rel="@(hasWhatsapp ? "noopener noreferrer" : null)"
                       aria-disabled="@(!hasWhatsapp)">

                            <span class="yg-channel-card-glow"></span>

                            <span class="yg-channel-icon">
                                <i class="bi bi-whatsapp"></i>
                            </span>

                            <span class="yg-channel-copy">
                                <small>تواصل سريع</small>
                                <strong>واتساب</strong>
                                <span class="yg-channel-value" dir="ltr">
                                    @(hasWhatsapp ? whatsappRaw : "لم يتم إضافة رقم واتساب من الإدارة")
                            </span>
                        </span>

                        <span class="yg-channel-arrow">
                            <i class="bi bi-arrow-up-left"></i>
                        </span>
                    </a>
                </div>

                <div class="col-lg-6">
                    <a class="yg-channel-card yg-channel-card--email @(hasEmail ? "" : "is-unavailable")"
                       href="@emailDirectUrl"
                       aria-disabled="@(!hasEmail)">

                        <span class="yg-channel-card-glow"></span>

                        <span class="yg-channel-icon">
                            <i class="bi bi-envelope-paper-heart-fill"></i>
                        </span>

                        <span class="yg-channel-copy">
                            <small>للتفاصيل والمراسلات</small>
                            <strong>البريد الإلكتروني</strong>
                            <span class="yg-channel-value" dir="ltr">
                                @(hasEmail ? contactEmail : "لم يتم إضافة بريد إلكتروني من الإدارة")
                            </span>
                        </span>

                        <span class="yg-channel-arrow">
                            <i class="bi bi-arrow-up-left"></i>
                        </span>
                    </a>
                </div>

            </div>


            <!-- ===================================================== -->
            <!-- MESSAGE COMPOSER                                      -->
            <!-- ===================================================== -->
            <div class="yg-contact-composer" data-contact-reveal>

                <div class="yg-composer-side">
                    <span class="yg-composer-side-badge">
                        <i class="bi bi-stars"></i>
                        رسالة جاهزة للإرسال
                    </span>

                    <h3>
                        اكتب التفاصيل
                        <span>ونحن نجهّز الرابط</span>
                    </h3>

                    <p>
                        اختر موضوع الرسالة واكتب التفاصيل. عند الضغط على واتساب أو البريد
                        سيتم إنشاء رسالة مرتبة تلقائيًا ثم فتح التطبيق المناسب.
                    </p>

                    <div class="yg-composer-steps">
                        <span><b>01</b> اكتب اسمك</span>
                        <span><b>02</b> اختر الموضوع</span>
                        <span><b>03</b> اكتب الرسالة</span>
                        <span><b>04</b> اختر وسيلة الإرسال</span>
                    </div>
                </div>

                <div class="yg-composer-form-shell">
                    <form id="contactForm"
                          class="yg-contact-form"
                          novalidate>

                        <div class="row g-3 g-md-4">

                            <div class="col-md-6">
                                <div class="yg-field">
                                    <label for="SenderName">
                                        <i class="bi bi-person"></i>
                                        الاسم الكامل
                                    </label>

                                    <div class="yg-field-shell">
                                        <input type="text"
                                               id="SenderName"
                                               class="form-control"
                                               placeholder="مثال: أحمد محمد"
                                               maxlength="80"
                                               autocomplete="name"
                                               required />
                                        <span class="yg-field-line"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="yg-field">
                                    <label for="Subject">
                                        <i class="bi bi-grid"></i>
                                        موضوع الرسالة
                                    </label>

                                    <div class="yg-field-shell yg-field-shell--select">
                                        <select id="Subject"
                                                class="form-select"
                                                required>
                                            <option value="استفسار عام">استفسار عام</option>
                                            <option value="مشكلة في الحجز">مشكلة في الحجز</option>
                                            <option value="طلب إضافة منشأة">طلب إضافة منشأة</option>
                                            <option value="شكوى أو اقتراح">شكوى أو اقتراح</option>
                                            <option value="مساعدة تقنية">مساعدة تقنية</option>
                                        </select>
                                        <span class="yg-field-line"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="yg-field">
                                    <div class="yg-field-label-row">
                                        <label for="MessageBody">
                                            <i class="bi bi-chat-left-text"></i>
                                            تفاصيل الرسالة
                                        </label>

                                        <span id="ygMessageCounter"
                                              class="yg-message-counter">
                                            0 / 700
                                        </span>
                                    </div>

                                    <div class="yg-field-shell yg-field-shell--textarea">
                                        <textarea id="MessageBody"
                                                  class="form-control"
                                                  rows="6"
                                                  maxlength="700"
                                                  placeholder="اكتب تفاصيل استفسارك أو المشكلة بوضوح..."
                                                  required></textarea>
                                        <span class="yg-field-line"></span>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="yg-send-zone">

                            <div class="yg-send-zone-copy">
                                <i class="bi bi-shield-lock"></i>
                                <span>
                                    لن يتم حفظ نص الرسالة في الموقع؛ سيتم فقط نقلك
                                    إلى وسيلة التواصل التي تختارها.
                                </span>
                            </div>

                            <div class="yg-send-actions">
                                <button type="button"
                                        id="sendByWhatsapp"
                                        class="yg-send-btn yg-send-btn--whatsapp"
                                        @(hasWhatsapp ? null : "disabled")>
                                    <span class="yg-send-icon">
                                        <i class="bi bi-whatsapp"></i>
                                    </span>
                                    <span class="yg-send-copy">
                                        <small>إرسال مباشر</small>
                                        <strong>عبر واتساب</strong>
                                    </span>
                                    <i class="bi bi-arrow-up-left yg-send-arrow"></i>
                                </button>

                                <button type="button"
                                        id="sendByEmail"
                                        class="yg-send-btn yg-send-btn--email"
                                        @(hasEmail ? null : "disabled")>
                                    <span class="yg-send-icon">
                                        <i class="bi bi-envelope-fill"></i>
                                    </span>
                                    <span class="yg-send-copy">
                                        <small>فتح تطبيق البريد</small>
                                        <strong>عبر الإيميل</strong>
                                    </span>
                                    <i class="bi bi-arrow-up-left yg-send-arrow"></i>
                                </button>
                            </div>

                        </div>

                        <div class="yg-contact-feedback"
                             id="contactFeedback"
                             role="status"
                             aria-live="polite"></div>

                    </form>
                </div>

            </div>

        </div>
    </section>

</main>

@section Scripts {
    <script>
        (() => {
            const page = document.getElementById('ygContactPage');
            const form = document.getElementById('contactForm');
            const nameInput = document.getElementById('SenderName');
            const subjectInput = document.getElementById('Subject');
            const messageInput = document.getElementById('MessageBody');
            const counter = document.getElementById('ygMessageCounter');
            const feedback = document.getElementById('contactFeedback');
            const whatsappButton = document.getElementById('sendByWhatsapp');
            const emailButton = document.getElementById('sendByEmail');

            if (!page || !form) return;

            const whatsappNumber = (page.dataset.whatsapp || '').trim();
            const contactEmail = (page.dataset.email || '').trim();
            const siteName = (page.dataset.siteName || 'دليلك اليمني').trim();

            const showFeedback = (message, type = 'info') => {
                if (!feedback) return;
                feedback.textContent = message;
                feedback.dataset.type = type;
                feedback.classList.add('is-visible');
            };

            const clearFeedback = () => {
                if (!feedback) return;
                feedback.textContent = '';
                feedback.classList.remove('is-visible');
                feedback.removeAttribute('data-type');
            };

            const updateCounter = () => {
                if (!messageInput || !counter) return;
                counter.textContent = `${messageInput.value.length} / 700`;
            };

            const validateMessage = () => {
                clearFeedback();

                const senderName = (nameInput?.value || '').trim();
                const subject = (subjectInput?.value || '').trim();
                const message = (messageInput?.value || '').trim();

                if (!senderName) {
                    nameInput?.focus();
                    showFeedback('اكتب اسمك أولاً حتى نجهّز الرسالة بشكل مرتب.', 'warning');
                    return null;
                }

                if (!subject) {
                    subjectInput?.focus();
                    showFeedback('اختر موضوع الرسالة.', 'warning');
                    return null;
                }

                if (!message) {
                    messageInput?.focus();
                    showFeedback('اكتب تفاصيل الرسالة قبل الإرسال.', 'warning');
                    return null;
                }

                return { senderName, subject, message };
            };

            const buildMessage = (data) => {
                return [
                    `مرحبًا فريق ${siteName} 👋`,
                    '',
                    `الاسم: ${data.senderName}`,
                    `الموضوع: ${data.subject}`,
                    '',
                    'تفاصيل الرسالة:',
                    data.message,
                    '',
                    'تم إرسال هذه الرسالة من صفحة تواصل معنا في دليلك اليمني.'
                ].join('\n');
            };

            whatsappButton?.addEventListener('click', () => {
                const data = validateMessage();
                if (!data) return;

                if (!whatsappNumber) {
                    showFeedback('رقم واتساب غير مضاف حاليًا من إعدادات الإدارة.', 'error');
                    return;
                }

                const text = buildMessage(data);
                const url = `https://wa.me/${encodeURIComponent(whatsappNumber)}?text=${encodeURIComponent(text)}`;

                showFeedback('تم تجهيز الرسالة، يتم الآن فتح واتساب...', 'success');
                window.open(url, '_blank', 'noopener,noreferrer');
            });

            emailButton?.addEventListener('click', () => {
                const data = validateMessage();
                if (!data) return;

                if (!contactEmail) {
                    showFeedback('البريد الإلكتروني غير مضاف حاليًا من إعدادات الإدارة.', 'error');
                    return;
                }

                const body = buildMessage(data);
                const subject = `[${siteName}] ${data.subject}`;
                const url = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

                showFeedback('تم تجهيز الرسالة، يتم الآن فتح تطبيق البريد...', 'success');
                window.location.href = url;
            });

            messageInput?.addEventListener('input', updateCounter);
            updateCounter();

            form.addEventListener('submit', (event) => event.preventDefault());

            document.querySelectorAll('.yg-channel-card.is-unavailable').forEach((card) => {
                card.addEventListener('click', (event) => event.preventDefault());
            });

            const revealItems = document.querySelectorAll('[data-contact-reveal]');
            if ('IntersectionObserver' in window) {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach((entry) => {
                        if (!entry.isIntersecting) return;
                        entry.target.classList.add('is-visible');
                        observer.unobserve(entry.target);
                    });
                }, { threshold: 0.12 });

                revealItems.forEach((item) => observer.observe(item));
            } else {
                revealItems.forEach((item) => item.classList.add('is-visible'));
            }
        })();
    </script>
}
