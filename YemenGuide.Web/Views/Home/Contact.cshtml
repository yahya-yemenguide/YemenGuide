@inject YemenGuide.Data.AppDbContext _context
@{
    ViewData["Title"] = "تواصل معنا";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var settings = _context.SystemSettings.FirstOrDefault();

    string siteName = settings?.SiteName ?? "دليلك اليمني";
    string whatsappRaw = settings?.WhatsAppNumber?.Trim() ?? string.Empty;
    string whatsappNumber = System.Text.RegularExpressions.Regex.Replace(
        whatsappRaw,
        @"\D",
        string.Empty);

    string contactEmail = settings?.ContactEmail?.Trim() ?? string.Empty;

    bool hasWhatsapp = !string.IsNullOrWhiteSpace(whatsappNumber);
    bool hasEmail = !string.IsNullOrWhiteSpace(contactEmail);
}

@section Styles {
    <link rel="stylesheet"
      href="~/css/customer/contact.css"
      asp-append-version="true" />
}

    <main class="yg-contact-page"
      id="ygContactPage"
      data-whatsapp="@whatsappNumber"
      data-email="@contactEmail"
      data-site-name="@siteName">

        <section class="yg-contact-hero">
            <div class="yg-contact-hero-bg" aria-hidden="true">
                <span class="yg-contact-hero-grid"></span>
                <span class="yg-contact-orb yg-contact-orb--cyan"></span>
                <span class="yg-contact-orb yg-contact-orb--orange"></span>
                <span class="yg-contact-line yg-contact-line--1"></span>
                <span class="yg-contact-line yg-contact-line--2"></span>
                <span class="yg-contact-star yg-contact-star--1"></span>
                <span class="yg-contact-star yg-contact-star--2"></span>
                <span class="yg-contact-star yg-contact-star--3"></span>
                <span class="yg-contact-star yg-contact-star--4"></span>
            </div>

            <div class="container yg-contact-hero-inner">
                <div class="row align-items-center g-5">

                    <div class="col-lg-7">
                        <div class="yg-contact-hero-copy" data-contact-reveal>
                            <span class="yg-contact-badge">
                                <span class="yg-contact-badge-dot"></span>
                                <i class="bi bi-headset"></i>
                                دعم دليلك اليمني
                            </span>

                            <p class="yg-contact-eyebrow">YEMENGUIDE • CONTACT CENTER</p>

                            <h1>
                                اكتب رسالتك مرة واحدة
                                <span>وأرسلها بالطريقة التي تناسبك</span>
                            </h1>

                            <p class="yg-contact-hero-text">
                                اختر موضوع الرسالة، اكتب التفاصيل، ثم افتح واتساب أو البريد
                                مباشرة على بيانات التواصل الرسمية المحددة من الإدارة.
                            </p>

                            <div class="yg-contact-trust-row">
                                <span><i class="bi bi-whatsapp"></i> واتساب مباشر</span>
                                <span><i class="bi bi-envelope-check"></i> بريد رسمي</span>
                                <span><i class="bi bi-shield-check"></i> بدون حفظ الرسالة داخل الموقع</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="yg-contact-hero-panel" data-contact-reveal>
                            <span class="yg-contact-panel-light"></span>

                            <div class="yg-contact-panel-icon">
                                <span class="yg-contact-panel-ring yg-contact-panel-ring--1"></span>
                                <span class="yg-contact-panel-ring yg-contact-panel-ring--2"></span>
                                <span class="yg-contact-panel-ring yg-contact-panel-ring--3"></span>
                                <span class="yg-contact-panel-core">
                                    <i class="bi bi-chat-dots-fill"></i>
                                </span>
                                <span class="yg-contact-panel-node yg-contact-panel-node--wa">
                                    <i class="bi bi-whatsapp"></i>
                                </span>
                                <span class="yg-contact-panel-node yg-contact-panel-node--mail">
                                    <i class="bi bi-envelope-fill"></i>
                                </span>
                            </div>

                            <div class="yg-contact-panel-copy">
                                <small>قنوات التواصل الرسمية</small>
                                <strong>رسالتك جاهزة خلال ثوانٍ</strong>
                                <p>لا تحتاج إلى إنشاء حساب دعم أو انتظار نموذج داخلي.</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>


        <section class="yg-contact-body">
            <div class="container">

                <div class="yg-contact-channel-grid" data-contact-reveal>

                    <a class="yg-contact-channel yg-contact-channel--wa @(hasWhatsapp ? "" : "is-disabled")"
                   href="@(hasWhatsapp ? $"https://wa.me/{whatsappNumber}" : "#")"
                   target="@(hasWhatsapp ? "_blank" : null)"
                   rel="@(hasWhatsapp ? "noopener noreferrer" : null)">
                        <span class="yg-contact-channel-glow"></span>
                        <span class="yg-contact-channel-icon">
                            <i class="bi bi-whatsapp"></i>
                        </span>
                        <span class="yg-contact-channel-copy">
                            <small>الأسرع للرد</small>
                            <strong>واتساب</strong>
                            <b dir="ltr">@(hasWhatsapp ? whatsappRaw : "غير مضاف من الإدارة")</b>
                    </span>
                    <span class="yg-contact-channel-arrow">
                        <i class="bi bi-arrow-up-left"></i>
                    </span>
                </a>

                <a class="yg-contact-channel yg-contact-channel--mail @(hasEmail ? "" : "is-disabled")"
                   href="@(hasEmail ? $"mailto:{contactEmail}" : "#")">
                    <span class="yg-contact-channel-glow"></span>
                    <span class="yg-contact-channel-icon">
                        <i class="bi bi-envelope-paper-fill"></i>
                    </span>
                    <span class="yg-contact-channel-copy">
                        <small>للمراسلات والتفاصيل</small>
                        <strong>البريد الإلكتروني</strong>
                        <b dir="ltr">@(hasEmail ? contactEmail : "غير مضاف من الإدارة")</b>
                    </span>
                    <span class="yg-contact-channel-arrow">
                        <i class="bi bi-arrow-up-left"></i>
                    </span>
                </a>

            </div>


            <div class="yg-contact-shell" data-contact-reveal>

                <aside class="yg-contact-shell-side">
                    <span class="yg-contact-shell-badge">
                        <i class="bi bi-stars"></i>
                        جهّز رسالتك
                    </span>

                    <h2>
                        كل ما تحتاجه
                        <span>في مكان واحد</span>
                    </h2>

                    <p>
                        اكتب اسمك، اختر الموضوع، وأضف التفاصيل. لو موضوعك غير موجود
                        اختر <strong>«أخرى»</strong> واكتب الموضوع بنفسك.
                    </p>

                    <div class="yg-contact-shell-steps">
                        <span><b>1</b> الاسم</span>
                        <span><b>2</b> الموضوع</span>
                        <span><b>3</b> التفاصيل</span>
                        <span><b>4</b> طريقة الإرسال</span>
                    </div>

                    <div class="yg-contact-shell-note">
                        <i class="bi bi-shield-lock-fill"></i>
                        <span>
                            الرسالة لا تُحفظ في قاعدة بيانات الموقع؛ يتم فقط تجهيزها
                            وفتح وسيلة التواصل التي اخترتها.
                        </span>
                    </div>
                </aside>


                <section class="yg-contact-composer">
                    <div class="yg-contact-composer-head">
                        <div>
                            <span>MESSAGE COMPOSER</span>
                            <h3>أرسل لنا رسالة</h3>
                        </div>
                        <div class="yg-contact-composer-status">
                            <span></span>
                            جاهز للإرسال
                        </div>
                    </div>

                    <form id="contactForm" novalidate>
                        <div class="row g-3 g-md-4">

                            <div class="col-md-6">
                                <div class="yg-contact-field">
                                    <label for="SenderName">
                                        <i class="bi bi-person"></i>
                                        الاسم الكامل
                                    </label>
                                    <div class="yg-contact-control">
                                        <input id="SenderName"
                                               type="text"
                                               class="form-control"
                                               maxlength="80"
                                               autocomplete="name"
                                               placeholder="اكتب اسمك هنا..."
                                               required />
                                        <span></span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="yg-contact-field">
                                    <label for="Subject">
                                        <i class="bi bi-grid"></i>
                                        موضوع الرسالة
                                    </label>
                                    <div class="yg-contact-control yg-contact-control--select">
                                        <select id="Subject"
                                                class="form-select"
                                                required>
                                            <option value="استفسار عام">استفسار عام</option>
                                            <option value="مشكلة في الحجز">مشكلة في الحجز</option>
                                            <option value="طلب إضافة منشأة">طلب إضافة منشأة</option>
                                            <option value="شكوى أو اقتراح">شكوى أو اقتراح</option>
                                            <option value="مساعدة تقنية">مساعدة تقنية</option>
                                            <option value="Other">أخرى</option>
                                        </select>
                                        <span></span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 d-none" id="OtherSubjectWrap">
                                <div class="yg-contact-field yg-contact-field--other">
                                    <label for="OtherSubject">
                                        <i class="bi bi-pencil-square"></i>
                                        اكتب موضوع الرسالة
                                    </label>
                                    <div class="yg-contact-control">
                                        <input id="OtherSubject"
                                               type="text"
                                               class="form-control"
                                               maxlength="120"
                                               placeholder="اكتب الموضوع الذي تريده..." />
                                        <span></span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="yg-contact-field">
                                    <div class="yg-contact-label-row">
                                        <label for="MessageBody">
                                            <i class="bi bi-chat-left-text"></i>
                                            تفاصيل الرسالة
                                        </label>
                                        <span class="yg-contact-counter" id="ygMessageCounter">0 / 700</span>
                                    </div>
                                    <div class="yg-contact-control yg-contact-control--textarea">
                                        <textarea id="MessageBody"
                                                  class="form-control"
                                                  rows="6"
                                                  maxlength="700"
                                                  placeholder="اكتب تفاصيل رسالتك بوضوح..."
                                                  required></textarea>
                                        <span></span>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="yg-contact-send">
                            <div class="yg-contact-send-title">
                                <span>اختر طريقة الإرسال</span>
                                <small>سنفتح التطبيق ونضع الرسالة جاهزة لك</small>
                            </div>

                            <div class="yg-contact-send-actions">
                                <button type="button"
                                        id="sendByWhatsapp"
                                        class="yg-contact-send-btn yg-contact-send-btn--wa"
                                        data-available="@(hasWhatsapp ? "true" : "false")">
                                    <span class="yg-contact-send-icon"><i class="bi bi-whatsapp"></i></span>
                                    <span class="yg-contact-send-copy">
                                        <small>فتح واتساب</small>
                                        <strong>إرسال عبر واتساب</strong>
                                    </span>
                                    <i class="bi bi-arrow-up-left"></i>
                                </button>

                                <button type="button"
                                        id="sendByEmail"
                                        class="yg-contact-send-btn yg-contact-send-btn--mail"
                                        data-available="@(hasEmail ? "true" : "false")">
                                    <span class="yg-contact-send-icon"><i class="bi bi-envelope-fill"></i></span>
                                    <span class="yg-contact-send-copy">
                                        <small>فتح البريد</small>
                                        <strong>إرسال عبر الإيميل</strong>
                                    </span>
                                    <i class="bi bi-arrow-up-left"></i>
                                </button>
                            </div>

                            <div class="yg-contact-feedback"
                                 id="contactFeedback"
                                 role="status"
                                 aria-live="polite"></div>
                        </div>
                    </form>
                </section>

            </div>

        </div>
    </section>
</main>

@section Scripts {
    <script>
        (() => {
            const page = document.getElementById('ygContactPage');
            const form = document.getElementById('contactForm');
            const nameInput = document.getElementById('SenderName');
            const subjectSelect = document.getElementById('Subject');
            const otherWrap = document.getElementById('OtherSubjectWrap');
            const otherInput = document.getElementById('OtherSubject');
            const messageInput = document.getElementById('MessageBody');
            const counter = document.getElementById('ygMessageCounter');
            const feedback = document.getElementById('contactFeedback');
            const whatsappButton = document.getElementById('sendByWhatsapp');
            const emailButton = document.getElementById('sendByEmail');

            if (!page || !form) return;

            const whatsappNumber = (page.dataset.whatsapp || '').trim();
            const contactEmail = (page.dataset.email || '').trim();
            const siteName = (page.dataset.siteName || 'دليلك اليمني').trim();

            const setChannelAvailability = (button) => {
                if (!button) return;
                const available = button.dataset.available === 'true';
                button.disabled = !available;
                button.classList.toggle('is-disabled', !available);
            };

            setChannelAvailability(whatsappButton);
            setChannelAvailability(emailButton);

            document.querySelectorAll('.yg-contact-channel.is-disabled').forEach((card) => {
                card.addEventListener('click', (event) => event.preventDefault());
            });

            const updateOtherSubject = () => {
                const isOther = subjectSelect?.value === 'Other';
                otherWrap?.classList.toggle('d-none', !isOther);

                if (otherInput) {
                    otherInput.required = isOther;
                    if (!isOther) otherInput.value = '';
                }

                if (isOther) {
                    setTimeout(() => otherInput?.focus(), 80);
                }
            };

            subjectSelect?.addEventListener('change', updateOtherSubject);
            updateOtherSubject();

            const updateCounter = () => {
                if (!messageInput || !counter) return;
                counter.textContent = `${messageInput.value.length} / 700`;
            };

            messageInput?.addEventListener('input', updateCounter);
            updateCounter();

            const showFeedback = (text, type = 'info') => {
                if (!feedback) return;
                feedback.textContent = text;
                feedback.dataset.type = type;
                feedback.classList.add('is-visible');
            };

            const clearFeedback = () => {
                if (!feedback) return;
                feedback.textContent = '';
                feedback.classList.remove('is-visible');
                feedback.removeAttribute('data-type');
            };

            const getFormData = () => {
                clearFeedback();

                const senderName = (nameInput?.value || '').trim();
                let subject = (subjectSelect?.value || '').trim();
                const message = (messageInput?.value || '').trim();

                if (!senderName) {
                    nameInput?.focus();
                    showFeedback('اكتب اسمك أولاً.', 'warning');
                    return null;
                }

                if (subject === 'Other') {
                    subject = (otherInput?.value || '').trim();
                    if (!subject) {
                        otherInput?.focus();
                        showFeedback('اكتب موضوع الرسالة في خانة «أخرى».', 'warning');
                        return null;
                    }
                }

                if (!subject) {
                    subjectSelect?.focus();
                    showFeedback('اختر موضوع الرسالة.', 'warning');
                    return null;
                }

                if (!message) {
                    messageInput?.focus();
                    showFeedback('اكتب تفاصيل الرسالة قبل الإرسال.', 'warning');
                    return null;
                }

                return { senderName, subject, message };
            };

            const buildMessage = (data) => [
                `مرحبًا فريق ${siteName} 👋`,
                '',
                `الاسم: ${data.senderName}`,
                `الموضوع: ${data.subject}`,
                '',
                'تفاصيل الرسالة:',
                data.message,
                '',
                '— تم تجهيز الرسالة من صفحة تواصل معنا في دليلك اليمني.'
            ].join('\n');

            whatsappButton?.addEventListener('click', () => {
                const data = getFormData();
                if (!data) return;

                if (!whatsappNumber) {
                    showFeedback('رقم واتساب غير مضاف حاليًا من إعدادات الإدارة.', 'error');
                    return;
                }

                const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(buildMessage(data))}`;
                showFeedback('تم تجهيز الرسالة، يتم الآن فتح واتساب...', 'success');
                window.open(url, '_blank', 'noopener,noreferrer');
            });

            emailButton?.addEventListener('click', () => {
                const data = getFormData();
                if (!data) return;

                if (!contactEmail) {
                    showFeedback('البريد الإلكتروني غير مضاف حاليًا من إعدادات الإدارة.', 'error');
                    return;
                }

                const mailSubject = `[${siteName}] ${data.subject}`;
                const url = `mailto:${contactEmail}?subject=${encodeURIComponent(mailSubject)}&body=${encodeURIComponent(buildMessage(data))}`;
                showFeedback('تم تجهيز الرسالة، يتم الآن فتح تطبيق البريد...', 'success');
                window.location.href = url;
            });

            form.addEventListener('submit', (event) => event.preventDefault());

            const revealItems = document.querySelectorAll('[data-contact-reveal]');
            if ('IntersectionObserver' in window) {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach((entry) => {
                        if (!entry.isIntersecting) return;
                        entry.target.classList.add('is-visible');
                        observer.unobserve(entry.target);
                    });
                }, { threshold: 0.12 });

                revealItems.forEach((item) => observer.observe(item));
            } else {
                revealItems.forEach((item) => item.classList.add('is-visible'));
            }
        })();
    </script>
}
