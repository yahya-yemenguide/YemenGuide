                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating border border-primary border-opacity-25 rounded-3">
                                    <input type="number" step="0.01" class="form-control" id="adenUsdRate" value="@Model.AdenUsdRate.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                                    <label for="adenUsdRate">مقابل الريال (المناطق الجنوبية)</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ✨ التسعيرة المزدوجة للسعودي -->
                <div class="col-md-6">
                    <div class="settings-card p-4 h-100">
                        <h6 class="fw-bold text-warning mb-3"><i class="bi bi-currency-exchange me-2"></i> سعر صرف الريال السعودي (SAR)</h6>
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="form-floating border border-success border-opacity-25 rounded-3">
                                    <input type="number" step="0.01" class="form-control" id="sanaaSarRate" value="@Model.SanaaSarRate.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                                    <label for="sanaaSarRate">مقابل الريال (المناطق الشمالية)</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating border border-primary border-opacity-25 rounded-3">
                                    <input type="number" step="0.01" class="form-control" id="adenSarRate" value="@Model.AdenSarRate.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                                    <label for="adenSarRate">مقابل الريال (المناطق الجنوبية)</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="mt-4 pt-3 border-top settings-save-actions">
                <button type="button" class="btn btn-primary btn-save-tab" onclick="saveAllSettings()">
                    <i class="bi bi-save me-2"></i> حفظ جميع الإعدادات
                </button>
            </div>
        </div>

        @* 3. تبويب التواصل *@
