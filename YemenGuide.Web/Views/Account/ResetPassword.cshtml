@{
    Layout = null;
    ViewData["Title"] = "تعيين كلمة مرور جديدة";
    string email = ViewBag.Email?.ToString() ?? string.Empty;

    string MaskEmail(string value)
    {
        if (string.IsNullOrWhiteSpace(value) || !value.Contains('@')) return value;
        var parts = value.Split('@', 2);
        var local = parts[0];
        var visible = local.Length <= 2 ? local[..1] : local[..Math.Min(2, local.Length)];
        return $"{visible}{new string('•', Math.Max(3, Math.Min(6, local.Length - visible.Length)))}@{parts[1]}";
    }
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f5fbfe" />
    <title>@ViewData["Title"] - دليلك اليمني</title>

    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="preload" href="~/lib/fonts/Tajawal/Tajawal-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="~/lib/fonts/Tajawal/Tajawal-Bold.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="~/lib/fonts/Tajawal/Tajawal-ExtraBold.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="~/css/shared/password-recovery.css" asp-append-version="true" />
</head>
<body class="recovery-page">
    <main class="recovery-stage recovery-stage--wide">
        <div class="recovery-ambient" aria-hidden="true">
            <span class="recovery-orb recovery-orb--one"></span>
            <span class="recovery-orb recovery-orb--two"></span>
            <span class="recovery-pattern"></span>
        </div>

        <section class="recovery-card recovery-card--reset" aria-labelledby="resetTitle">
            <header class="recovery-brand">
                <span class="recovery-brand-mark"><i class="bi bi-compass-fill"></i></span>
                <div>
                    <strong>دليلك اليمني</strong>
                    <small>تأمين كلمة المرور</small>
                </div>
            </header>

            <div class="recovery-heading recovery-heading--compact">
                <span class="recovery-kicker"><i class="bi bi-shield-lock-fill"></i> خطوة أخيرة</span>
                <h1 id="resetTitle">أنشئ كلمة مرور جديدة</h1>
                <p>أدخل رمز التحقق المرسل إلى <strong class="masked-email">@MaskEmail(email)</strong> ثم اختر كلمة مرور جديدة.</p>
            </div>

            <form id="resetForm" method="post" novalidate data-otp-purpose="reset" data-resend-cooldown="45">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" id="resetEmail" value="@email" />
                <input type="hidden" name="code" id="code" value="" />

                <div class="recovery-otp-section">
                    <div class="recovery-label-row">
                        <label>رمز التحقق</label>
                        <span class="otp-expiry-note"><i class="bi bi-clock"></i> صالح لمدة 5 دقائق</span>
                    </div>

                    <div class="otp-cells" data-otp-cells dir="ltr" aria-label="رمز التحقق المكون من 6 أرقام">
                        @for (int i = 0; i < 6; i++)
                        {
                            <input class="otp-cell"
                                   type="text"
                                   inputmode="numeric"
                                   pattern="[0-9]*"
                                   maxlength="1"
                                   autocomplete="@(i == 0 ? "one-time-code" : "off")"
                                   aria-label="الرقم @(i + 1) من رمز التحقق" />
                        }
                    </div>

                    <div class="otp-resend-row">
                        <span>لم يصلك الرمز؟</span>
                        <button type="button" class="otp-resend-btn" id="resetResendBtn" disabled>
                            إعادة الإرسال بعد <strong id="resetResendTimer">00:45</strong>
                        </button>
                    </div>
                </div>

                <div class="recovery-field">
                    <label for="newPassword">كلمة المرور الجديدة</label>
                    <div class="recovery-input-wrap">
                        <i class="bi bi-lock-fill"></i>
                        <input type="password"
                               id="newPassword"
                               name="newPassword"
                               placeholder="8 أحرف على الأقل"
                               autocomplete="new-password"
                               required />
                        <button type="button" class="recovery-password-toggle" data-password-toggle="#newPassword" aria-label="إظهار كلمة المرور">
                            <i class="bi bi-eye-slash-fill"></i>
                        </button>
                    </div>
                </div>

                <div class="recovery-field">
                    <label for="confirmPassword">تأكيد كلمة المرور</label>
                    <div class="recovery-input-wrap">
                        <i class="bi bi-shield-check"></i>
                        <input type="password"
                               id="confirmPassword"
                               name="confirmPassword"
                               placeholder="أعد كتابة كلمة المرور"
                               autocomplete="new-password"
                               required />
                        <button type="button" class="recovery-password-toggle" data-password-toggle="#confirmPassword" aria-label="إظهار كلمة المرور">
                            <i class="bi bi-eye-slash-fill"></i>
                        </button>
                    </div>
                </div>

                <div class="recovery-password-meter" id="passwordStrengthContainer" hidden>
                    <div class="recovery-meter-top">
                        <span>قوة كلمة المرور</span>
                        <strong id="strengthText">—</strong>
                    </div>
                    <div class="recovery-meter-track"><span id="strengthBar"></span></div>
                    <div class="recovery-rules">
                        <span data-rule="length"><i class="bi bi-circle"></i> 8 أحرف</span>
                        <span data-rule="letter"><i class="bi bi-circle"></i> حرف إنجليزي</span>
                        <span data-rule="number"><i class="bi bi-circle"></i> رقم</span>
                    </div>
                </div>

                <div id="resetError" class="recovery-message recovery-message--error" role="alert" aria-live="polite" hidden></div>

                <button type="submit" class="recovery-primary-btn" id="resetBtn">
                    <span>حفظ كلمة المرور</span>
                    <i class="bi bi-check2-circle"></i>
                </button>
            </form>

            <a class="recovery-back" href="/Account/Login">
                <i class="bi bi-arrow-right"></i>
                <span>العودة لتسجيل الدخول</span>
            </a>
        </section>
    </main>

    <script src="~/js/shared/password-recovery.js" asp-append-version="true"></script>
</body>
</html>
