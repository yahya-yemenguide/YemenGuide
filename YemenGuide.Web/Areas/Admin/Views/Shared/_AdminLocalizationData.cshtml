    void AddDynamicTranslation(string? arabicValue, string? englishValue)
    {
        if (language != "en" ||
            string.IsNullOrWhiteSpace(arabicValue) ||
            string.IsNullOrWhiteSpace(englishValue))
        {
            return;
        }

        exact[arabicValue.Trim()] = englishValue.Trim();
    }

    // نفس قاعدة العميل: لا نترجم ما كتبه المستخدم من عندنا.
    // نستخدم الإنجليزية فقط عندما يكون للبيان حقل English فعلي في قاعدة البيانات.
    if (language == "en")
    {
        var categories = await _context.Categories
            .AsNoTracking()
            .Select(c => new { c.CategoryName, c.CategoryNameEn })
            .ToListAsync();

        foreach (var category in categories)
        {
            AddDynamicTranslation(category.CategoryName, category.CategoryNameEn);
        }

        var cities = await _context.Cities
            .AsNoTracking()
            .Select(c => new { c.CityName, c.CityNameEn })
            .ToListAsync();

        foreach (var city in cities)
        {
            AddDynamicTranslation(city.CityName, city.CityNameEn);
        }

        var settings = await _context.SystemSettings
            .AsNoTracking()
            .OrderBy(s => s.Id)
            .Select(s => new
            {
                s.SiteName,
                s.SiteNameEn,
                s.SiteDescription,
                s.SiteDescriptionEn
            })
            .FirstOrDefaultAsync();

        if (settings != null)
        {
            AddDynamicTranslation(settings.SiteName, settings.SiteNameEn);
            AddDynamicTranslation(settings.SiteDescription, settings.SiteDescriptionEn);
        }
    }

