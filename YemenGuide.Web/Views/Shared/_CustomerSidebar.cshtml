@*
    Area: Customer
    View: Shared / _CustomerSidebar.cshtml
*@

@{
    string currentController =
        ViewContext.RouteData.Values["Controller"]?.ToString() ?? string.Empty;

    string currentAction =
        ViewContext.RouteData.Values["Action"]?.ToString() ?? string.Empty;

    bool isOverviewActive =
        currentController.Equals("Overview", StringComparison.OrdinalIgnoreCase) &&
        currentAction.Equals("Overview", StringComparison.OrdinalIgnoreCase);

    bool isProfileActive =
        currentController.Equals("Profile", StringComparison.OrdinalIgnoreCase) ||
        currentAction.Equals("CustomerProfile", StringComparison.OrdinalIgnoreCase);

    bool isMessagesActive =
        currentController.Equals("Messages", StringComparison.OrdinalIgnoreCase) ||
        currentAction.Equals("MyMessages", StringComparison.OrdinalIgnoreCase);

    bool isBookingsActive =
        currentController.Equals("Bookings", StringComparison.OrdinalIgnoreCase) ||
        currentAction.Equals("MyBookings", StringComparison.OrdinalIgnoreCase);

    bool isPaymentsActive =
        currentController.Equals("Payments", StringComparison.OrdinalIgnoreCase) ||
        currentAction.Equals("MyPayments", StringComparison.OrdinalIgnoreCase);

    bool isFavoritesActive =
        currentController.Equals("Favorites", StringComparison.OrdinalIgnoreCase) ||
        currentAction.Equals("MyFavorites", StringComparison.OrdinalIgnoreCase);

    bool isReportsActive =
        currentController.Equals("Reports", StringComparison.OrdinalIgnoreCase) ||
        currentAction.Equals("MyReports", StringComparison.OrdinalIgnoreCase);
}

<aside class="customer-sidebar customer-desktop-sidebar border-end d-none d-md-flex flex-column"
       id="customerSidebar"
       aria-label="قائمة لوحة العميل">

    <script>
        (function () {
            const sidebar = document.getElementById('customerSidebar');

            if (!sidebar) {
                return;
            }

            const isDesktopOrTablet =
                window.matchMedia('(min-width: 768px)').matches;

            if (isDesktopOrTablet &&
                localStorage.getItem('customerCompactMode') === 'enabled') {
                sidebar.classList.add('sidebar-collapsed');
            }
        })();
    </script>

    <div class="sidebar-header text-center mb-3 pb-3 border-bottom flex-shrink-0">
        <div class="d-inline-block position-relative mt-2">
            <h4 id="dynamic-tab-title"
                class="fw-bold mb-0 text-dark d-flex align-items-center justify-content-center"
                style="font-size: 1.25rem;">

                <i class="bi bi-grid-fill me-2 text-primary"></i>
                <span class="nav-text">لوحة التحكم</span>
            </h4>
        </div>
    </div>

    <div class="nav-scroll-area flex-grow-1 w-100">
        <nav class="nav flex-column custom-sidebar-nav w-100"
             aria-label="أقسام حساب العميل">

            <a href="/Overview/Overview"
               class="nav-link @(isOverviewActive ? "active" : "")"
               data-customer-sidebar-link="overview"
               aria-current="@(isOverviewActive ? "page" : null)">

                <i class="bi bi-speedometer2 me-3"></i>
                <span class="nav-text">لوحة القيادة</span>
            </a>

            <a href="/Profile/CustomerProfile"
               class="nav-link @(isProfileActive ? "active" : "")"
               data-customer-sidebar-link="profile"
               aria-current="@(isProfileActive ? "page" : null)">

                <i class="bi bi-person-lines-fill me-3"></i>
                <span class="nav-text">البيانات والإعدادات</span>
            </a>

            <a href="/Messages/MyMessages"
               class="nav-link @(isMessagesActive ? "active" : "")"
               data-customer-sidebar-link="messages"
               aria-current="@(isMessagesActive ? "page" : null)">

                <i class="bi bi-chat-dots-fill me-3"></i>
                <span class="nav-text">المحادثات والرسائل</span>
            </a>

            <a href="/Bookings/MyBookings"
               class="nav-link @(isBookingsActive ? "active" : "")"
               data-customer-sidebar-link="bookings"
               aria-current="@(isBookingsActive ? "page" : null)">

                <i class="bi bi-calendar-check me-3"></i>
                <span class="nav-text">حجوزاتي</span>
            </a>

            <a href="/Favorites/MyFavorites"
               class="nav-link @(isFavoritesActive ? "active" : "")"
               data-customer-sidebar-link="favorites"
               aria-current="@(isFavoritesActive ? "page" : null)">

                <i class="bi bi-heart me-3"></i>
                <span class="nav-text">المفضلة</span>
            </a>

            <a href="/Reports/MyReports"
               class="nav-link @(isReportsActive ? "active" : "")"
               data-customer-sidebar-link="reports"
               aria-current="@(isReportsActive ? "page" : null)">

                <i class="bi bi-shield-exclamation me-3"></i>
                <span class="nav-text">الشكاوى والبلاغات</span>
            </a>
        </nav>
    </div>

    <div class="logout-wrapper pt-3 mt-2 border-top flex-shrink-0 bg-white w-100">
        <a asp-controller="Account"
           asp-action="Logout"
           class="nav-link text-danger fw-bold d-flex align-items-center rounded-3 p-3 transition-all"
           style="background: rgba(220, 53, 69, 0.05); text-decoration: none;">

            <i class="bi bi-box-arrow-right me-3 fs-5"></i>
            <span class="nav-text">تسجيل الخروج</span>
        </a>
    </div>

    <button class="sidebar-compact-toggle"
            id="customerSidebarToggle"
            type="button"
            aria-label="طي أو توسيع القائمة الجانبية"
            aria-controls="customerSidebar"
            aria-expanded="true"
            title="طي أو توسيع القائمة">

        <i class="bi bi-chevron-right toggle-icon"></i>
    </button>
</aside>
