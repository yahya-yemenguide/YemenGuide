                                        <div class="col-6"><div class="form-check custom-checkbox"><input class="form-check-input" type="checkbox" name="EventTypes" value="حفل تخرج"><label class="small fw-bold">حفل تخرج</label></div></div>
                                        <div class="col-6"><div class="form-check custom-checkbox"><input class="form-check-input" type="checkbox" name="EventTypes" value="مناسبات شركات"><label class="small fw-bold">مناسبات شركات</label></div></div>
                                        <div class="col-6"><div class="form-check custom-checkbox"><input class="form-check-input" type="checkbox" name="EventTypes" value="معارض"><label class="small fw-bold">معارض</label></div></div>
                                        <div class="col-6"><div class="form-check custom-checkbox"><input class="form-check-input" type="checkbox" name="EventTypes" value="حفلات خاصة"><label class="small fw-bold">حفلات خاصة</label></div></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="unit-box h-100 mt-0">
                                    <label class="small fw-bold text-primary mb-3 border-bottom pb-2 d-block">تجهيزات الجلوس والمقاعد:</label>
                                    <div class="row g-3 px-2">
                                        <div class="col-12"><div class="form-check custom-checkbox"><input class="form-check-input fs-5 mt-0" type="checkbox" name="SeatingTypes" value="مجالس"><label class="small fw-bold ms-2 mt-1">نظام مجالس عربية</label></div></div>
                                        <div class="col-12"><div class="form-check custom-checkbox"><input class="form-check-input fs-5 mt-0" type="checkbox" name="SeatingTypes" value="طاولات وكراسي"><label class="small fw-bold ms-2 mt-1">طاولات ملكية مع كراسي</label></div></div>
                                        <div class="col-12"><div class="form-check custom-checkbox"><input class="form-check-input fs-5 mt-0" type="checkbox" name="SeatingTypes" value="كراسي فقط"><label class="small fw-bold ms-2 mt-1">ترتيب مسرحي (كراسي فقط)</label></div></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-2 p-3 border rounded-3 bg-white shadow-sm border-primary border-opacity-25">
                            <h6 class="fw-bold text-primary mb-3"><i class="bi bi-tags-fill me-2"></i> باقات الحجز والأسعار للقاعة <span class="text-danger">*</span></h6>
                            <p class="small text-muted mb-3">يرجى تفعيل باقة واحدة على الأقل (صباحية، مسائية، إلخ).</p>

                            <div class="mb-3 border-bottom pb-2">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input fs-5 shadow-sm" type="checkbox" id="chkMorning" onchange="document.getElementById('morning-fields-hall').classList.toggle('d-none')">
                                    <label class="form-check-label fw-bold mt-1 ms-2 text-dark" for="chkMorning">باقة صباحية (مثال: 9 صباحاً - 1 ظهراً)</label>
                                </div>
                                <div id="morning-fields-hall" class="row g-2 d-none ps-4">
                                    <div class="col-md-6"><input type="number" name="MorningPrice" class="form-control vip-input req-morning" placeholder="سعر الحجز الصباحي (ريال)"></div>
                                    <div class="col-md-6"><input type="number" name="MorningCapacity" class="form-control vip-input req-morning" placeholder="العدد الأقصى للحضور"></div>
                                </div>
                            </div>

                            <div class="mb-3 border-bottom pb-2">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input fs-5 shadow-sm" type="checkbox" id="chkEvening" onchange="document.getElementById('evening-fields-hall').classList.toggle('d-none')">
                                    <label class="form-check-label fw-bold mt-1 ms-2 text-dark" for="chkEvening">باقة مسائية (مثال: 4 عصراً - 10 ليلاً)</label>
                                </div>
                                <div id="evening-fields-hall" class="row g-2 d-none ps-4">
                                    <div class="col-md-6"><input type="number" name="EveningPrice" class="form-control vip-input req-evening" placeholder="سعر الحجز المسائي (ريال)"></div>
                                    <div class="col-md-6"><input type="number" name="EveningCapacity" class="form-control vip-input req-evening" placeholder="العدد الأقصى للحضور"></div>
                                </div>
                            </div>
                            <div class="mb-2">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input fs-5 shadow-sm" type="checkbox" id="chkNightHall" onchange="document.getElementById('night-fields-hall').classList.toggle('d-none')">
                                    <label class="form-check-label fw-bold mt-1 ms-2 text-dark" for="chkNightHall">باقة سمرة / ليلية (مثال: 9 مساءً - 3 فجراً)</label>
                                </div>
                                <div id="night-fields-hall" class="row g-2 d-none ps-4">
                                    <div class="col-md-6"><input type="number" name="NightPrice" class="form-control vip-input req-night" placeholder="سعر حجز السمرة (ريال)"></div>
                                    <div class="col-md-6"><input type="number" name="NightCapacity" class="form-control vip-input req-night" placeholder="العدد الأقصى للحضور"></div>
                                </div>
                            </div>

                            <!-- محرر الباقات المخصصة الديناميكي: يمكن إضافة أكثر من باقة -->
                            <section class="custom-packages-builder"
                                 data-custom-packages-builder
                                 data-package-example="مثال: باقة مؤتمرات">
                                <div class="custom-packages-builder__head">
                                    <div class="custom-packages-builder__title">
                                        <span class="custom-packages-builder__icon"><i class="bi bi-stars"></i></span>
                                        <div>
                                            <strong>باقات أخرى مخصصة</strong>
                                            <small>أنشئ باقات إضافية للقاعة، وحدد وقت وسعر وسعة كل باقة بشكل مستقل.</small>
                                        </div>
                                    </div>
                                    <button type="button" class="custom-package-add-button" data-add-custom-package>
                                        <i class="bi bi-plus-lg"></i>
                                        إضافة باقة مخصصة
                                    </button>
                                </div>

                                <div class="custom-packages-list" data-custom-packages-list aria-live="polite"></div>

                                <div class="custom-packages-empty" data-custom-packages-empty>
                                    <i class="bi bi-tags"></i>
                                    <div>
                                        <strong>لا توجد باقات مخصصة بعد</strong>
                                        <span>أضف باقة عندما تحتاج إلى وقت أو سعر مختلف عن الباقات الأساسية.</span>
                                    </div>
                                </div>
                            </section>

                        </div>
                    </div>

                    <div class="step-section wizard-step-card wizard-special-step wizard-special-step--hall-facilities" id="step_hall_facilities">
                        <h6 class="form-section-title"><i class="bi bi-box-seam"></i> التجهيزات والمرافق المساندة</h6>
                        <div class="row g-4">
                            <div class="col-6 col-md-3"><label class="small fw-bold text-muted">دورات المياه</label><input type="number" min="0" class="form-control vip-input text-center" name="HallBathroomsCount"></div>
                            <div class="col-6 col-md-3"><label class="small fw-bold text-muted">أجهزة التكييف</label><input type="number" min="0" class="form-control vip-input text-center" name="ACsCount"></div>
                            <div class="col-6 col-md-3"><label class="small fw-bold text-muted">غرف التخزين</label><input type="number" min="0" class="form-control vip-input text-center" name="StorageRoomsCount"></div>
                            <div class="col-6 col-md-3"><label class="small fw-bold text-muted">غرف التحضير</label><input type="number" min="0" class="form-control vip-input text-center" name="PrivateRoomsCount"></div>
                            <div class="col-6 col-md-3"><label class="small fw-bold text-muted">المطابخ المركزية</label><input type="number" min="0" class="form-control vip-input text-center" name="KitchensCount"></div>
                            <div class="col-6 col-md-3"><label class="small fw-bold text-muted">غرف الصلاة</label><input type="number" min="0" class="form-control vip-input text-center" name="PrayerRoomsCount"></div>
                            <div class="col-6 col-md-3"><label class="small fw-bold text-muted">أنظمة الصوت</label><input type="number" min="0" class="form-control vip-input text-center" name="SpeakersCount"></div>
                            <div class="col-6 col-md-3"><label class="small fw-bold text-muted">مواقف السيارات</label><input type="number" min="0" class="form-control vip-input text-center" name="ParkingCount"></div>

                            <div class="col-12 mt-4 dynamic-field-container">
                                <label class="small fw-bold text-muted mb-2">تجهيزات فريدة أخرى غير مذكورة؟</label>
                                <div class="input-group mb-2">
                                    <input type="text" class="form-control vip-input" name="CustomHallFacilities" placeholder="اكتب الميزة واضغط الإضافة..." onkeypress="if(event.key === 'Enter') { event.preventDefault(); addDynamicTag(this.nextElementSibling); }">
                                    <button class="btn btn-primary shadow-none" type="button" onclick="addDynamicTag(this)"><i class="bi bi-plus-lg"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else // 🚫 منشآت عامة (مطاعم، معالم...) ليس فيها حجز
                {
                    <div class="step-section wizard-step-card wizard-special-step wizard-special-step--warnings" id="step_warnings">
                        <h6 class="form-section-title"><i class="bi bi-exclamation-triangle-fill text-warning"></i> إرشادات وسياسات العرض</h6>
                        <div class="alert border-0 p-4 shadow-sm rounded-4" style="background: #fffcf5; border-right: 4px solid #ffc107 !important;">
                            <h6 class="fw-black text-dark"><i class="bi bi-shield-check text-warning me-2 fs-5"></i> ميثاق استخدام المنصة:</h6>
                            <ul class="mb-4 mt-3 fw-bold small text-muted lh-lg">
                                <li>تتعهد بإدخال بيانات صحيحة ومطابقة للواقع للحفاظ على مصداقية المنشأة.</li>
                                <li>يُمنع استخدام المنصة لنشر محتوى غير لائق أو مخالف للقوانين والآداب العامة.</li>
                                <li>إدارة المنصة غير مسؤولة عن أي تعاملات مالية مباشرة بينك وبين العملاء للمنشآت غير الداعمة لنظام الحجز.</li>
                                <li>يحق لإدارة المنصة إيقاف أو حجب المنشأة في حال تلقي شكاوى متكررة من الزوار.</li>
                            </ul>
                            <div class="form-check">
                                <input class="form-check-input fs-5" type="checkbox" id="agreeWarnings" required>
                                <label class="form-check-label fw-bold mt-1 ms-2 text-dark" for="agreeWarnings">أقر بأنني اطلعت على الشروط وأوافق على الالتزام بها تماماً.</label>
                            </div>
                        </div>
                    </div>
                }

            </form>
        </div>

        <!-- ========================================================================= -->
        <!-- 🚀 شريط ثابت خارج منطقة التمرير -->
