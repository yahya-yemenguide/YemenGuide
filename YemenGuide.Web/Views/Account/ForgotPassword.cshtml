@{
    Layout = null;
    ViewData["Title"] = "استعادة كلمة المرور";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f5fbfe" />
    <title>@ViewData["Title"] - دليلك اليمني</title>

    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="preload" href="~/lib/fonts/Tajawal/Tajawal-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="~/lib/fonts/Tajawal/Tajawal-Bold.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="~/lib/fonts/Tajawal/Tajawal-ExtraBold.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="~/css/shared/password-recovery.css" asp-append-version="true" />
</head>
<body class="recovery-page">
    <main class="recovery-stage">
        <div class="recovery-ambient" aria-hidden="true">
            <span class="recovery-orb recovery-orb--one"></span>
            <span class="recovery-orb recovery-orb--two"></span>
            <span class="recovery-pattern"></span>
        </div>

        <a class="recovery-home" href="/">
            <i class="bi bi-house-door-fill"></i>
            <span>الرئيسية</span>
        </a>

        <section class="recovery-card" aria-labelledby="forgotTitle">
            <header class="recovery-brand">
                <span class="recovery-brand-mark"><i class="bi bi-compass-fill"></i></span>
                <div>
                    <strong>دليلك اليمني</strong>
                    <small>استعادة آمنة للحساب</small>
                </div>
            </header>

            <div class="recovery-hero-icon">
                <span class="recovery-icon-ring"></span>
                <span class="recovery-icon-core"><i class="bi bi-envelope-paper-heart-fill"></i></span>
            </div>

            <div class="recovery-heading">
                <span class="recovery-kicker">استعادة الحساب</span>
                <h1 id="forgotTitle">نسيت كلمة المرور؟</h1>
                <p>أدخل البريد الإلكتروني المرتبط بحسابك، وسنرسل رمزاً آمناً لإعادة تعيين كلمة المرور.</p>
            </div>

            <form id="forgotForm" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div class="recovery-field">
                    <label for="email">البريد الإلكتروني</label>
                    <div class="recovery-input-wrap">
                        <i class="bi bi-envelope-fill"></i>
                        <input type="email"
                               id="email"
                               name="email"
                               placeholder="name@example.com"
                               autocomplete="email"
                               inputmode="email"
                               required />
                    </div>
                </div>

                <div id="forgotError" class="recovery-message recovery-message--error" role="alert" aria-live="polite" hidden></div>

                <button type="submit" class="recovery-primary-btn" id="forgotBtn">
                    <span>إرسال رمز التحقق</span>
                    <i class="bi bi-send-fill"></i>
                </button>
            </form>

            <div class="recovery-trust-row">
                <span><i class="bi bi-shield-check"></i> بياناتك محمية</span>
                <span><i class="bi bi-clock-history"></i> الرمز مؤقت</span>
            </div>

            <a class="recovery-back" href="/Account/Login">
                <i class="bi bi-arrow-right"></i>
                <span>العودة لتسجيل الدخول</span>
            </a>
        </section>
    </main>

    <script src="~/js/shared/password-recovery.js" asp-append-version="true"></script>
</body>
</html>
