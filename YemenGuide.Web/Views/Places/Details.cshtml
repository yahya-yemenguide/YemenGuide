                                <i class="bi bi-chat-quote"></i>
                                تجارب حقيقية
                            </span>

                            <h2>تقييمات العملاء</h2>
                        </div>

                        <span class="section-count">
                            @Model.TotalReviews تقييم
                        </span>
                    </div>

                    <button type="button"
                            class="reviews-summary-card"
                            onclick="toggleReviewsContainer()"
                            aria-controls="smartReviewsContainer"
                            aria-expanded="false">

                        <div class="reviews-score-block">

                            <strong>
                                @Model.AverageRating.ToString("0.0")
                            </strong>

                            <div class="reviews-stars"
                                 aria-label="التقييم @Model.AverageRating من خمسة">

                                @for (
                                int star = 1;
                                star <= 5;
                                star++
                                )
                                {
                                    if (
                                    star <= Math.Round(
                                    Model.AverageRating
                                    )
                                    )
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else if (
                                    star - 0.5 <=
                                    Model.AverageRating
                                    )
                                    {
                                        <i class="bi bi-star-half"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star"></i>
                                    }
                                }
                            </div>

                            <span>
                                بناءً على @Model.TotalReviews تجربة
                            </span>
                        </div>

                        <div class="reviews-distribution">

                            @for (
                            int star = 5;
                            star >= 1;
                            star--
                            )
                            {
                                int starCount =
                                Model.StarDistribution != null &&
                                Model.StarDistribution.ContainsKey(star)
                                ? Model.StarDistribution[star]
                                : 0;

                                int totalReviews =
                                Model.TotalReviews > 0
                                ? Model.TotalReviews
                                : 1;

                                int percentage =
                                (int)Math.Round(
                                (double)starCount /
                                totalReviews *
                                100
                                );

                                <div class="rating-progress-row">

                                    <span>@star</span>

                                    <div class="rating-progress-track">

                                        <span style="width:@percentage%;"></span>
                                    </div>

                                    <small>@starCount</small>
                                </div>
                            }
                        </div>

                        <div class="reviews-summary-toggle">

                            <span id="reviewsToggleText">
                                عرض التقييمات أو إضافة تقييم
                            </span>

                            <i class="bi bi-chevron-down"
                               id="reviewsChevronIcon"></i>
                        </div>
                    </button>

