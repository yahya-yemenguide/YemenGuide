<div class="modal fade premium-place-modal"
     id="datePickerModal"
     tabindex="-1"
     aria-labelledby="datePickerModalTitle"
     aria-hidden="true"
     dir="rtl">

    <div class="modal-dialog modal-dialog-centered premium-place-modal-dialog premium-date-dialog">

        <div class="modal-content premium-place-modal-content">

            <span class="premium-modal-decoration decoration-one"></span>
            <span class="premium-modal-decoration decoration-two"></span>

            <div class="premium-modal-mobile-handle"
                 aria-hidden="true">
            </div>

            <div class="premium-place-modal-header">

                <div class="premium-modal-heading">

                    <span class="premium-modal-icon">

                        <i class="bi bi-calendar2-week-fill"></i>
                    </span>

                    <div>
                        <small>خطوة سريعة</small>

                        <h5 class="modal-title"
                            id="datePickerModalTitle">

                            اختر فترة الإقامة
                        </h5>

                        <p>
                            حدد تاريخ الدخول والخروج لعرض الغرف المتاحة.
                        </p>
                    </div>
                </div>

                <button type="button"
                        class="premium-modal-close custom-close-btn"
