@model YemenGuide.Core.DTOs.Admin.DashboardDto
@using System.Globalization
@using System.Text.Json

@{
    bool isArabic =
        string.Equals(
            CultureInfo.CurrentUICulture
                .TwoLetterISOLanguageName,
            "ar",
            StringComparison.OrdinalIgnoreCase);

    string L(string ar, string en) =>
        isArabic ? ar : en;

    string locale =
        isArabic
            ? "ar-YE"
            : "en-US";

    ViewData["Title"] =
        L(
            "لوحة التحكم",
            "Dashboard");

    Layout =
        "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    string StatusLabel(string? status) =>
        (status ?? "")
        .Trim()
        .ToLowerInvariant()
        switch
        {
            "active" =>
                L("نشطة", "Active"),

            "approved" =>
                L("معتمدة", "Approved"),

            "pending" =>
                L("قيد المراجعة", "Pending"),

            "rejected" =>
                L("مرفوضة", "Rejected"),

            "inactive" =>
                L("غير نشطة", "Inactive"),

            _ =>
                string.IsNullOrWhiteSpace(
                    status)
                    ? L(
                        "غير محدد",
                        "Unknown")
                    : status
        };

    string StatusTone(string? status) =>
        (status ?? "")
        .Trim()
        .ToLowerInvariant()
        switch
        {
            "active" => "success",
            "approved" => "success",
            "pending" => "warning",
            "rejected" => "danger",
            _ => "neutral"
        };

    string FinanceLabel(string? status) =>
        (status ?? "")
        .Trim()
        .ToLowerInvariant()
        switch
        {
            "charged" =>
                L("محصّلة", "Charged"),

            "held" =>
                L("محجوزة", "Held"),

            "calculated" =>
                L("محسوبة", "Calculated"),

            "debt" =>
                L("مديونية", "Debt"),

            "released" =>
                L("محررة", "Released"),

            "notapplicable" =>
                L(
                    "غير خاضعة",
                    "Not applicable"),

            _ =>
                string.IsNullOrWhiteSpace(
                    status)
                    ? L(
                        "غير محدد",
                        "Unknown")
                    : status
        };

    string FinanceTone(string? status) =>
        (status ?? "")
        .Trim()
        .ToLowerInvariant()
        switch
        {
            "charged" => "green",
            "held" => "orange",
            "calculated" => "blue",
            "debt" => "red",
            "released" => "purple",
            _ => "neutral"
        };
}

@section Styles {
    <link rel="stylesheet"
      href="~/css/admin/dashboard-overview.css"
      asp-append-version="true" />
}

    <div id="adminDashboardData"
     hidden
     data-locale="@locale"
     data-is-rtl="@isArabic.ToString().ToLowerInvariant()"
     data-currency="@Model.DisplayCurrency"
     data-currency-code="@Model.CurrencyCode"
     data-currency-symbol="@Model.CurrencySymbol"
     data-admin-name="@Model.AdminName"
     data-generated-at="@Model.GeneratedAt.ToString("O")"
     data-greeting-morning="@L("صباح الخير", "Good morning")"
     data-greeting-afternoon="@L("مساء الخير", "Good afternoon")"
     data-greeting-evening="@L("أهلًا بعودتك", "Welcome back")"
     data-booking-created-name="@L("حجوزات أُنشئت", "Bookings created")"
     data-booking-starting-name="@L("حجوزات تبدأ", "Bookings starting")"
     data-revenue-name="@L("إيراد", "Revenue")"
     data-booking-labels='@Html.Raw(JsonSerializer.Serialize(Model.BookingTrend.Select(x => x.Label)))'
     data-booking-created='@Html.Raw(JsonSerializer.Serialize(Model.BookingTrend.Select(x => x.Count)))'
     data-booking-starting='@Html.Raw(JsonSerializer.Serialize(Model.BookingTrend.Select(x => (int)x.Amount)))'
     data-revenue-labels='@Html.Raw(JsonSerializer.Serialize(Model.RevenueTrend.Select(x => x.Label)))'
     data-revenue-values='@Html.Raw(JsonSerializer.Serialize(Model.RevenueTrend.Select(x => x.Amount)))'
     data-place-status-keys='@Html.Raw(JsonSerializer.Serialize(Model.PlaceStatusDistribution.Select(x => x.Status)))'
     data-place-status-labels='@Html.Raw(JsonSerializer.Serialize(Model.PlaceStatusDistribution.Select(x => StatusLabel(x.Status))))'
     data-place-status-values='@Html.Raw(JsonSerializer.Serialize(Model.PlaceStatusDistribution.Select(x => x.Count)))'
     data-finance-keys='@Html.Raw(JsonSerializer.Serialize(Model.FinanceDistribution.Select(x => x.Status)))'
     data-finance-labels='@Html.Raw(JsonSerializer.Serialize(Model.FinanceDistribution.Select(x => FinanceLabel(x.Status))))'
     data-finance-values='@Html.Raw(JsonSerializer.Serialize(Model.FinanceDistribution.Select(x => x.Amount)))'
     data-category-labels='@Html.Raw(JsonSerializer.Serialize(Model.CategoryDistribution.Select(x => x.CategoryName)))'
     data-category-values='@Html.Raw(JsonSerializer.Serialize(Model.CategoryDistribution.Select(x => x.PlaceCount)))'>
    </div>

    <div class="admin-command-center">

        <section class="acc-hero acc-reveal">

            <div class="acc-hero__aurora"
             aria-hidden="true">
            </div>

            <div class="acc-hero__copy">

                <span class="acc-eyebrow">
                    <i class="bi bi-activity"></i>
                    <b></b>
                    @L(
                "مركز قيادة المنصة",
                "Platform command center")
                </span>

                <h1>
                    <span data-greeting>
                        @L("مرحبًا", "Hello")
                    </span>،
                    <strong>
                        @Model.AdminName
                    </strong>
                </h1>

                <p>
                    @L(
                "المهم أمامك الآن: تشغيل المنصة، حركة الحجوزات، الأداء المالي، وما يحتاج تدخلك.",
                "What matters now: platform operations, booking activity, financial performance, and items requiring your attention.")
                </p>

            </div>

            <div class="acc-hero__live">

                <span class="acc-live-pill">
                    <i class="bi bi-broadcast-pin"></i>
                    @L("مباشر", "Live")
                </span>

                <strong data-live-clock>
                    --:--
                </strong>

                <small>
                    @Model.GeneratedAt.ToString(
                "yyyy/MM/dd",
                CultureInfo.CurrentCulture)
                </small>

            </div>

            <div class="acc-hero__pulse">

                <article>
                    <span class="is-blue">
                        <i class="bi bi-calendar2-plus"></i>
                    </span>

                    <div>
                        <strong data-count="@Model.TodayBookingsCreated">
                            0
                        </strong>

                        <small>
                            @L(
                        "حجز جديد اليوم",
                        "New bookings today")
                        </small>
                    </div>
                </article>

                <article>
                    <span class="is-orange">
                        <i class="bi bi-calendar2-event"></i>
                    </span>

                    <div>
                        <strong data-count="@Model.TodayBookingsStarting">
                            0
                        </strong>

                        <small>
                            @L(
                        "حجز يبدأ اليوم",
                        "Bookings starting today")
                        </small>
                    </div>
                </article>

                <article>
                    <span class="is-green">
                        <i class="bi bi-cash-stack"></i>
                    </span>

                    <div>
                        <strong>
                            @Model.TodayRevenueText
                        </strong>

                        <small>
                            @L(
                        "إيراد المنصة اليوم",
                        "Platform revenue today")
                        </small>
                    </div>
                </article>

            </div>

        </section>


    @if (Model.AttentionItems.Count > 0)
    {
        <section class="acc-attention acc-reveal"
             aria-label="@L("يحتاج انتباهك", "Needs your attention")">

            <header>
                <span>
                    <i class="bi bi-lightning-charge-fill"></i>
                    @L(
                "يحتاج انتباهك الآن",
                "Needs your attention now")
                </span>

                <small>
                    @Model.AttentionItems.Count
                    @L(
                "إجراء مهم",
                "important actions")
                </small>
            </header>

            <div class="acc-attention__rail">

                @foreach (var item in Model.AttentionItems)
                {
                    <a href="@item.Url"
               class="acc-attention-item tone-@item.Tone">

                        <span class="acc-attention-item__icon">
                            <i class="@item.IconClass"></i>
                        </span>

                        <div>
                            <strong>
                                @item.Title
                            </strong>

                            <small>
                                @item.Description
                            </small>
                        </div>

                        <b>
                            @item.ValueText
                        </b>

                        <i class="bi bi-arrow-left-short acc-attention-item__arrow"></i>

                    </a>
                }

            </div>

        </section>
    }


    <section class="acc-kpis acc-reveal">

        <article class="acc-kpi kpi-revenue">

            <div class="acc-kpi__head">
                <span>
                    <i class="bi bi-wallet2"></i>
                </span>

                <small>
                    @L(
                    "إيرادات المنصة",
                    "Platform revenue")
                </small>
            </div>

            <strong>
                @Model.TotalRevenueText
            </strong>

            <div class="acc-spark"
                 data-spark="revenue">
            </div>

            <footer>
                <i class="bi bi-check2-circle"></i>
                @L(
                "عمولات تم تحصيلها نهائيًا",
                "Commissions successfully collected")
            </footer>

        </article>


        <article class="acc-kpi kpi-bookings">

            <div class="acc-kpi__head">
                <span>
                    <i class="bi bi-calendar2-check"></i>
                </span>

                <small>
                    @L("الحجوزات", "Bookings")
                </small>
            </div>

            <strong data-count="@Model.TotalBookings">
                0
            </strong>

            <div class="acc-spark"
                 data-spark="bookings">
            </div>

            <footer>
                <b>
                    @Model.ThisMonthBookings.ToString(
                    "N0",
                    CultureInfo.CurrentCulture)
                </b>

                @L(
                "خلال الشهر الحالي",
                "this month")
            </footer>

        </article>


        <article class="acc-kpi kpi-users">

            <div class="acc-kpi__head">
                <span>
                    <i class="bi bi-people-fill"></i>
                </span>

                <small>
                    @L("المستخدمون", "Users")
                </small>
            </div>

            <strong data-count="@Model.TotalUsers">
                0
            </strong>

            <div class="acc-spark"
                 data-spark="users">
            </div>

            <footer>
                @L(
                "قاعدة المستخدمين المسجلة في النظام",
                "Registered users on the platform")
            </footer>

        </article>


        <article class="acc-kpi kpi-places">

            <div class="acc-kpi__head">
                <span>
                    <i class="bi bi-buildings-fill"></i>
                </span>

                <small>
                    @L("المنشآت", "Places")
                </small>
            </div>

            <strong data-count="@Model.TotalPlaces">
                0
            </strong>

            <div class="acc-spark"
                 data-spark="places">
            </div>

            <footer>
                <b>
                    @Model.ActivePlaces.ToString(
                    "N0",
                    CultureInfo.CurrentCulture)
                </b>

                @L(
                "منشأة متاحة ومعتمدة",
                "active and approved places")
            </footer>

        </article>

    </section>


    <section class="acc-analytics acc-reveal">

        <article class="acc-panel acc-panel--wide">

            <header class="acc-panel__head">

                <div>
                    <span class="is-blue">
                        <i class="bi bi-graph-up-arrow"></i>
                    </span>

                    <div>
                        <small>
                            @L(
                            "حركة آخر 7 أيام",
                            "Last 7 days")
                        </small>

                        <h2>
                            @L(
                            "الحجوزات على المنصة",
                            "Platform bookings")
                        </h2>
                    </div>
                </div>

                <span class="acc-chart-legend"
                      aria-label="@L("دليل ألوان مخطط الحجوزات", "Booking chart legend")">

                    <span>
                        <i class="legend-dot is-blue"></i>
                        @L(
                        "حجوزات أُنشئت",
                        "Bookings created")
                    </span>

                    <span>
                        <i class="legend-dot is-orange"></i>
                        @L(
                        "حجوزات تبدأ",
                        "Bookings starting")
                    </span>

                </span>

            </header>

            <div class="acc-chart acc-chart--main">
                <canvas id="adminBookingsChart"></canvas>
            </div>

        </article>


        <article class="acc-panel acc-panel--status">

            <header class="acc-panel__head">

                <div>
                    <span class="is-orange">
                        <i class="bi bi-pie-chart-fill"></i>
                    </span>

                    <div>
                        <small>
                            @L(
                            "جودة العرض",
                            "Listing quality")
                        </small>

                        <h2>
                            @L(
                            "حالة المنشآت",
                            "Place status")
                        </h2>
                    </div>
                </div>

            </header>

            <div class="acc-status-layout">

                <div class="acc-chart acc-chart--donut">
                    <canvas id="adminPlacesChart"></canvas>
                </div>

                <div class="acc-chart-key acc-chart-key--status"
                     aria-label="@L("دليل ألوان حالات المنشآت", "Place status legend")">

                    @foreach (var item in Model.PlaceStatusDistribution)
                    {
                        <span>
                            <i class="legend-dot status-@StatusTone(item.Status)"></i>
                            <b>
                                @StatusLabel(item.Status)
                            </b>
                            <small>
                                @item.Count
                            </small>
                        </span>
                    }

                </div>

            </div>

        </article>

    </section>


    <section class="acc-analytics acc-analytics--secondary acc-reveal">

        <article class="acc-panel">

            <header class="acc-panel__head">

                <div>
                    <span class="is-green">
                        <i class="bi bi-currency-exchange"></i>
                    </span>

                    <div>
                        <small>
                            @L(
                            "آخر 7 أيام",
                            "Last 7 days")
                        </small>

                        <h2>
                            @L(
                            "إيرادات المنصة",
                            "Platform revenue")
                        </h2>
                    </div>
                </div>

                <span class="acc-chart-legend">
                    <span>
                        <i class="legend-dot is-green"></i>
                        @L(
                        "عمولة محصّلة",
                        "Collected commission")
                    </span>
                </span>

            </header>

            <div class="acc-chart acc-chart--small">
                <canvas id="adminRevenueChart"></canvas>
            </div>

        </article>


        <article class="acc-panel">

            <header class="acc-panel__head">

                <div>
                    <span class="is-purple">
                        <i class="bi bi-wallet-fill"></i>
                    </span>

                    <div>
                        <small>
                            @L(
                            "دورة العمولات",
                            "Commission cycle")
                        </small>

                        <h2>
                            @L(
                            "الحالة المالية",
                            "Financial status")
                        </h2>
                    </div>
                </div>

                <small class="acc-muted-money">
                    @L(
                    "معلّق:",
                    "Pending:")
                    @Model.PendingRevenueText
                </small>

            </header>

            <div class="acc-chart acc-chart--small">
                <canvas id="adminFinanceChart"></canvas>
            </div>

            <div class="acc-chart-key acc-chart-key--finance"
                 aria-label="@L("دليل ألوان الحالة المالية", "Financial status legend")">

                @foreach (var item in Model.FinanceDistribution)
                {
                    <span>
                        <i class="legend-dot finance-@FinanceTone(item.Status)"></i>
                        <b>
                            @FinanceLabel(item.Status)
                        </b>
                    </span>
                }

            </div>

        </article>


        <article class="acc-panel">

            <header class="acc-panel__head">

                <div>
                    <span class="is-cyan">
                        <i class="bi bi-grid-fill"></i>
                    </span>

                    <div>
                        <small>
                            @L(
                            "توزيع العرض",
                            "Listing distribution")
                        </small>

                        <h2>
                            @L(
                            "الفئات الأكثر حضورًا",
                            "Top categories")
                        </h2>
                    </div>
                </div>

            </header>

            <div class="acc-category-list">

                @foreach (var category in Model.CategoryDistribution.Take(5))
                {
                    var percent =
                    Model.TotalPlaces > 0
                    ? Math.Round(
                    category.PlaceCount *
                    100m /
                    Model.TotalPlaces,
                    0)
                    : 0;

                    <div class="acc-category-row">

                        <span>
                            <b>
                                @category.CategoryName
                            </b>

                            <small>
                                @category.PlaceCount
                                @L(
                            "منشأة",
                            "places")
                            </small>
                        </span>

                        <div>
                            <i style="--w:@percent%"></i>
                        </div>

                        <strong>
                            @percent%
                        </strong>

                    </div>
                }

                @if (!Model.CategoryDistribution.Any())
                {
                    <div class="acc-empty-mini">
                        <i class="bi bi-inbox"></i>
                        <span>
                            @L(
                        "لا توجد بيانات فئات بعد.",
                        "No category data yet.")
                        </span>
                    </div>
                }

            </div>

        </article>

    </section>


    <section class="acc-bottom acc-reveal">

        <article class="acc-panel acc-recent">

            <header class="acc-panel__head">

                <div>
                    <span class="is-blue">
                        <i class="bi bi-stars"></i>
                    </span>

                    <div>
                        <small>
                            @L(
                            "آخر ما دخل المنصة",
                            "Latest additions")
                        </small>

                        <h2>
                            @L(
                            "أحدث المنشآت",
                            "Newest places")
                        </h2>
                    </div>
                </div>

                <a asp-area="Admin"
                   asp-controller="Places"
                   asp-action="PlaceManagement">

                    @L(
                    "عرض الكل",
                    "View all")

                    <i class="bi bi-arrow-left"></i>
                </a>

            </header>

            <div class="acc-recent-list">

                @foreach (var place in Model.RecentPlaces)
                {
                    <a asp-area="Admin"
                   asp-controller="Places"
                   asp-action="PlaceManagement"
                   class="acc-recent-item">

                        <span class="acc-recent-item__icon">
                            <i class="bi bi-building"></i>
                        </span>

                        <div class="acc-recent-item__copy">
                            <strong>
                                @place.PlaceName
                            </strong>

                            <small>
                                @place.CategoryName
                                ·
                                @place.OwnerName
                            </small>
                        </div>

                        <span class="acc-status-badge is-@StatusTone(place.Status)">
                            <i></i>
                            @StatusLabel(place.Status)
                        </span>

                        <i class="bi bi-chevron-left"></i>

                    </a>
                }

                @if (!Model.RecentPlaces.Any())
                {
                    <div class="acc-empty-mini">
                        <i class="bi bi-buildings"></i>

                        <span>
                            @L(
                        "لا توجد منشآت مسجلة بعد.",
                        "No places registered yet.")
                        </span>
                    </div>
                }

            </div>

        </article>


        <aside class="acc-side-stack">

            <article class="acc-panel acc-quick acc-quick--full">

                <header>
                    <span>
                        <i class="bi bi-lightning-charge-fill"></i>
                        @L(
                        "اختصارات الإدارة",
                        "Admin shortcuts")
                    </span>

                    <small>
                        @L(
                        "انتقال مباشر للوظيفة نفسها",
                        "Direct access")
                    </small>
                </header>

                <div>

                    <a asp-area="Admin"
                       asp-controller="Places"
                       asp-action="PlaceManagement">

                        <i class="bi bi-buildings"></i>

                        <span>
                            @L(
                            "إدارة المنشآت",
                            "Manage places")
                        </span>
                    </a>

                    <a asp-area="Admin"
                       asp-controller="Users"
                       asp-action="UserManagement">

                        <i class="bi bi-people"></i>

                        <span>
                            @L(
                            "إدارة المستخدمين",
                            "Manage users")
                        </span>
                    </a>

                    <a asp-area="Admin"
                       asp-controller="Reports"
                       asp-action="ReportsCenter">

                        <i class="bi bi-flag-fill"></i>

                        <span>
                            @L(
                            "الشكاوى والبلاغات",
                            "Reports & complaints")
                        </span>
                    </a>

                    <a href="~/Admin/Financials/Manage">

                        <i class="bi bi-wallet2"></i>

                        <span>
                            @L(
                            "العمليات المالية",
                            "Financial operations")
                        </span>
                    </a>

                    <a asp-area="Admin"
                       asp-controller="Advertisements"
                       asp-action="AdvertisementManagement">

                        <i class="bi bi-megaphone-fill"></i>

                        <span>
                            @L(
                            "إدارة الإعلانات",
                            "Manage ads")
                        </span>
                    </a>

                    <a asp-area="Admin"
                       asp-controller="MasterEntities"
                       asp-action="MasterEntitiesManagement">

                        <i class="bi bi-grid-1x2"></i>

                        <span>
                            @L(
                            "تصنيفات النظام",
                            "System categories")
                        </span>
                    </a>

                </div>

            </article>

        </aside>

    </section>

</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js"></script>

    <script src="~/js/admin/dashboard-overview.js"
        asp-append-version="true">
    </script>
}
