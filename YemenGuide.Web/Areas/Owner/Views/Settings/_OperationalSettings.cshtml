    }
</style>

<script>
    (function installOperationalShiftValidation() {
        if (window.__yemenGuideOperationalShiftValidationInstalled) {
            return;
        }

        const container = document.getElementById("shiftsContainer");
        const page = document.getElementById("facilitySettingsPage") || document;
        const bufferInput = document.getElementById("bufferTimeHours");

        if (!container) {
            return;
        }

        window.__yemenGuideOperationalShiftValidationInstalled = true;

        function normalizeDigits(value) {
            const arabic = "٠١٢٣٤٥٦٧٨٩";
            const eastern = "۰۱۲۳۴۵۶۷۸۹";

            return String(value || "")
                .replace(/[٠-٩]/g, digit => String(arabic.indexOf(digit)))
                .replace(/[۰-۹]/g, digit => String(eastern.indexOf(digit)));
        }

        function readTimeMinutes(input) {
            if (!input) {
                return null;
            }

            if (Number.isFinite(input.valueAsNumber)) {
                return Math.floor(input.valueAsNumber / 60000);
            }

            const value = normalizeDigits(input.value).trim();
            const match = /^(\d{1,2}):(\d{2})$/.exec(value);

            if (!match) {
                return null;
            }

            const hours = Number(match[1]);
            const minutes = Number(match[2]);

            if (
                !Number.isInteger(hours) ||
                !Number.isInteger(minutes) ||
                hours < 0 ||
                hours > 23 ||
                minutes < 0 ||
                minutes > 59
            ) {
                return null;
            }

            return (hours * 60) + minutes;
        }

        function buildSegments(start, end) {
            if (start === null || end === null || start === end) {
                return [];
            }

            return start < end
                ? [[start, end]]
                : [[start, 1440], [0, end]];
        }

        function segmentsOverlap(firstSegments, secondSegments) {
            return firstSegments.some(first =>
                secondSegments.some(second =>
                    Math.max(first[0], second[0]) <
                    Math.min(first[1], second[1])
                )
            );
        }

        function readRows() {
            return Array.from(
                container.querySelectorAll(".luxury-list-item")
            ).map((item, index) => {
                const nameInput = item.querySelector(".policy-desc");
                const timeInputs = item.querySelectorAll('input[type="time"]');
                const fromInput = timeInputs[0] || null;
                const toInput = timeInputs[1] || null;
                const rawName = nameInput?.value?.trim() || "";
                const start = readTimeMinutes(fromInput);
                const end = readTimeMinutes(toInput);

                return {
                    item,
                    index,
                    nameInput,
                    fromInput,
                    toInput,
                    rawName,
                    name: rawName || `الفترة ${index + 1}`,
                    from: fromInput?.value || "",
                    to: toInput?.value || "",
                    start,
                    end,
                    segments: buildSegments(start, end)
                };
            });
        }

        function getOperationMode() {
            return document.querySelector(
                'input[name="operationSystemMode"]:checked'
            )?.value || "";
        }

        function readBufferHours() {
            if (!bufferInput) {
                return 0;
            }

            const value = Number(normalizeDigits(bufferInput.value));
            return Number.isFinite(value) ? value : NaN;
        }

        function findIssue() {
            if (getOperationMode() !== "Shifts") {
                return null;
            }

            const rows = readRows();

            if (rows.length === 0) {
                return {
                    message: "أضف فترة تشغيلية واحدة على الأقل قبل الحفظ.",
                    target: null,
                    rows: []
                };
            }

            const bufferHours = readBufferHours();
            if (
                !Number.isInteger(bufferHours) ||
                bufferHours < 0 ||
                bufferHours > 12
            ) {
                return {
                    message: "وقت التجهيز والتنظيف يجب أن يكون بين 0 و12 ساعة.",
                    target: bufferInput,
                    rows: []
                };
            }

            for (const row of rows) {
                if (!row.rawName) {
                    return {
                        message: `اكتب اسم الفترة رقم ${row.index + 1}.`,
                        target: row.nameInput,
                        rows: [row]
                    };
                }

                if (row.start === null || row.end === null) {
                    return {
                        message: `حدد وقت البداية والنهاية للفترة «${row.name}».`,
                        target: row.fromInput || row.toInput,
                        rows: [row]
                    };
                }

                if (row.start === row.end) {
                    return {
                        message: `لا يمكن أن تبدأ وتنتهي الفترة «${row.name}» في نفس الوقت.`,
                        target: row.fromInput,
                        rows: [row]
                    };
                }
            }

            for (let firstIndex = 0; firstIndex < rows.length; firstIndex += 1) {
                for (
                    let secondIndex = firstIndex + 1;
                    secondIndex < rows.length;
                    secondIndex += 1
                ) {
                    const first = rows[firstIndex];
                    const second = rows[secondIndex];

                    if (!segmentsOverlap(first.segments, second.segments)) {
                        continue;
                    }

                    return {
                        message:
                            `لا يمكن الحفظ: الفترة «${first.name}» تتداخل مع الفترة «${second.name}». غيّر وقت إحدى الفترتين أولًا.`,
                        target: first.fromInput,
                        rows: [first, second]
                    };
                }
            }

            return null;
        }

        function clearVisualState() {
            container
                .querySelectorAll(".is-invalid")
                .forEach(element => {
                    element.classList.remove("is-invalid");
                    element.removeAttribute("aria-invalid");
                });

            bufferInput?.classList.remove("is-invalid");
            bufferInput?.removeAttribute("aria-invalid");
            document.getElementById("shiftScheduleWarning")?.remove();
        }

        function markInvalid(element) {
            if (!element) {
                return;
            }

            element.classList.add("is-invalid");
            element.setAttribute("aria-invalid", "true");
        }

        function renderIssue(issue) {
            clearVisualState();

            if (!issue) {
                return;
            }

            issue.rows?.forEach(row => {
                markInvalid(row.nameInput);
                markInvalid(row.fromInput);
                markInvalid(row.toInput);
            });

            markInvalid(issue.target);

            const warning = document.createElement("div");
            warning.id = "shiftScheduleWarning";
            warning.className =
                "alert alert-danger d-flex align-items-start gap-2 mt-2 mb-0 py-2 px-3 fw-bold small";
            warning.setAttribute("role", "alert");
            warning.innerHTML =
                '<i class="bi bi-exclamation-triangle-fill mt-1"></i><span></span>';
            warning.querySelector("span").textContent = issue.message;
            container.insertAdjacentElement("afterend", warning);
        }

        function refreshValidation() {
            const issue = findIssue();
            renderIssue(issue);
            return issue;
        }

        function focusIssue(issue) {
            try {
                if (typeof window.activateFacilityTab === "function") {
                    window.activateFacilityTab("operational-tab", false);
                }
            } catch (_) {
            }

            window.setTimeout(() => {
                issue?.target?.scrollIntoView?.({
                    behavior: "smooth",
                    block: "center"
                });
                issue?.target?.focus?.({ preventScroll: true });
            }, 120);
        }

        async function notifyBlockedSave(issue) {
            if (!issue) {
                return;
            }

            focusIssue(issue);

            if (window.Swal?.fire) {
                await window.Swal.fire({
                    icon: "error",
                    title: "لا يمكن حفظ إعدادات التشغيل",
                    text: issue.message,
                    confirmButtonText: "تعديل الفترات",
                    confirmButtonColor: "#FF5A5F"
                });
            }
        }

        function isRowEditing(item) {
            if (!item) return false;

            return Array.from(
                item.querySelectorAll("input, select")
            ).some(field =>
                field.tagName === "SELECT"
                    ? !field.disabled
                    : !field.readOnly
            );
        }

        function getRowConfirmButton(item) {
            return item?.querySelector(".btn-edit") || null;
        }

        function updateNewRowTimeTouched(item) {
            if (!item || item.dataset.requiresTimeChange !== "true") {
                return;
            }

            const timeInputs = item.querySelectorAll('input[type="time"]');
            const currentFrom = timeInputs[0]?.value || "";
            const currentTo = timeInputs[1]?.value || "";

            item.dataset.timeTouched =
                currentFrom !== (item.dataset.initialFrom || "") ||
                currentTo !== (item.dataset.initialTo || "")
                    ? "true"
                    : "false";
        }

        function findIssueForRow(row, rows) {
            if (!row) return null;

            if (!row.rawName) {
                return {
                    message: `اكتب اسم الفترة رقم ${row.index + 1}.`,
                    target: row.nameInput
                };
            }

            if (row.start === null || row.end === null) {
                return {
                    message: `حدد وقت البداية والنهاية للفترة «${row.name}».`,
                    target: row.fromInput || row.toInput
                };
            }

            if (row.start === row.end) {
                return {
                    message: `لا يمكن أن تبدأ وتنتهي الفترة «${row.name}» في نفس الوقت.`,
                    target: row.fromInput
                };
            }

            if (
                row.item.dataset.requiresTimeChange === "true" &&
                row.item.dataset.timeTouched !== "true"
            ) {
                return {
                    message: "غيّر وقت البداية أو النهاية أولًا، ثم يمكنك اعتماد الفترة.",
                    target: row.fromInput
                };
            }

            for (const other of rows) {
                if (other.item === row.item) continue;
                if (!other.segments.length || !row.segments.length) continue;

                if (segmentsOverlap(row.segments, other.segments)) {
                    return {
                        message: `الفترة «${row.name}» تتداخل مع الفترة «${other.name}». غيّر الوقت أولًا.`,
                        target: row.fromInput
                    };
                }
            }

            return null;
        }

        function updateEditConfirmButtons() {
            const rows = readRows();

            container
                .querySelectorAll(".shift-row-validation-hint")
                .forEach(element => element.remove());

            rows.forEach(row => {
                const button = getRowConfirmButton(row.item);
                if (!button || !isRowEditing(row.item)) {
                    if (button) {
                        button.disabled = false;
                        button.removeAttribute("aria-disabled");
                    }
                    return;
                }

                updateNewRowTimeTouched(row.item);
                const currentRows = readRows();
                const currentRow = currentRows.find(value => value.item === row.item);
                const issue = findIssueForRow(currentRow, currentRows);

                button.disabled = Boolean(issue);
                button.setAttribute(
                    "aria-disabled",
                    issue ? "true" : "false"
                );
                button.title = issue
                    ? issue.message
                    : "اعتماد الفترة";

                if (issue) {
                    const hint = document.createElement("div");
                    hint.className =
                        "shift-row-validation-hint text-danger";
                    hint.textContent = issue.message;
                    row.item.insertAdjacentElement("afterend", hint);
                }
            });
        }

        function refreshOperationalValidation() {
            const issue = refreshValidation();
            updateEditConfirmButtons();
            return issue;
        }

        function handleShiftFieldChange(event) {
            const item = event.target.closest(".luxury-list-item");
            if (item && event.target.matches('input[type="time"]')) {
                updateNewRowTimeTouched(item);
            }

            window.requestAnimationFrame(refreshOperationalValidation);
        }

        container.addEventListener("input", handleShiftFieldChange);
        container.addEventListener("change", handleShiftFieldChange);

        // بعد اعتماد فترة صحيحة نزيل شرط "يجب تغيير الوقت" الخاص بالفترة الجديدة.
        container.addEventListener("click", event => {
            const button = event.target.closest(".btn-edit");
            if (!button || button.disabled) return;

            const item = button.closest(".luxury-list-item");
            if (!item) return;

            window.setTimeout(() => {
                if (!isRowEditing(item)) {
                    delete item.dataset.requiresTimeChange;
                    delete item.dataset.timeTouched;
                    delete item.dataset.initialFrom;
                    delete item.dataset.initialTo;
                }

                refreshOperationalValidation();
            }, 0);
        });

        bufferInput?.addEventListener("input", refreshOperationalValidation);
        bufferInput?.addEventListener("change", refreshOperationalValidation);

        document
            .querySelectorAll('input[name="operationSystemMode"]')
            .forEach(input => {
                input.addEventListener("change", refreshOperationalValidation);
            });

        const observer = new MutationObserver(mutations => {
            mutations.forEach(mutation => {
                mutation.addedNodes.forEach(node => {
                    if (!(node instanceof HTMLElement)) return;
                    if (!node.matches(".luxury-list-item")) return;
                    if (!isRowEditing(node)) return;

                    const timeInputs = node.querySelectorAll('input[type="time"]');
                    node.dataset.requiresTimeChange = "true";
                    node.dataset.timeTouched = "false";
                    node.dataset.initialFrom = timeInputs[0]?.value || "";
                    node.dataset.initialTo = timeInputs[1]?.value || "";
                });
            });

            window.requestAnimationFrame(refreshOperationalValidation);
        });

        observer.observe(container, {
            childList: true,
            subtree: false
        });

        // أهم جزء: نوقف حدث الحفظ في مرحلة capture قبل وصوله إلى
        // facility-settings.js إذا كانت الفترات متداخلة أو ناقصة.
        page.addEventListener(
            "click",
            function blockInvalidOperationalSave(event) {
                const saveButton = event.target.closest(
                    ".btn-royal-save, #verificationPolicySaveButton"
                );

                if (!saveButton) {
                    return;
                }

                const issue = refreshValidation();
                if (!issue) {
                    return;
                }

                event.preventDefault();
                event.stopPropagation();
                event.stopImmediatePropagation();
                notifyBlockedSave(issue);
            },
            true
        );

        document.getElementById("settingsForm")?.addEventListener(
            "submit",
            function blockInvalidOperationalSubmit(event) {
                const issue = refreshValidation();
                if (!issue) {
                    return;
                }

                event.preventDefault();
                event.stopPropagation();
                event.stopImmediatePropagation();
                notifyBlockedSave(issue);
            },
            true
        );

        refreshOperationalValidation();
    })();
</script>
