                font-weight: 800;
            }

            .yg-promo-en-picker__head button:disabled {
                opacity: .28;
                cursor: not-allowed;
            }

            .yg-promo-en-picker__month {
                text-align: center;
                color: #263f52;
                font-size: .9rem;
                font-weight: 900;
            }

            .yg-promo-en-picker__weekdays,
            .yg-promo-en-picker__days {
                display: grid;
                grid-template-columns: repeat(7, 1fr);
