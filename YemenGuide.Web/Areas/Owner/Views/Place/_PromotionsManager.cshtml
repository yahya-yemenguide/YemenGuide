            .yg-promo-en-picker__actions button {
                min-width: 78px;
                height: 38px;
                padding: 0 14px;
                border-radius: 10px;
                font-size: .7rem;
                font-weight: 900;
                cursor: pointer;
            }

            .yg-promo-en-picker__cancel {
                color: #607786;
                background: #fff;
                border: 1px solid #dce8ee;
            }

            .yg-promo-en-picker__apply {
                color: #fff;
                background: #00a6da;
                border: 1px solid #00a6da;
            }

        </style>


        <script>
            /*
             * توافق المرحلة 5/6 مع أي نسخة قديمة من promotions-manager.js:
             * - RewardServiceId يبقى أول خدمة مختارة للتوافق القديم.
             * - RewardServiceIds هي المصدر الحقيقي للاختيار المتعدد.
             * - السعر النهائي لباقة الخدمات يجب أن يكون أقل من مجموع أسعارها الأصلية.
             */
            (function () {
                const root = document.getElementById("promotionManager");
                if (!root || root.dataset.bundleCompatibilityInstalled === "true") return;
                root.dataset.bundleCompatibilityInstalled = "true";

                function getForm(target) {
                    return target?.closest?.("#promotionForm") || document.querySelector("#promotionForm");
                }

                function selectedServices(form) {
                    if (!form) return [];
                    return Array.from(form.querySelectorAll('input[name="RewardServiceIds"]:checked'))
                        .map(input => ({
                            input,
                            id: Number(input.value || 0),
                            price: Number(input.dataset.price || 0),
                            name: String(input.dataset.name || "خدمة")
                        }))
                        .filter(item => item.id > 0 && Number.isFinite(item.price) && item.price >= 0);
                }

                function originalBundlePrice(form) {
                    return selectedServices(form).reduce((sum, item) => sum + item.price, 0);
                }

                function money(value) {
                    try {
                        return new Intl.NumberFormat("ar-YE", { maximumFractionDigits: 2 }).format(value);
                    } catch {
                        return String(Math.round(value * 100) / 100);
                    }
                }

                function setAlert(form, message) {
                    const alert = form?.querySelector("#promotionFormAlert");
                    if (alert) {
                        alert.textContent = message;
                        alert.hidden = false;
                        alert.scrollIntoView?.({ block: "nearest", behavior: "smooth" });
                    }
                }

                function syncBundle(form) {
                    if (!form) return;

                    const selected = selectedServices(form);
                    const legacy = form.querySelector("#promotionRewardServiceId");
                    if (legacy) {
                        legacy.value = selected.length ? String(selected[0].id) : "";
                    }

                    const rewardType = form.querySelector('input[name="RewardType"]:checked')?.value || "";
                    const isBundle = rewardType === "ServiceSpecialPrice";
                    const total = originalBundlePrice(form);
                    const price = form.querySelector("#promotionSpecialPrice");
                    const hint = form.querySelector("#promotionSpecialPriceHint");
                    const summary = form.querySelector("#promotionBundleSummary");
                    const finalValue = Number(price?.value || 0);

                    if (price && isBundle && total > 0) {
                        const max = Math.max(0, Math.round((total - 0.01) * 100) / 100);
                        price.max = String(max);
                    } else if (price && isBundle) {
                        price.removeAttribute("max");
                    }

                    if (hint && isBundle) {
                        hint.textContent = total > 0
                            ? `السعر النهائي يجب أن يكون أقل من مجموع أسعار الخدمات المختارة (${money(total)} ريال).`
                            : "اختر خدمة واحدة على الأقل أولًا ليتم حساب الحد الأعلى للسعر.";

                        const invalid = finalValue > 0 && total > 0 && finalValue >= total;
                        hint.style.color = invalid ? "#c94d4d" : "";
                    }

                    if (summary) {
                        summary.hidden = !isBundle || total <= 0;
                    }

                    const originalText = form.querySelector("#promotionBundleOriginalText");
                    const finalText = form.querySelector("#promotionBundleFinalText");
                    const savingText = form.querySelector("#promotionBundleSavingText");

                    if (originalText) originalText.textContent = `${money(total)} ريال`;
                    if (finalText) finalText.textContent = finalValue > 0 ? `${money(finalValue)} ريال` : "—";
                    if (savingText) {
                        const saving = finalValue > 0 && finalValue < total ? total - finalValue : 0;
                        savingText.textContent = `${money(saving)} ريال`;
                    }
                }

                function validateBundleBeforeContinue(form) {
                    if (!form) return true;

                    const rewardType = form.querySelector('input[name="RewardType"]:checked')?.value || "";
                    if (rewardType !== "ServiceSpecialPrice") return true;

                    syncBundle(form);

                    const selected = selectedServices(form);
                    if (!selected.length) {
                        setAlert(form, "اختر خدمة واحدة على الأقل ضمن باقة الخدمات.");
                        selected[0]?.input?.focus?.();
                        return false;
                    }

                    const total = originalBundlePrice(form);
                    const price = form.querySelector("#promotionSpecialPrice");
                    const value = Number(price?.value || 0);

                    if (!Number.isFinite(value) || value <= 0) {
                        setAlert(form, "أدخل السعر النهائي لباقة الخدمات بشكل صحيح.");
                        price?.focus?.();
                        return false;
                    }

                    if (total <= 0) {
                        setAlert(form, "تعذر حساب مجموع أسعار الخدمات المختارة.");
                        return false;
                    }

                    if (value >= total) {
                        setAlert(
                            form,
                            `السعر النهائي يجب أن يكون أقل من مجموع أسعار الخدمات (${money(total)} ريال).`
                        );
                        price?.classList?.add("is-invalid");
                        price?.focus?.();
                        return false;
                    }

                    price?.classList?.remove("is-invalid");
                    return true;
                }

                document.addEventListener("change", function (event) {
                    const target = event.target;
                    if (!(target instanceof HTMLElement)) return;

                    if (target.matches('input[name="RewardServiceIds"], input[name="RewardType"], input[name="OfferMode"]')) {
                        const form = getForm(target);
                        window.setTimeout(() => syncBundle(form), 0);
                    }
                }, true);

                document.addEventListener("input", function (event) {
                    const target = event.target;
                    if (!(target instanceof HTMLElement)) return;
                    if (target.id === "promotionSpecialPrice") {
                        syncBundle(getForm(target));
                    }
                }, true);

                // نتحقق قبل وصول النقرة إلى كود التحقق القديم.
                document.addEventListener("click", function (event) {
                    const button = event.target?.closest?.(
                        "#promotionNextStep, #savePromotionDraft, #publishPromotion"
                    );
                    if (!button) return;

                    const form = getForm(button);
                    syncBundle(form);

                    if (!validateBundleBeforeContinue(form)) {
                        event.preventDefault();
                        event.stopImmediatePropagation();
                    }
                }, true);

                document.addEventListener("submit", function (event) {
                    const form = event.target;
                    if (!(form instanceof HTMLFormElement) || form.id !== "promotionForm") return;

                    syncBundle(form);
                    if (!validateBundleBeforeContinue(form)) {
                        event.preventDefault();
                        event.stopImmediatePropagation();
                    }
                }, true);
            })();
        </script>

        <script type="application/json" id="promotionManagerData">@Html.Raw(promotionsJson)</script>
    }
</section>
