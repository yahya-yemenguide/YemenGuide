@using YemenGuide.Core.DTOs.Admin
@using System.Globalization
@model AdminFinancialManagePageDto

@{
    var shell = Model?.Shell ?? new AdminFinancialShellDto();
    var access = Model?.Access ?? new AdminFinancialAccessDto();
    var selectedTab = string.IsNullOrWhiteSpace(shell.SelectedTab)
        ? AdminFinancialTabs.Overview
        : shell.SelectedTab.Trim().ToLowerInvariant();

    bool IsActive(string tab) =>
        string.Equals(selectedTab, tab, StringComparison.OrdinalIgnoreCase);

    var canOpenManagement =
        access.CanManageSettings ||
        access.CanManagePlatformWallets;

    var isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var uiDir = isArabic ? "rtl" : "ltr";
    var uiLang = isArabic ? "ar" : "en";

    ViewData["Title"] = isArabic ? "الإدارة المالية" : "Financial Management";
}

<link rel="stylesheet" href="~/css/admin/financials/admin-financials-shell.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin/financials/admin-financial-overview.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin/financials/admin-commission-guarantee.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin/financials/admin-topup-review.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin/financials/admin-financial-transactions.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin/financials/admin-financial-reports.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin/financials/admin-financial-management.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin/financials/admin-financials-phase1.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin/financials/admin-financials-phase2.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin/financials/admin-financials-phase3.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin/financials/admin-financials-phase4.css" asp-append-version="true" />

<main class="af-shell"
      id="adminFinancialsRoot"
      dir="@uiDir"
      data-ui-lang="@uiLang"
      data-selected-tab="@selectedTab"
      data-shell-url="@Url.Action("Shell", "AdminFinancials", new { area = "Admin" })"
      data-management-url="@Url.Action("Index", "AdminFinancialManagement", new { area = "Admin" })">

    <section class="af-hero af-hero--compact" aria-labelledby="adminFinancialsTitle">
        <div class="af-hero__content">
            <div class="af-hero__headline-row">
                <div class="af-hero__compact-title">
                    <h1 class="af-hero__title" id="adminFinancialsTitle">الإدارة المالية</h1>

                    <div class="af-hero__meta">
                        <span class="af-meta-pill">
                            <i class="bi bi-cash-coin" aria-hidden="true"></i>
                            <span>العملة:</span>
                            <strong>@shell.Currency</strong>
                        </span>

                        <span class="af-meta-pill">
                            <i class="bi bi-clock" aria-hidden="true"></i>
                            <span>آخر تحديث:</span>
                            <strong>@shell.GeneratedAt.ToString("yyyy/MM/dd - HH:mm")</strong>
                        </span>
                    </div>
                </div>

                <div class="af-hero__actions">
                    <button type="button"
                            class="af-btn af-btn--ghost"
                            data-finance-refresh>
                        <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                        <span>تحديث</span>
                    </button>

                    @if (canOpenManagement)
                    {
                        <button type="button"
                                class="af-btn af-btn--primary"
                                data-finance-management-open>
                            <i class="bi bi-sliders2" aria-hidden="true"></i>
                            <span>إدارة المالية</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="af-workspace">
        <nav class="af-tabs"
             role="tablist"
             aria-label="تبويبات الإدارة المالية"
             data-finance-keyboard-tabs>
            @if (access.CanView)
            {
                <button type="button"
                        role="tab"
                        aria-selected="@(IsActive(AdminFinancialTabs.Overview) ? "true" : "false")"
                        tabindex="@(IsActive(AdminFinancialTabs.Overview) ? "0" : "-1")"
                        class="af-tab @(IsActive(AdminFinancialTabs.Overview) ? "is-active" : null)"
                        data-finance-tab="@AdminFinancialTabs.Overview"
                        data-finance-tab-url="@Url.Action("Index", "AdminFinancialOverview", new { area = "Admin" })">
                    <span class="af-tab__icon"><i class="bi bi-grid-1x2"></i></span>
                    <span>نظرة عامة</span>
                </button>

                <button type="button"
                        role="tab"
                        aria-selected="@(IsActive(AdminFinancialTabs.CommissionGuarantee) ? "true" : "false")"
                        tabindex="@(IsActive(AdminFinancialTabs.CommissionGuarantee) ? "0" : "-1")"
                        class="af-tab @(IsActive(AdminFinancialTabs.CommissionGuarantee) ? "is-active" : null)"
                        data-finance-tab="@AdminFinancialTabs.CommissionGuarantee"
                        data-finance-tab-url="@Url.Action("Index", "AdminCommissionGuarantee", new { area = "Admin" })">
                    <span class="af-tab__icon"><i class="bi bi-shield-check"></i></span>
                    <span>العمولات والضمان</span>
                </button>
            }

            @if (access.CanReviewTopUps)
            {
                <button type="button"
                        role="tab"
                        aria-selected="@(IsActive(AdminFinancialTabs.TopUps) ? "true" : "false")"
                        tabindex="@(IsActive(AdminFinancialTabs.TopUps) ? "0" : "-1")"
                        class="af-tab @(IsActive(AdminFinancialTabs.TopUps) ? "is-active" : null)"
                        data-finance-tab="@AdminFinancialTabs.TopUps"
                        data-finance-tab-url="@Url.Action("Index", "AdminTopUpReview", new { area = "Admin" })">
                    <span class="af-tab__icon"><i class="bi bi-wallet2"></i></span>
                    <span>طلبات الشحن</span>
                    @if (shell.PendingTopUpsCount > 0)
                    {
                        <span class="af-tab__count" data-shell-counter="pending-topups-tab">@shell.PendingTopUpsCount</span>
                    }
                </button>
            }

            @if (access.CanView)
            {
                <button type="button"
                        role="tab"
                        aria-selected="@(IsActive(AdminFinancialTabs.Transactions) ? "true" : "false")"
                        tabindex="@(IsActive(AdminFinancialTabs.Transactions) ? "0" : "-1")"
                        class="af-tab @(IsActive(AdminFinancialTabs.Transactions) ? "is-active" : null)"
                        data-finance-tab="@AdminFinancialTabs.Transactions"
                        data-finance-tab-url="@Url.Action("Index", "AdminFinancialTransactions", new { area = "Admin" })">
                    <span class="af-tab__icon"><i class="bi bi-arrow-left-right"></i></span>
                    <span>كشف الحركات</span>
                </button>
            }

            @if (access.CanViewReports)
            {
                <button type="button"
                        role="tab"
                        aria-selected="@(IsActive(AdminFinancialTabs.Reports) ? "true" : "false")"
                        tabindex="@(IsActive(AdminFinancialTabs.Reports) ? "0" : "-1")"
                        class="af-tab @(IsActive(AdminFinancialTabs.Reports) ? "is-active" : null)"
                        data-finance-tab="@AdminFinancialTabs.Reports"
                        data-finance-tab-url="@Url.Action("Index", "AdminFinancialReports", new { area = "Admin" })">
                    <span class="af-tab__icon"><i class="bi bi-file-earmark-bar-graph"></i></span>
                    <span>التقارير والمستندات</span>
                </button>
            }
        </nav>

        <div class="af-tab-panel" id="adminFinancialTabHost" aria-live="polite">
            <div class="af-loading-state" data-finance-loading>
                <div class="af-loading-state__mark"><span></span><span></span><span></span></div>
                <strong>جارٍ تجهيز البيانات المالية</strong>
                <p>لحظات بسيطة...</p>
            </div>
        </div>
    </section>

    <div class="af-drawer-backdrop" data-finance-management-backdrop hidden></div>
    <aside class="af-management-drawer"
           data-finance-management-drawer
           aria-hidden="true"
           hidden>
        <div class="af-management-drawer__host" data-finance-management-host></div>
    </aside>

    <div class="af-global-loader" data-finance-global-loader hidden>
        <div class="af-global-loader__spinner"></div>
    </div>

    <div class="af-toast-stack" id="adminFinanceToastStack" aria-live="polite"></div>
</main>

<script src="~/js/admin/financials/admin-financials-shell.js" asp-append-version="true"></script>
<script src="~/js/admin/financials/admin-financial-overview.js" asp-append-version="true"></script>
<script src="~/js/admin/financials/admin-commission-guarantee.js" asp-append-version="true"></script>
<script src="~/js/admin/financials/admin-topup-review.js" asp-append-version="true"></script>
<script src="~/js/admin/financials/admin-financial-transactions.js" asp-append-version="true"></script>
<script src="~/js/admin/financials/admin-financial-reports.js" asp-append-version="true"></script>
<script src="~/js/admin/financials/admin-financial-management.js" asp-append-version="true"></script>
<script src="~/js/admin/financials/admin-financials-phase1.js" asp-append-version="true"></script>
<script src="~/js/admin/financials/admin-financials-phase2.js" asp-append-version="true"></script>
<script src="~/js/admin/financials/admin-financials-phase3.js" asp-append-version="true"></script>
<script src="~/js/admin/financials/admin-financials-phase4.js" asp-append-version="true"></script>
