                min-width: 0;
            }

            .yg-promo-bundle-summary small,
            .yg-promo-bundle-summary b { display: block; }
            .yg-promo-bundle-summary small { color:#8A9AA8; font-size:.59rem; font-weight:700; }
            .yg-promo-bundle-summary b { color:#30495C; font-size:.72rem; font-weight:950; }
            .yg-promo-bundle-summary .is-saving b { color:#23956D; }
            .yg-promo-bundle-summary > i { color:#00A6DA; }

            @@media (max-width: 760px) {
                .yg-promo-service-checks { grid-template-columns: 1fr; }
                .yg-promo-bundle-summary { grid-template-columns: 1fr 1fr; }
                .yg-promo-bundle-summary > i { display:none; }
