            max-height: 200px !important;
        }

        #addCategoryOffcanvas .icon-item {
            height: 46px !important;
        }

        #addCategoryOffcanvas .booking-system-options {
            grid-template-columns: 1fr !important;
        }

        #addCategoryOffcanvas .booking-option-card {
            min-height: 82px !important;
        }

        #addCategoryOffcanvas .entity-form-footer,
        #addCityOffcanvas .entity-form-footer {
            padding: 11px 12px !important;
        }

        #addCategoryOffcanvas .btn-save-entity,
        #addCityOffcanvas .btn-save-entity {
            min-width: 160px !important;
            min-height: 50px !important;
            font-size: .78rem !important;
        }
    }

    @media (max-width: 420px) {
        #addCategoryOffcanvas .category-icon-grid {
            grid-template-columns: repeat(4, minmax(0,1fr)) !important;
        }

        .entity-field-label--with-note {
            align-items: flex-start;
            flex-direction: column;
        }

        #addCategoryOffcanvas .entity-footer-security,
        #addCityOffcanvas .entity-footer-security {
            display: none !important;
        }

        #addCategoryOffcanvas .btn-save-entity,
        #addCityOffcanvas .btn-save-entity {
            width: 100% !important;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        #addCategoryOffcanvas *,
        #addCityOffcanvas * {
            transition: none !important;
        }
    }
</style>

<script>
    /*
     * تحسينات واجهة الفئات فقط.
     * لا تغيّر منطق الحفظ الموجود في master-entities.js.
     */
    (function () {
        'use strict';

        function normalizeSmartTerm(value) {
            return String(value || '')
                .trim()
                .toLowerCase()
                .replace(/[أإآ]/g, 'ا')
                .replace(/ة/g, 'ه');
        }

        function getIconClass(button) {
            const icon = button?.querySelector('i.bi');
            if (!icon) return '';

            return Array
                .from(icon.classList)
                .find(name => name.startsWith('bi-') && name !== 'bi') || '';
        }

        function scoreIcon(iconObj, rawTerm) {
            const term = normalizeSmartTerm(rawTerm);
            if (!term || !iconObj) return 0;

            const iconClass = normalizeSmartTerm(iconObj.class || '');
            let score = iconClass.includes(term) ? 50 : 0;

            (iconObj.tags || []).forEach(tagValue => {
                const tag = normalizeSmartTerm(tagValue);
                if (!tag) return;

                if (tag === term) {
                    score = Math.max(score, 120);
                }
                else if (tag.startsWith(term) || term.startsWith(tag)) {
                    score = Math.max(score, 100);
                }
                else if (tag.includes(term) || term.includes(tag)) {
                    score = Math.max(score, 82);
                }
            });

            return score;
        }

        function installLuxuryCategoryInteractions() {
            const form = document.getElementById('addCategoryForm');
            if (!form) return;

            const nameInput = form.querySelector('.category-name-input');
            const iconSearch = form.querySelector('.category-icon-search');
            const grid = form.querySelector('.category-icon-grid');
            const previewName = document.getElementById('previewCategoryName');
            const status = document.getElementById('smartIconStatus');

            /*
             * تُربط هذه المستمعات قبل مستمعات master-entities.js
             * حتى لا يقوم البحث القديم بإخفاء الأيقونات.
             */
            function handleSmartInput(event, isNameInput) {
                event.stopImmediatePropagation();

                if (isNameInput && previewName) {
                    previewName.textContent =
                        nameInput?.value.trim() || 'فئة جديدة';
                }

                window.setTimeout(() => {
                    highlightSmartIcons(
                        event.currentTarget?.value || '',
                        true
                    );
                }, 0);
            }

            nameInput?.addEventListener(
                'input',
                event => handleSmartInput(event, true),
                true
            );

            iconSearch?.addEventListener(
                'input',
                event => handleSmartInput(event, false),
                true
            );

            function highlightSmartIcons(rawTerm, autoSelect) {
                if (!grid || !Array.isArray(window.iconsData)) {
                    return;
                }

                const buttons = Array.from(
                    grid.querySelectorAll('.icon-item')
                );

                if (!buttons.length) {
                    return;
                }

                buttons.forEach(button => {
                    button.dataset.iconClass = getIconClass(button);
                    button.classList.remove(
                        'is-smart-match',
                        'is-smart-best'
                    );
                });

                const term = normalizeSmartTerm(rawTerm);

                if (!term) {
                    if (status) {
                        status.innerHTML =
                            '<span class="smart-icon-status__icon"><i class="bi bi-magic"></i></span>' +
                            '<span>اكتب اسم الفئة وسيتم تمييز الأيقونات الأنسب مع إبقاء جميع الأيقونات ظاهرة.</span>';
                    }
                    return;
                }

                const ranked = window.iconsData
                    .map(item => ({
                        item,
                        score: scoreIcon(item, term)
                    }))
                    .filter(result => result.score > 0)
                    .sort((a, b) => b.score - a.score);

                if (!ranked.length) {
                    if (status) {
                        status.innerHTML =
                            '<span class="smart-icon-status__icon"><i class="bi bi-grid"></i></span>' +
                            '<span>لا يوجد تطابق مباشر؛ جميع الأيقونات ما زالت متاحة للاختيار اليدوي.</span>';
                    }
                    return;
                }

                const topScore = ranked[0].score;
                const recommended = ranked
                    .filter(result => result.score >= Math.max(50, topScore - 22))
                    .slice(0, 5);

                recommended.forEach(result => {
                    const button = buttons.find(
                        item => item.dataset.iconClass === result.item.class
                    );

                    button?.classList.add('is-smart-match');
                });

                const best = ranked[0].item;

                const bestButton = buttons.find(
                    item => item.dataset.iconClass === best.class
                );

                bestButton?.classList.add(
                    'is-smart-match',
                    'is-smart-best'
                );

                if (status) {
                    const title =
                        (best.tags || [])[0] ||
                        best.class.replace('bi-', '');

                    status.innerHTML =
                        '<span class="smart-icon-status__icon"><i class="bi bi-stars"></i></span>' +
                        `<span>أفضل اقتراح حالي: <strong>${title}</strong> — تم تمييز الاقتراحات دون حذف أيقونة.</span>`;
                }

                if (
                    autoSelect &&
                    bestButton &&
                    !bestButton.classList.contains('active')
                ) {
                    bestButton.click();
                }
            }

            /*
             * master-entities.js يعيد بناء شبكة الأيقونات عند الفتح والتعديل.
             * نعيد فقط التمييز بعد البناء دون تغيير اختيار الفئة المحفوظة.
             */
            if (grid) {
                const observer = new MutationObserver(() => {
                    window.setTimeout(() => {
                        const term =
                            iconSearch?.value.trim() ||
                            nameInput?.value.trim() ||
                            '';

                        highlightSmartIcons(term, false);
                    }, 0);
                });

                observer.observe(grid, {
                    childList: true
                });
            }

            /*
             * بطاقات نظام الحجز أصبحت هي عنصر الاختيار،
             * بينما select المخفي يبقى مصدر القيمة للحفظ القديم.
             */
            window.setTimeout(() => {
                const select =
                    document.getElementById('bookingSystemId');

                const cards = Array.from(
                    form.querySelectorAll('[data-booking-choice]')
                );

                function syncBookingCards() {
                    const current = String(select?.value ?? '0');

                    cards.forEach(card => {
                        const active =
                            card.dataset.bookingChoice === current;

                        card.classList.toggle('is-active', active);
                        card.setAttribute(
                            'aria-pressed',
                            active ? 'true' : 'false'
                        );
                    });
                }

                cards.forEach(card => {
                    card.addEventListener('click', () => {
                        if (!select) return;

                        select.value =
                            card.dataset.bookingChoice || '0';

                        select.dispatchEvent(
                            new Event('change', {
                                bubbles: true
                            })
                        );

                        syncBookingCards();
                    });
                });

                select?.addEventListener(
                    'change',
                    syncBookingCards
                );

                syncBookingCards();

                const initialTerm =
                    nameInput?.value.trim() || '';

                highlightSmartIcons(
                    initialTerm,
                    false
                );
            }, 0);
        }

        if (document.readyState === 'loading') {
            document.addEventListener(
                'DOMContentLoaded',
                installLuxuryCategoryInteractions,
                { once: true }
            );
        }
        else {
            installLuxuryCategoryInteractions();
        }
    })();
</script>
