<div class="royal-policies-wrapper policy-section-stack fade-in-up" dir="rtl">

    <section class="royal-card policy-card policy-card--cyan top-border-gold">
        <header class="policy-card__header">
            <span class="icon-glow-wrapper policy-card__icon" aria-hidden="true">
                <i class="bi bi-gear-wide-connected"></i>
            </span>
            <div>
                <span class="policy-card__kicker">نظام التقويم</span>
                <h2>آلية تشغيل المنشأة</h2>
                <p>اختر طريقة احتساب المدة وعرض المواعيد المتاحة للزبائن.</p>
            </div>
        </header>

        <div class="policy-choice-grid">
            <label class="royal-radio-card policy-choice-card">
                <input type="radio"
                       name="operationSystemMode"
                       value="FullDay"
                       onchange="toggleOperationMode()"
                       checked />
                <span class="card-content policy-choice-card__content">
                    <span class="radio-icon policy-choice-card__icon policy-choice-card__icon--cyan">
                        <i class="bi bi-calendar-day-fill"></i>
                    </span>
                    <span class="policy-choice-card__copy">
                        <strong>نظام اليوم الكامل</strong>
                        <small>وقت ثابت للاستلام ووقت ثابت للتسليم.</small>
                    </span>
                    <span class="check-indicator" aria-hidden="true">
                        <i class="bi bi-check-circle-fill"></i>
                    </span>
                </span>
            </label>

            <label class="royal-radio-card policy-choice-card">
                <input type="radio"
                       name="operationSystemMode"
                       value="Shifts"
                       onchange="toggleOperationMode()" />
                <span class="card-content policy-choice-card__content">
                    <span class="radio-icon policy-choice-card__icon policy-choice-card__icon--amber">
                        <i class="bi bi-clock-history"></i>
                    </span>
                    <span class="policy-choice-card__copy">
                        <strong>نظام الفترات</strong>
                        <small>فترات صباحية أو مسائية أو أوقات مخصصة.</small>
                    </span>
                    <span class="check-indicator" aria-hidden="true">
                        <i class="bi bi-check-circle-fill"></i>
                    </span>
                </span>
            </label>
        </div>
    </section>

    <section id="fullDaySettingsCard"
             class="royal-card policy-card policy-card--cyan azure-theme fade-in-up">
        <header class="policy-card__header policy-card__header--compact">
            <span class="icon-glow-wrapper policy-card__icon" aria-hidden="true">
                <i class="bi bi-door-open-fill"></i>
            </span>
            <div>
                <span class="policy-card__kicker">مواعيد اليوم الكامل</span>
                <h2>أوقات الاستلام والتسليم</h2>
                <p>الأوقات الرسمية لدخول الزبون وخروجه من الوحدة.</p>
            </div>
        </header>

        <div class="policy-form-grid">
            <div class="luxury-floating-input policy-field">
                <label for="checkInTime">
                    <i class="bi bi-box-arrow-in-right"></i>
                    وقت الاستلام (Check-in)
                </label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-clock" aria-hidden="true"></i>
                    <input type="time"
                           class="form-control"
                           id="checkInTime"
                           value="14:00" />
                </div>
            </div>

            <div class="luxury-floating-input policy-field">
                <label for="checkOutTime">
                    <i class="bi bi-box-arrow-right"></i>
                    وقت التسليم (Check-out)
                </label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-clock" aria-hidden="true"></i>
                    <input type="time"
                           class="form-control"
                           id="checkOutTime"
                           value="12:00" />
                </div>
            </div>
        </div>
    </section>

    <section id="shiftsSettingsCard"
             class="royal-card policy-card policy-card--green emerald-theme fade-in-up d-none">
        <div class="policy-shifts-grid">
            <div class="policy-shifts-builder">
                <header class="policy-card__header policy-card__header--compact">
                    <span class="icon-glow-wrapper policy-card__icon" aria-hidden="true">
                        <i class="bi bi-list-task"></i>
                    </span>
                    <div>
                        <span class="policy-card__kicker">الفترات المتاحة</span>
                        <h2>باني الفترات التشغيلية</h2>
                        <p>أضف اسم كل فترة وحدد وقت بدايتها ونهايتها.</p>
                    </div>
                </header>

                <div id="shiftsContainer"
                     class="policy-builder-list d-flex flex-column gap-3 mb-3">
                    <div class="luxury-list-item policy-builder-item policy-builder-item--shift">
                        <span class="item-icon policy-builder-item__icon" aria-hidden="true">
                            <i class="bi bi-sun-fill"></i>
                        </span>

                        <input type="text"
                               class="form-control fw-bold policy-desc editing-mode text-center"
                               value="الفترة الصباحية"
                               aria-label="اسم الفترة"
                               readonly />

                        <div class="input-group input-group-sm policy-shift-time">
                            <span class="input-group-text">من</span>
                            <input type="time"
                                   class="form-control text-center fw-bold policy-val editing-mode"
                                   value="08:00"
                                   aria-label="بداية الفترة"
                                   readonly />
                            <span class="input-group-text">إلى</span>
                            <input type="time"
                                   class="form-control text-center fw-bold policy-val editing-mode"
                                   value="14:00"
                                   aria-label="نهاية الفترة"
                                   readonly />
                        </div>

                        <div class="actions-wrapper policy-builder-item__actions">
                            <button type="button"
                                    class="btn-action text-primary btn-edit"
                                    onclick="toggleEditMode(this)"
                                    aria-label="تعديل الفترة">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button type="button"
                                    class="btn-action text-danger btn-delete"
                                    onclick="this.closest('.luxury-list-item').remove()"
                                    aria-label="حذف الفترة">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <button type="button"
                        class="btn-royal-add emerald-add w-100"
                        onclick="addShiftPolicy()">
                    <i class="bi bi-plus-circle"></i>
                    <span>إضافة فترة تشغيلية جديدة</span>
                </button>
            </div>

            <aside class="policy-buffer-panel policy-buffer-panel--compact border">
                <div class="policy-buffer-panel__heading">
                    <span class="policy-buffer-panel__icon" aria-hidden="true">
                        <i class="bi bi-stars"></i>
                    </span>
                    <div class="policy-buffer-panel__copy">
                        <span class="policy-buffer-panel__kicker">فاصل بين الحجوزات</span>
                        <h3>وقت التجهيز والتنظيف</h3>
                        <p>حدد المدة التي تحتاجها المنشأة للتجهيز قبل بدء الحجز التالي.</p>
                    </div>
                </div>

                <div class="policy-buffer-panel__controls">
                    <label for="bufferTimeHours">مدة التجهيز</label>
                    <div class="input-group">
                        <input type="number"
                               class="form-control text-center fw-bold show-spinners"
                               id="bufferTimeHours"
                               value="2"
                               min="0"
                               max="12" />
                        <span class="input-group-text">ساعة</span>
                    </div>
                </div>

                <div class="policy-buffer-panel__example">
                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                    <small>مثال: إذا انتهى الحجز 2:00 وكانت مدة التجهيز ساعتين، يبدأ الحجز التالي 4:00.</small>
                </div>
            </aside>
        </div>
    </section>

    <div class="policy-two-column-grid">
        <section class="royal-card policy-card policy-card--amber gold-theme">
            <header class="policy-card__header policy-card__header--compact">
                <span class="icon-glow-wrapper policy-card__icon" aria-hidden="true">
                    <i class="bi bi-shield-lock"></i>
                </span>
                <div>
                    <span class="policy-card__kicker">منع الحجوزات المفاجئة</span>
                    <h2>الحد الأدنى للحجز المسبق</h2>
                    <p>أقل مدة مطلوبة بين إنشاء الحجز وموعد بدايته.</p>
                </div>
            </header>

            <div class="policy-number-field border">
                <label for="minimumNoticeHours">المدة المطلوبة قبل الحجز</label>
                <div class="input-group">
                    <span class="input-group-text">قبل</span>
                    <input type="number"
                           class="form-control text-center fw-bold show-spinners"
                           id="minimumNoticeHours"
                           value=""
                           min="1"
                           max="72" />
                    <span class="input-group-text">ساعة</span>
                </div>
            </div>
        </section>

        <section class="royal-card policy-card policy-card--amber gold-theme">
            <header class="policy-card__header policy-card__header--compact">
                <span class="icon-glow-wrapper policy-card__icon" aria-hidden="true">
                    <i class="bi bi-telescope"></i>
                </span>
                <div>
                    <span class="policy-card__kicker">مدى التقويم</span>
                    <h2>أقصى أفق زمني للحجز</h2>
                    <p>عدد الشهور التي يمكن للزبون الحجز خلالها مقدمًا.</p>
                </div>
            </header>

            <div class="policy-number-field border">
                <label for="maximumHorizonMonths">فتح التقويم حتى</label>
                <div class="input-group">
                    <span class="input-group-text">حتى</span>
                    <input type="number"
                           class="form-control text-center fw-bold show-spinners"
                           id="maximumHorizonMonths"
                           value=""
                           min="1"
                           max="24" />
                    <span class="input-group-text">شهر</span>
                </div>
            </div>
        </section>
    </div>

    <section class="royal-card policy-card policy-card--neutral silver-theme">
        <header class="policy-card__header policy-card__header--compact">
            <span class="icon-glow-wrapper policy-card__icon" aria-hidden="true">
                <i class="bi bi-calendar-x-fill"></i>
            </span>
            <div>
                <span class="policy-card__kicker">إغلاق أسبوعي ثابت</span>
                <h2>أيام الإغلاق والصيانة</h2>
                <p>الأيام المختارة ستُحجب تلقائيًا من تقويم الحجز كل أسبوع.</p>
            </div>
        </header>

        <div class="policy-days-grid" role="group" aria-label="أيام الإغلاق الأسبوعية">
            <label class="policy-day-chip">
                <input type="checkbox" name="closedDays" value="Saturday" />
                <span>السبت</span>
            </label>
            <label class="policy-day-chip">
                <input type="checkbox" name="closedDays" value="Sunday" />
                <span>الأحد</span>
            </label>
            <label class="policy-day-chip">
                <input type="checkbox" name="closedDays" value="Monday" />
                <span>الإثنين</span>
            </label>
            <label class="policy-day-chip">
                <input type="checkbox" name="closedDays" value="Tuesday" />
                <span>الثلاثاء</span>
            </label>
            <label class="policy-day-chip">
                <input type="checkbox" name="closedDays" value="Wednesday" />
                <span>الأربعاء</span>
            </label>
            <label class="policy-day-chip">
                <input type="checkbox" name="closedDays" value="Thursday" />
                <span>الخميس</span>
            </label>
            <label class="policy-day-chip policy-day-chip--friday">
                <input type="checkbox" name="closedDays" value="Friday" />
                <span>الجمعة</span>
            </label>
        </div>
    </section>

    <footer class="policy-save-bar">
        <div class="policy-save-bar__copy">
            <i class="bi bi-info-circle"></i>
            <span>تؤثر هذه الإعدادات مباشرة في المواعيد المتاحة للحجز.</span>
        </div>
        <button type="button" class="btn-royal-save">
            <i class="bi bi-check2-all"></i>
            <span>حفظ إعدادات التشغيل</span>
        </button>
    </footer>
</div>

<style id="facilityPoliciesResponsiveFix">
    /*
       استجابة جميع أقسام صفحة السياسات للهاتف والتابلت.
       هذا النمط موجود داخل ملف قائم أصلًا، ولا يضيف ملف CSS جديدًا للمشروع.
    */
    #facilitySettingsPage,
    #facilitySettingsPage .tab-pane-content,
    #facilitySettingsPage .royal-policies-wrapper,
    #facilitySettingsPage .policy-section-stack,
    #facilitySettingsPage .royal-card,
    #facilitySettingsPage .policy-card {
        min-width: 0;
        max-width: 100%;
        box-sizing: border-box;
    }

    #facilitySettingsPage .royal-policies-wrapper,
    #facilitySettingsPage .policy-section-stack {
        overflow-x: clip;
    }

    #facilitySettingsPage .policy-card__header > div,
    #facilitySettingsPage .policy-choice-card__copy,
    #facilitySettingsPage .policy-save-bar__copy,
    #facilitySettingsPage .policy-builder-item,
    #facilitySettingsPage .policy-field,
    #facilitySettingsPage .policy-number-field {
        min-width: 0;
    }

    #facilitySettingsPage .policy-card__header h2,
    #facilitySettingsPage .policy-card__header h3,
    #facilitySettingsPage .policy-card__header p,
    #facilitySettingsPage .policy-choice-card__copy strong,
    #facilitySettingsPage .policy-choice-card__copy small,
    #facilitySettingsPage .policy-buffer-panel h3,
    #facilitySettingsPage .policy-buffer-panel p,
    #facilitySettingsPage .policy-buffer-panel small {
        overflow-wrap: anywhere;
        word-break: normal;
    }

    #shiftsSettingsCard .policy-buffer-panel {
        align-self: stretch;
        height: auto !important;
        min-height: 0 !important;
    }

    /*
       بطاقة وقت التجهيز والتنظيف: نعرضها عموديًا بشكل واضح بدل ضغط
       العنوان والوصف والحقل في صف واحد، وهو ما كان يكسّر الكلمات.
    */
    #shiftsSettingsCard .policy-buffer-panel--compact {
        display: flex !important;
        flex-direction: column !important;
        align-items: stretch !important;
        justify-content: flex-start !important;
        gap: 14px !important;
        padding: 18px !important;
        text-align: start !important;
        overflow: hidden;
    }

    #shiftsSettingsCard .policy-buffer-panel__heading {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 11px;
        align-items: start;
        width: 100%;
        min-width: 0;
    }

    #shiftsSettingsCard .policy-buffer-panel__copy {
        min-width: 0;
    }

    #shiftsSettingsCard .policy-buffer-panel__kicker {
        display: block;
        margin-bottom: 3px;
        font-size: .78rem;
        font-weight: 800;
        color: #d49a08;
    }

    #shiftsSettingsCard .policy-buffer-panel h3 {
        margin: 0 0 5px !important;
        font-size: 1.08rem !important;
        line-height: 1.45 !important;
        white-space: normal !important;
        overflow-wrap: normal !important;
        word-break: keep-all !important;
    }

    #shiftsSettingsCard .policy-buffer-panel p {
        margin: 0 !important;
        line-height: 1.65 !important;
        white-space: normal !important;
        overflow-wrap: normal !important;
        word-break: normal !important;
    }

    #shiftsSettingsCard .policy-buffer-panel__controls {
        width: 100%;
        min-width: 0;
        padding: 12px;
        border-radius: 14px;
        background: rgba(245, 158, 11, .06);
        border: 1px solid rgba(245, 158, 11, .16);
    }

    #shiftsSettingsCard .policy-buffer-panel__controls > label {
        display: block;
        margin-bottom: 7px;
        font-size: .88rem;
        font-weight: 800;
    }

    #shiftsSettingsCard .policy-buffer-panel .input-group {
        width: 100% !important;
        max-width: none !important;
        min-width: 0;
        flex-wrap: nowrap;
    }

    #shiftsSettingsCard .policy-buffer-panel #bufferTimeHours {
        min-width: 0;
        height: 44px;
        font-size: 1rem;
    }

    #shiftsSettingsCard .policy-buffer-panel__example {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        width: 100%;
        min-width: 0;
        padding: 10px 12px;
        border-radius: 12px;
        background: rgba(0, 166, 218, .06);
        line-height: 1.65;
    }

    #shiftsSettingsCard .policy-buffer-panel__example i {
        flex: 0 0 auto;
        margin-top: 2px;
        color: #00a6da;
    }

    #shiftsSettingsCard .policy-buffer-panel__example small {
        min-width: 0;
        white-space: normal !important;
        overflow-wrap: normal !important;
        word-break: normal !important;
    }

    #shiftScheduleWarning {
        border-radius: 14px;
        line-height: 1.7;
    }

    #shiftsContainer .policy-val.is-invalid,
    #shiftsContainer .policy-desc.is-invalid,
    #bufferTimeHours.is-invalid {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 .16rem rgba(220, 53, 69, .12) !important;
    }

    /* لا يظهر زر اعتماد الفترة كأنه متاح قبل اكتمالها وصحة وقتها. */
    #shiftsContainer .btn-edit:disabled {
        opacity: .38 !important;
        cursor: not-allowed !important;
        pointer-events: none !important;
        filter: grayscale(.35);
    }

    #shiftsContainer .shift-row-validation-hint {
        margin: 6px 4px 0;
        padding: 7px 10px;
        border-radius: 10px;
        background: rgba(220, 53, 69, .07);
        font-size: .84rem;
        font-weight: 700;
        line-height: 1.55;
    }

    /* مساحة منطقية لبطاقة وقت التجهيز على الشاشات الكبيرة. */
    @@media (min-width: 992px) {
        #shiftsSettingsCard .policy-shifts-grid {
            grid-template-columns: minmax(0, 1fr) minmax(330px, 380px) !important;
            align-items: stretch !important;
        }

        #shiftsSettingsCard .policy-buffer-panel {
            width: 100% !important;
            min-width: 330px !important;
            max-width: 380px !important;
            padding: 18px !important;
        }

        #shiftsSettingsCard .policy-buffer-panel h3,
        #shiftsSettingsCard .policy-buffer-panel p,
        #shiftsSettingsCard .policy-buffer-panel small {
            overflow-wrap: normal !important;
            word-break: normal !important;
            white-space: normal !important;
        }
    }

    @@media (max-width: 991.98px) {
        #facilitySettingsPage .policy-shifts-grid,
        #facilitySettingsPage .policy-two-column-grid,
        #facilitySettingsPage .policy-choice-grid,
        #facilitySettingsPage .policy-form-grid {
            grid-template-columns: minmax(0, 1fr) !important;
        }

        #facilitySettingsPage .policy-buffer-panel,
        #facilitySettingsPage .policy-shifts-builder {
            width: 100% !important;
            max-width: 100% !important;
        }

        #facilitySettingsPage .policy-two-column-grid > *,
        #facilitySettingsPage .policy-form-grid > *,
        #facilitySettingsPage .policy-choice-grid > * {
            width: 100%;
            min-width: 0;
        }
    }

    @@media (max-width: 767.98px) {
        #facilitySettingsPage {
            width: 100%;
            overflow-x: hidden;
        }

        #facilitySettingsPage .tab-pane-content {
            padding-inline: 0 !important;
        }

        #facilitySettingsPage .royal-policies-wrapper,
        #facilitySettingsPage .policy-section-stack {
            gap: 12px !important;
        }

        #facilitySettingsPage .royal-card,
        #facilitySettingsPage .policy-card {
            padding: 14px !important;
            border-radius: 18px !important;
        }

        #facilitySettingsPage .policy-card__header,
        #facilitySettingsPage .policy-card__header--compact {
            display: grid !important;
            grid-template-columns: auto minmax(0, 1fr) !important;
            align-items: start !important;
            gap: 10px !important;
        }

        #facilitySettingsPage .policy-card__header h2 {
            font-size: 1.05rem !important;
            line-height: 1.45 !important;
            margin-bottom: 4px !important;
        }

        #facilitySettingsPage .policy-card__header p,
        #facilitySettingsPage .policy-choice-card__copy small,
        #facilitySettingsPage .policy-buffer-panel p,
        #facilitySettingsPage .policy-buffer-panel small {
            font-size: .84rem !important;
            line-height: 1.65 !important;
        }

        #facilitySettingsPage .policy-choice-grid,
        #facilitySettingsPage .policy-form-grid,
        #facilitySettingsPage .policy-two-column-grid,
        #facilitySettingsPage .policy-shifts-grid {
            display: grid !important;
            grid-template-columns: minmax(0, 1fr) !important;
            gap: 10px !important;
        }

        #facilitySettingsPage .policy-choice-card,
        #facilitySettingsPage .royal-radio-card,
        #facilitySettingsPage .policy-field,
        #facilitySettingsPage .policy-number-field,
        #facilitySettingsPage .policy-buffer-panel {
            width: 100% !important;
            min-width: 0 !important;
            max-width: none !important;
        }

        #facilitySettingsPage .policy-choice-card__content,
        #facilitySettingsPage .card-content {
            min-width: 0 !important;
            gap: 10px !important;
            padding: 12px !important;
        }

        #facilitySettingsPage .policy-builder-list {
            width: 100%;
            min-width: 0;
        }

        #facilitySettingsPage .policy-builder-item {
            display: grid !important;
            grid-template-columns: auto minmax(0, 1fr) auto !important;
            gap: 9px !important;
            align-items: center !important;
            width: 100% !important;
            min-width: 0 !important;
            padding: 11px !important;
        }

        #facilitySettingsPage .policy-builder-item > .policy-desc,
        #facilitySettingsPage .policy-builder-item > .policy-shift-time,
        #facilitySettingsPage .policy-builder-item > .input-group:not(.policy-shift-time) {
            grid-column: 2 / -1;
            width: 100% !important;
            min-width: 0 !important;
        }

        #facilitySettingsPage .policy-builder-item__actions,
        #facilitySettingsPage .actions-wrapper {
            grid-column: 1 / -1;
            justify-self: end;
            display: flex !important;
            flex-wrap: wrap;
            gap: 8px !important;
        }

        #facilitySettingsPage .policy-shift-time {
            display: grid !important;
            grid-template-columns: auto minmax(0, 1fr) auto minmax(0, 1fr) !important;
            width: 100% !important;
        }

        #facilitySettingsPage .policy-shift-time .form-control,
        #facilitySettingsPage .policy-shift-time .input-group-text,
        #facilitySettingsPage .input-group .form-control,
        #facilitySettingsPage .input-group .input-group-text {
            min-width: 0 !important;
        }

        #facilitySettingsPage .policy-buffer-panel {
            display: flex !important;
            flex-direction: column !important;
            gap: 12px !important;
            align-items: stretch !important;
            padding: 14px !important;
            text-align: start !important;
        }

        #facilitySettingsPage .policy-buffer-panel__heading {
            grid-template-columns: auto minmax(0, 1fr) !important;
            gap: 9px !important;
        }

        #facilitySettingsPage .policy-buffer-panel__controls,
        #facilitySettingsPage .policy-buffer-panel__example {
            width: 100% !important;
            max-width: none !important;
        }

        #facilitySettingsPage .policy-days-grid {
            display: grid !important;
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
            gap: 8px !important;
        }

        #facilitySettingsPage .policy-day-chip,
        #facilitySettingsPage .policy-day-chip > span {
            width: 100% !important;
            min-width: 0 !important;
        }

        #facilitySettingsPage .policy-save-bar {
            display: flex !important;
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 10px !important;
            padding: 12px !important;
        }

        #facilitySettingsPage .policy-save-bar .btn-royal-save,
        #facilitySettingsPage .btn-royal-add {
            width: 100% !important;
            justify-content: center !important;
        }

        #facilitySettingsPage input,
        #facilitySettingsPage select,
        #facilitySettingsPage textarea,
        #facilitySettingsPage .form-control,
        #facilitySettingsPage .form-select {
            max-width: 100% !important;
        }
    }


    @@media (max-width: 575.98px) {
        #shiftsSettingsCard .policy-buffer-panel h3 {
            font-size: 1rem !important;
        }

        #shiftsSettingsCard .policy-buffer-panel__kicker {
            font-size: .74rem;
        }

        #shiftsSettingsCard .policy-buffer-panel__controls {
