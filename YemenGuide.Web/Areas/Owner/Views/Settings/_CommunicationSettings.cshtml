        width: 100%;
    }

    .communication-settings-v2 .communication-contact-card .policy-field {
        margin: 0;
        padding: 10px 11px;
        border: 1px solid var(--comm-line);
        border-radius: 13px;
        background: #ffffff;
    }

    .communication-settings-v2 .communication-contact-card .policy-field > label {
        margin-bottom: 5px;
        font-size: 0.76rem;
    }

    .communication-settings-v2 .communication-contact-card .form-control {
        min-height: 35px;
        border-color: #dce7ec;
        border-radius: 9px;
        font-size: 0.78rem;
    }

    .communication-settings-v2 .communication-contact-card .policy-field small {
        display: block;
        margin-top: 4px;
        color: var(--comm-muted);
        font-size: 0.65rem;
    }

    .communication-settings-v2 .communication-hidden-settings {
        display: none !important;
    }

    .communication-settings-v2 .communication-save-bar {
        margin-top: 0;
        padding: 9px 11px;
        border: 1px solid #e2ebef;
        border-radius: 11px;
        background: linear-gradient(145deg, #ffffff, #f8fcfe);
        box-shadow: 0 7px 18px rgba(5, 32, 60, 0.04);
    }

    .communication-settings-v2 .communication-save-bar .btn-royal-save {
        min-height: 35px;
        padding-inline: 17px;
        border-radius: 11px;
    }


    @@media (min-width: 992px) {
        .communication-settings-v2 .communication-top-grid {
            align-items: stretch;
        }

        .communication-settings-v2 .communication-top-grid > .communication-card {
            align-self: stretch;
            height: 100%;
        }
    }
    @@media (max-width: 991.98px) {
        .communication-settings-v2 .communication-top-grid {
            grid-template-columns: 1fr;
        }

        .communication-settings-v2 .communication-top-grid .communication-chat-card,
        .communication-settings-v2 .communication-top-grid .communication-contact-card {
            grid-column: 1;
            grid-row: auto;
        }

        .communication-settings-v2 .communication-top-grid .communication-chat-card {
            order: 1;
        }

        .communication-settings-v2 .communication-top-grid .communication-contact-card {
            order: 2;
        }
    }

    @@media (max-width: 767.98px) {
        .communication-settings-v2 {
            gap: 12px;
        }

        .communication-settings-v2 .communication-card {
            border-radius: 15px;
        }

        .communication-settings-v2 .communication-chat-card #chatSettingsContainer,
        .communication-settings-v2 .communication-contact-card .policy-form-grid {
            grid-template-columns: 1fr;
        }

        .communication-settings-v2 .communication-card .policy-card__header {
            gap: 10px;
            padding-bottom: 11px;
        }

        .communication-settings-v2 .communication-card .policy-card__header h2 {
            font-size: 0.94rem;
        }

        .communication-settings-v2 #quickRepliesContainer .policy-toggle-card,
        .communication-settings-v2 .quick-add-slot {
            min-height: 76px;
        }

        .communication-settings-v2 .quick-add-button {
            min-width: 150px;
        }

        .communication-settings-v2 .custom-quick-zone__header {
            align-items: flex-start;
            flex-direction: column;
        }

        .communication-settings-v2 .communication-save-bar {
            gap: 10px;
        }
    }

    @@media (max-width: 575.98px) {
        .communication-settings-v2 #quickRepliesContainer > .col {
            width: 100%;
        }

        .communication-settings-v2 .quick-add-slot {
            min-height: 64px;
        }

        .communication-settings-v2 .quick-add-button {
            width: 100% !important;
            max-width: 230px;
        }

        .communication-settings-v2 #customQuickRepliesContainer .policy-builder-item--reply {
            align-items: stretch;
        }

        .communication-settings-v2 #customQuickRepliesContainer .policy-quick-reply-fields {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            width: 100%;
        }

        .communication-settings-v2 #customQuickRepliesContainer .policy-quick-reply-fields .form-control {
            min-width: 0;
        }
    }
</style>

