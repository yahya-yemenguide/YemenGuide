                                        onclick="
                                                        const track =
                                                            document.getElementById(
                                                                'packagesContainer'
                                                            );

                                                        if (!track) {
                                                            return;
                                                        }

                                                        const cards =
                                                            Array.from(
                                                                track.querySelectorAll(
                                                                    '.package-card'
                                                                )
                                                            );

                                                        if (!cards.length) {
                                                            return;
                                                        }

                                                        let currentIndex =
                                                            Number.parseInt(
                                                                track.dataset.currentIndex || '0',
                                                                10
                                                            ) || 0;

                                                        currentIndex =
                                                            Math.min(
                                                                cards.length - 1,
                                                                currentIndex + 1
                                                            );

                                                        track.dataset.currentIndex =
                                                            String(currentIndex);

                                                        cards[currentIndex]
                                                            .scrollIntoView({
                                                                behavior: 'smooth',
