@{
    ViewData["Title"] = "تواصل معنا";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/customer/contact.css"
          asp-append-version="true" />
}

<main class="yg-contact-page"
      id="ygContactPage">

    <!-- ============================================================= -->
    <!-- 01 — SIGNAL HORIZON HERO                                      -->
    <!-- ============================================================= -->
    <section class="yg-contact-hero"
             aria-labelledby="contactHeroTitle">

        <!-- Visual canvas -->
        <div class="yg-contact-hero-canvas"
             aria-hidden="true">

            <span class="yg-contact-hero-image"></span>
            <span class="yg-contact-hero-shade"></span>

            <span class="yg-contact-topography yg-contact-topography--a"></span>
            <span class="yg-contact-topography yg-contact-topography--b"></span>

            <span class="yg-contact-aurora yg-contact-aurora--cyan"></span>
            <span class="yg-contact-aurora yg-contact-aurora--orange"></span>
            <span class="yg-contact-aurora yg-contact-aurora--micro"></span>

            <span class="yg-contact-star yg-contact-star--01"></span>
            <span class="yg-contact-star yg-contact-star--02"></span>
            <span class="yg-contact-star yg-contact-star--03"></span>
            <span class="yg-contact-star yg-contact-star--04"></span>
            <span class="yg-contact-star yg-contact-star--05"></span>
            <span class="yg-contact-star yg-contact-star--06"></span>
            <span class="yg-contact-star yg-contact-star--07"></span>
            <span class="yg-contact-star yg-contact-star--08"></span>
            <span class="yg-contact-star yg-contact-star--09"></span>
            <span class="yg-contact-star yg-contact-star--10"></span>
            <span class="yg-contact-star yg-contact-star--11"></span>
            <span class="yg-contact-star yg-contact-star--12"></span>

            <span class="yg-contact-dust yg-contact-dust--a"></span>
            <span class="yg-contact-dust yg-contact-dust--b"></span>

            <span class="yg-contact-comet"></span>
            <span class="yg-contact-sweep"></span>
        </div>

        <div class="container yg-contact-hero-container">
            <div class="row align-items-center g-4 g-xl-5">

                <!-- Copy -->
                <div class="col-lg-7">
                    <div class="yg-contact-hero-copy"
                         data-yg-reveal>

                        <span class="yg-contact-status-pill">
                            <span class="yg-contact-live-dot"></span>
                            <i class="bi bi-headset"></i>
                            <span>فريق الدعم جاهز لمساعدتك</span>
                        </span>

                        <div class="yg-contact-kicker">
                            <span></span>
                            <b>YemenGuide Support</b>
                        </div>

                        <h1 id="contactHeroTitle"
                            class="yg-contact-title">
                            نحن على بُعد
                            <span>رسالة</span>
                        </h1>

                        <p class="yg-contact-lead">
                            لديك استفسار، مشكلة في حجز، أو فكرة تحب تشاركنا بها؟
                            نحن هنا لنسمعك ونساعدك بطريقة أسرع وأوضح.
                        </p>

                        <div class="yg-contact-hero-chips"
                             aria-label="أنواع المساعدة">

                            <span>
                                <i class="bi bi-calendar2-check"></i>
                                مساعدة في الحجز
                            </span>

                            <span>
                                <i class="bi bi-building-add"></i>
                                إضافة منشأة
                            </span>

                            <span>
                                <i class="bi bi-lightbulb"></i>
                                استفسار أو اقتراح
                            </span>

                        </div>

                    </div>
                </div>

                <!-- Signal Orb -->
                <div class="col-lg-5">
                    <div class="yg-contact-signal-stage"
                         id="ygContactSignalStage"
                         data-yg-reveal
                         aria-hidden="true">

                        <div class="yg-contact-signal-orb">

                            <span class="yg-signal-glow"></span>

                            <span class="yg-signal-ring yg-signal-ring--outer"></span>
                            <span class="yg-signal-ring yg-signal-ring--middle"></span>
                            <span class="yg-signal-ring yg-signal-ring--inner"></span>

                            <span class="yg-signal-node yg-signal-node--phone">
                                <i class="bi bi-telephone-fill"></i>
                            </span>

                            <span class="yg-signal-node yg-signal-node--mail">
                                <i class="bi bi-envelope-fill"></i>
                            </span>

                            <span class="yg-signal-node yg-signal-node--location">
                                <i class="bi bi-geo-alt-fill"></i>
                            </span>

                            <div class="yg-signal-core">
                                <span class="yg-signal-core-halo"></span>

                                <span class="yg-signal-core-icon">
                                    <i class="bi bi-headset"></i>
                                </span>

                                <strong>معك دائمًا</strong>
                                <small>Contact Signal</small>
                            </div>

                            <span class="yg-signal-spark yg-signal-spark--a"></span>
                            <span class="yg-signal-spark yg-signal-spark--b"></span>
                            <span class="yg-signal-spark yg-signal-spark--c"></span>

                        </div>

                        <div class="yg-contact-signal-caption">
                            <span class="yg-signal-caption-dot"></span>
                            قناة التواصل مفتوحة
                        </div>

                    </div>
                </div>

            </div>
        </div>

        <div class="yg-contact-hero-edge"
             aria-hidden="true"></div>

    </section>


    <!-- ============================================================= -->
    <!-- 02 — CONTACT COMMAND DECK                                     -->
    <!-- ============================================================= -->
    <section class="yg-contact-content">

        <div class="container yg-contact-content-container">

            <div class="yg-contact-command-deck"
                 data-yg-reveal>

                <span class="yg-command-deck-glow"
                      aria-hidden="true"></span>

                <div class="row g-0">

                    <!-- ================================================= -->
                    <!-- CONTACT CHANNELS                                  -->
                    <!-- ================================================= -->
                    <div class="col-lg-4">

                        <aside class="yg-contact-channels">

                            <div class="yg-section-heading">

                                <span class="yg-section-heading-icon">
                                    <i class="bi bi-broadcast-pin"></i>
                                </span>

                                <div>
                                    <span class="yg-section-kicker">
                                        قنوات التواصل
                                    </span>

                                    <h2>
                                        يسعدنا الاستماع إليك
                                    </h2>
                                </div>

                            </div>

                            <p class="yg-channels-intro">
                                سواء كان لديك استفسار عن حجز، أو واجهت مشكلة،
                                أو ترغب في إضافة منشأتك إلى دليلك اليمني،
                                فريقنا جاهز لخدمتك.
                            </p>


                            <div class="yg-contact-rails">

                                <article class="yg-contact-rail">
                                    <span class="yg-rail-icon">
                                        <i class="bi bi-geo-alt-fill"></i>
                                    </span>

                                    <div class="yg-rail-copy">
                                        <small>موقعنا</small>
                                        <strong>صنعاء، شارع الستين الجنوبي</strong>
                                    </div>

                                    <span class="yg-rail-signal"
                                          aria-hidden="true"></span>
                                </article>


                                <article class="yg-contact-rail is-orange">
                                    <span class="yg-rail-icon">
                                        <i class="bi bi-telephone-fill"></i>
                                    </span>

                                    <div class="yg-rail-copy">
                                        <small>رقم الهاتف</small>
                                        <strong dir="ltr">
                                            +967 777 000 000
                                        </strong>
                                    </div>

                                    <span class="yg-rail-signal"
                                          aria-hidden="true"></span>
                                </article>


                                <article class="yg-contact-rail">
                                    <span class="yg-rail-icon">
                                        <i class="bi bi-envelope-fill"></i>
                                    </span>

                                    <div class="yg-rail-copy">
                                        <small>البريد الإلكتروني</small>
                                        <strong>
                                            info@yemenguide.com
                                        </strong>
                                    </div>

                                    <span class="yg-rail-signal"
                                          aria-hidden="true"></span>
                                </article>

                            </div>


                            <div class="yg-contact-mini-note">
                                <i class="bi bi-stars"></i>

                                <span>
                                    كل رسالة تهمنا، وسنعمل على توجيهها
                                    إلى الجهة المناسبة.
                                </span>
                            </div>

                        </aside>

                    </div>


                    <!-- ================================================= -->
                    <!-- MESSAGE COMPOSER                                  -->
                    <!-- ================================================= -->
                    <div class="col-lg-8">

                        <section class="yg-message-composer">

                            <div class="yg-composer-header">

                                <div class="yg-composer-title-group">

                                    <span class="yg-composer-icon">
                                        <i class="bi bi-chat-square-dots-fill"></i>
                                    </span>

                                    <div>
                                        <span class="yg-section-kicker">
                                            Message Composer
                                        </span>

                                        <h2>
                                            أرسل لنا رسالة
                                        </h2>
                                    </div>

                                </div>

                                <span class="yg-composer-status">
                                    <span></span>
                                    متاحون لاستقبال رسالتك
                                </span>

                            </div>


                            <!-- Design-only form for now.
                                 Backend wiring intentionally postponed. -->
                            <form id="contactForm"
                                  action="#"
                                  method="post"
                                  class="yg-contact-form"
                                  data-design-only="true">

                                <div class="row g-3 g-md-4">

                                    <div class="col-md-6">
                                        <div class="yg-field">

                                            <label for="SenderName">
                                                الاسم الكامل
                                            </label>

                                            <div class="yg-field-shell">

                                                <span class="yg-field-icon">
                                                    <i class="bi bi-person"></i>
                                                </span>

                                                <input type="text"
                                                       id="SenderName"
                                                       class="form-control"
                                                       placeholder="أدخل اسمك هنا..."
                                                       autocomplete="name"
                                                       required>

                                                <span class="yg-field-focus-line"
                                                      aria-hidden="true"></span>

                                            </div>

                                        </div>
                                    </div>


                                    <div class="col-md-6">
                                        <div class="yg-field">

                                            <label for="ContactInfo">
                                                رقم الهاتف / الإيميل
                                            </label>

                                            <div class="yg-field-shell">

                                                <span class="yg-field-icon">
                                                    <i class="bi bi-at"></i>
                                                </span>

                                                <input type="text"
                                                       id="ContactInfo"
                                                       class="form-control"
                                                       placeholder="طريقة التواصل معك..."
                                                       autocomplete="email"
                                                       required>

                                                <span class="yg-field-focus-line"
                                                      aria-hidden="true"></span>

                                            </div>

                                        </div>
                                    </div>


                                    <div class="col-12">
                                        <div class="yg-field">

                                            <label for="Subject">
                                                موضوع الرسالة
                                            </label>

                                            <div class="yg-field-shell yg-field-shell--select">

                                                <span class="yg-field-icon">
                                                    <i class="bi bi-grid"></i>
                                                </span>

                                                <select id="Subject"
                                                        class="form-select">

                                                    <option>استفسار عام</option>
                                                    <option>مشكلة في الحجز</option>
                                                    <option>طلب إضافة منشأة</option>
                                                    <option>شكوى أو اقتراح</option>

                                                </select>

                                                <span class="yg-field-focus-line"
                                                      aria-hidden="true"></span>

                                            </div>

                                        </div>
                                    </div>


                                    <div class="col-12">
                                        <div class="yg-field">

                                            <div class="yg-field-label-row">
                                                <label for="MessageBody">
                                                    نص الرسالة
                                                </label>

                                                <span class="yg-message-counter"
                                                      id="ygMessageCounter">
                                                    0 حرف
                                                </span>
                                            </div>

                                            <div class="yg-field-shell yg-field-shell--textarea">

                                                <span class="yg-field-icon">
                                                    <i class="bi bi-pencil-square"></i>
                                                </span>

                                                <textarea id="MessageBody"
                                                          class="form-control"
                                                          rows="5"
                                                          maxlength="700"
                                                          placeholder="اكتب تفاصيل رسالتك هنا بوضوح..."
                                                          required></textarea>

                                                <span class="yg-field-focus-line"
                                                      aria-hidden="true"></span>

                                            </div>

                                        </div>
                                    </div>


                                    <div class="col-12">

                                        <div class="yg-composer-footer">

                                            <div class="yg-composer-hint">
                                                <i class="bi bi-lock"></i>
                                                <span>
                                                    بياناتك تستخدم فقط للتواصل معك
                                                    بخصوص رسالتك.
                                                </span>
                                            </div>

                                            <button type="submit"
                                                    id="btnSubmitContact"
                                                    class="yg-contact-submit">

                                                <span class="yg-submit-icon">
                                                    <i class="bi bi-send-fill"></i>
                                                </span>

                                                <span class="yg-submit-copy">
                                                    <small>جاهز للإرسال</small>
                                                    <strong>إرسال الرسالة</strong>
                                                </span>

                                                <span class="yg-submit-arrow">
                                                    <i class="bi bi-arrow-up-left"></i>
                                                </span>

                                                <span class="yg-submit-shine"
                                                      aria-hidden="true"></span>

                                            </button>

                                        </div>

                                    </div>

                                </div>

                            </form>


                            <div class="yg-design-only-note"
                                 id="ygDesignOnlyNote"
                                 role="status"
                                 aria-live="polite">

                                <i class="bi bi-code-slash"></i>
                                <span>
                                    واجهة الإرسال جاهزة بصريًا — الربط البرمجي
                                    سيتم إضافته لاحقًا.
                                </span>

                            </div>

                        </section>

                    </div>

                </div>

            </div>

        </div>

    </section>

</main>


@section Scripts {
    <script src="~/js/customer/contact.js"
            asp-append-version="true"></script>
}
