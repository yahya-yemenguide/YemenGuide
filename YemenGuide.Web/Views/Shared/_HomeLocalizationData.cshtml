    if (homeLanguage == "en")
    {
        void AddPlatformTranslation(
            string? arabicValue,
            string? englishValue)
        {
            var ar = arabicValue?.Trim();
            var en = englishValue?.Trim();

            if (!string.IsNullOrWhiteSpace(ar) &&
                !string.IsNullOrWhiteSpace(en))
            {
                exact[ar] = en;
            }
        }

        var bilingualSettings =
            await _context.SystemSettings
                .AsNoTracking()
                .OrderBy(setting => setting.Id)
                .Select(setting => new
                {
                    setting.SiteName,
                    setting.SiteNameEn,
                    setting.SiteDescription,
                    setting.SiteDescriptionEn,
                    setting.HeroTitleMain,
                    setting.HeroTitleMainEn,
                    setting.HeroTitleSub,
                    setting.HeroTitleSubEn,
                    setting.BannerText,
                    setting.BannerTextEn
                })
                .FirstOrDefaultAsync();

        if (bilingualSettings != null)
        {
            AddPlatformTranslation(
                bilingualSettings.SiteName,
                bilingualSettings.SiteNameEn);

            AddPlatformTranslation(
                bilingualSettings.SiteDescription,
                bilingualSettings.SiteDescriptionEn);

            AddPlatformTranslation(
                bilingualSettings.HeroTitleMain,
                bilingualSettings.HeroTitleMainEn);

            AddPlatformTranslation(
                bilingualSettings.HeroTitleSub,
                bilingualSettings.HeroTitleSubEn);

            AddPlatformTranslation(
                bilingualSettings.BannerText,
                bilingualSettings.BannerTextEn);
        }

        var bilingualHeroSlides =
            await _context.HeroSlides
                .AsNoTracking()
                .Where(slide => slide.IsActive == true)
                .Select(slide => new
                {
                    slide.TypingText,
                    slide.TypingTextEn
                })
                .ToListAsync();

        foreach (var slide in bilingualHeroSlides)
        {
            AddPlatformTranslation(
                slide.TypingText,
                slide.TypingTextEn);
        }

        var bilingualCategories =
            await _context.Categories
                .AsNoTracking()
                .Select(category => new
                {
                    category.CategoryName,
                    category.CategoryNameEn
                })
                .ToListAsync();

        foreach (var category in bilingualCategories)
        {
            AddPlatformTranslation(
                category.CategoryName,
                category.CategoryNameEn);
        }

        var bilingualCities =
            await _context.Cities
                .AsNoTracking()
                .Select(city => new
                {
                    city.CityName,
                    city.CityNameEn
                })
                .ToListAsync();

        foreach (var city in bilingualCities)
        {
            AddPlatformTranslation(
                city.CityName,
                city.CityNameEn);
        }
    }

