@model YemenGuide.Core.Entities.Category

@{
    var defaultColor = "#00A6DA";
    var defaultIcon = "bi-building";
}

<div class="offcanvas offcanvas-end entity-offcanvas category-entity-offcanvas"
     tabindex="-1"
     id="addCategoryOffcanvas"
     aria-labelledby="addCategoryLabel"
     data-bs-backdrop="true"
     data-bs-scroll="false">

    <div class="entity-sheet-handle" aria-hidden="true"><span></span></div>

    <div class="offcanvas-header entity-offcanvas-header">
        <div class="entity-offcanvas-heading">
            <div class="entity-heading-icon"><i class="bi bi-tags-fill"></i></div>
            <div class="entity-heading-text">
                <div class="entity-heading-kicker">إدارة الفئات</div>
                <h5 class="offcanvas-title" id="addCategoryLabel">إضافة فئة جديدة</h5>
                <small class="entity-heading-description">
                    أنشئ هوية الفئة واضبط نظام الحجز وصلاحية إضافة المنشآت من مكان واحد.
                </small>
            </div>
        </div>

        <button type="button"
                class="btn-close btn-close-white entity-offcanvas-close"
                data-bs-dismiss="offcanvas"
                aria-label="إغلاق"></button>
    </div>

    <div class="offcanvas-body entity-offcanvas-body p-0">
        <form id="addCategoryForm" class="entity-offcanvas-form" autocomplete="off">
            <input type="hidden" id="categoryId" value="0" />

            <div class="entity-form-scroll">

                <section class="preview-card category-preview-card" aria-label="معاينة الفئة">
                    <div class="preview-card-glow preview-card-glow--one"></div>
                    <div class="preview-card-glow preview-card-glow--two"></div>

                    <div class="preview-card-content">
                        <div class="preview-card-label">
                            <i class="bi bi-stars"></i>
                            معاينة مباشرة
                        </div>

                        <div class="category-preview-main">
                            <div class="preview-icon category-preview-icon">
                                <i id="previewCategoryIcon"
                                   class="bi @defaultIcon"
                                   style="color:@defaultColor"></i>
                            </div>

                            <div class="category-preview-copy">
                                <h5 id="previewCategoryName" class="category-preview-name">فئة جديدة</h5>
                                <p id="previewCategoryBooking" class="category-preview-booking">بدون حجز</p>
                            </div>
                        </div>

                        <div class="category-preview-footer">
                            <span id="previewCategoryAccess"
                                  class="preview-access-badge preview-access-badge--open">
                                <i class="bi bi-people-fill"></i>
                                المالك والإدارة
                            </span>

                            <span class="preview-system-badge">
                                <i class="bi bi-shield-check"></i>
                                إعداد نظامي
                            </span>
                        </div>
                    </div>
                </section>

                <section class="entity-form-section">
                    <div class="entity-section-heading">
                        <div class="entity-section-number">01</div>
                        <div class="entity-section-icon">
                            <i class="bi bi-info-circle-fill"></i>
                        </div>
                        <div class="entity-section-heading-text">
                            <h6 class="entity-section-title">المعلومات الأساسية</h6>
                            <p class="entity-section-description">
                                اكتب اسمًا واضحًا ومميزًا يظهر للمستخدمين.
                            </p>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="entity-field-group h-100">
                                <label class="entity-field-label" for="categoryNameInput">
                                    <span>اسم الفئة بالعربية</span>
                                    <span class="entity-required-mark">*</span>
                                </label>

                                <div class="entity-input-group">
                                    <span class="entity-input-icon">
                                        <i class="bi bi-tag-fill"></i>
                                    </span>

                                    <input type="text"
                                           class="form-control category-name-input"
                                           id="categoryNameInput"
                                           name="CategoryName"
                                           placeholder="مثال: مطاعم"
                                           maxlength="50"
                                           required />
                                </div>

                                <small class="entity-field-help">
                                    <i class="bi bi-lightbulb"></i>
                                    الاسم الذي يظهر عند استخدام العربية.
                                </small>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="entity-field-group h-100">
                                <label class="entity-field-label" for="categoryNameEnInput">
                                    <span>اسم الفئة بالإنجليزية</span>
                                    <span class="entity-required-mark">*</span>
                                </label>

                                <div class="entity-input-group" dir="ltr">
                                    <span class="entity-input-icon">
                                        <i class="bi bi-translate"></i>
                                    </span>

                                    <input type="text"
                                           class="form-control category-name-en-input"
                                           id="categoryNameEnInput"
                                           name="CategoryNameEn"
                                           placeholder="e.g. Restaurants"
                                           maxlength="150"
                                           dir="ltr"
                                           required />
                                </div>

                                <small class="entity-field-help">
                                    <i class="bi bi-globe2"></i>
                                    الاسم الذي يظهر عند استخدام English.
                                </small>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="entity-form-section entity-form-section--identity">
                    <div class="entity-section-heading">
                        <div class="entity-section-number">02</div>
                        <div class="entity-section-icon">
                            <i class="bi bi-palette-fill"></i>
                        </div>
                        <div class="entity-section-heading-text">
                            <h6 class="entity-section-title">الهوية البصرية</h6>
                            <p class="entity-section-description">
                                اختر لونًا وأيقونة تعبّران عن نوع الفئة.
                            </p>
                        </div>
                    </div>

                    <div class="entity-field-group">
                        <label class="entity-field-label" for="categoryColorPicker">لون الفئة</label>

                        <div class="category-color-panel">
                            <label class="category-color-selector"
                                   for="categoryColorPicker"
                                   title="اختيار اللون">
                                <input type="color"
                                       class="category-color-picker"
                                       id="categoryColorPicker"
                                       name="ThemeColor"
                                       value="@defaultColor" />
                                <span class="category-color-selector-icon">
                                    <i class="bi bi-eyedropper"></i>
                                </span>
                            </label>

                            <div class="category-color-details">
                                <span class="category-color-caption">اللون المختار</span>
                                <strong class="category-color-hex" dir="ltr">@defaultColor</strong>
                            </div>

                            <span class="category-color-status">
                                <i class="bi bi-check-circle-fill"></i>
                            </span>
                        </div>
                    </div>

                    <div class="entity-field-group">
                        <div class="entity-field-label entity-field-label--with-note">
                            <span>أيقونة الفئة</span>
                            <small>
                                <i class="bi bi-stars"></i>
                                الاقتراح الذكي لا يخفي بقية الأيقونات
                            </small>
                        </div>

                        <div class="icon-picker-container category-icon-picker">
                            <div class="category-icon-search-group">
                                <span><i class="bi bi-search"></i></span>

                                <input type="search"
                                       class="form-control category-icon-search"
                                       id="categoryIconSearch"
                                       placeholder="اكتب مطعم، فندق، مستشفى، شاليه..." />

                                <span class="category-icon-search-hint"
                                      title="اقتراح ذكي">
                                    <i class="bi bi-stars"></i>
                                </span>
                            </div>

                            <div class="smart-icon-status" id="smartIconStatus" aria-live="polite">
                                <span class="smart-icon-status__icon">
                                    <i class="bi bi-magic"></i>
                                </span>
                                <span>
                                    اكتب اسم الفئة وسيتم تمييز الأيقونات الأنسب مع إبقاء جميع الأيقونات ظاهرة.
                                </span>
                            </div>

                            <div class="category-icon-grid icon-grid"
                                 role="listbox"
                                 aria-label="أيقونات الفئات"></div>

                            <div class="icon-picker-footer">
                                <i class="bi bi-lightbulb-fill"></i>
                                يمكنك قبول الاقتراح أو اختيار أيقونة أخرى يدويًا في أي وقت.
                            </div>
                        </div>
                    </div>
                </section>

                <section class="entity-form-section">
                    <div class="entity-section-heading">
                        <div class="entity-section-number">03</div>
                        <div class="entity-section-icon">
                            <i class="bi bi-image-fill"></i>
                        </div>
                        <div class="entity-section-heading-text">
                            <h6 class="entity-section-title">صورة الفئة</h6>
                            <p class="entity-section-description">
                                صورة أفقية واضحة تستخدم في بطاقات الفئة.
                            </p>
                        </div>
                    </div>

                    <div class="entity-field-group">
                        <label class="entity-field-label" for="categoryImageInput">
                            صورة الخلفية
                            <span class="entity-required-note">مطلوبة عند الإضافة</span>
                        </label>

                        <label class="category-upload-wrapper" for="categoryImageInput">
                            <div class="category-upload-visual">
                                <span class="category-upload-icon">
                                    <i class="bi bi-cloud-arrow-up-fill"></i>
                                </span>

                                <div class="category-upload-copy">
                                    <strong class="category-upload-title">اختر صورة للفئة</strong>
                                    <span class="category-upload-description">
                                        JPG / PNG / WEBP — يفضّل مقاس أفقي وجودة عالية
                                    </span>
                                </div>
                            </div>

                            <div class="category-upload-preview"
                                 id="categoryImagePreview"
                                 hidden>
                                <img id="categoryImagePreviewImg" alt="معاينة صورة الفئة" />
                                <span class="category-upload-preview__overlay">
                                    <i class="bi bi-arrow-repeat"></i>
                                    تغيير الصورة
                                </span>
                            </div>

                            <input type="file"
                                   id="categoryImageInput"
                                   name="imageFile"
                                   accept="image/*"
                                   hidden />
                        </label>

                        <small class="entity-field-help">
                            <i class="bi bi-info-circle"></i>
                            عند تعديل فئة موجودة يمكنك إبقاء الصورة الحالية دون رفع صورة جديدة.
                        </small>
                    </div>
                </section>

                <section class="entity-form-section booking-system-section">
                    <div class="entity-section-heading">
                        <div class="entity-section-number">04</div>
                        <div class="entity-section-icon"><i class="bi bi-calendar2-check-fill"></i></div>
                        <div class="entity-section-heading-text">
                            <h6 class="entity-section-title">نظام الحجز</h6>
                            <p class="entity-section-description">
                                اختر نوع الحجز مباشرة من البطاقات التالية.
                            </p>
                        </div>
                    </div>

                    <div class="entity-field-group">
                        <label class="entity-field-label" for="bookingSystemId">نوع نظام الحجز</label>

                        <div class="premium-booking-select-wrapper booking-select-hidden-ui">
                            <span class="premium-booking-select-icon"><i class="bi bi-calendar-week-fill"></i></span>
                            <select class="form-select premium-booking-select"
                                    id="bookingSystemId"
                                    name="BookingSystemId">
                                <option value="0">بدون حجز — معلومات المنشأة فقط</option>
                                <option value="1">الغرف والأيام — فنادق وشقق وسكن</option>
                                <option value="2">الباقات والفترات — شاليهات واستراحات</option>
                                <option value="3">المناسبات والقاعات — قاعات وحفلات</option>
                            </select>
                            <span class="premium-booking-select-arrow"><i class="bi bi-chevron-down"></i></span>
                        </div>

                        <div class="booking-system-help booking-system-help--clickable"
                             role="radiogroup"
                             aria-label="نوع نظام الحجز">
                            <div class="booking-help-item"
                                 data-booking-help="0"
                                 role="radio"
                                 tabindex="0"
                                 aria-checked="true">
                                <span>0</span>
                                <p>
                                    <strong>بدون حجز</strong>
                                    للمعالم والمطاعم والخدمات العامة.
                                </p>
                            </div>

                            <div class="booking-help-item"
                                 data-booking-help="1"
                                 role="radio"
                                 tabindex="0"
                                 aria-checked="false">
                                <span>1</span>
                                <p>
                                    <strong>غرف وأيام</strong>
                                    حسب الوصول والمغادرة.
                                </p>
                            </div>

                            <div class="booking-help-item"
                                 data-booking-help="2"
                                 role="radio"
                                 tabindex="0"
                                 aria-checked="false">
                                <span>2</span>
                                <p>
                                    <strong>باقات وفترات</strong>
                                    صباحية أو مسائية أو مخصصة.
                                </p>
                            </div>

                            <div class="booking-help-item"
                                 data-booking-help="3"
                                 role="radio"
                                 tabindex="0"
                                 aria-checked="false">
                                <span>3</span>
                                <p>
                                    <strong>قاعات ومناسبات</strong>
                                    حسب التاريخ والوقت.
                                </p>
                            </div>
                        </div>

                        <small class="entity-field-help booking-choice-help">
                            <i class="bi bi-check2-circle"></i>
                            البطاقة المحددة هي التي سيتم حفظها كنظام حجز للفئة.
                        </small>
                    </div>
                </section>

                <section class="entity-form-section category-access-section">
                    <div class="entity-section-heading">
                        <div class="entity-section-number">05</div>
                        <div class="entity-section-icon entity-section-icon--coral">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>

                        <div class="entity-section-heading-text">
                            <h6 class="entity-section-title">صلاحية إضافة المنشآت</h6>
                            <p class="entity-section-description">
                                حدد من يحق له إنشاء منشآت جديدة تحت هذه الفئة.
                            </p>
                        </div>
                    </div>

                    <div class="category-access-options"
                         role="radiogroup"
                         aria-label="صلاحية إضافة المنشآت">

                        <label class="category-access-card is-selected" data-access-card="true">
                            <input type="radio"
                                   name="OwnerCanAddPlacesChoice"
                                   value="true"
                                   checked />

                            <span class="category-access-card__check">
                                <i class="bi bi-check-lg"></i>
                            </span>

                            <span class="category-access-card__icon category-access-card__icon--open">
                                <i class="bi bi-people-fill"></i>
                            </span>

                            <span class="category-access-card__copy">
                                <strong>المالك والإدارة</strong>
                                <small>
                                    تظهر الفئة للمالك ويمكنه إضافة منشآت جديدة ضمنها.
                                </small>
                            </span>

                            <span class="category-access-card__status category-access-card__status--open">
                                مفتوحة
                            </span>
                        </label>

                        <label class="category-access-card" data-access-card="false">
                            <input type="radio"
                                   name="OwnerCanAddPlacesChoice"
                                   value="false" />

                            <span class="category-access-card__check">
                                <i class="bi bi-check-lg"></i>
                            </span>

                            <span class="category-access-card__icon category-access-card__icon--locked">
                                <i class="bi bi-lock-fill"></i>
                            </span>

                            <span class="category-access-card__copy">
                                <strong>الإدارة فقط</strong>
                                <small>
                                    مناسبة للمعالم الأثرية والجهات والمواقع الحكومية والعامة.
                                </small>
                            </span>

                            <span class="category-access-card__status category-access-card__status--locked">
                                مقيدة
                            </span>
                        </label>
                    </div>

                    <div class="category-access-note">
                        <i class="bi bi-shield-check"></i>
                        <div>
                            <strong>القيد سيطبق على إضافة المنشآت</strong>
                            <span>
                                اختيار «الإدارة فقط» يعني أن المالك لن يتمكن من إنشاء منشآت جديدة داخل هذه الفئة بعد تفعيل حماية المالك.
                            </span>
                        </div>
                    </div>
                </section>
            </div>

            <div class="entity-form-footer">
                <div class="entity-footer-security">
                    <i class="bi bi-shield-check"></i>
                    <div>
                        <strong>حفظ آمن</strong>
                        <span>سيتم تطبيق الإعدادات على الفئة فورًا.</span>
                    </div>
                </div>

                <button type="submit"
                        class="btn-save-entity btn-save-category"
                        id="saveCategoryBtn">
                    <span class="btn-save-entity-icon">
                        <i class="bi bi-floppy-fill"></i>
                    </span>
                    <span class="btn-save-entity-text">حفظ الفئة</span>
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    /*
       تحسين آمن للمودلين:
       - لا يغيّر بنية الأقسام أو ارتفاعاتها
       - لا يستخدم media داخل Razor
       - يحافظ على خط Tajawal المحلي المشترك
    */
    #addCategoryOffcanvas,
    #addCityOffcanvas {
        font-family: var(--yg-font-family) !important;
    }

    #addCategoryOffcanvas :where(h1,h2,h3,h4,h5,h6,p,small,strong,b,span,label,button,input,select,textarea),
    #addCityOffcanvas :where(h1,h2,h3,h4,h5,h6,p,small,strong,b,span,label,button,input,select,textarea) {
        font-family: var(--yg-font-family) !important;
    }

    #addCategoryOffcanvas .bi,
    #addCategoryOffcanvas [class^="bi-"],
    #addCategoryOffcanvas [class*=" bi-"],
    #addCityOffcanvas .bi,
    #addCityOffcanvas [class^="bi-"],
    #addCityOffcanvas [class*=" bi-"] {
        font-family: "bootstrap-icons" !important;
    }

    #addCategoryOffcanvas .entity-heading-text .offcanvas-title,
    #addCityOffcanvas .entity-heading-text .offcanvas-title {
        font-size: 1.24rem !important;
        font-weight: 900 !important;
        line-height: 1.4 !important;
    }

    #addCategoryOffcanvas .entity-heading-description,
    #addCityOffcanvas .entity-heading-description {
        font-size: .79rem !important;
        font-weight: 600 !important;
        line-height: 1.65 !important;
    }

    #addCategoryOffcanvas .preview-card,
    #addCityOffcanvas .preview-card {
        border-color: rgba(0,166,218,.13) !important;
        box-shadow: 0 14px 34px rgba(5,32,60,.07) !important;
    }

    #addCategoryOffcanvas .category-preview-name,
    #addCityOffcanvas .city-preview-name {
        font-size: 1.08rem !important;
        font-weight: 900 !important;
    }

    #addCategoryOffcanvas .category-preview-booking,
    #addCityOffcanvas .city-preview-hint {
        font-size: .74rem !important;
        line-height: 1.6 !important;
    }

    #addCategoryOffcanvas .entity-form-section,
    #addCityOffcanvas .entity-form-section {
        border-color: rgba(5,32,60,.085) !important;
        box-shadow: 0 9px 26px rgba(5,32,60,.05) !important;
    }

    #addCategoryOffcanvas .entity-section-title,
    #addCityOffcanvas .entity-section-title {
        font-size: .96rem !important;
        font-weight: 900 !important;
        line-height: 1.45 !important;
    }

    #addCategoryOffcanvas .entity-section-description,
    #addCityOffcanvas .entity-section-description {
        font-size: .73rem !important;
        font-weight: 600 !important;
        line-height: 1.6 !important;
    }

    #addCategoryOffcanvas .entity-field-label,
    #addCityOffcanvas .entity-field-label {
        font-size: .81rem !important;
        font-weight: 900 !important;
    }

    #addCategoryOffcanvas .entity-input-group .form-control,
    #addCityOffcanvas .entity-input-group .form-control {
        font-size: .86rem !important;
        font-weight: 700 !important;
    }

    #addCategoryOffcanvas .entity-field-help,
    #addCityOffcanvas .entity-field-help {
        font-size: .67rem !important;
        line-height: 1.6 !important;
    }

    #addCategoryOffcanvas .category-color-caption,
    #addCityOffcanvas .city-color-caption {
        font-size: .66rem !important;
    }

    #addCategoryOffcanvas .category-color-hex,
    #addCityOffcanvas .city-color-hex {
        font-size: .82rem !important;
        font-weight: 900 !important;
    }

    #addCategoryOffcanvas .category-upload-title {
        font-size: .79rem !important;
        font-weight: 900 !important;
    }

    #addCategoryOffcanvas .category-upload-description {
        font-size: .65rem !important;
        line-height: 1.55 !important;
    }

    /* لا نعرض القائمة المنسدلة لأنها تكرر نفس الأربع خيارات */
    #addCategoryOffcanvas .booking-select-hidden-ui {
        display: none !important;
    }

    #addCategoryOffcanvas .booking-system-help--clickable {
        gap: 10px !important;
        margin-top: 0 !important;
    }

    #addCategoryOffcanvas .booking-system-help--clickable .booking-help-item {
        min-height: 78px !important;
        padding: 12px !important;
        border: 1.5px solid rgba(5,32,60,.085) !important;
        border-radius: 15px !important;
        background: #fafcfe !important;
        cursor: pointer;
        outline: none;
        transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease, background .18s ease;
    }

    #addCategoryOffcanvas .booking-system-help--clickable .booking-help-item:hover {
        transform: translateY(-2px);
        border-color: rgba(0,166,218,.28) !important;
        background: #fff !important;
        box-shadow: 0 9px 22px rgba(5,32,60,.07);
    }

    #addCategoryOffcanvas .booking-system-help--clickable .booking-help-item:focus-visible {
        border-color: var(--me-cyan) !important;
        box-shadow: 0 0 0 4px rgba(0,166,218,.09);
    }

    #addCategoryOffcanvas .booking-system-help--clickable .booking-help-item > span {
        width: 34px !important;
        height: 34px !important;
        flex: 0 0 34px !important;
        border-radius: 10px !important;
        font-size: .68rem !important;
    }

    #addCategoryOffcanvas .booking-system-help--clickable .booking-help-item p {
        font-size: .72rem !important;
        line-height: 1.55 !important;
    }

    #addCategoryOffcanvas .booking-system-help--clickable .booking-help-item strong {
        margin-bottom: 3px !important;
        font-size: .8rem !important;
        font-weight: 900 !important;
    }

    #addCategoryOffcanvas .booking-system-help--clickable .booking-help-item.is-active {
        border-color: var(--me-cyan) !important;
        background: linear-gradient(145deg, rgba(0,166,218,.08), #fff) !important;
        box-shadow: 0 0 0 3px rgba(0,166,218,.07), 0 10px 24px rgba(0,166,218,.08) !important;
    }

    #addCategoryOffcanvas .booking-choice-help {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 10px !important;
        color: #4f7565 !important;
    }

    #addCategoryOffcanvas .icon-picker-container {
        border-color: rgba(5,32,60,.085) !important;
        box-shadow: 0 7px 20px rgba(5,32,60,.035);
    }

    #addCategoryOffcanvas .category-icon-search {
        font-size: .79rem !important;
    }

    #addCategoryOffcanvas .icon-item {
        position: relative;
        transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease, background .16s ease !important;
    }

    #addCategoryOffcanvas .icon-item.is-smart-match:not(.active) {
        border-color: rgba(0,166,218,.38) !important;
        background: rgba(0,166,218,.055) !important;
        color: #078fbe !important;
        box-shadow: 0 0 0 3px rgba(0,166,218,.045);
    }

    #addCategoryOffcanvas .icon-item.is-smart-best:not(.active)::before {
        content: "★";
        position: absolute;
        top: 3px;
        inset-inline-end: 5px;
        color: #f59e0b;
        font-size: .52rem;
        line-height: 1;
    }

    #addCategoryOffcanvas .category-access-card__copy strong {
        font-size: .77rem !important;
    }

    #addCategoryOffcanvas .category-access-card__copy small {
        font-size: .62rem !important;
        line-height: 1.6 !important;
    }

    #addCityOffcanvas .city-guidance-title {
        font-size: .8rem !important;
        font-weight: 900 !important;
    }

    #addCityOffcanvas .city-guidance-text {
        font-size: .68rem !important;
        line-height: 1.65 !important;
    }

    #addCategoryOffcanvas .btn-save-entity,
    #addCityOffcanvas .btn-save-entity {
        font-size: .82rem !important;
        font-weight: 900 !important;
        box-shadow: 0 10px 24px rgba(0,166,218,.18) !important;
    }

    body.dark-mode #addCategoryOffcanvas .booking-system-help--clickable .booking-help-item {
        background: #20212d !important;
        border-color: rgba(255,255,255,.08) !important;
    }

    body.dark-mode #addCategoryOffcanvas .booking-system-help--clickable .booking-help-item.is-active {
        background: rgba(0,166,218,.09) !important;
        border-color: var(--me-cyan) !important;
    }
</style>

<script>
    /*
       هذا السكربت يُثبت بعد اكتمال تحميل الصفحة،
       لذلك يترك master-entities.js الأصلي يعمل أولًا ثم يضيف المطلوب فقط.
    */
    window.addEventListener('load', function () {
        'use strict';

        const form = document.getElementById('addCategoryForm');
        if (!form) return;

        const bookingSelect = document.getElementById('bookingSystemId');
        const bookingCards = Array.from(
            form.querySelectorAll('[data-booking-help]')
        );

        function syncBookingCards() {
            const current = String(bookingSelect?.value ?? '0');

            bookingCards.forEach(card => {
                const active = card.dataset.bookingHelp === current;

                card.classList.toggle('is-active', active);
                card.setAttribute('aria-checked', active ? 'true' : 'false');
            });
        }

        bookingCards.forEach(card => {
            const choose = function () {
                if (!bookingSelect) return;

                bookingSelect.value = card.dataset.bookingHelp || '0';
                bookingSelect.dispatchEvent(
                    new Event('change', { bubbles: true })
                );
                syncBookingCards();
            };

            card.addEventListener('click', choose);
            card.addEventListener('keydown', function (event) {
                if (event.key !== 'Enter' && event.key !== ' ') return;
                event.preventDefault();
                choose();
            });
        });

        bookingSelect?.addEventListener('change', syncBookingCards);
        syncBookingCards();

        const nameInput = form.querySelector('.category-name-input');
        const nameEnInput = form.querySelector('.category-name-en-input');
        const iconSearch = form.querySelector('.category-icon-search');
        const iconGrid = form.querySelector('.category-icon-grid');

        if (!nameInput || !nameEnInput || !iconSearch || !iconGrid || !Array.isArray(window.iconsData)) {
            return;
        }

        let restoringIcons = false;

        function normalize(value) {
            return String(value || '')
                .trim()
                .toLowerCase()
                .replace(/[أإآ]/g, 'ا')
                .replace(/ة/g, 'ه');
        }

        function getSmartTerms() {
            const directSearch = iconSearch.value.trim();

            // البحث اليدوي داخل الأيقونات له الأولوية.
            if (directSearch) {
                return [directSearch];
            }

            // في الوضع العادي نستفيد من الاسمين العربي والإنجليزي معًا.
            return [
                nameInput.value.trim(),
                nameEnInput.value.trim()
            ].filter(Boolean);
        }

        function scoreIconForOneTerm(iconObj, rawTerm) {
            const term = normalize(rawTerm);
            if (!term) return 0;

            let score = normalize(iconObj.class || '').includes(term) ? 40 : 0;

            (iconObj.tags || []).forEach(tagValue => {
                const tag = normalize(tagValue);
                if (!tag) return;

                if (tag === term) score = Math.max(score, 120);
                else if (tag.startsWith(term) || term.startsWith(tag)) score = Math.max(score, 100);
                else if (tag.includes(term) || term.includes(tag)) score = Math.max(score, 80);
            });

            return score;
        }

        function scoreIcon(iconObj, rawTerms) {
            const terms = Array.isArray(rawTerms)
                ? rawTerms
                : [rawTerms];

            return terms.reduce(
                (best, term) => Math.max(best, scoreIconForOneTerm(iconObj, term)),
                0
            );
        }

        function iconClassOf(button) {
            const icon = button.querySelector('i.bi');
            if (!icon) return '';

            return Array.from(icon.classList)
                .find(value => value.startsWith('bi-') && value !== 'bi') || '';
        }

        /*
           نطلب من الـJS الأصلي رسم كل الأيقونات عن طريق بحث فارغ،
           ثم نعيد النص المكتوب ونبرز المقترحات فقط.
           بهذه الطريقة تبقى كل الأيقونات ظاهرة، ويعمل الاقتراح
           من الاسم العربي أو الاسم الإنجليزي أو البحث اليدوي.
        */
        function restoreAllIconsAndHighlight(rawTerms, autoSelectBest) {
            if (restoringIcons) return;

            restoringIcons = true;

            const searchValue = iconSearch.value;
            iconSearch.value = '';
            iconSearch.dispatchEvent(new Event('input', { bubbles: true }));
            iconSearch.value = searchValue;

            restoringIcons = false;

            const buttons = Array.from(
                iconGrid.querySelectorAll('.icon-item')
            );

            buttons.forEach(button => {
                button.classList.remove('is-smart-match', 'is-smart-best');
            });

            const terms = (Array.isArray(rawTerms) ? rawTerms : [rawTerms])
                .map(value => String(value || '').trim())
                .filter(Boolean);

            if (!terms.length) return;

            const ranked = window.iconsData
                .map(item => ({ item, score: scoreIcon(item, terms) }))
                .filter(result => result.score > 0)
                .sort((a, b) => b.score - a.score);

            if (!ranked.length) return;

            const bestScore = ranked[0].score;
            const suggested = ranked
                .filter(result => result.score >= Math.max(40, bestScore - 25))
                .slice(0, 6);

            suggested.forEach(result => {
                const button = buttons.find(
                    item => iconClassOf(item) === result.item.class
                );

                button?.classList.add('is-smart-match');
            });

            const bestClass = ranked[0].item.class;
            const bestButton = buttons.find(
                item => iconClassOf(item) === bestClass
            );

            bestButton?.classList.add('is-smart-best');

            if (
                autoSelectBest &&
                bestButton &&
                !bestButton.classList.contains('active')
            ) {
                bestButton.click();
            }
        }

        function afterOriginalHandler(autoSelect) {
            window.setTimeout(function () {
                restoreAllIconsAndHighlight(getSmartTerms(), autoSelect);
            }, 0);
        }

        nameInput.addEventListener('input', function () {
            if (restoringIcons) return;
            afterOriginalHandler(true);
        });

        nameEnInput.addEventListener('input', function () {
            if (restoringIcons) return;
            afterOriginalHandler(true);
        });

        iconSearch.addEventListener('input', function () {
            if (restoringIcons) return;
            afterOriginalHandler(true);
        });

        const gridObserver = new MutationObserver(function () {
            if (restoringIcons) return;

            window.setTimeout(function () {
                const terms = getSmartTerms();
                if (!terms.length) return;

                const buttons = Array.from(
                    iconGrid.querySelectorAll('.icon-item')
                );

                const ranked = window.iconsData
                    .map(item => ({ item, score: scoreIcon(item, terms) }))
                    .filter(result => result.score > 0)
                    .sort((a, b) => b.score - a.score);

                buttons.forEach(button => {
                    button.classList.remove('is-smart-match', 'is-smart-best');
                });

                if (!ranked.length) return;

                const bestScore = ranked[0].score;
                const suggested = ranked
                    .filter(result => result.score >= Math.max(40, bestScore - 25))
                    .slice(0, 6);

                suggested.forEach(result => {
                    buttons
                        .find(item => iconClassOf(item) === result.item.class)
                        ?.classList.add('is-smart-match');
                });

                buttons
                    .find(item => iconClassOf(item) === ranked[0].item.class)
                    ?.classList.add('is-smart-best');
            }, 0);
        });

        gridObserver.observe(iconGrid, { childList: true });

        /*
           أول عرض يبقى بكامل الأيقونات بدون تحديد تلقائي
           حتى لا نغيّر أيقونة فئة عند فتحها للتعديل.
        */
        restoreAllIconsAndHighlight('', false);
    }, { once: true });
</script>
