<div class="modal fade premium-place-modal"
     id="attendanceModal"
     tabindex="-1"
     aria-labelledby="attendanceModalTitle"
     aria-hidden="true"
     dir="rtl">

    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable premium-place-modal-dialog premium-attendance-dialog">

        <div class="modal-content premium-place-modal-content">

            <div class="premium-modal-mobile-handle"
                 aria-hidden="true">
            </div>

            <div class="premium-place-modal-header">

                <div class="premium-modal-heading">

                    <span class="premium-modal-icon">
                        <i class="bi bi-people-fill"></i>
                    </span>

                    <div>
                        <small>بيانات الحضور</small>

                        <h5 class="modal-title"
                            id="attendanceModalTitle">

                            من سيحضر الحجز؟
                        </h5>

                        <p>
                            حدد نوع الحجز وأعداد الأشخاص بدقة.
                        </p>
                    </div>
                </div>

                <button type="button"
                        class="premium-modal-close custom-close-btn"
                        data-bs-dismiss="modal"
                        aria-label="إغلاق">

                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-body premium-place-modal-body">

                <div class="premium-field-group">

                    <label for="bookingTypeSelect"
                           class="premium-field-label">

                        <span>
                            <i class="bi bi-person-badge-fill"></i>
                        </span>

                        <span>نوع الحجز</span>
                    </label>

                    <div class="premium-select-shell">

                        <select id="bookingTypeSelect"
                                class="form-select premium-select-input">

                            <option value="family">
                                عائلة (رجال ونساء)
                            </option>

                            <option value="men">
                                شباب فقط
                            </option>

                            <option value="women">
                                نساء فقط
                            </option>

                            <option value="company">
                                جهة / شركة
                            </option>

                            <option value="other">
                                أخرى — اكتب نوع الحجز
                            </option>
                        </select>

                        <i class="bi bi-chevron-down"></i>
                    </div>

                    <div id="bookingTypeOtherWrap"
                         class="premium-other-booking-field"
                         hidden
                         aria-hidden="true">

                        <label for="bookingTypeOtherInput"
                               class="premium-other-booking-label">
                            <i class="bi bi-pencil-square"></i>
                            <span>اكتب نوع الحجز</span>
                        </label>

                        <div class="premium-other-booking-input-shell">
                            <i class="bi bi-stars"></i>

                            <input type="text"
                                   id="bookingTypeOtherInput"
                                   class="form-control premium-other-booking-input"
                                   maxlength="50"
                                   autocomplete="off"
                                   placeholder="مثال: وفد جامعي، مناسبة خاصة، مجموعة أصدقاء..."
                                   aria-describedby="bookingTypeOtherHint" />

                            <span id="bookingTypeOtherCounter"
                                  class="premium-other-booking-counter">
                                0 / 50
                            </span>
                        </div>

                        <small id="bookingTypeOtherHint"
                               class="premium-other-booking-hint">
                            اكتب وصفًا مختصرًا وواضحًا لنوع الحجز.
                        </small>
                    </div>
                </div>

                <div class="premium-counter-list">

                    <div class="premium-counter-row">

                        <div class="premium-counter-label">

                            <span>
                                <i class="bi bi-person-fill"></i>
                            </span>

                            <div>
                                <strong>عدد الكبار</strong>
                                <small>الأشخاص البالغون</small>
                            </div>
                        </div>

                        <div class="premium-counter-control"
                             dir="ltr">

                            <button type="button"
                                    onclick="smartUpdateCount(
                                        'adultsCount',
                                        -1
                                    )"
                                    aria-label="إنقاص عدد الكبار">

                                <i class="bi bi-dash-lg"></i>
                            </button>

                            <input type="text"
                                   inputmode="numeric"
                                   id="adultsCount"
                                   class="form-control no-arrows"
                                   value="0"
                                   aria-label="عدد الكبار"
                                   onfocus="
                                       if (this.value === '0') {
                                           this.value = '';
                                       }
                                   "
                                   onblur="
                                       if (this.value === '') {
                                           this.value = '0';
                                       }

                                       syncBookingNumbers(
                                           'adults'
                                       );
                                   "
                                   oninput="
                                       this.value =
                                           this.value.replace(
                                               /[^0-9]/g,
                                               ''
                                           );

                                       syncBookingNumbers(
                                           'adults'
                                       );
                                   " />

                            <button type="button"
                                    onclick="smartUpdateCount(
                                        'adultsCount',
                                        1
                                    )"
                                    aria-label="زيادة عدد الكبار">

                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>

                    <div class="premium-counter-row">

                        <div class="premium-counter-label">

                            <span>
                                <i class="bi bi-person-hearts"></i>
                            </span>

                            <div>
                                <strong>عدد الأطفال</strong>
                                <small>الأطفال ضمن الحجز</small>
                            </div>
                        </div>

                        <div class="premium-counter-control"
                             dir="ltr">

                            <button type="button"
                                    onclick="smartUpdateCount(
                                        'childrenCount',
                                        -1
                                    )"
                                    aria-label="إنقاص عدد الأطفال">

                                <i class="bi bi-dash-lg"></i>
                            </button>

                            <input type="text"
                                   inputmode="numeric"
                                   id="childrenCount"
                                   class="form-control no-arrows"
                                   value="0"
                                   aria-label="عدد الأطفال"
                                   onfocus="
                                       if (this.value === '0') {
                                           this.value = '';
                                       }
                                   "
                                   onblur="
                                       if (this.value === '') {
                                           this.value = '0';
                                       }

                                       syncBookingNumbers(
                                           'children'
                                       );
                                   "
                                   oninput="
                                       this.value =
                                           this.value.replace(
                                               /[^0-9]/g,
                                               ''
                                           );

                                       syncBookingNumbers(
                                           'children'
                                       );
                                   " />

                            <button type="button"
                                    onclick="smartUpdateCount(
                                        'childrenCount',
                                        1
                                    )"
                                    aria-label="زيادة عدد الأطفال">

                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div id="capacityWarning"
                     class="premium-inline-alert is-danger alert alert-danger d-none">

                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span id="warningText"></span>
                </div>
            </div>

            <div class="modal-footer premium-place-modal-footer">

                <button type="button"
                        class="btn btn-info premium-modal-primary"
                        onclick="goToFinalCheckout()">

                    <span>متابعة الحجز</span>
                    <i class="bi bi-arrow-left"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade premium-place-modal"
     id="hallBookingModal"
     tabindex="-1"
     aria-labelledby="hallBookingModalTitle"
     aria-hidden="true"
     dir="rtl">

    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable premium-place-modal-dialog premium-hall-dialog">

        <div class="modal-content premium-place-modal-content">

            <div class="premium-modal-mobile-handle"
                 aria-hidden="true">
            </div>

            <div class="premium-place-modal-header">

                <div class="premium-modal-heading">

                    <span class="premium-modal-icon">
                        <i class="bi bi-buildings-fill"></i>
                    </span>

                    <div>
                        <small>تفاصيل المناسبة</small>

                        <h5 class="modal-title"
                            id="hallBookingModalTitle">

                            تجهيز القاعة
                        </h5>

                        <p>
                            اختر نوع المناسبة وطريقة ترتيب المقاعد.
                        </p>
                    </div>
                </div>

                <button type="button"
                        class="premium-modal-close custom-close-btn"
                        data-bs-dismiss="modal"
                        aria-label="إغلاق">

                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-body premium-place-modal-body">

                <div class="premium-field-group">

                    <label for="hallEventTypeSelect"
                           class="premium-field-label">

                        <span>
                            <i class="bi bi-balloon-heart-fill"></i>
                        </span>

                        <span>نوع المناسبة</span>
                    </label>

                    <div class="premium-select-shell">

                        <select id="hallEventTypeSelect"
                                class="form-select premium-select-input">

                            @if (availableEvents.Any())
                            {
                                foreach (
                                var eventName in
                                availableEvents
                                )
                                {
                                    <option value="@eventName">
                                        @eventName
                                    </option>
                                }
                            }
                            else
                            {
                                <option value="غير محدد">
                                    غير محدد
                                </option>
                            }
                            <option value="other">
                                أخرى — اكتب نوع المناسبة
                            </option>
                        </select>

                        <i class="bi bi-chevron-down"></i>
                    </div>

                    <div id="hallEventOtherWrap"
                         class="premium-other-booking-field"
                         hidden
                         aria-hidden="true">

                        <label for="hallEventOtherInput"
                               class="premium-other-booking-label">
                            <i class="bi bi-pencil-square"></i>
                            <span>ما نوع المناسبة؟</span>
                        </label>

                        <div class="premium-other-booking-input-shell">
                            <i class="bi bi-stars"></i>

                            <input type="text"
                                   id="hallEventOtherInput"
                                   class="form-control premium-other-booking-input"
                                   maxlength="50"
                                   autocomplete="off"
                                   placeholder="مثال: فعالية جامعية، ورشة خاصة، مناسبة عائلية..."
                                   aria-describedby="hallEventOtherHint" />

                            <span id="hallEventOtherCounter"
                                  class="premium-other-booking-counter">
                                0 / 50
                            </span>
                        </div>

                        <small id="hallEventOtherHint"
                               class="premium-other-booking-hint">
                            اكتب وصفًا مختصرًا وواضحًا لنوع المناسبة.
                        </small>
                    </div>

                </div>

                <div class="premium-seating-section">

                    <div class="premium-field-label">

                        <span>
                            <i class="bi bi-grid-3x3-gap-fill"></i>
                        </span>

                        <span>ترتيب القاعة</span>
                    </div>

                    <div class="premium-seating-list">

                        @if (availableSeats.Any())
                        {
                            bool isFirstSeat = true;

                            foreach (
                            var seat in
                            availableSeats
                            )
                            {
                                string activeSeatClass =
                                isFirstSeat
                                ? "border-info active-seating"
                                : "border-light";

                                string seatIconClass =
                                isFirstSeat
                                ? "bi-record-circle text-info"
                                : "bi-circle text-muted";

                                isFirstSeat = false;

                                <button type="button"
                                class="seating-option premium-seating-option @activeSeatClass"
                                data-seat-name="@seat"
                                onclick="selectSeating(
                                            this,
                                            this.dataset.seatName
                                        )">

                                    <span class="premium-seating-option-icon">

                                        <i class="bi bi-layout-text-window-reverse"></i>
                                    </span>

                                    <span class="seating-text-value">
                                        @seat
                                    </span>

                                    <i class="bi @seatIconClass radio-icon"></i>
                                </button>
                            }
                        }
                        else
                        {
                            <div class="premium-empty-option">

                                <i class="bi bi-info-circle"></i>

                                <span>
                                    لا توجد خيارات لترتيب القاعة حاليًا.
                                </span>
                            </div>
                        }
                    
                        <button type="button"
                                class="seating-option premium-seating-option border-light"
                                data-seat-name="other"
                                onclick="selectSeating(this, this.dataset.seatName)">
                            <span class="premium-seating-option-icon">
                                <i class="bi bi-pencil-square"></i>
                            </span>
                            <span class="seating-text-value">أخرى</span>
                            <i class="bi bi-circle text-muted radio-icon"></i>
                        </button>
</div>
                

                    <div id="seatingOtherWrap"
                         class="premium-other-booking-field mt-3"
                         hidden
                         aria-hidden="true">
                        <label for="seatingOtherInput"
                               class="premium-other-booking-label">
                            <i class="bi bi-pencil-square"></i>
                            <span>اكتب ترتيب القاعة المطلوب</span>
                        </label>

                        <div class="premium-other-booking-input-shell">
                            <i class="bi bi-grid-3x3-gap"></i>
                            <input type="text"
                                   id="seatingOtherInput"
                                   class="form-control premium-other-booking-input"
                                   maxlength="80"
                                   autocomplete="off"
                                   placeholder="مثال: طاولات دائرية مع منصة أمامية..."
                                   aria-describedby="seatingOtherHint" />
                            <span id="seatingOtherCounter"
                                  class="premium-other-booking-counter">0 / 80</span>
                        </div>

                        <small id="seatingOtherHint"
                               class="premium-other-booking-hint">
                            وضّح الترتيب المطلوب حتى يصل للمالك كما كتبته.
                        </small>
                    </div>
</div>
            </div>

            <div class="modal-footer premium-place-modal-footer">

                <button type="button"
                        class="btn btn-info premium-modal-primary"
                        onclick="goToFinalCheckoutForHall()">

                    <span>متابعة الحجز</span>
                    <i class="bi bi-arrow-left"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade service-gallery-modal"
     id="serviceGalleryModal"
     tabindex="-1"
     aria-labelledby="serviceGalleryTitle"
     aria-hidden="true"
     dir="rtl">

    <div class="modal-dialog modal-dialog-centered service-gallery-dialog">

        <div class="modal-content service-gallery-content">

            <header class="service-gallery-header">

                <div class="service-gallery-heading">

                    <span>
                        <i class="bi bi-images"></i>
                    </span>

                    <div>
                        <small>
                            صور الخدمة الإضافية
                        </small>

                        <h5 id="serviceGalleryTitle"
                            class="modal-title">
                            صور الخدمة
                        </h5>
                    </div>
                </div>

                <button type="button"
                        class="service-gallery-close"
                        data-bs-dismiss="modal"
                        aria-label="إغلاق معرض الصور">

                    <i class="bi bi-x-lg"></i>
                </button>
            </header>

            <div id="serviceGalleryStage"
                 class="service-gallery-stage">

                <button id="serviceGalleryPrevious"
                        type="button"
                        class="service-gallery-navigation service-gallery-previous"
                        aria-label="الصورة السابقة">

                    <i class="bi bi-chevron-right"></i>
                </button>

                <div class="service-gallery-image-wrap">

                    <img id="serviceGalleryMainImage"
                         src=""
                         alt="صورة الخدمة" />

                    <span id="serviceGalleryCounter"
                          class="service-gallery-counter">
                        0 / 0
                    </span>
                </div>

                <button id="serviceGalleryNext"
                        type="button"
                        class="service-gallery-navigation service-gallery-next"
                        aria-label="الصورة التالية">

                    <i class="bi bi-chevron-left"></i>
                </button>
            </div>

            <div id="serviceGalleryThumbnails"
                 class="service-gallery-thumbnails"
                 aria-label="الصور المصغرة">
            </div>
        </div>
    </div>
</div>



<style>
    /* العرض المركب: نوضح للعميل الباقة والخدمات قبل الضغط على العرض. */
    .promotion-bundle-scope {
        display: grid;
        gap: .45rem;
        margin: .65rem 0 .8rem;
        padding: .7rem .8rem;
        border: 1px solid rgba(0, 166, 218, .18);
        border-radius: 14px;
        background: linear-gradient(135deg, rgba(0, 166, 218, .06), rgba(255, 255, 255, .92));
    }

    .promotion-bundle-scope > span {
        display: flex;
        align-items: center;
        gap: .45rem;
        color: #536779;
        font-size: .72rem;
        line-height: 1.65;
    }

    .promotion-bundle-scope > span i {
        color: #00A6DA;
        font-size: .8rem;
    }

    .promotion-bundle-scope > span b {
        color: #30495C;
        font-weight: 900;
    }

    .package-promotion-bundle-note {
        display: flex;
        align-items: center;
        gap: .4rem;
        margin-top: .5rem;
        padding: .45rem .6rem;
        border: 1px solid rgba(33, 168, 117, .18);
        border-radius: 12px;
        background: rgba(33, 168, 117, .07);
        color: #137a55;
        font-size: .72rem;
        font-weight: 700;
        line-height: 1.5;
    }

    .package-promotion-bundle-note i {
        flex: 0 0 auto;
        font-size: .88rem;
    }

    .promotion-target-flash {
        outline: 3px solid rgba(0, 166, 218, .32) !important;
        outline-offset: 4px;
        box-shadow: 0 0 0 7px rgba(0, 166, 218, .08) !important;
    }
</style>

@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script type="module"
        src="https://cdn.jsdelivr.net/npm/emoji-picker-element@1.21.3/index.js">
    </script>

    <script src="~/js/customer/Details.js"
        asp-append-version="true">
    </script>

    @if (Model.AttributionAdvertisementId.HasValue)
    {
        <script src="~/js/customer/advertisements.js" asp-append-version="true"></script>
    }


    @if (hasValidCoordinates)
    {
        <script async
        defer
        src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDsGFrKQykUki-adl_KJKEVlugvx4e3vjM&callback=initMap">
        </script>
    }
}
