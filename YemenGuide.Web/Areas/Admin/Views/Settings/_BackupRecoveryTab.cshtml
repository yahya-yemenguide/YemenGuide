<div class="tab-pane-content backup-recovery-tab settings-tab-panel"
     style="display: none;"
     role="tabpanel">

    <section class="backup-v3"
             id="backupRecoveryCenter"
             data-dashboard-url="@Url.Action("Dashboard", "Backup", new { area = "Admin" })"
             data-create-url="@Url.Action("CreateFull", "Backup", new { area = "Admin" })"
             data-save-settings-url="@Url.Action("SaveSettings", "Backup", new { area = "Admin" })"
             data-download-base="/Admin/Backup/Download/"
             data-restore-stored-url="@Url.Action("RestoreStored", "Backup", new { area = "Admin" })"
             data-restore-uploaded-url="@Url.Action("RestoreUploaded", "Backup", new { area = "Admin" })"
             data-delete-url="@Url.Action("Delete", "Backup", new { area = "Admin" })">

        <header class="backup-v3__header">
            <div class="backup-v3__title">
                <span class="backup-v3__eyebrow">
                    <i class="bi bi-database-check"></i>
                    حماية قاعدة البيانات
                </span>

                <h2>النسخ الاحتياطي والاستعادة</h2>

                <p>
                    أنشئ نسخة كاملة لقاعدة البيانات واحفظها على جهازك،
                    أو استعد نسخة سابقة عند الحاجة.
                </p>
            </div>

            <div class="backup-v3__actions">
                <span class="backup-v3__ready"
                      id="backupReadyBadge">
                    <i class="bi bi-hourglass-split"></i>
                    جاري الفحص
                </span>

                <button type="button"
                        class="backup-v3__button backup-v3__button--secondary"
                        id="backupRestoreFromFileBtn">
                    <i class="bi bi-folder2-open"></i>
                    استعادة من ملف
                </button>

                <button type="button"
                        class="backup-v3__button backup-v3__button--primary"
                        id="backupCreateNowBtn">
                    <i class="bi bi-download"></i>
                    إنشاء وحفظ نسخة
                </button>

                <input type="file"
                       id="backupRestoreFileInput"
                       accept=".bak,application/octet-stream"
                       class="d-none" />
            </div>
        </header>

        <section class="backup-v3__summary">
            <div class="backup-v3__summary-main">
                <span class="backup-v3__summary-icon">
                    <i class="bi bi-clock-history"></i>
                </span>

                <div>
                    <small>آخر نسخة</small>
                    <strong id="backupLastBackupTitle">
                        لا توجد نسخة حتى الآن
                    </strong>
                    <span id="backupLastBackupTime">
                        عند إنشاء النسخة ستظهر هنا مباشرة.
                    </span>
                </div>
            </div>

            <div class="backup-v3__summary-meta">
                <div>
                    <small>الحالة</small>
                    <strong id="backupLastBackupStatus">—</strong>
                </div>

                <div>
                    <small>الحجم</small>
                    <strong id="backupLastBackupSize">—</strong>
                </div>

                <div>
                    <small>عدد النسخ</small>
                    <strong id="backupCount">0</strong>
                </div>
            </div>
        </section>

        <section class="backup-v3__auto">
            <div class="backup-v3__auto-copy">
                <span class="backup-v3__auto-icon">
                    <i class="bi bi-arrow-repeat"></i>
                </span>
                <div>
                    <h3>النسخ التلقائي اليومي</h3>
                    <p>
                        يحتفظ النظام بآخر <b>7 نسخ تلقائية</b> فقط.
                        النسخ اليدوية لا تُحذف تلقائيًا، ونسخ الأمان قبل الاستعادة يحتفظ بآخر <b>3</b>.
                    </p>
                </div>
            </div>

            <div class="backup-v3__auto-controls">
                <label class="backup-v3__auto-toggle">
                    <input type="checkbox"
                           id="backupAutoEnabled" />
                    <span></span>
                    <b id="backupAutoLabel">غير مفعّل</b>
                </label>

                <label class="backup-v3__time">
                    <span>وقت النسخ</span>
                    <input type="time"
                           id="backupDailyTime"
                           value="02:00" />
                </label>

                <button type="button"
                        class="backup-v3__auto-save"
                        id="backupSaveAutoBtn">
                    <i class="bi bi-check2-circle"></i>
                    حفظ
                </button>
            </div>
        </section>

        <section class="backup-v3__list">
            <header class="backup-v3__list-head">
                <div>
                    <h3>النسخ المحفوظة</h3>
                    <p>
                        الاسم الذي تختاره عند الحفظ يظهر هنا،
                        وتستطيع تنزيل النسخة أو استعادتها أو حذفها.
                    </p>
                </div>

                <button type="button"
                        class="backup-v3__refresh"
                        id="backupRefreshBtn">
                    <i class="bi bi-arrow-clockwise"></i>
                    تحديث
                </button>
            </header>

            <div class="backup-v3__table-wrap">
                <table class="backup-v3__table">
                    <thead>
                        <tr>
                            <th>النسخة</th>
                            <th>التاريخ والوقت</th>
                            <th>الحجم</th>
                            <th>الحالة</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>

                    <tbody id="backupTableBody">
                        <tr>
                            <td colspan="5">
                                <div class="backup-v3__empty">
                                    <span class="spinner-border spinner-border-sm"></span>
                                    جاري تحميل النسخ...
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <div class="backup-v3__note">
            <i class="bi bi-shield-check"></i>
            <span>
                قبل أي استعادة فعلية، ينشئ النظام تلقائيًا نسخة أمان للحالة الحالية.
                النسخ الخارجية مثل Google Drive سنضيفها بعد إكمال المحلي.
            </span>
        </div>

    </section>
</div>
