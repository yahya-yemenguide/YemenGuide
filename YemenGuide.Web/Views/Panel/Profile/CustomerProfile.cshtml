@section Scripts {

    <script src="~/lib/sweetalert2/sweetalert2.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.4/build/js/intlTelInput.min.js"></script>

    <script src="~/js/customer/customer-profile.js"
        asp-append-version="true"></script>

    <!--
        واجهة العملة الجديدة تشغّل نفس منطق الحفظ القديم الموجود
        في customer-profile.js عبر select مخفي، لذلك لا نغيّر أي Endpoint.
    -->
    <script>
        (() => {
            const currencySelect =
                document.getElementById('currencySelect');

            const currencyStatus =
                document.getElementById('preferredCurrencyStatus');

            const currencyInputs =
                Array.from(
                    document.querySelectorAll(
                        'input[name="preferredCurrencyUi"]'
                    )
                );

            if (!currencySelect || currencyInputs.length === 0) {
                return;
            }

            currencyInputs.forEach(input => {
                input.addEventListener('change', function () {
                    if (!this.checked) {
                        return;
                    }

                    const selectedCurrency =
                        this.value;

                    currencySelect.value =
                        selectedCurrency;

                    if (currencyStatus) {
                        currencyStatus.classList.remove(
                            'is-saved',
                            'is-error'
                        );

                        currencyStatus.classList.add(
                            'is-saving'
                        );

                        currencyStatus.innerHTML =
                            `<i class="bi bi-arrow-repeat"></i>
                                     <span>جاري تثبيت <strong>${selectedCurrency}</strong>...</span>`;
                    }

                    currencySelect.dispatchEvent(
                        new Event(
                            'change',
                            { bubbles: true }
                        )
                    );
                });
            });
        })();
    </script>

    <script src="~/js/customer/customer-sidebar.js"
        asp-append-version="true"></script>
}
