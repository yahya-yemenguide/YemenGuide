{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "apexcharts@3.45.1",
      "destination": "wwwroot/lib/apexcharts/"
    },
    {
      "library": "bootstrap@5.3.3",
      "destination": "wwwroot/lib/bootstrap/"
    },
    {
      "library": "bootstrap-icons@1.11.3",
      "destination": "wwwroot/lib/bootstrap-icons/"
    },
    {
      "library": "Chart.js@4.4.1",
      "destination": "wwwroot/lib/chart.js/"
    },
    {
      "library": "datatables@1.10.21", //حالياً ليست موجودة استخدم رابط من النت
      "destination": "wwwroot/lib/datatables/"
    },
    {
      "library": "fullcalendar@6.1.11",
      "destination": "wwwroot/lib/fullcalendar/"
    },
    {
      "library": "jquery@3.7.1",
      "destination": "wwwroot/lib/jquery/"
    },
    {
      "provider": "unpkg",
      "library": "@microsoft/signalr@latest",
      "destination": "wwwroot/lib/signalr/"
    },
    {
      "library": "sweetalert2@11.10.7",
      "destination": "wwwroot/lib/sweetalert2/",
      "files": [
        "sweetalert2.js",
        "sweetalert2.min.css"
      ]
    }
  ]
}







