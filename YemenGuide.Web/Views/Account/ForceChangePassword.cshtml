@{
    Layout = null;
    ViewData["Title"] = "تأمين الحساب";
    bool isGoogle = string.Equals(Context.Request.Query["source"].ToString(), "google", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f5fbfe" />
    <title>@ViewData["Title"] - دليلك اليمني</title>

    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="preload" href="~/lib/fonts/Tajawal/Tajawal-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="~/lib/fonts/Tajawal/Tajawal-Bold.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="~/lib/fonts/Tajawal/Tajawal-ExtraBold.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="~/css/shared/auth-security-modal.css" asp-append-version="true" />
</head>
<body class="security-page">
    <main class="security-page-stage">
        <div class="security-ambient" aria-hidden="true">
            <span class="security-orb security-orb--cyan"></span>
            <span class="security-orb security-orb--coral"></span>
            <span class="security-pattern"></span>
        </div>

        <section class="security-card" aria-labelledby="securityPageTitle">
            <header class="security-brand">
                <span class="security-brand-mark"><i class="bi bi-compass-fill"></i></span>
                <div>
                    <strong>دليلك اليمني</strong>
                    <small>بوابة الأمان</small>
                </div>
            </header>

            <div class="security-visual" aria-hidden="true">
                <span class="security-visual-ring"></span>
                <span class="security-visual-core"><i class="bi @(isGoogle ? "bi-google" : "bi-shield-lock-fill")"></i></span>
                <span class="security-visual-badge"><i class="bi bi-check-lg"></i></span>
            </div>

            <div class="security-heading">
                <span class="security-kicker"><i class="bi bi-stars"></i> خطوة أمان أخيرة</span>
                <h1 id="securityPageTitle">@(isGoogle ? "تم ربط Google بنجاح" : "أمّن حسابك")</h1>
                <p>
                    @(isGoogle
                        ? "أنشئ الآن كلمة مرور خاصة بحساب دليلك اليمني. ستتمكن بعدها من الدخول بواسطة Google أو باستخدام بريدك وكلمة المرور."
                        : "لأمان حسابك، أنشئ كلمة مرور جديدة وخاصة بك قبل المتابعة.")
                </p>
            </div>

            <form id="forceChangePwdForm"
                  class="security-form"
                  method="post"
                  novalidate
                  data-auth-password-form
                  data-endpoint="/Account/ForceChangePassword">
                @Html.AntiForgeryToken()

                <div class="security-field">
                    <label for="newPassword">كلمة المرور الجديدة</label>
                    <div class="security-input-wrap">
                        <i class="bi bi-lock-fill"></i>
                        <input type="password"
                               name="newPassword"
                               id="newPassword"
                               placeholder="8 أحرف على الأقل"
                               autocomplete="new-password"
                               required />
                        <button type="button" class="security-password-toggle" data-password-toggle="#newPassword" aria-label="إظهار كلمة المرور">
                            <i class="bi bi-eye-slash-fill"></i>
                        </button>
                    </div>
                </div>

                <div class="security-field">
                    <label for="confirmPassword">تأكيد كلمة المرور</label>
                    <div class="security-input-wrap">
                        <i class="bi bi-shield-check"></i>
                        <input type="password"
                               name="confirmPassword"
                               id="confirmPassword"
                               placeholder="أعد كتابة كلمة المرور"
                               autocomplete="new-password"
                               required />
                        <button type="button" class="security-password-toggle" data-password-toggle="#confirmPassword" aria-label="إظهار كلمة المرور">
                            <i class="bi bi-eye-slash-fill"></i>
                        </button>
                    </div>
                </div>

                <div class="security-meter" data-password-meter hidden>
                    <div class="security-meter-top">
                        <span>قوة كلمة المرور</span>
                        <strong data-strength-text>—</strong>
                    </div>
                    <div class="security-meter-track"><span data-strength-bar></span></div>
                    <div class="security-rules">
                        <span data-rule="length"><i class="bi bi-circle"></i> 8 أحرف على الأقل</span>
                        <span data-rule="letter"><i class="bi bi-circle"></i> حرف إنجليزي</span>
                        <span data-rule="number"><i class="bi bi-circle"></i> رقم واحد</span>
                    </div>
                </div>

                <div class="security-message security-message--error" data-form-message role="alert" aria-live="polite" hidden></div>

                <button type="submit" class="security-primary-btn" data-submit-button>
                    <span>@(isGoogle ? "تأمين الحساب والمتابعة" : "حفظ والمتابعة")</span>
                    <i class="bi bi-arrow-left-short"></i>
                </button>
            </form>

            <div class="security-trust">
                <span><i class="bi bi-shield-check"></i> كلمة المرور مشفرة</span>
                <span><i class="bi bi-google"></i> Google سيظل متاحاً للدخول</span>
            </div>
        </section>
    </main>

    <script src="~/js/shared/auth-security-modal.js" asp-append-version="true"></script>
</body>
</html>
