                                                        'all',
                                                        this
                                                    )">

                                                الكل
                                            </button>

                                            <button type="button"
                                                    class="review-filter-chip"
                                                    onclick="filterReviews(
                                                        'positive',
                                                        this
                                                    )">

                                                إيجابية
                                            </button>

                                            <button type="button"
                                                    class="review-filter-chip"
                                                    onclick="filterReviews(
                                                        'negative',
                                                        this
                                                    )">

                                                سلبية
                                            </button>

                                            @for (
                                            int filterStar = 5;
                                            filterStar >= 1;
                                            filterStar--
                                            )
                                            {
                                                <button type="button"
                                                    class="review-filter-chip"
                                                    onclick="filterReviews(
                                                            '@filterStar',
                                                            this
                                                        )">

                                                    @filterStar
                                                    <i class="bi bi-star-fill"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>

                                    <div id="noReviewsFilterMessage"
                                         class="reviews-empty-message d-none">

                                        <i class="bi bi-filter-circle"></i>

                                        <h3>
                                            لا توجد مراجعات تطابق هذا الفلتر
                                        </h3>
                                    </div>

                                    <div class="reviews-list">

                                        @if (
                                        Model.Reviews != null &&
                                        Model.Reviews.Any()
                                        )
                                        {
                                            foreach (
                                            var rootReview in
                                            Model.Reviews
                                            )
                                            {
                                                RenderCustomerReviewNode(
                                                rootReview,
                                                0,
                                                currentUserId,
                                                FormatInstagramTime
                                                );
                                            }
                                        }
                                        else
                                        {
                                            <div class="reviews-empty-message">

                                                <i class="bi bi-star-half"></i>

                                                <h3>
                                                    كن أول من يشارك تجربته
                                                </h3>

                                                <p>
                                                    ساعد الآخرين بتقييم هذا
                                                    المكان بعد زيارته.
                                                </p>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="review-composer">

                                    <div id="reviewStarsArea"
                                         class="review-composer-top">

                                        <span id="replyingToIndicator">
                                            ما هو تقييمك للمكان؟
                                        </span>

                                        <div class="rating-stars"
                                             dir="ltr"
                                             id="interactiveStars">

                                            <i class="bi bi-star star-item"
                                               data-value="1"></i>

                                            <i class="bi bi-star star-item"
                                               data-value="2"></i>

                                            <i class="bi bi-star star-item"
                                               data-value="3"></i>

                                            <i class="bi bi-star star-item"
                                               data-value="4"></i>

                                            <i class="bi bi-star star-item"
                                               data-value="5"></i>
                                        </div>

                                        <button type="button"
                                                class="review-cancel-reply d-none"
                                                id="cancelReplyBtn"
                                                onclick="cancelInstaReply()">

                                            <i class="bi bi-x-lg"></i>
                                            <span>إلغاء</span>
                                        </button>
                                    </div>

                                    <div class="review-input-shell">

                                        <div class="dropup review-emoji-wrap">

                                            <button class="review-emoji-button"
                                                    type="button"
                                                    data-bs-toggle="dropdown"
                                                    data-bs-auto-close="outside"
                                                    aria-label="إضافة رمز تعبيري">

                                                <i class="bi bi-emoji-smile"></i>
                                            </button>

                                            <div class="dropdown-menu review-emoji-menu">

                                                <emoji-picker id="customerEmojiPicker"
                                                              class="light">
                                                </emoji-picker>
                                            </div>
                                        </div>

                                        <input type="hidden"
                                               id="userRatingValue"
                                               value="0" />

                                        <input type="hidden"
                                               id="instaParentReviewId"
                                               value="" />

                                        <input type="hidden"
                                               id="instaEditModeId"
                                               value="" />

                                        <input type="text"
                                               id="instaReplyInput"
                                               class="review-text-input"
                                               placeholder="اكتب تقييمك هنا..."
                                               autocomplete="off" />

                                        <button type="button"
                                                class="review-publish-button"
                                                id="instaPostBtn"
                                                onclick="submitCustomerPost()">

                                            <span>نشر</span>
                                            <i class="bi bi-send-fill"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <aside class="place-content-aside is-sticky-rail">

                <div class="booking-sticky-wrap">

                    @if (isBookingPlace)
                    {
                        <section class="premium-booking-card">

                            <div class="booking-card-head">

                                <div>
                                    <small>خطوة الحجز</small>

                                    <div class="booking-price-line is-package">

                                        <strong>
                                            @Model.BookingAvailabilityMessage
                                        </strong>
                                    </div>
                                </div>

                                <div class="booking-rating">

                                    <i class="bi bi-star-fill"></i>

                                    <strong>
                                        @Model.AverageRating.ToString("0.0")
                                    </strong>

                                    <span>
                                        (@Model.TotalReviews)
                                    </span>
                                </div>
                            </div>

                            @if (highlightedPromotion != null)
                            {
                                <button type="button"
                                class="booking-mini-offer"
                                data-promotion-action
                                data-promotion-id="@highlightedPromotion.PromotionId"
                                data-target-anchor="@highlightedPromotion.TargetAnchor">

                                    <span class="booking-mini-offer-icon">
                                        <i class="bi bi-fire"></i>
                                    </span>

                                    <span class="booking-mini-offer-copy">
                                        <small>عرض متاح الآن</small>
                                        <strong>
                                            @highlightedPromotion.OfferDisplay
                                            على @highlightedPromotion.TargetLabel
                                        </strong>
                                    </span>

                                    <i class="bi bi-arrow-left"></i>
                                </button>
                            }

                            <div class="booking-assurance-list">

                                <div>
                                    <i class="bi bi-shield-check"></i>
                                    <span>بيانات الحجز محمية</span>
                                </div>

                                <div>
                                    <i class="bi bi-cash-stack"></i>
                                    <span>لن يتم خصم مبلغ الآن</span>
                                </div>

                                <div>
                                    <i class="bi bi-headset"></i>
                                    <span>دعم ومتابعة للطلب</span>
                                </div>
                            </div>

                            @if (isHotel)
                            {
                                <button type="button"
                                data-bs-toggle="modal"
                                data-bs-target="#datePickerModal"
                                class="booking-primary-button"
                                disabled="@(!Model.CanBook)"
                                aria-disabled="@(!Model.CanBook)">

                                    <span>
                                        عرض الغرف المتاحة
                                    </span>

                                    <i class="bi bi-calendar2-check-fill"></i>
                                </button>
                            }
                            else if (
                            isPackageSystem ||
                            isHall
                            )
                            {
                                <button type="button"
                                class="booking-primary-button"
                                disabled="@(!Model.CanBook)"
                                aria-disabled="@(!Model.CanBook)"
                                onclick="
                                            const packages =
                                                document.getElementById(
                                                    'packagesSection'
                                                );

                                            if (packages) {
                                                packages.scrollIntoView({
                                                    behavior: 'smooth',
                                                    block: 'start'
                                                });
                                            }
                                        ">

                                    <span>
                                        استعراض الباقات
                                    </span>

                                    <i class="bi bi-ticket-perforated-fill"></i>
                                </button>
                            }
                            else
                            {
                                <a asp-controller="Places"
                           asp-action="Checkout"
                           class="booking-primary-button"
                           data-customer-booking-start>

                                    <span>احجز الآن</span>
                                    <i class="bi bi-arrow-left"></i>
                                </a>
                            }

                            <div class="booking-journey-mini"
                             aria-label="خطوات إكمال الحجز">

                                <div class="booking-journey-step is-current">

                                    <span>1</span>

                                    <div>
                                        <small>الآن</small>
                                        <strong>اختر الباقة</strong>
                                    </div>
                                </div>

                                <i class="bi bi-chevron-left"></i>

                                <div class="booking-journey-step">

                                    <span>2</span>

                                    <div>
                                        <small>بعدها</small>
                                        <strong>حدد الموعد</strong>
                                    </div>
                                </div>

                                <i class="bi bi-chevron-left"></i>

                                <div class="booking-journey-step">

                                    <span>3</span>

                                    <div>
                                        <small>أخيرًا</small>
                                        <strong>راجع وأكد</strong>
                                    </div>
                                </div>
                            </div>

                            <div class="booking-policy-note">

                                <i class="bi bi-info-circle-fill"></i>

                                <span>
                                    راجع السياسات بعناية قبل إرسال طلب
                                    الحجز.
                                </span>
                            </div>
                        </section>
                    }
                    else
                    {
                        <section class="premium-visit-card">

                            <span class="visit-card-icon">
                                <i class="bi bi-door-open-fill"></i>
                            </span>

                            <small>
                                مكان مفتوح للزيارة
                            </small>

                            <h2>
                                لا يحتاج إلى حجز مسبق
                            </h2>

                            <p>
                                استخدم الاتجاهات للوصول إلى المكان بسهولة.
                            </p>

                            @if (hasValidCoordinates)
                            {
                                <a href="@directionsUrl"
                           target="_blank"
                           rel="noopener"
                           class="booking-primary-button visit-button">

                                    <span>
                                        احصل على الاتجاهات
                                    </span>

                                    <i class="bi bi-geo-alt-fill"></i>
                                </a>
                            }
                            else
                            {
                                <button type="button"
                                class="booking-primary-button visit-button"
                                disabled>

                                    <span>
                                        الموقع غير محدد
                                    </span>

                                    <i class="bi bi-geo-alt"></i>
                                </button>
                            }
                        </section>
                    }

                    <section class="place-chat-card @(Model.CanContactPlace
                        ? "is-available"
                        : "is-unavailable")"
                             aria-label="التواصل مع المنشأة">

                        <div class="place-chat-card-icon">
                            <i class="bi bi-chat-heart-fill"></i>
                        </div>

                        <div class="place-chat-card-copy">
                            <small>لديك استفسار قبل الحجز؟</small>

                            <h2>
                                تواصل مباشرة مع المنشأة
                            </h2>

                            <p>
                                @if (Model.CanContactPlace)
                                {
                                    <text>
                                        اسأل @Model.OwnerName عن التوفر والخدمات
                                        والتفاصيل قبل تأكيد طلبك.
                                    </text>
                                }
                                else
                                {
                                    @Model.ChatUnavailableMessage
                                }
                            </p>
                        </div>

                        @if (Model.CanContactPlace)
                        {
                            <a asp-controller="Messages"
                           asp-action="MyMessages"
                           asp-route-placeId="@Model.PlaceId"
                           asp-route-withOwnerId="@Model.OwnerId"
                           class="booking-primary-button place-chat-button">

                                <span>تواصل مع المنشأة</span>
                                <i class="bi bi-chat-dots-fill"></i>
                            </a>
                        }
                        else
                        {
                            <button type="button"
                                class="booking-primary-button place-chat-button is-disabled"
                                title="@Model.ChatUnavailableMessage"
                                disabled>

                                <span>الدردشة غير متاحة</span>
                                <i class="bi bi-chat-dots"></i>
                            </button>
                        }
                    </section>
                </div>

            </aside>
        </div>
    </div>

    <div class="sticky-bottom-booking d-lg-none">

        <div class="mobile-booking-inner">

            @if (isBookingPlace)
            {
                <div class="mobile-booking-price">

                    <small>الحجز</small>

                    <strong>
                        @Model.BookingAvailabilityMessage
                    </strong>
                </div>

                @if (isHotel)
                {
                    <button type="button"
                    data-bs-toggle="modal"
                    data-bs-target="#datePickerModal"
                    class="mobile-booking-button"
                    disabled="@(!Model.CanBook)"
                    aria-disabled="@(!Model.CanBook)">

                        احجز الآن
                    </button>
                }
                else if (
                isPackageSystem ||
                isHall
                )
                {
                    <button type="button"
                    class="mobile-booking-button"
                    disabled="@(!Model.CanBook)"
                    aria-disabled="@(!Model.CanBook)"
                    onclick="
                                const packages =
                                    document.getElementById(
                                        'packagesSection'
                                    );

                                if (packages) {
                                    packages.scrollIntoView({
                                        behavior: 'smooth',
                                        block: 'start'
                                    });
                                }
                            ">

                        استعراض الباقات
                    </button>
                }
                else
                {
                    <a asp-controller="Places"
               asp-action="Checkout"
               class="mobile-booking-button"
               data-customer-booking-start>

                        احجز الآن
                    </a>
                }
            }
            else
            {
                <div class="mobile-booking-price">

                    <small>حالة الدخول</small>

                    <strong>
                        <i class="bi bi-door-open-fill"></i>
                        متاح للزيارة
                    </strong>
                </div>

                @if (hasValidCoordinates)
                {
                    <a href="@directionsUrl"
               target="_blank"
               rel="noopener"
               class="mobile-booking-button is-directions">

                        الاتجاهات
                    </a>
                }
                else
                {
                    <button type="button"
                    class="mobile-booking-button is-directions"
                    disabled>

                        الموقع غير محدد
                    </button>
                }
            }
        </div>
    </div>
</main>

@Html.AntiForgeryToken()


@if (Model.AttributionAdvertisementId.HasValue)
