@using YemenGuide.Web.Services.Finance
@using YemenGuide.Core.DTOs.Admin
@model AdminFinancialReportPageDto

@{
    var display = await FinancialDisplayContext.CreateAsync(Context, Model, Context.RequestAborted);
    var filter = Model?.Filter ?? new AdminFinancialReportFilterDto();
    var capabilities = Model?.Capabilities ?? new AdminFinancialReportFilterCapabilitiesDto();
    var hasSelectedReport = Context.Request.Query.ContainsKey("ReportType");
    var selectedReport = Model?.ReportTypeOptions?.FirstOrDefault(option => option.IsSelected);

    string MetricTone(string? tone) =>
        string.IsNullOrWhiteSpace(tone) ? "neutral" : tone.Trim().ToLowerInvariant();

    string CellTone(AdminFinancialReportCellDto? cell) =>
        cell == null || string.IsNullOrWhiteSpace(cell.Tone)
            ? "neutral"
            : cell.Tone.Trim().ToLowerInvariant();
}

<section class="afr" data-reports-root>
    @if (!hasSelectedReport)
    {
        <header class="afr-welcome">
            <span class="afr-welcome__icon"><i class="bi bi-file-earmark-bar-graph"></i></span>
            <div>
                <span class="afr-welcome__eyebrow">مركز التقارير المالية</span>
                <h2>ما التقرير الذي تريد عرضه؟</h2>
                <p>اختر تقريرًا واحدًا، وستظهر فلاتره ونتائجه فقط دون أي أقسام إضافية.</p>
            </div>
        </header>

        <div class="afr-report-selector" role="list" aria-label="أنواع التقارير">
            @foreach (var option in Model.ReportTypeOptions)
            {
                <button type="button"
                        class="afr-report-option"
                        data-report-type="@option.Value"
                        role="listitem">
                    <span class="afr-report-option__icon">
                        <i class="@(string.IsNullOrWhiteSpace(option.IconClass) ? "bi bi-file-earmark-text" : option.IconClass)"></i>
                    </span>
                    <span class="afr-report-option__text">
                        <strong>@option.Label</strong>
                        @if (!string.IsNullOrWhiteSpace(option.Description))
                        {
                            <small>@option.Description</small>
                        }
                    </span>
                    <span class="afr-report-option__arrow"><i class="bi bi-arrow-left"></i></span>
                </button>
            }
        </div>

        <div class="afr-welcome-note">
            <i class="bi bi-shield-check"></i>
            <span>كل تقرير يعرض بياناته وفلاتره ومستنداته المرتبطة فقط.</span>
        </div>
    }
    else
    {
        <header class="afr-active-head">
            <div class="afr-active-head__identity">
                <span class="afr-active-head__icon">
                    <i class="@(string.IsNullOrWhiteSpace(selectedReport?.IconClass) ? "bi bi-file-earmark-bar-graph" : selectedReport.IconClass)"></i>
                </span>
                <div>
                    <span>التقرير المحدد</span>
                    <h2>@Model.Title</h2>
                    <p>@Model.Subtitle</p>
                </div>
            </div>

            <div class="afr-active-head__actions">
                <button type="button" class="afr-btn afr-btn--ghost" data-report-change>
                    <i class="bi bi-grid"></i>
                    تغيير التقرير
                </button>
                <a class="afr-btn afr-btn--primary"
                   href="@Url.Action("Print", "AdminFinancialReports", new { area = "Admin", ReportType = Model.ReportType, autoPrint = true })"
                   data-report-print
                   target="_blank">
                    <i class="bi bi-printer"></i>
                    طباعة التقرير
                </a>
            </div>
        </header>

    <form class="afr-filter-card"
          method="get"
          action="@Url.Action("Index", "AdminFinancialReports", new { area = "Admin" })"
          data-report-filter-form>

        <input type="hidden"
               name="ReportType"
               value="@Model.ReportType"
               data-report-type-input />

        <div class="afr-filter-card__head">
            <div>
                <span>الفلاتر</span>
                <h3>@Model.Title</h3>
                <p>@Model.Subtitle</p>
            </div>

            @if (Model.HasActiveFilters)
            {
                <button type="button"
                        class="afr-clear-filters"
                        data-report-clear-filters>
                    مسح الفلاتر
                </button>
            }
        </div>

        <div class="afr-filter-grid">
            @if (capabilities.ShowDateScope)
            {
                <div class="afr-field">
                    <label>مرجع التاريخ</label>
                    <select name="DateScope">
                        @foreach (var option in Model.DateScopeOptions)
                        {
                            <option value="@option.Value"
                                    selected="@(option.IsSelected ? "selected" : null)">
                                @option.Label
                            </option>
                        }
                    </select>
                </div>
            }

            <div class="afr-field">
                <label>من تاريخ</label>
                <input type="date"
                       name="FromDate"
                       value="@(filter.FromDate?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="afr-field">
                <label>إلى تاريخ</label>
                <input type="date"
                       name="ToDate"
                       value="@(filter.ToDate?.ToString("yyyy-MM-dd"))" />
            </div>

            @if (capabilities.ShowOwner)
            {
                <div class="afr-field">
                    <label>المالك</label>
                    <select name="OwnerId">
                        <option value="">كل الملاك</option>
                        @foreach (var owner in Model.Owners)
                        {
                            <option value="@owner.OwnerId"
                                    selected="@(filter.OwnerId == owner.OwnerId ? "selected" : null)">
                                @owner.OwnerName
                            </option>
                        }
                    </select>
                </div>
            }

            @if (capabilities.ShowPlace)
            {
                <div class="afr-field">
                    <label>المنشأة</label>
                    <select name="PlaceId">
                        <option value="">كل المنشآت</option>
                        @foreach (var place in Model.Places)
                        {
                            <option value="@place.PlaceId"
                                    selected="@(filter.PlaceId == place.PlaceId ? "selected" : null)">
                                @place.PlaceName
                            </option>
                        }
                    </select>
                </div>
            }

            @if (capabilities.ShowBookingId)
            {
                <div class="afr-field">
                    <label>رقم الحجز</label>
                    <input type="number"
                           name="BookingId"
                           min="1"
                           value="@filter.BookingId" />
                </div>
            }

            @if (capabilities.ShowTransactionId)
            {
                <div class="afr-field">
                    <label>رقم الحركة/الطلب</label>
                    <input type="number"
                           name="CommissionTransactionId"
                           min="1"
                           value="@filter.CommissionTransactionId" />
                </div>
            }

            @if (capabilities.ShowPlatformWallet)
            {
                <div class="afr-field">
                    <label>حساب المنصة</label>
                    <select name="PlatformWalletId">
                        <option value="">كل الحسابات</option>
                        @foreach (var wallet in Model.PlatformWallets)
                        {
                            <option value="@wallet.PlatformWalletId"
                                    selected="@(filter.PlatformWalletId == wallet.PlatformWalletId ? "selected" : null)">
                                @wallet.WalletName — @wallet.AccountNumber
                            </option>
                        }
                    </select>
                </div>
            }

            @if (capabilities.ShowCommissionStatus)
            {
                <div class="afr-field">
                    <label>حالة العمولة</label>
                    <select name="CommissionStatus">
                        <option value="">كل الحالات</option>
                        @foreach (var option in Model.CommissionStatusOptions)
                        {
                            <option value="@option.Value"
                                    selected="@(option.IsSelected ? "selected" : null)">
                                @option.Label
                            </option>
                        }
                    </select>
                </div>
            }

            @if (capabilities.ShowAccountStatus)
            {
                <div class="afr-field">
                    <label>حالة الحساب</label>
                    <select name="AccountStatus">
                        <option value="">كل الحالات</option>
                        @foreach (var option in Model.AccountStatusOptions)
                        {
                            <option value="@option.Value"
                                    selected="@(option.IsSelected ? "selected" : null)">
                                @option.Label
                            </option>
                        }
                    </select>
                </div>
            }

            @if (capabilities.ShowTransactionType)
            {
                <div class="afr-field">
                    <label>نوع الحركة</label>
                    <select name="TransactionType">
                        <option value="">كل الأنواع</option>
                        @foreach (var option in Model.TransactionTypeOptions)
                        {
                            <option value="@option.Value"
                                    selected="@(option.IsSelected ? "selected" : null)">
                                @option.Label
                            </option>
                        }
                    </select>
                </div>
            }

            @if (capabilities.ShowTransactionStatus)
            {
                <div class="afr-field">
                    <label>حالة الحركة</label>
                    <select name="TransactionStatus">
                        <option value="">كل الحالات</option>
                        @foreach (var option in Model.TransactionStatusOptions)
                        {
                            <option value="@option.Value"
                                    selected="@(option.IsSelected ? "selected" : null)">
                                @option.Label
                            </option>
                        }
                    </select>
                </div>
            }

            @if (capabilities.ShowTopUpStatus)
            {
                <div class="afr-field">
                    <label>حالة الشحن</label>
                    <select name="TopUpStatus">
                        <option value="">كل الحالات</option>
                        @foreach (var option in Model.TopUpStatusOptions)
                        {
                            <option value="@option.Value"
                                    selected="@(option.IsSelected ? "selected" : null)">
                                @option.Label
                            </option>
                        }
                    </select>
                </div>
            }

            @if (capabilities.ShowReferenceNumber)
            {
                <div class="afr-field">
                    <label>المرجع</label>
                    <input type="text"
                           name="ReferenceNumber"
                           value="@filter.ReferenceNumber" />
                </div>
            }

            @if (capabilities.ShowSearch)
            {
                <div class="afr-field afr-field--wide">
                    <label>بحث</label>
                    <div class="afr-search-field">
                        <i class="bi bi-search"></i>
                        <input type="search"
                               name="Search"
                               value="@filter.Search"
                               placeholder="بحث داخل نتائج التقرير..." />
                    </div>
                </div>
            }
        </div>

        <div class="afr-boolean-filters">
            @if (capabilities.ShowHasDebt)
            {
                <label class="afr-check-pill">
                    <input type="checkbox"
                           name="HasDebt"
                           value="true"
                           checked="@(filter.HasDebt == true ? "checked" : null)" />
                    <span>عليها دين فقط</span>
                </label>
            }

            @if (capabilities.ShowLowBalance)
            {
                <label class="afr-check-pill">
                    <input type="checkbox"
                           name="IsLowBalance"
                           value="true"
                           checked="@(filter.IsLowBalance == true ? "checked" : null)" />
                    <span>رصيد منخفض فقط</span>
                </label>
            }

            @if (capabilities.ShowSuspended)
            {
                <label class="afr-check-pill">
                    <input type="checkbox"
                           name="IsSuspended"
                           value="true"
                           checked="@(filter.IsSuspended == true ? "checked" : null)" />
                    <span>الموقوفة فقط</span>
                </label>
            }
        </div>

        <div class="afr-filter-card__actions">
            <button type="submit" class="afr-btn afr-btn--primary">
                <i class="bi bi-play-fill"></i>
                عرض التقرير
            </button>
        </div>
    </form>

    <section class="afr-report-header-card">
        <div class="afr-report-header-card__identity">
            <span class="afr-report-header-card__mark">
                <i class="bi bi-file-earmark-bar-graph"></i>
            </span>
            <div>
                <span class="afr-report-header-card__eyebrow">@Model.PeriodLabel</span>
                <h3>@Model.Title</h3>
                <p>@Model.FilterDescription</p>
            </div>
        </div>

        <div class="afr-report-header-card__meta">
            <div>
                <small>عدد النتائج</small>
                <strong>@Model.TotalAvailableRows</strong>
            </div>
            <div>
                <small>تاريخ الإنشاء</small>
                <strong>@Model.GeneratedAt.ToString("yyyy/MM/dd HH:mm")</strong>
            </div>
        </div>
    </section>

    @if (Model.Metrics.Count > 0)
    {
        <div class="afr-metrics">
            @foreach (var metric in Model.Metrics.Take(4))
            {
                <article class="afr-metric afr-metric--@MetricTone(metric.Tone)">
                    <span class="afr-metric__icon">
                        <i class="@(string.IsNullOrWhiteSpace(metric.IconClass) ? "bi bi-activity" : metric.IconClass)"></i>
                    </span>
                    <div>
                        <small>@metric.Label</small>
                        <strong>@display.Metric(metric)</strong>
                        @if (!string.IsNullOrWhiteSpace(metric.Hint))
                        {
                            <span>@metric.Hint</span>
                        }
                    </div>
                </article>
            }
        </div>
    }

    <div class="afr-sections">
        @foreach (var reportSection in Model.Sections)
        {
            <section class="afr-data-card @(reportSection.IsPrimary ? "afr-data-card--primary" : null)">
                <div class="afr-data-card__head">
                    <div>
                        <span class="afr-data-card__eyebrow">بيانات التقرير</span>
                        <h3>@reportSection.Title</h3>
                        @if (!string.IsNullOrWhiteSpace(reportSection.Description))
                        {
                            <p>@reportSection.Description</p>
                        }
                    </div>

                    <span class="afr-data-card__count">@reportSection.Rows.Count سجل</span>
                </div>

                @if (reportSection.Rows.Count == 0)
                {
                    <div class="afr-empty">
                        <span class="afr-empty__icon"><i class="bi bi-inbox"></i></span>
                        <h4>@(string.IsNullOrWhiteSpace(reportSection.EmptyMessage) ? "لا توجد بيانات" : reportSection.EmptyMessage)</h4>
                        <p>غيّر الفلاتر أو الفترة الزمنية وحاول مجددًا.</p>
                    </div>
                }
                else
                {
                    var hasDocuments = reportSection.Rows.Any(r =>
                        !string.IsNullOrWhiteSpace(r.DocumentType) &&
                        r.DocumentSourceId.HasValue);

                    <div class="afr-table-wrap">
                        <table class="afr-table">
                            <thead>
                                <tr>
                                    @foreach (var column in reportSection.Columns.Where(c => c.IsVisible))
                                    {
                                        <th class="afr-align-@column.Alignment.ToLowerInvariant()">
                                            @column.Label
                                        </th>
                                    }
                                    @if (hasDocuments)
                                    {
                                        <th></th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in reportSection.Rows)
                                {
                                    <tr data-tone="@row.Tone">
                                        @{
                                            var visibleIndexes = reportSection.Columns
                                                .Select((column, index) => new { column, index })
                                                .Where(x => x.column.IsVisible)
                                                .ToList();
                                        }

                                        @foreach (var entry in visibleIndexes)
                                        {
                                            var cell = row.TypedCells.Count > entry.index
                                                ? row.TypedCells[entry.index]
                                                : null;

                                            <td class="afr-cell afr-cell--@CellTone(cell)">
                                                @if (cell != null && !string.IsNullOrWhiteSpace(cell.LinkUrl))
                                                {
                                                    <a href="@cell.LinkUrl">@display.Cell(cell, row.PlaceId)</a>
                                                }
                                                else
                                                {
                                                    <span title="@cell?.Tooltip">@display.Cell(cell, row.PlaceId)</span>
                                                }
                                            </td>
                                        }

                                        @if (hasDocuments)
                                        {
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(row.DocumentType) &&
                                                     row.DocumentSourceId.HasValue)
                                                {
                                                    <a class="afr-row-action"
                                                       href="@Url.Action("Document", "AdminFinancialReports", new { area = "Admin", documentType = row.DocumentType, sourceId = row.DocumentSourceId.Value })"
                                                       target="_blank">
                                                        مستند
                                                        <i class="bi bi-arrow-up-left"></i>
                                                    </a>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    </div>

    @if (Model.Documents.Count > 0)
    {
        <section class="afr-documents">
            <div class="afr-documents__head">
                <div>
                    <span>مستندات جاهزة</span>
                    <h3>المستندات المالية</h3>
                    <p>مستندات رسمية مرتبطة بنتائج التقرير الحالية.</p>
                </div>
                <span class="afr-documents__count">@Model.Documents.Count</span>
            </div>

            <div class="afr-document-grid">
                @foreach (var document in Model.Documents.Take(12))
                {
                    <article class="afr-document-card">
                        <div class="afr-document-card__top">
                            <span class="afr-document-card__icon">
                                <i class="bi bi-file-earmark-text"></i>
                            </span>
                            <span class="afr-document-card__status">@document.Status</span>
                        </div>

                        <div class="afr-document-card__body">
                            <small>@document.DocumentNumber</small>
                            <h4>@document.Title</h4>
                            <p>
                                @(string.IsNullOrWhiteSpace(document.PlaceName)
                                    ? document.Subtitle
                                    : document.PlaceName)
                            </p>
                        </div>

                        <div class="afr-document-card__meta">
                            @if (document.Amount.HasValue)
                            {
                                <strong>@display.Money(document.Amount.Value, document.PlaceId)</strong>
                            }
                            <span>@document.DocumentDate.ToString("yyyy/MM/dd")</span>
                        </div>

                        <div class="afr-document-card__actions">
                            <a href="@Url.Action("Document", "AdminFinancialReports", new { area = "Admin", documentType = document.DocumentType, sourceId = document.SourceId, autoPrint = false })"
                               target="_blank">
                                عرض
                            </a>
                            <a class="is-primary"
                               href="@Url.Action("Document", "AdminFinancialReports", new { area = "Admin", documentType = document.DocumentType, sourceId = document.SourceId, autoPrint = true })"
                               target="_blank">
                                طباعة
                            </a>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
    }
</section>
