                <div class="quick-add-slot">
                    <button type="button"
                        class="btn-royal-add emerald-add mt-0 quick-add-button"
                        onclick="addQuickReply()"
                        aria-label="إضافة سؤال سريع خاص">
                    <i class="bi bi-plus-circle"></i>
                    <span>إضافة سؤال سريع</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="custom-quick-zone">
            <div class="custom-quick-zone__header">
                <div class="custom-quick-zone__title">
                    <i class="bi bi-stars"></i>
                    <span>أسئلتك المخصصة</span>
                </div>
                <span class="custom-quick-zone__limit">حتى 5 أسئلة خاصة</span>
            </div>
            <div id="customQuickRepliesContainer"
                 class="policy-builder-list d-flex flex-column gap-2"
                 aria-label="الأسئلة السريعة الخاصة التي أضافها المالك"></div>
        </div>

        <div class="policy-card__note mt-3 communication-quick-note">
            <i class="bi bi-shield-check"></i>
            الأسئلة الخمسة الأساسية يجيب عنها النظام من البيانات الحالية. أما السؤال الذي تضيفه بنفسك فيجب كتابة السؤال وإجابته، ويُرسل الرد الجاهز تلقائيًا عند اختيار العميل له.
        </div>
    </section>

    <div class="communication-hidden-settings" aria-hidden="true">
        <section class="royal-card policy-card policy-card--neutral silver-theme d-none" aria-hidden="true">
            <header class="policy-card__header policy-card__header--compact">
                <span class="icon-glow-wrapper policy-card__icon" aria-hidden="true">
                    <i class="bi bi-bell-fill"></i>
                </span>
                <div>
                    <span class="policy-card__kicker">الرسائل الجديدة</span>
                    <h2>التنبيهات</h2>
                    <p>اختر الطريقة المناسبة لتنبيهك عند وصول رسالة.</p>
                </div>
            </header>

            <div class="policy-toggle-list">
                <label class="policy-toggle-card">
                    <span class="policy-toggle-card__icon policy-toggle-card__icon--green">
                        <i class="bi bi-music-note-beamed"></i>
                    </span>
                    <span class="policy-toggle-card__copy">
                        <strong>تنبيه صوتي</strong>
                        <small>تشغيل رنين عند وصول رسالة.</small>
                    </span>
                    <span class="form-check form-switch m-0">
                        <input class="form-check-input"
                               type="checkbox"
                               id="isSoundAlertEnabled"
                               checked />
                    </span>
                </label>

                <label class="policy-toggle-card">
                    <span class="policy-toggle-card__icon policy-toggle-card__icon--cyan">
                        <i class="bi bi-app-indicator"></i>
                    </span>
                    <span class="policy-toggle-card__copy">
                        <strong>إشعار منبثق</strong>
                        <small>عرض إشعار فوري داخل لوحة التحكم.</small>
                    </span>
                    <span class="form-check form-switch m-0">
                        <input class="form-check-input"
                               type="checkbox"
                               id="isPushNoticeEnabled"
                               checked />
                    </span>
                </label>
            </div>
        </section>
    </div>

    <footer class="policy-save-bar communication-save-bar">
        <div class="policy-save-bar__copy">
            <i class="bi bi-info-circle"></i>
            <span>تُطبق إعدادات التواصل والأسئلة السريعة على المنشأة الحالية فقط.</span>
        </div>
        <button type="button" class="btn-royal-save">
            <i class="bi bi-send-check-fill"></i>
            <span>حفظ إعدادات التواصل</span>
        </button>
    </footer>
</div>

<script>
    // تمديد منطق الأسئلة السريعة باستخدام الملفات الحالية فقط.
    // لا نضيف جدولًا أو ملف JavaScript جديدًا، ونحافظ على QuickRepliesJson الموجود أصلًا.
    document.addEventListener("DOMContentLoaded", function installOwnerCustomQuickQuestions() {
        if (window.__yemenGuideCustomQuickQuestionsInstalled === true) return;
        window.__yemenGuideCustomQuickQuestionsInstalled = true;

        const customQuickReplyType = "custom-quick-reply";
        const maximumCustomQuickQuestions = 5;

        function createCustomQuickQuestionKey() {
            if (window.crypto?.randomUUID) {
                return `custom_${window.crypto.randomUUID().replace(/-/g, "")}`;
            }

            return `custom_${Date.now()}_${Math.random().toString(36).slice(2, 10)}`;
        }

        function getObjectValue(source, ...keys) {
            for (const key of keys) {
                const value = source?.[key];
                if (value !== undefined && value !== null) return String(value);
            }
            return "";
        }

        function isOldQuickReply(item) {
            if (!item || typeof item !== "object") return false;

            const type = getObjectValue(item, "type", "Type").trim();
            if (type) return false;

            const question = getObjectValue(item, "question", "Question", "title", "Title").trim();
            const answer = getObjectValue(item, "answer", "Answer", "reply", "Reply").trim();
            return Boolean(question && answer);
        }

        function createCustomQuickReplyItem(reply = {}, editing = false) {
            const item = document.createElement("div");
            const question = getObjectValue(
                reply,
                "question",
                "Question",
                "title",
                "Title"
            ).trim();
            const answer = getObjectValue(
                reply,
                "answer",
                "Answer",
                "reply",
                "Reply"
            ).trim();
            const existingKey = getObjectValue(reply, "key", "Key").trim().toLowerCase();

            item.className =
                "luxury-list-item policy-builder-item policy-builder-item--reply fade-in-up";
            item.dataset.quickQuestionKey =
                existingKey.startsWith("custom_")
                    ? existingKey
                    : createCustomQuickQuestionKey();

            item.innerHTML = `
                <span class="item-icon policy-builder-item__icon" aria-hidden="true">
                    <i class="bi bi-question-circle-fill"></i>
                </span>
                <div class="input-group input-group-sm flex-grow-1 policy-quick-reply-fields">
                    <span class="input-group-text">السؤال</span>
                    <input type="text"
                           class="form-control fw-bold text-primary custom-quick-question ${editing ? "editing-mode" : ""}"
                           value="${escapeAttribute(question)}"
                           maxlength="140"
                           placeholder="مثال: هل يوجد موقف سيارات؟"
                           aria-label="السؤال السريع"
                           ${editing ? "" : "readonly"}>
                    <span class="input-group-text">الإجابة</span>
                    <input type="text"
                           class="form-control fw-bold policy-desc custom-quick-answer ${editing ? "editing-mode" : ""}"
                           value="${escapeAttribute(answer)}"
                           maxlength="1200"
                           placeholder="اكتب الإجابة التي ستُرسل للعميل تلقائيًا..."
                           aria-label="إجابة السؤال السريع"
                           ${editing ? "" : "readonly"}>
                </div>
                ${buildItemActionsHtml("السؤال السريع", editing)}
            `;

            return item;
        }

        window.addQuickReply = function addQuickReply() {
            const container = document.getElementById("customQuickRepliesContainer");
            if (!container) return;

            const existingItems = container.querySelectorAll(".policy-builder-item--reply");
            if (existingItems.length >= maximumCustomQuickQuestions) {
                Swal.fire({
                    icon: "info",
                    title: "الحد الأقصى للأسئلة الخاصة",
                    text: "يمكن إضافة خمسة أسئلة خاصة كحد أقصى بالإضافة إلى الأسئلة الأساسية الخمسة.",
                    confirmButtonColor: "#00A6DA"
                });
                return;
            }

            const item = createCustomQuickReplyItem({}, true);
            container.appendChild(item);
            item.querySelector(".custom-quick-question")?.focus();
        };

        window.serializeQuickRepliesList = function serializeQuickRepliesList() {
            const topicInputs = Array.from(
                document.querySelectorAll("#quickRepliesContainer [data-customer-quick-topic]")
            );

            const topics = topicInputs
                .filter(input => input.checked)
                .map(input => ({
                    type: "customer-topic",
                    key: input.dataset.topicKey || "",
                    title: input.dataset.topicTitle || "",
                    question: input.dataset.topicQuestion || ""
                }))
                .filter(topic => topic.key && topic.title && topic.question);

            const customReplies = Array.from(
                document.querySelectorAll(
                    "#customQuickRepliesContainer .policy-builder-item--reply"
                )
            )
                .map(item => {
                    const question =
                        item.querySelector(".custom-quick-question")?.value.trim() || "";
                    const answer =
                        item.querySelector(".custom-quick-answer")?.value.trim() || "";
                    let key = String(item.dataset.quickQuestionKey || "")
                        .trim()
                        .toLowerCase();

                    if (!key.startsWith("custom_")) {
                        key = createCustomQuickQuestionKey();
                        item.dataset.quickQuestionKey = key;
                    }

                    return {
                        type: customQuickReplyType,
                        key,
                        question,
                        answer,
                        title: question,
                        reply: answer
                    };
                })
                .filter(item => item.question && item.answer)
                .slice(0, maximumCustomQuickQuestions);

            return JSON.stringify([
                { type: "customer-topic-config", version: 2 },
                ...topics,
                ...customReplies,
                ...facilityPolicyState.legacyQuickReplies
            ]);
        };

        window.rebuildQuickRepliesList = function rebuildQuickRepliesList(jsonText) {
            const fixedContainer = document.getElementById("quickRepliesContainer");
            const customContainer = document.getElementById("customQuickRepliesContainer");
            if (!fixedContainer) return;

            const parsed = parseJsonArray(jsonText);
            const topicInputs = Array.from(
                fixedContainer.querySelectorAll("[data-customer-quick-topic]")
            );

            const hasTopicConfig = parsed.some(item =>
                item &&
                typeof item === "object" &&
                getObjectValue(item, "type", "Type").trim().toLowerCase() ===
                    "customer-topic-config"
            );

            const selectedKeys = new Set(
                parsed
                    .filter(item => item && typeof item === "object")
                    .filter(item =>
                        getObjectValue(item, "type", "Type").trim().toLowerCase() ===
                        "customer-topic"
                    )
                    .map(item =>
                        getObjectValue(
                            item,
                            "key",
                            "Key",
                            "topicKey",
                            "TopicKey"
                        ).trim().toLowerCase()
                    )
                    .filter(Boolean)
            );

            // لا نغير القيم الافتراضية للخمسة الأساسية إلا إذا وُجد حفظ صريح سابق.
            if (hasTopicConfig || selectedKeys.size > 0) {
                topicInputs.forEach(input => {
                    const key = String(input.dataset.topicKey || "")
                        .trim()
                        .toLowerCase();
                    input.checked = selectedKeys.has(key);
                });
            }

            const customItems = [];
            const preservedLegacyItems = [];

            parsed.forEach(item => {
                if (!item || typeof item !== "object") return;

                const type = getObjectValue(item, "type", "Type")
                    .trim()
                    .toLowerCase();

                if (type === "customer-topic" || type === "customer-topic-config") {
                    return;
                }

                if (type === customQuickReplyType || isOldQuickReply(item)) {
                    customItems.push(item);
                    return;
                }

                // أي صيغة قديمة غير معروفة نحافظ عليها كما هي حتى لا نفقد بيانات.
                preservedLegacyItems.push({ ...item });
            });

            facilityPolicyState.legacyQuickReplies = preservedLegacyItems;

            if (!customContainer) return;
            customContainer.innerHTML = "";

            customItems
                .slice(0, maximumCustomQuickQuestions)
                .forEach(reply => {
                    customContainer.appendChild(
                        createCustomQuickReplyItem(reply, false)
                    );
                });
        };

        const originalValidateFacilitySettingsForm =
            window.validateFacilitySettingsForm;

        window.validateFacilitySettingsForm = function validateFacilitySettingsForm() {
            const errors = typeof originalValidateFacilitySettingsForm === "function"
                ? originalValidateFacilitySettingsForm()
                : [];

            const items = Array.from(
                document.querySelectorAll(
                    "#customQuickRepliesContainer .policy-builder-item--reply"
                )
            );
            const normalizedQuestions = new Set();

            for (const item of items) {
                const questionInput = item.querySelector(".custom-quick-question");
                const answerInput = item.querySelector(".custom-quick-answer");
                const question = questionInput?.value.trim() || "";
                const answer = answerInput?.value.trim() || "";

                if (!question || !answer) {
                    errors.push({
                        tab: "communication-tab",
                        target: !question
                            ? "#customQuickRepliesContainer .custom-quick-question"
                            : "#customQuickRepliesContainer .custom-quick-answer",
                        message: "أكمل السؤال والإجابة للسؤال السريع المضاف، أو احذفه إذا لم تعد تحتاجه."
                    });
                    break;
                }

                const normalizedQuestion = question
                    .toLowerCase()
                    .replace(/\s+/g, " ")
                    .trim();

                if (normalizedQuestions.has(normalizedQuestion)) {
                    errors.push({
                        tab: "communication-tab",
                        target: "#customQuickRepliesContainer",
                        message: "يوجد سؤال سريع مكرر. عدّل السؤال المكرر أو احذفه."
                    });
                    break;
                }

                normalizedQuestions.add(normalizedQuestion);
            }

            return errors;
        };
    });
</script>
