        @* =========================================================
        4. تبويب الصيانة والطوارئ — النسخة المبسطة والواضحة
        ========================================================= *@

        <div id="settings-maintenance-panel" class="tab-pane-content maintenance-tab settings-tab-panel" role="tabpanel" style="display: none;">

            <div class="settings-tab-intro settings-tab-intro--danger mb-4">
                <div class="settings-tab-intro__icon"><i class="bi bi-tools"></i></div>
                <div class="settings-tab-intro__copy">
                    <span>مركز الصيانة</span>
                    <h2>شغّل الصيانة بخطوات بسيطة وواضحة</h2>
                    <p>ابدأ من المفتاح الرئيسي، ثم اختر ما تريد إيقافه ومن يتأثر ومتى تبدأ الصيانة. الإدارة تبقى مستثناة دائمًا.</p>
                </div>
            </div>

            <section class="maintenance-simple"
                     data-maintenance-center
                     data-enabled="@Model.MaintenanceMode.ToString().ToLowerInvariant()"
                     data-type="@maintenanceType">

                @* الحالة الرئيسية *@
                <div class="maintenance-simple-status" data-maintenance-status-board>
                    <div class="maintenance-simple-status__identity">
                        <span class="maintenance-simple-status__icon" aria-hidden="true">
                            <i class="bi bi-check2-circle"></i>
                        </span>
                        <div>
                            <small>حالة المنصة</small>
                            <h3 id="maintenanceStatusTitle">
                                @(Model.MaintenanceMode ? "وضع الصيانة مفعّل" : "المنصة تعمل بشكل طبيعي")
                            </h3>
                            <p id="maintenanceStatusDescription">
                                @(Model.MaintenanceMode
                                    ? "إعدادات الصيانة أدناه هي التي ستحدد ما الذي يتوقف ومن يتأثر."
                                    : "لا توجد قيود صيانة مفعلة الآن، وجميع الخدمات تعمل بصورة طبيعية.")
                            </p>
                        </div>
                    </div>

                    <label class="maintenance-simple-power" for="maintenanceMode">
                        <span>
                            <strong id="maintenancePowerLabel">@(Model.MaintenanceMode ? "إيقاف الصيانة" : "تشغيل الصيانة")</strong>
                            <small>المفتاح الرئيسي</small>
                        </span>
                        <span class="form-check form-switch m-0">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="maintenanceMode"
                                   @(Model.MaintenanceMode ? "checked" : null)>
                        </span>
                    </label>
                </div>

                <div class="maintenance-simple-normal-note" id="maintenanceNormalNote">
                    <i class="bi bi-check-circle-fill"></i>
                    <div>
                        <strong>كل شيء طبيعي الآن</strong>
                        <span>إذا لم تكن بحاجة إلى صيانة، لا تحتاج إلى تغيير أي شيء. فعّل المفتاح فقط عندما تريد تطبيق الصيانة.</span>
                    </div>
                </div>

                @* تظهر الخطوات فقط عند تفعيل الصيانة *@
                <div class="maintenance-simple-setup" id="maintenanceSetupPanel">

                    @* 1. النوع *@
                    <section class="maintenance-simple-step">
                        <header class="maintenance-simple-step__head">
                            <span class="maintenance-simple-step__number">1</span>
                            <div>
                                <h3>ماذا تريد أن توقف؟</h3>
                                <p>اختر الخيار الذي يصف ما تريد فعله بالضبط.</p>
                            </div>
                        </header>

                        <div class="maintenance-simple-choice-grid maintenance-simple-choice-grid--three" role="radiogroup" aria-label="نوع الصيانة">
                            <label class="maintenance-simple-choice maintenance-simple-choice--danger" data-maintenance-type-card="Full">
                                <input type="radio"
                                       name="maintenanceType"
                                       id="maintenanceTypeFull"
                                       value="Full"
                                       @(maintenanceType == "Full" ? "checked" : null)>
                                <span class="maintenance-simple-choice__check"><i class="bi bi-check-lg"></i></span>
                                <span class="maintenance-simple-choice__icon"><i class="bi bi-lock-fill"></i></span>
                                <span class="maintenance-simple-choice__copy">
                                    <strong>إغلاق المنصة بالكامل</strong>
                                    <small>يظهر للمستخدمين شاشة الصيانة ولا يستطيعون استخدام المنصة.</small>
                                </span>
                                <span class="maintenance-simple-choice__footer">أقوى وضع</span>
                            </label>

                            <label class="maintenance-simple-choice maintenance-simple-choice--warning" data-maintenance-type-card="ReadOnly">
                                <input type="radio"
                                       name="maintenanceType"
                                       id="maintenanceTypeReadOnly"
                                       value="ReadOnly"
                                       @(maintenanceType == "ReadOnly" ? "checked" : null)>
                                <span class="maintenance-simple-choice__check"><i class="bi bi-check-lg"></i></span>
                                <span class="maintenance-simple-choice__icon"><i class="bi bi-eye-fill"></i></span>
                                <span class="maintenance-simple-choice__copy">
                                    <strong>السماح بالتصفح فقط</strong>
                                    <small>يشاهد المستخدم المحتوى، لكن العمليات التي تغيّر البيانات تتوقف.</small>
                                </span>
                                <span class="maintenance-simple-choice__footer">مشاهدة فقط</span>
                            </label>

                            <label class="maintenance-simple-choice maintenance-simple-choice--primary" data-maintenance-type-card="Partial">
                                <input type="radio"
                                       name="maintenanceType"
                                       id="maintenanceTypePartial"
                                       value="Partial"
                                       @(maintenanceType == "Partial" ? "checked" : null)>
                                <span class="maintenance-simple-choice__check"><i class="bi bi-check-lg"></i></span>
                                <span class="maintenance-simple-choice__icon"><i class="bi bi-sliders2"></i></span>
                                <span class="maintenance-simple-choice__copy">
                                    <strong>إيقاف خدمات محددة فقط</strong>
                                    <small>المنصة تستمر بالعمل، وأنت تختار الخدمات التي تريد إيقافها.</small>
                                </span>
                                <span class="maintenance-simple-choice__footer">تحكم دقيق</span>
                            </label>
                        </div>

                        @* تظهر فقط مع الصيانة الجزئية *@
                        <div class="maintenance-simple-partial" id="maintenancePartialPanel" data-maintenance-partial-panel>
                            <div class="maintenance-simple-partial__head">
                                <i class="bi bi-ui-checks-grid"></i>
                                <div>
                                    <strong>ما الخدمات التي تريد إيقافها؟</strong>
                                    <span>اضغط على أي خدمة لإيقافها مؤقتًا. الباقي سيستمر بالعمل.</span>
                                </div>
                            </div>

                            <div class="maintenance-simple-services">
                                <label class="maintenance-service-card" for="maintenanceBlockBookings">
                                    <input type="checkbox" id="maintenanceBlockBookings" @(Model.MaintenanceBlockBookings ? "checked" : null)>
                                    <span class="maintenance-service-card__icon"><i class="bi bi-calendar-x"></i></span>
                                    <span class="maintenance-service-card__copy">
                                        <strong>الحجوزات</strong>
                                        <small>إنشاء وإدارة الحجوزات</small>
                                    </span>
                                    <span class="maintenance-service-card__state">يعمل</span>
                                </label>

                                <label class="maintenance-service-card" for="maintenanceBlockPayments">
                                    <input type="checkbox" id="maintenanceBlockPayments" @(Model.MaintenanceBlockPayments ? "checked" : null)>
                                    <span class="maintenance-service-card__icon"><i class="bi bi-credit-card"></i></span>
                                    <span class="maintenance-service-card__copy">
                                        <strong>المدفوعات</strong>
                                        <small>الدفع وإثباتات الدفع</small>
                                    </span>
                                    <span class="maintenance-service-card__state">يعمل</span>
                                </label>

                                <label class="maintenance-service-card" for="maintenanceBlockOwnerChanges">
                                    <input type="checkbox" id="maintenanceBlockOwnerChanges" @(Model.MaintenanceBlockOwnerChanges ? "checked" : null)>
                                    <span class="maintenance-service-card__icon"><i class="bi bi-building-gear"></i></span>
                                    <span class="maintenance-service-card__copy">
                                        <strong>تعديلات المالك</strong>
                                        <small>المنشآت والغرف والباقات والسياسات</small>
                                    </span>
                                    <span class="maintenance-service-card__state">يعمل</span>
                                </label>

                                <label class="maintenance-service-card" for="maintenanceBlockMessages">
                                    <input type="checkbox" id="maintenanceBlockMessages" @(Model.MaintenanceBlockMessages ? "checked" : null)>
                                    <span class="maintenance-service-card__icon"><i class="bi bi-chat-dots"></i></span>
                                    <span class="maintenance-service-card__copy">
                                        <strong>الرسائل</strong>
                                        <small>إرسال الرسائل الجديدة</small>
                                    </span>
                                    <span class="maintenance-service-card__state">يعمل</span>
                                </label>

                                <label class="maintenance-service-card" for="maintenanceBlockReviews">
                                    <input type="checkbox" id="maintenanceBlockReviews" @(Model.MaintenanceBlockReviews ? "checked" : null)>
                                    <span class="maintenance-service-card__icon"><i class="bi bi-star"></i></span>
                                    <span class="maintenance-service-card__copy">
                                        <strong>التقييمات</strong>
                                        <small>إضافة وتعديل التقييمات</small>
                                    </span>
                                    <span class="maintenance-service-card__state">يعمل</span>
                                </label>

                                <label class="maintenance-service-card" for="maintenanceBlockRegistrations">
                                    <input type="checkbox" id="maintenanceBlockRegistrations" @(Model.MaintenanceBlockRegistrations ? "checked" : null)>
                                    <span class="maintenance-service-card__icon"><i class="bi bi-person-plus"></i></span>
                                    <span class="maintenance-service-card__copy">
                                        <strong>التسجيل</strong>
                                        <small>إنشاء حسابات جديدة</small>
                                    </span>
                                    <span class="maintenance-service-card__state">يعمل</span>
                                </label>
                            </div>
                        </div>
                    </section>

                    @* 2. النطاق *@
                    <section class="maintenance-simple-step">
                        <header class="maintenance-simple-step__head">
                            <span class="maintenance-simple-step__number">2</span>
                            <div>
                                <h3>من سيتأثر بالصيانة؟</h3>
                                <p>اختر الفئة التي تريد تطبيق الصيانة عليها.</p>
                            </div>
                        </header>

                        <input type="checkbox"
                               id="maintenanceAffectOwners"
                               @(Model.MaintenanceAffectOwners == true ? "checked" : null)
                               hidden>

                        <div class="maintenance-simple-choice-grid maintenance-simple-choice-grid--two" role="radiogroup" aria-label="الفئات المتأثرة بالصيانة">
                            <label class="maintenance-simple-choice maintenance-simple-choice--compact" data-maintenance-scope-card="customers">
                                <input type="radio"
                                       name="maintenanceScope"
                                       id="maintenanceScopeCustomers"
                                       value="customers"
                                       @(Model.MaintenanceAffectOwners != true ? "checked" : null)>
                                <span class="maintenance-simple-choice__check"><i class="bi bi-check-lg"></i></span>
                                <span class="maintenance-simple-choice__icon"><i class="bi bi-people"></i></span>
                                <span class="maintenance-simple-choice__copy">
                                    <strong>العملاء والزوار فقط</strong>
                                    <small>المالكون يستمرون في استخدام لوحة التحكم.</small>
                                </span>
                            </label>

                            <label class="maintenance-simple-choice maintenance-simple-choice--compact" data-maintenance-scope-card="everyone">
                                <input type="radio"
                                       name="maintenanceScope"
                                       id="maintenanceScopeEveryone"
                                       value="everyone"
                                       @(Model.MaintenanceAffectOwners == true ? "checked" : null)>
                                <span class="maintenance-simple-choice__check"><i class="bi bi-check-lg"></i></span>
                                <span class="maintenance-simple-choice__icon"><i class="bi bi-buildings"></i></span>
                                <span class="maintenance-simple-choice__copy">
                                    <strong>العملاء والزوار والمالكون</strong>
                                    <small>الصيانة تشمل جميع الواجهات ما عدا الإدارة.</small>
                                </span>
                            </label>
                        </div>

                        <div class="maintenance-simple-admin-note">
                            <i class="bi bi-person-badge-fill"></i>
                            <div>
                                <strong>الإدارة مستثناة دائمًا</strong>
                                <span>يمكن لموظفي الإدارة المصرح لهم الدخول وإيقاف الصيانة أو تعديل إعداداتها.</span>
                            </div>
                            <i class="bi bi-check-circle-fill"></i>
                        </div>
                    </section>

                    @* 3. الوقت *@
                    <section class="maintenance-simple-step">
                        <header class="maintenance-simple-step__head">
                            <span class="maintenance-simple-step__number">3</span>
                            <div>
                                <h3>متى تبدأ الصيانة؟</h3>
                                <p>شغّلها فورًا أو حدّد موعدًا لاحقًا بتوقيت اليمن.</p>
                            </div>
                        </header>

                        <div class="maintenance-simple-choice-grid maintenance-simple-choice-grid--two" role="radiogroup" aria-label="موعد بدء الصيانة">
                            <label class="maintenance-simple-choice maintenance-simple-choice--compact" data-maintenance-timing-card="now">
                                <input type="radio"
                                       name="maintenanceTiming"
                                       id="maintenanceTimingNow"
                                       value="now"
                                       @(string.IsNullOrWhiteSpace(maintenanceStartInput) ? "checked" : null)>
                                <span class="maintenance-simple-choice__check"><i class="bi bi-check-lg"></i></span>
                                <span class="maintenance-simple-choice__icon"><i class="bi bi-lightning-charge-fill"></i></span>
                                <span class="maintenance-simple-choice__copy">
                                    <strong>ابدأ الآن</strong>
                                    <small>تبدأ الصيانة بعد الحفظ مباشرة وتستمر حتى توقفها يدويًا.</small>
                                </span>
                            </label>

                            <label class="maintenance-simple-choice maintenance-simple-choice--compact" data-maintenance-timing-card="scheduled">
                                <input type="radio"
                                       name="maintenanceTiming"
                                       id="maintenanceTimingScheduled"
                                       value="scheduled"
                                       @(!string.IsNullOrWhiteSpace(maintenanceStartInput) ? "checked" : null)>
                                <span class="maintenance-simple-choice__check"><i class="bi bi-check-lg"></i></span>
                                <span class="maintenance-simple-choice__icon"><i class="bi bi-calendar2-week"></i></span>
                                <span class="maintenance-simple-choice__copy">
                                    <strong>تحديد موعد</strong>
                                    <small>اختر تاريخ ووقت البداية، ويمكن تحديد نهاية تلقائية.</small>
                                </span>
                            </label>
                        </div>

                        <div class="maintenance-simple-schedule" id="maintenanceSchedulePanel">
                            <div class="maintenance-simple-schedule__fields">
                                <div class="maintenance-simple-field">
                                    <label for="maintenanceStartAt">
                                        <span>موعد البداية</span>
                                        <small>بتوقيت اليمن</small>
                                    </label>
                                    <input type="datetime-local"
                                           class="form-control"
                                           id="maintenanceStartAt"
                                           value="@maintenanceStartInput">
                                </div>

                                <div class="maintenance-simple-field" id="maintenanceEndField">
                                    <label for="maintenanceEndAt">
                                        <span>موعد الانتهاء</span>
                                        <small>اختياري</small>
                                    </label>
                                    <input type="datetime-local"
                                           class="form-control"
                                           id="maintenanceEndAt"
                                           value="@maintenanceEndInput">
                                </div>
                            </div>

                            <label class="maintenance-simple-inline-toggle" for="maintenanceNoEnd">
                                <span>
                                    <strong>بدون موعد انتهاء</strong>
                                    <small>تستمر الصيانة حتى توقفها يدويًا.</small>
                                </span>
                                <span class="form-check form-switch m-0">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="maintenanceNoEnd"
                                           @(string.IsNullOrWhiteSpace(maintenanceEndInput) ? "checked" : null)>
                                </span>
                            </label>
                        </div>

                        <div class="maintenance-simple-summary-line" id="maintenanceScheduleSummary">
                            <i class="bi bi-clock-history"></i>
                            <span>سيبدأ وضع الصيانة فورًا بعد الحفظ.</span>
                        </div>
                    </section>

                    @* 4. الرسالة *@
                    <section class="maintenance-simple-step">
                        <header class="maintenance-simple-step__head">
                            <span class="maintenance-simple-step__number">4</span>
                            <div>
                                <h3>ماذا سيشاهد المستخدم؟</h3>
                                <p>اكتب رسالة قصيرة وواضحة. هذه هي الرسالة التي ستظهر عند الحاجة.</p>
                            </div>
                        </header>

                        <div class="maintenance-simple-message-grid">
                            <div class="maintenance-simple-field">
                                <label for="maintenanceTitle">
                                    <span>العنوان</span>
                                    <small>مثال: نعود إليكم قريبًا</small>
                                </label>
                                <input type="text"
                                       class="form-control"
                                       id="maintenanceTitle"
                                       maxlength="150"
                                       value="@(Model.MaintenanceTitle ?? "نعود إليكم قريبًا")"
                                       placeholder="نعود إليكم قريبًا">
                            </div>

                            <div class="maintenance-simple-field maintenance-simple-field--message">
                                <label for="maintenanceMessage">
                                    <span>رسالة الصيانة</span>
                                    <small>رسالة مطمئنة ومختصرة</small>
                                </label>
                                <textarea class="form-control"
                                          id="maintenanceMessage"
                                          maxlength="500"
                                          placeholder="نجري حاليًا بعض التحسينات على المنصة، وسنعود إليكم قريبًا...">@Model.MaintenanceMessage</textarea>
                                <div class="maintenance-simple-message-footer">
                                    <span><i class="bi bi-lightbulb"></i> اجعل الرسالة بسيطة ولا تذكر تفاصيل تقنية داخلية.</span>
                                    <span id="maintenanceMessageCounter">0 / 500</span>
                                </div>
                            </div>
                        </div>

                        <div class="settings-bilingual-pair mt-3">
                            <div class="settings-language-field settings-language-field--en" dir="ltr">
                                <span class="settings-language-badge">EN</span>
                                <div class="form-floating">
                                    <input type="text"
                                           class="form-control"
                                           id="maintenanceTitleEn"
                                           maxlength="150"
                                           value="@Model.MaintenanceTitleEn"
                                           placeholder="We’ll be back soon">
                                    <label for="maintenanceTitleEn">Maintenance title — English</label>
                                </div>
                            </div>

                            <div class="settings-language-field settings-language-field--en" dir="ltr">
                                <span class="settings-language-badge">EN</span>
                                <div class="form-floating">
                                    <textarea class="form-control"
                                              id="maintenanceMessageEn"
                                              maxlength="500"
                                              placeholder="We’re making improvements and will be back soon..."
                                              style="height: 110px">@Model.MaintenanceMessageEn</textarea>
                                    <label for="maintenanceMessageEn">Maintenance message — English</label>
                                </div>
                            </div>
                        </div>

                        <label class="maintenance-simple-contact" for="maintenanceShowContact">
                            <span class="maintenance-simple-contact__icon"><i class="bi bi-headset"></i></span>
                            <span class="maintenance-simple-contact__copy">
                                <strong>إظهار وسائل التواصل والدعم</strong>
                                <small>سيستخدم النظام البريد والهاتف والواتساب المسجلة في تبويب «التواصل».</small>
                            </span>
                            <span class="form-check form-switch m-0">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="maintenanceShowContact"
                                       @(Model.MaintenanceShowContact == true ? "checked" : null)>
                            </span>
                        </label>
                    </section>

                </div>

                @* الملخص والحفظ يبقيان ظاهرين حتى يمكن إيقاف الصيانة بسهولة *@
                <div class="maintenance-simple-final" data-maintenance-preview>
                    <div class="maintenance-simple-final__icon"><i class="bi bi-eye-fill"></i></div>
                    <div class="maintenance-simple-final__body">
                        <small>ملخص ما سيحدث عند الحفظ</small>
                        <strong id="maintenancePreviewTitle">سيتم تحديث الملخص تلقائيًا</strong>
                        <p id="maintenancePreviewText">غيّر الخيارات لترى النتيجة هنا قبل التطبيق.</p>
                    </div>
                    <span class="maintenance-simple-final__badge" id="maintenancePreviewBadge">طبيعي</span>
                    <button type="button" class="btn btn-primary btn-save-tab maintenance-save-button" onclick="saveAllSettings()">
                        <i class="bi bi-shield-check"></i>
                        <span id="maintenanceSaveButtonText">حفظ إعدادات الصيانة</span>
                    </button>
                </div>

            </section>

        </div>




        @* ✨ 5. تبويب شبكات الدفع *@
        <div class="tab-pane-content wallets-tab settings-tab-panel" style="display: none;">
            <div class="row g-4">

                <div class="col-12">
                    <div class="settings-card p-4">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="card-icon">
                                <i class="bi bi-plus-circle"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">إضافة شبكة معتمدة جديدة</h5>
                                <small class="text-muted">إدراج قناة دفع للنظام</small>
                            </div>
                        </div>

                        <form id="addSupportedWalletForm" onsubmit="createPlatformWallet(event)">
                            <div class="row g-3 align-items-end settings-wallet-form-row settings-wallet-form-row--bilingual">
                                <div class="col-lg-3 col-md-6">
                                    <div class="form-floating">
                                        <input type="text"
                                               class="form-control"
                                               id="newWalletName"
                                               placeholder="اسم الشبكة"
                                               dir="rtl"
                                               required>
                                        <label for="newWalletName">اسم البنك أو المحفظة — عربي</label>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6" dir="ltr">
                                    <div class="form-floating">
                                        <input type="text"
                                               class="form-control"
                                               id="newWalletNameEn"
                                               placeholder="Wallet or bank name"
                                               required>
                                        <label for="newWalletNameEn">Wallet / bank name — English</label>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-8">
                                    <div class="custom-file-upload-group">
                                        <label for="newWalletLogo"
                                               class="form-label small text-muted fw-bold mb-2 d-block">
                                            <i class="bi bi-image me-1 text-primary"></i>
                                            شعار الشبكة (Logo)
                                        </label>
                                        <input type="file"
                                               class="form-control m-0"
                                               id="newWalletLogo"
                                               accept="image/*"
                                               required>
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-4">
                                    <button type="submit"
                                            class="btn btn-primary w-100 py-3 rounded-3 settings-wallet-add-btn"
                                            style="height: calc(3.5rem + 2px);">
                                        <i class="bi bi-plus-lg me-2"></i>
                                        إضافة
                                    </button>
                                </div>
                            </div>
                        </form>

                    </div>
                </div>

                <div class="col-12">
                    <div class="settings-card p-4">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="card-icon text-success">
                                <i class="bi bi-shield-check"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">القنوات الفعالة في النظام</h5>
                                <small class="text-muted">إدارة الشبكات المتاحة</small>
                            </div>
                        </div>

                        <div class="table-responsive settings-table-scroll">
                            <table class="table table-hover align-middle mb-0 custom-admin-table">
                                <thead>
                                    <tr>
                                        <th scope="col" class="text-center" style="width: 60px;">#</th>
                                        <th scope="col">الشعار</th>
                                        <th scope="col">اسم المحفظة</th>
                                        <th scope="col" class="text-center">الحالة</th>
                                        <th scope="col" class="text-center">إجراء</th>
                                    </tr>
                                </thead>
                                <tbody id="supportedWalletsTableBody">
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">
                                            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                            جاري جلب البيانات...
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/admin/settings-actions.js" asp-append-version="true"></script>
}
