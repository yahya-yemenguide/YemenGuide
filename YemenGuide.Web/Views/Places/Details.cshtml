@using System.Security.Claims
@using System.Linq
@using System.Collections.Generic
@model YemenGuide.Core.DTOs.Customer.PlaceDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
    ViewData["HideFooter"] = true;

    string catName = Model.CategoryName ?? "";

    var additionalServiceDisplayPriceTexts =
        Model.AdditionalServiceDisplayPriceTexts ??
        new Dictionary<int, string>();

    var packageDisplayPriceTexts =
        Model.PackageDisplayPriceTexts ??
        new Dictionary<int, string>();

    string GetServiceDisplayPriceText(int serviceId, decimal fallback)
    {
        return additionalServiceDisplayPriceTexts.TryGetValue(
            serviceId,
            out var value) &&
            !string.IsNullOrWhiteSpace(value)
                ? value
                : $"{fallback:N0} ر.ي";
    }

    string GetPackageDisplayPriceText(int packageId, decimal fallback)
    {
        return packageDisplayPriceTexts.TryGetValue(
            packageId,
            out var value) &&
            !string.IsNullOrWhiteSpace(value)
                ? value
                : $"{fallback:N0} ر.ي";
    }

    // نستخدم التعريف المركزي الموجود في PlaceDetailsViewModel
    // حتى لا تُستبعد BookingSystemId = 4 من رحلة القاعات/الباقات مرة أخرى.
    bool isHotel = Model.IsHotelSystem;
    bool isPackageSystem = Model.IsPackageSystem;
    bool isHall = Model.IsHallSystem;
    bool isBookingPlace = Model.RequiresBooking;

    var currentUserIdClaim =
        User.FindFirstValue(ClaimTypes.NameIdentifier);

    int currentUserId =
        int.TryParse(
            currentUserIdClaim,
            out int parsedUserId
        )
            ? parsedUserId
            : 0;

    Func<DateTime, string> FormatInstagramTime =
        (DateTime date) =>
        {
            var timeSpan = DateTime.Now - date;

            if (timeSpan.TotalSeconds < 60)
            {
                return $"{Math.Max(1, (int)timeSpan.TotalSeconds)} ث";
            }

            if (timeSpan.TotalMinutes < 60)
            {
                return $"{(int)timeSpan.TotalMinutes} د";
            }

            if (timeSpan.TotalHours < 24)
            {
                return $"{(int)timeSpan.TotalHours} س";
            }

            if (timeSpan.TotalDays < 7)
            {
                return $"{(int)timeSpan.TotalDays} ي";
            }

            return $"{(int)(timeSpan.TotalDays / 7)} أ";
        };

    string marketingText =
        Model.MarketingDescription?.Trim() ?? string.Empty;

    string normalizedMarketingText =
        (marketingText ?? string.Empty)
            .Trim()
            .Trim('-', '–', '—', '_', ' ', '\t', '\r', '\n')
            .Trim();

    bool hasUsefulMarketingText =
        !string.IsNullOrWhiteSpace(normalizedMarketingText) &&
        !string.Equals(
            normalizedMarketingText,
            "تفاصيل المنشأة",
            StringComparison.OrdinalIgnoreCase
        ) &&
        !string.Equals(
            normalizedMarketingText,
            "تفاصيل المكان",
            StringComparison.OrdinalIgnoreCase
        );

    string technicalDetails =
        Model.TechnicalDetails ?? "";

    var technicalInfoGroups =
        new List<(
            string Title,
            string Icon,
            string AccentClass,
            List<string> Items
        )>();

    if (!string.IsNullOrWhiteSpace(technicalDetails))
    {
        var technicalLines =
            technicalDetails
                .Replace("\r\n", "\n")
                .Replace("\r", "\n")
                .Split(
                    '\n',
                    StringSplitOptions.RemoveEmptyEntries
                )
                .Select(line =>
                    line.Trim()
                        .Trim('•', '-', '–', '—'))
                .Where(line =>
                    !string.IsNullOrWhiteSpace(line))
                .ToList();

        foreach (var technicalLine in technicalLines)
        {
            int separatorIndex =
                technicalLine.IndexOf(':');

            string groupTitle =
                separatorIndex > 0
                    ? technicalLine
                        .Substring(0, separatorIndex)
                        .Trim()
                    : "تفاصيل إضافية";

            string groupContent =
                separatorIndex > 0
                    ? technicalLine
                        .Substring(separatorIndex + 1)
                        .Trim()
                    : technicalLine;

            var groupItems =
                groupContent
                    .Split(
                        new[]
                        {
                            " | ",
                            " - ",
                            " – ",
                            " — ",
                            "،",
                            ",",
                            ";",
                            "؛"
                        },
                        StringSplitOptions.RemoveEmptyEntries
                    )
                    .Select(item =>
                        item.Trim()
                            .Trim('•', '-', '–', '—'))
                    .Where(item =>
                        !string.IsNullOrWhiteSpace(item))
                    .Distinct(
                        StringComparer.OrdinalIgnoreCase
                    )
                    .ToList();

            if (!groupItems.Any())
            {
                groupItems.Add(groupContent);
            }

            string normalizedTitle =
                groupTitle.Trim();

            string groupIcon;
            string accentClass;

            if (
                normalizedTitle.Contains("مبنى") ||
                normalizedTitle.Contains("المبنى") ||
                normalizedTitle.Contains("غرف")
            )
            {
                groupIcon = "bi-building";
                accentClass = "is-building";
            }
            else if (
                normalizedTitle.Contains("ترفيه") ||
                normalizedTitle.Contains("ألعاب") ||
                normalizedTitle.Contains("العاب")
            )
            {
                groupIcon = "bi-controller";
                accentClass = "is-entertainment";
            }
            else if (
                normalizedTitle.Contains("مجانية") ||
                normalizedTitle.Contains("خدمات")
            )
            {
                groupIcon = "bi-gift";
                accentClass = "is-services";
            }
            else if (
                normalizedTitle.Contains("تبريد") ||
                normalizedTitle.Contains("تدفئة") ||
                normalizedTitle.Contains("تكييف")
            )
            {
                groupIcon = "bi-snow2";
                accentClass = "is-climate";
            }
            else if (
                normalizedTitle.Contains("حوش") ||
                normalizedTitle.Contains("حديقة") ||
                normalizedTitle.Contains("خارجي")
            )
            {
                groupIcon = "bi-tree";
                accentClass = "is-outdoor";
            }
            else
            {
                groupIcon = "bi-stars";
                accentClass = "is-general";
            }

            technicalInfoGroups.Add(
                (
                    groupTitle,
                    groupIcon,
                    accentClass,
                    groupItems
                )
            );
        }
    }

    string BuildPolicyHtml(
        IEnumerable<string>? items,
        string fallback)
    {
        var cleanItems =
            items?
                .Where(item =>
                    !string.IsNullOrWhiteSpace(item))
                .Select(item =>
                    System.Net.WebUtility.HtmlEncode(item.Trim()))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList() ??
            new List<string>();

        return cleanItems.Any()
            ? "🔹 " + string.Join("<br>🔹 ", cleanItems)
            : fallback;
    }

    var depositPolicyItems =
        Model.PolicySections?
            .Where(section =>
                section.Key == "deposit")
            .SelectMany(section =>
                section.Items) ??
        Enumerable.Empty<string>();

    var cancellationPolicyItems =
        Model.PolicySections?
            .Where(section =>
                section.Key == "cancellation")
            .SelectMany(section =>
                section.Items) ??
        Enumerable.Empty<string>();

    var securityPolicyItems =
        Model.PolicySections?
            .Where(section =>
                section.Key == "security" ||
                section.Key == "exceptions" ||
                section.Key == "terms")
            .SelectMany(section =>
                section.Items) ??
        Enumerable.Empty<string>();

    securityPolicyItems =
        securityPolicyItems.Concat(
            Model.DynamicRules ??
            new List<string>()
        );

    string policyStr =
        BuildPolicyHtml(
            depositPolicyItems,
            "لم يحدد مالك المنشأة سياسة العربون."
        );

    string cancelPolicyStr =
        BuildPolicyHtml(
            cancellationPolicyItems,
            "لم يحدد مالك المنشأة سياسة الإلغاء."
        );

    string securityPolicyStr =
        BuildPolicyHtml(
            securityPolicyItems,
            "لم يحدد مالك المنشأة قوانين إضافية."
        );

    List<string> availableEvents =
        Model.EventTypes?
            .Where(item =>
                !string.IsNullOrWhiteSpace(item))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList() ??
        new List<string>();

    List<string> availableSeats =
        Model.SeatingSetups?
            .Where(item =>
                !string.IsNullOrWhiteSpace(item))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList() ??
        new List<string>();

    var galleryImages =
        new List<string>();

    if (!string.IsNullOrWhiteSpace(Model.MainImage))
    {
        galleryImages.Add(Model.MainImage);
    }

    if (Model.GalleryImages != null &&
        Model.GalleryImages.Any())
    {
        galleryImages.AddRange(
            Model.GalleryImages.Where(image =>
                !string.IsNullOrWhiteSpace(image))
        );
    }

    galleryImages = galleryImages
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    var sideImages = galleryImages
        .Skip(1)
        .Take(4)
        .ToList();

    int hiddenImagesCount =
        Math.Max(
            0,
            galleryImages.Count - 5
        );

    string checkInTime =
        !string.IsNullOrWhiteSpace(Model.CheckInTime)
            ? Model.CheckInTime
            : "غير محدد";

    string checkOutTime =
        !string.IsNullOrWhiteSpace(Model.CheckOutTime)
            ? Model.CheckOutTime
            : "غير محدد";

    if (checkInTime.Length > 5 &&
        checkInTime.Contains(':'))
    {
        checkInTime = checkInTime.Substring(0, 5);
    }

    if (checkOutTime.Length > 5 &&
        checkOutTime.Contains(':'))
    {
        checkOutTime = checkOutTime.Substring(0, 5);
    }

    string operationSystemText =
        Model.PlacePolicy?.OperationSystemMode switch
        {
            "FullDay" => "يوم كامل",
            "Shifts" => "فترات محددة",
            "Hourly" => "حجز بالساعة",
            null or "" => "غير محدد",
            var value => value
        };

    bool hasValidCoordinates =
        Model.HasValidCoordinates;

    var activePromotions =
        Model.Promotions ??
        new List<YemenGuide.Core.DTOs.Customer.PlacePromotionDto>();

    bool hasPromotions =
        activePromotions.Any();

    var highlightedPromotion =
        activePromotions
            .FirstOrDefault(promotion =>
                promotion.IsSelected) ??
        activePromotions.FirstOrDefault();

    string directionsUrl =
        hasValidCoordinates
            ? "https://www.google.com/maps/dir/" +
              "?api=1&destination=" +
              Model.Latitude.ToString(
                  System.Globalization.CultureInfo.InvariantCulture
              ) +
              "," +
              Model.Longitude.ToString(
                  System.Globalization.CultureInfo.InvariantCulture
              )
            : "";
}

@functions {
    void RenderCustomerReviewNode(
        YemenGuide.Core.DTOs.Customer.ReviewDto review,
        int depth,
        int currentUserId,
        Func<DateTime, string> formatTime
    )
    {
        string depthClass =
            depth > 0
                ? "review-node-reply me-4 mt-3"
                : "review-node-root mt-3";

        string initial =
            string.IsNullOrWhiteSpace(
                review.UserName
            )
                ? "ز"
                : review.UserName
                    .Substring(0, 1)
                    .ToUpper();

        <article class="insta-comment-block review-node-item @depthClass"
             id="review-block-@review.ReviewId"
             data-review-id="@review.ReviewId"
             data-stars="@review.Stars"
             data-depth="@depth">

            <div class="review-node-layout">

                <div class="review-node-avatar-wrap">

                    @if (
            !string.IsNullOrWhiteSpace(
            review.ProfileImage
            )
            )
                    {
                        <img src="@review.ProfileImage"
                     class="insta-avatar"
                     alt="@review.UserName"
                     loading="lazy" />
                    }
                    else
                    {
                        <div class="insta-avatar-initial">
                            @initial
                        </div>
                    }
                </div>

                <div class="review-node-content">

                    <div class="review-node-head">

                        <div class="review-node-main">

                            <div class="review-node-user-row">

                                <strong class="review-node-user">
                                    @review.UserName
                                </strong>

                                @if (
                        depth == 0 &&
                        review.Stars > 0
                        )
                                {
                                    <span class="review-node-stars">

                                        @for (
                                   int star = 1;
                                   star <= 5;
                                   star++
                                   )
                                        {
                                            <i class="bi @(star <= review.Stars
                                                ? "bi-star-fill"
                                                : "bi-star")"></i>
                                        }
                                    </span>
                                }
                            </div>

                            <p class="insta-text review-node-text">

                                <span class="review-text-content">
                                    @review.ReviewText
                                </span>
                            </p>
                        </div>

                        <button type="button"
                            class="insta-heart-btn review-like-button"
                            onclick="toggleInstaLike(@review.ReviewId)"
                            aria-label="الإعجاب بالتقييم">

                            <i class="bi @(review.IsLikedByMe
                                ? "bi-heart-fill text-danger"
                                : "bi-heart")"
                           id="heart-icon-@review.ReviewId"></i>

                            <span class="insta-likes-count"
                              id="likes-count-@review.ReviewId"
                              style="display:@(review.LikesCount > 0
                                      ? "block"
                                      : "none");">

                                @review.LikesCount
                            </span>
                        </button>
                    </div>

                    <div class="insta-meta review-node-meta">

                        <span>
                            @formatTime(review.CreatedAt)
                        </span>

                        @if (review.IsEdited)
                        {
                            <span>(معدل)</span>
                        }

                        <button type="button"
                            data-user-name="@review.UserName"
                            onclick="prepareInstaReply(
                                                            @review.ReviewId,
                                                            this.dataset.userName
                                                        )">

                            رد
                        </button>

                        @if (
                review.UserId ==
                currentUserId &&
                currentUserId > 0
                )
                        {
                            <button type="button"
                            class="review-edit-action"
                            onclick="editInstaReview(@review.ReviewId)">

                                تعديل
                            </button>

                            <button type="button"
                            class="review-delete-action"
                            onclick="deleteInstaReview(@review.ReviewId)">

                                حذف
                            </button>
                        }
                    </div>

                    @if (
            review.Replies != null &&
            review.Replies.Any()
            )
                    {
                        <button type="button"
                        class="insta-toggle-replies"
                        id="toggle-btn-@review.ReviewId"
                        aria-controls="nested-replies-@review.ReviewId"
                        aria-expanded="false"
                        onclick="toggleRepliesVisibility(
                                                            @review.ReviewId,
                                                            @review.Replies.Count
                                                        )">

                            <span class="insta-toggle-line"></span>

                            <span id="toggle-text-@review.ReviewId">

                                عرض @review.Replies.Count من الردود
                            </span>
                        </button>

                        <div id="nested-replies-@review.ReviewId"
                     class="nested-replies"
                     aria-hidden="true"
                     style="display:none;">

                            @foreach (
                       var reply in
                       review.Replies
                       )
                            {
                                RenderCustomerReviewNode(
                                reply,
                                depth + 1,
                                currentUserId,
                                formatTime
                                );
                            }
                        </div>
                    }
                </div>
            </div>
        </article>
    }
}

@section Styles {
    <link rel="stylesheet"
      href="~/css/customer/Details.css"
      asp-append-version="true" />


    <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
}

    <main class="place-details-page"
      dir="rtl"
      data-selected-promotion-id="@(Model.SelectedPromotionId?.ToString() ?? "0")"
      data-attribution-advertisement-id="@(Model.AttributionAdvertisementId?.ToString() ?? string.Empty)"
      data-attribution-place-id="@Model.PlaceId">

        <input type="hidden"
           id="selectedPromotionIdInput"
           value="@(Model.SelectedPromotionId?.ToString() ?? "0")" />

        <div class="place-details-shell">

            <header class="place-heading"
                aria-labelledby="placePageTitle">

                <nav class="place-breadcrumb"
                 aria-label="مسار التنقل">

                    <a asp-controller="Home"
                   asp-action="Index">

                        الرئيسية
                    </a>

                    <i class="bi bi-chevron-left"></i>

                    <a asp-controller="Places"
                   asp-action="Search">

                        استكشف
                    </a>

                    <i class="bi bi-chevron-left"></i>

                    <span>@catName</span>
                </nav>

                <div class="place-heading-row">

                    <div class="place-heading-copy">

                        <div class="place-title-line">

                            <h1 id="placePageTitle"
                            class="place-title">

                                @Model.Name
                            </h1>

                            <div class="place-heading-badges">

                                <span class="place-category-badge">

                                    <i class="bi bi-grid-fill"></i>
                                    <span>@catName</span>
                                </span>

                            @if (isBookingPlace)
                            {
                                <span class="place-status-badge @(Model.CanBook
                                ? "is-bookable"
                                : "is-visit")">

                                    <i class="bi @(Model.CanBook
                                    ? "bi-calendar2-check-fill"
                                    : "bi-calendar2-x-fill")"></i>

                                    <span>
                                        @(Model.CanBook
                                            ? "متاح للحجز"
                                            : "الحجز غير متاح")
                                    </span>
                                </span>
                            }
                            else
                            {
                                <span class="place-status-badge is-visit">

                                    <i class="bi bi-door-open-fill"></i>
                                    <span>متاح للزيارة</span>
                                </span>
                            }

                            @if (hasPromotions)
                            {
                                <a href="#offersSection"
                               class="place-offers-badge"
                               aria-label="عرض عروض المنشأة">

                                    <span class="place-offers-badge-fire">
                                        <i class="bi bi-fire"></i>
                                    </span>

                                    <span>
                                        @(activePromotions.Count == 1
                                            ? "عرض خاص متاح"
                                            : $"{activePromotions.Count} عروض متاحة")
                                    </span>
                                </a>
                            }
                        </div>
                    </div>

                    <div class="place-meta-row">

                        <button type="button"
                                class="place-rating-link"
                                onclick="
                                    const reviews =
                                        document.getElementById(
                                            'reviewsSectionTrigger'
                                        );

                                    if (reviews) {
                                        reviews.scrollIntoView({
                                            behavior: 'smooth',
                                            block: 'start'
                                        });
                                    }
                                ">

                            <i class="bi bi-star-fill"></i>

                            <strong>
                                @Model.AverageRating.ToString("0.0")
                            </strong>

                            <span>
                                @Model.TotalReviews تقييم
                            </span>
                        </button>

                        <span class="place-meta-separator"></span>

                        <div class="place-location-line">

                            <i class="bi bi-geo-alt-fill"></i>

                            <span>@Model.CityName</span>

                            @if (
                            !string.IsNullOrWhiteSpace(
                            Model.AddressDetails
                            )
                            )
                            {
                                <span class="place-address-text">
                                    — @Model.AddressDetails
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="place-heading-actions"
                     aria-label="إجراءات المكان">

                    @if (Model.CanContactPlace)
                    {
                        <a asp-controller="Messages"
                       asp-action="MyMessages"
                       asp-route-placeId="@Model.PlaceId"
                       asp-route-withOwnerId="@Model.OwnerId"
                       class="place-round-action place-chat-round-action"
                       aria-label="التواصل مع المنشأة"
                       title="التواصل مع @Model.Name">

                            <i class="bi bi-chat-dots-fill"></i>
                        </a>
                    }
                    else
                    {
                        <button type="button"
                            class="place-round-action place-chat-round-action is-disabled"
                            aria-label="الدردشة غير متاحة"
                            title="@Model.ChatUnavailableMessage"
                            disabled>

                            <i class="bi bi-chat-dots"></i>
                        </button>
                    }

                    <button type="button"
                            class="place-round-action"
                            id="sharePlaceBtn"
                            aria-label="مشاركة المكان"
                            title="مشاركة المكان">

                        <i class="bi bi-share-fill"></i>
                    </button>

                    <button type="button"
                            class="place-round-action favorite-action @(Model.IsFavorited
                                ? "is-active"
                                : "")"
                            onclick="toggleHeart(
                                event,
                                this,
                                @Model.PlaceId
                            )"
                            aria-label="حفظ في المفضلة"
                            title="حفظ في المفضلة">

                        <i class="@(Model.IsFavorited
                            ? "bi bi-heart-fill text-danger"
                            : "bi bi-heart")"
                           id="favoriteIcon"></i>
                    </button>
                </div>
            </div>
        </header>

        <section class="place-gallery is-compact-gallery"
                 aria-label="صور @Model.Name">

            <div class="place-gallery-grid">

                <button type="button"
                        class="gallery-main-shot"
                        onclick="toggleExtendedGallery()"
                        aria-label="فتح معرض الصور">

                    <img src="@Model.MainImage"
                         id="mainDisplayImage"
                         class="main-hero-img"
                         alt="@Model.Name"
                         onerror="this.src='/images/bg1.jpg'" />

                    <span class="gallery-main-gradient"></span>

                    <span class="gallery-photo-counter d-md-none">

                        <i class="bi bi-images"></i>
                        <span>@galleryImages.Count</span>
                    </span>
                </button>

                <div class="gallery-side-grid d-none d-md-grid">

                    @for (
                    int imageIndex = 0;
                    imageIndex < 4;
                    imageIndex++
                    )
                    {
                        <div class="gallery-side-cell">

                            @if (
                           imageIndex <
                           sideImages.Count
                           )
                            {
                                <button type="button"
                                class="gallery-side-shot"
                                onclick="changeMainImage(
                                            this.querySelector('img')
                                        )"
                                aria-label="عرض صورة إضافية">

                                    <img src="@sideImages[imageIndex]"
                                 class="side-hero-img"
                                 alt="صورة إضافية لـ @Model.Name"
                                 loading="lazy"
                                 onerror="this.src='/images/bg1.jpg'" />

                                    @if (
                                   imageIndex == 3 &&
                                   hiddenImagesCount > 0
                                   )
                                    {
                                        <span class="gallery-more-overlay"
                                  onclick="
                                                  event.stopPropagation();
                                                  toggleExtendedGallery();
                                              ">

                                            <strong>
                                                +@hiddenImagesCount
                                            </strong>

                                            <small>
                                                صور أخرى
                                            </small>
                                        </span>
                                    }
                                </button>
                            }
                            else
                            {
                                <div class="gallery-empty-shot"
                             aria-hidden="true">

                                    <i class="bi bi-image"></i>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (galleryImages.Any())
            {
                <button type="button"
                    class="gallery-open-all"
                    onclick="toggleExtendedGallery()">

                    <i class="bi bi-grid-3x3-gap-fill"></i>
                    <span>عرض جميع الصور</span>
                </button>
            }
        </section>

        <section id="extendedGallerySection"
                 class="extended-gallery-panel"
                 style="display:none;"
                 aria-label="جميع صور المكان"
                 aria-hidden="true">

            <div class="extended-gallery-head">

                <div>
                    <span class="section-kicker">

                        <i class="bi bi-images"></i>
                        معرض المكان
                    </span>

                    <h2>جميع الصور</h2>
                </div>

                <button type="button"
                        class="section-close-button"
                        onclick="toggleExtendedGallery()">

                    <i class="bi bi-x-lg"></i>
                    <span>إغلاق</span>
                </button>
            </div>

            <div class="extended-gallery-track horizontal-scroll"
                 id="extendedGalleryScroll"
                 tabindex="0">

                @for (
                int imageIndex = 0;
                imageIndex < galleryImages.Count;
                imageIndex++
                )
                {
                    <button type="button"
                        class="extended-gallery-item @(imageIndex == 0
                                ? "is-active"
                                : "")"
                        onclick="changeMainImage(
                                this.querySelector('img')
                            )">

                        <img src="@galleryImages[imageIndex]"
                         class="extended-thumb @(imageIndex == 0
                                ? "active"
                                : "")"
                         alt="صورة @(imageIndex + 1) من @Model.Name"
                         loading="lazy"
                         onerror="this.src='/images/bg1.jpg'" />
                    </button>
                }
            </div>
        </section>

        @if (hasPromotions)
        {
            <section class="promotion-showcase-section"
                 id="offersSection"
                 aria-labelledby="offersSectionTitle">

                <span class="promotion-ambient promotion-ambient-one"
                  aria-hidden="true"></span>

                <span class="promotion-ambient promotion-ambient-two"
                  aria-hidden="true"></span>

                <header class="promotion-showcase-header">

                    <div class="promotion-showcase-title">

                        <span class="promotion-kicker">
                            <i class="bi bi-stars"></i>
                            فرصة خاصة أثناء زيارتك
                        </span>

                        <h2 id="offersSectionTitle">
                            عروض تضيف لمسة أجمل لتجربتك
                        </h2>

                        <p>
                            اختر العرض المناسب لك، وسنتحقق من جميع شروطه
                            والسعر النهائي مرة أخرى عند إكمال الحجز.
                        </p>
                    </div>

                    <div class="promotion-showcase-tools">

                        <div class="promotion-showcase-counter"
                         aria-label="عدد العروض الفعالة">

                            <span>
                                <i class="bi bi-fire"></i>
                            </span>

                            <div>
                                <strong>@activePromotions.Count</strong>
                                <small>
                                    @(activePromotions.Count == 1
                                        ? "عرض فعّال"
                                        : "عروض فعّالة")
                                </small>
                            </div>
                        </div>

                        @if (activePromotions.Count > 1)
                        {
                            <div class="promotion-carousel-nav"
                         aria-label="التنقل بين العروض">

                                <button type="button"
                                class="promotion-carousel-button"
                                id="promotionPreviousButton"
                                aria-label="العرض السابق">

                                    <i class="bi bi-chevron-right"></i>
                                </button>

                                <span class="promotion-carousel-position"
                              aria-live="polite">

                                    <strong id="promotionCurrentIndex">1</strong>
                                    <span>/</span>
                                    <strong>@activePromotions.Count</strong>
                                </span>

                                <button type="button"
                                class="promotion-carousel-button is-next"
                                id="promotionNextButton"
                                aria-label="العرض التالي">

                                    <i class="bi bi-chevron-left"></i>
                                </button>
                            </div>
                        }
                    </div>
                </header>

                <div class="promotion-showcase-track horizontal-scroll"
                 id="promotionShowcaseTrack"
                 tabindex="0"
                 role="region"
                 data-promotion-total="@activePromotions.Count"
                 aria-describedby="promotionGestureHint"
                 aria-label="عروض المنشأة — اسحب أو استخدم الأسهم للتنقل">

                    @foreach (var promotion in activePromotions)
                    {
                        var promotionIncludedServiceIds =
                            (promotion.TargetAnchor ?? string.Empty)
                                .Split(
                                    '|',
                                    StringSplitOptions.RemoveEmptyEntries |
                                    StringSplitOptions.TrimEntries)
                                .Select(anchor =>
                                    anchor
                                        .Trim()
                                        .TrimStart('#'))
                                .Where(anchor =>
                                    anchor.StartsWith(
                                        "serviceCard-",
                                        StringComparison.OrdinalIgnoreCase))
                                .Select(anchor =>
                                {
                                    return int.TryParse(
                                        anchor.Substring("serviceCard-".Length),
                                        out int serviceId)
                                            ? serviceId
                                            : 0;
                                })
                                .Where(serviceId => serviceId > 0)
                                .Distinct()
                                .ToList();

                        if (
                            promotion.RewardServiceId.HasValue &&
                            promotion.RewardServiceId.Value > 0 &&
                            !promotionIncludedServiceIds.Contains(
                                promotion.RewardServiceId.Value))
                        {
                            promotionIncludedServiceIds.Add(
                                promotion.RewardServiceId.Value);
                        }

                        var promotionIncludedServiceNames =
                            Model.AdditionalServices
                                .Where(service =>
                                    promotionIncludedServiceIds.Contains(
                                        service.ServiceId))
                                .Select(service =>
                                    service.ServiceName?.Trim())
                                .Where(name =>
                                    !string.IsNullOrWhiteSpace(name))
                                .Select(name => name!)
                                .Distinct(
                                    StringComparer.OrdinalIgnoreCase)
                                .ToList();

                        if (
                            promotionIncludedServiceNames.Count == 0 &&
                            !string.IsNullOrWhiteSpace(
                                promotion.RewardServiceName))
                        {
                            promotionIncludedServiceNames =
                                promotion.RewardServiceName
                                    .Split(
                                        '+',
                                        StringSplitOptions.RemoveEmptyEntries |
                                        StringSplitOptions.TrimEntries)
                                    .Where(name =>
                                        !string.IsNullOrWhiteSpace(name))
                                    .Distinct(
                                        StringComparer.OrdinalIgnoreCase)
                                    .ToList();
                        }

                        bool promotionIsServiceBundle =
                            (
                                string.Equals(
                                    promotion.RewardType,
                                    "FreeService",
                                    StringComparison.OrdinalIgnoreCase) ||
                                string.Equals(
                                    promotion.RewardType,
                                    "ServiceSpecialPrice",
                                    StringComparison.OrdinalIgnoreCase)
                            ) &&
                            (
                                promotionIncludedServiceIds.Count > 0 ||
                                promotionIncludedServiceNames.Count > 0
                            );

                        string promotionIncludedServicesText =
                            promotionIncludedServiceNames.Count > 0
                                ? string.Join(
                                    "، ",
                                    promotionIncludedServiceNames)
                                : promotion.RewardServiceName
                                    .Replace(" + ", "، ");

                        <article class="promotion-spotlight-card @(promotion.IsSelected ? "is-selected" : "")"
                         data-promotion-card
                         data-promotion-id="@promotion.PromotionId"
                         data-target-anchor="@promotion.TargetAnchor"
                         data-target-type="@promotion.TargetType"
                         data-included-service-ids="@string.Join(",", promotionIncludedServiceIds)"
                         aria-selected="@(promotion.IsSelected ? "true" : "false")">

                            <div class="promotion-card-media @(promotion.HasImage ? "has-image" : "")">

                                @if (promotion.HasImage)
                                {
                                    <img src="@promotion.ImagePath"
                             alt="@promotion.PromotionTitle"
                             loading="lazy"
                             onerror="this.style.display='none'" />
                                }

                                <span class="promotion-card-media-glow"
                              aria-hidden="true"></span>

                                <span class="promotion-discount-orb">

                                    <small>عرض</small>
                                    <strong>@promotion.OfferDisplay</strong>
                                </span>
                            </div>

                            <div class="promotion-card-content">

                                <div class="promotion-card-topline">

                                    <span class="promotion-target-pill">
                                        <i class="bi @promotion.TargetIconClass"></i>
                                        @promotion.TargetLabel
                                    </span>

                                    <span class="promotion-time-pill">
                                        <i class="bi bi-clock-history"></i>
                                        @promotion.RemainingTimeLabel
                                    </span>
                                </div>

                                <h3>@promotion.PromotionTitle</h3>

                                @if (!string.IsNullOrWhiteSpace(promotion.OfferSummary))
                                {
                                    <p class="promotion-card-description promotion-offer-summary">
                                        <i class="bi bi-gift-fill"></i>
                                        @promotion.OfferSummary
                                    </p>
                                    @if (promotion.IsRewardRepeatable && string.Equals(promotion.RewardType, "FreeQuantity", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <p class="promotion-repeat-note"><i class="bi bi-arrow-repeat"></i> المكافأة تتكرر عند اكتمال كل مجموعة</p>
                                    }
                                }

                                @if (promotionIsServiceBundle)
                                {
                                    <div class="promotion-bundle-scope">
                                        <span class="promotion-bundle-scope__target">
                                            <i class="bi bi-ticket-perforated"></i>
                                            <b>الباقة/الخيار المشمول:</b>
                                            @promotion.TargetLabel
                                        </span>
                                        <span class="promotion-bundle-scope__services">
                                            <i class="bi bi-check2-square"></i>
                                            <b>الخدمات التي ستُحدد تلقائيًا:</b>
                                            @promotionIncludedServicesText
                                        </span>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(
                               promotion.ShortDescription))
                                {
                                    <p class="promotion-card-description">
                                        @promotion.ShortDescription
                                    </p>
                                }
                                else if (!string.IsNullOrWhiteSpace(
                                promotion.Description))
                                {
                                    <p class="promotion-card-description">
                                        @promotion.Description
                                    </p>
                                }

                                @if (promotion.HasEstimatedPrice)
                                {
                                    <div class="promotion-price-preview">

                                        <div>
                                            <small>
                                                @(string.Equals(
                                                    promotion.RewardType,
                                                    "ServiceSpecialPrice",
                                                    StringComparison.OrdinalIgnoreCase)
                                                    ? "سعر الخدمات قبل العرض"
                                                    : "السعر المرجعي")
                                            </small>
                                            <del>
                                                @promotion.DisplayOriginalPriceText
                                            </del>
                                        </div>

                                        <span class="promotion-price-arrow">
                                            <i class="bi bi-arrow-left"></i>
                                        </span>

                                        <div class="is-discounted">
                                            <small>
                                                @(string.Equals(
                                                    promotion.RewardType,
                                                    "ServiceSpecialPrice",
                                                    StringComparison.OrdinalIgnoreCase)
                                                    ? "سعر الخدمات في العرض"
                                                    : "بعد العرض تقديريًا")
                                            </small>
                                            <strong>
                                                @promotion.DisplayEstimatedPriceAfterDiscountText
                                            </strong>
                                        </div>

                                        <span class="promotion-save-pill">
                                            وفّر
                                            @promotion.DisplayEstimatedDiscountAmountText
                                        </span>
                                    </div>
                                }

                                @if (promotion.Conditions != null &&
                               promotion.Conditions.Any())
                                {
                                    <div class="promotion-condition-list">

                                        @foreach (
                                       var condition in
                                       promotion.Conditions.Take(3))
                                        {
                                            <span>
                                                <i class="bi bi-check2"></i>
                                                @condition
                                            </span>
                                        }
                                    </div>
                                }

                                <div class="promotion-card-actions">

                                    @if (promotion.IsCodeRequired)
                                    {
                                        <button type="button"
                                    class="promotion-code-pill"
                                    data-copy-promo-code="@promotion.PromoCode"
                                    title="نسخ كود الخصم">

                                            <span>كود العرض</span>
                                            <strong>@promotion.PromoCode</strong>
                                            <i class="bi bi-copy"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="promotion-auto-pill">
                                            <i class="bi bi-magic"></i>
                                            يطبق تلقائيًا عند تحقق الشروط
                                        </span>
                                    }

                                    <button type="button"
                                    class="promotion-apply-button"
                                    data-promotion-action
                                    data-promotion-id="@promotion.PromotionId"
                                    data-target-type="@promotion.TargetType"
                                    data-target-anchor="@promotion.TargetAnchor">

                                        <span>
                                            @(promotion.TargetType == "Room"
                                                ? "اختر تاريخ الإقامة"
                                                : promotion.TargetType == "Package" &&
                                                  promotionIsServiceBundle
                                                ? "اختر الباقة والخدمات"
                                                : promotion.TargetType == "Package"
                                                ? "شاهد الباقة"
                                                : promotion.TargetType == "Service"
                                                ? "شاهد الخدمة"
                                                : isBookingPlace
                                                ? "استفد من العرض"
                                                : "استكشف التفاصيل")
                                        </span>

                                        <i class="bi bi-arrow-left"></i>
                                    </button>
                                </div>
                            </div>
                        </article>
                    }
                </div>

                @if (activePromotions.Count > 1)
                {
                    <div class="promotion-gesture-hint"
                 id="promotionGestureHint">

                        <i class="bi bi-hand-index-thumb"></i>
                        <span>
                            اسحب بالماوس أو الإصبع، أو استخدم أسهم لوحة المفاتيح للتنقل بين العروض.
                        </span>
                    </div>
                }

                <div class="promotion-showcase-note">
                    <i class="bi bi-shield-check"></i>
                    <span>
                        السعر الموضح هنا معاينة ذكية فقط؛ التحقق النهائي من
                        التاريخ والكمية وعدد الأشخاص وحدود الاستخدام يتم عند الحجز.
                    </span>
                </div>
            </section>
        }

        <section class="place-intro-card"
                 id="placeOverviewSection">

            <div class="place-intro-main">

                <span class="section-kicker">

                    <i class="bi bi-stars"></i>
                    تجربة موثوقة
                </span>

                <h2>
                    نبذة عن المنشأة
                </h2>

                @if (hasUsefulMarketingText)
                {
                    <p class="place-intro-description">
                        @normalizedMarketingText
                    </p>
                }
            </div>

        </section>

        <nav class="place-section-nav"
             aria-label="أقسام صفحة المكان">

            <div class="place-section-nav-track">

                <a href="#placeOverviewSection"
                   class="place-section-link active">
                    نظرة عامة
                </a>

                @if (hasPromotions)
                {
                    <a href="#offersSection"
                   class="place-section-link place-section-link-offers">
                        <i class="bi bi-fire"></i>
                        العروض
                    </a>
                }

                <a href="#amenitiesSection"
                   class="place-section-link">
                    المرافق
                </a>

                @if (
                Model.AdditionalServices != null &&
                Model.AdditionalServices.Any()
                )
                {
                    <a href="#servicesSection"
                   class="place-section-link">
                        الخدمات
                    </a>
                }

                @if (isBookingPlace)
                {
                    <a href="#policies-section"
                   class="place-section-link">
                        السياسات
                    </a>
                }


                @if (
                (isPackageSystem || isHall) &&
                Model.Packages != null &&
                Model.Packages.Any()
                )
                {
                    <a href="#packagesSection"
                   class="place-section-link">
                        الباقات
                    </a>
                }

                <a href="#locationSection"
                   class="place-section-link">
                    الموقع
                </a>

                <a href="#reviewsSectionTrigger"
                   class="place-section-link">
                    التقييمات
                </a>
            </div>
        </nav>

        <div class="place-content-layout">

            <div class="place-content-main">

                @if (
                technicalInfoGroups.Any()
                )
                {
                    <section class="details-section-card technical-showcase-section"
                         id="buildingDetailsSection">

                        <div class="section-heading-row technical-showcase-heading">

                            <div>
                                <span class="section-kicker">

                                    <i class="bi bi-building-check"></i>
                                    تفاصيل المنشأة
                                </span>

                                <h2>
                                    المكان في نظرة مرتبة وواضحة
                                </h2>

                                <p class="section-heading-description">
                                    أهم التفاصيل موزعة إلى مجموعات سريعة تساعدك
                                    على فهم التجربة قبل الحجز.
                                </p>
                            </div>

                            <span class="technical-source-badge">

                                <i class="bi bi-patch-check-fill"></i>

                                بيانات المنشأة
                            </span>
                        </div>

                        <div class="technical-details-showcase">

                            @foreach (
                           var technicalGroup in
                           technicalInfoGroups
                           )
                            {
                                <article class="technical-detail-card @technicalGroup.AccentClass">

                                    <header class="technical-detail-card-head">

                                        <span class="technical-detail-icon">

                                            <i class="bi @technicalGroup.Icon"></i>
                                        </span>

                                        <div>
                                            <small>مجموعة معلومات</small>

                                            <h3>
                                                @technicalGroup.Title
                                            </h3>
                                        </div>
                                    </header>

                                    <ul class="technical-detail-points">

                                        @foreach (
                                       var technicalItem in
                                       technicalGroup.Items
                                       )
                                        {
                                            <li>

                                                <i class="bi bi-check2"></i>

                                                <span>
                                                    @technicalItem
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                </article>
                            }
                        </div>
                    </section>
                }

                @*
                أنواع الغرف لا تُعرض هنا عمدًا.
                اختيار الغرفة الفعلي يتم بعد تحديد تاريخ الإقامة في AvailableRooms،
                حتى لا نكرر نفس الخطوة مرتين ونحافظ على دقة التوفر والأسعار.
                *@

                <section class="details-section-card"
                         id="amenitiesSection">

                    <div class="section-heading-row">

                        <div>
                            <span class="section-kicker">

                                <i class="bi bi-gem"></i>
                                المزايا
                            </span>

                            <h2>ما يوفره هذا المكان</h2>
                        </div>

                        @if (
                        Model.Amenities != null &&
                        Model.Amenities.Any()
                        )
                        {
                            <span class="section-count">
                                @Model.Amenities.Count ميزة
                            </span>
                        }
                    </div>

                    @if (
                    Model.Amenities != null &&
                    Model.Amenities.Any()
                    )
                    {
                        <div class="amenities-grid">

                            @foreach (
                           var amenity in
                           Model.Amenities
                           )
                            {
                                <div class="amenity-item">

                                    <span class="amenity-icon">

                                        <i class="bi @(string.IsNullOrWhiteSpace(
                                            amenity.IconClass
                                        )
                                            ? "bi-check2"
                                            : amenity.IconClass)"></i>
                                    </span>

                                    <span>
                                        @amenity.AmenityName
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="section-empty-state">

                            <i class="bi bi-info-circle"></i>

                            <span>
                                لم يتم تحديد المرافق الأساسية بعد.
                            </span>
                        </div>
                    }

                    @if (
                    isBookingPlace &&
                    Model.Spaces != null &&
                    Model.Spaces.Any()
                    )
                    {
                        <div class="spaces-divider"></div>

                        <div class="subsection-heading">

                            <div>
                                <i class="bi bi-bounding-box-circles"></i>
                                <h3>المساحات المتوفرة</h3>
                            </div>

                            <span>
                                @Model.Spaces.Count مساحة
                            </span>
                        </div>

                        <div class="spaces-grid">

                            @foreach (
                           var space in
                           Model.Spaces
                           )
                            {
                                <div class="space-item">

                                    <i class="bi @(string.IsNullOrWhiteSpace(
                                        space.IconClass
                                    )
                                        ? "bi-check-circle"
                                        : space.IconClass)"></i>

                                    <span>
                                        @space.SpaceName
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </section>

                <section class="details-section-card services-original-layout"
                         id="servicesSection">

                    <div class="section-heading-row">

                        <div>
                            <span class="section-kicker">

                                <i class="bi bi-plus-circle"></i>
                                إضافات اختيارية
                            </span>

                            <h2>
                                خدمات تجعل تجربتك أكثر راحة
                            </h2>
                        </div>

                        @if (
                        Model.AdditionalServices != null &&
                        Model.AdditionalServices.Any()
                        )
                        {
                            <span class="section-count">
                                تضاف إلى السعر
                            </span>
                        }
                    </div>

                    @if (
                    Model.AdditionalServices != null &&
                    Model.AdditionalServices.Any()
                    )
                    {
                        var additionalServices =
                        Model.AdditionalServices
                        .ToList();

                        <div class="services-grid">

                            @for (
                           int serviceIndex = 0;
                           serviceIndex <
                           additionalServices.Count;
                           serviceIndex++
                           )
                            {
                                var service =
                                additionalServices[
                                serviceIndex
                                ];

                                string serviceImage =
                                "/images/default-service.jpg";

                                string serviceImagesJson =
                                "[]";

                                string serviceCheckboxId =
                                $"additionalService_{serviceIndex}";

                                if (
                                !string.IsNullOrWhiteSpace(
                                service.ImageUrl
                                )
                                )
                                {
                                    var serviceImages =
                                    service.ImageUrl
                                    .Split(
                                    ',',
                                    StringSplitOptions
                                    .RemoveEmptyEntries
                                    )
                                    .Select(image =>
                                    image.Trim()
                                    )
                                    .Where(image =>
                                    !string.IsNullOrWhiteSpace(
                                    image
                                    )
                                    )
                                    .Distinct(
                                    StringComparer
                                    .OrdinalIgnoreCase
                                    )
                                    .ToList();

                                    if (serviceImages.Any())
                                    {
                                        serviceImage =
                                        serviceImages.First();

                                        serviceImagesJson =
                                        System.Text.Json
                                        .JsonSerializer
                                        .Serialize(
                                        serviceImages
                                        );
                                    }
                                }

                                var servicePromotion =
                                activePromotions.FirstOrDefault(promotion =>
                                promotion.ServiceId == service.ServiceId);

                                <label class="service-choice-card addon-container @(servicePromotion != null ? "has-promotion" : "")"
                               id="serviceCard-@service.ServiceId"
                               data-promotion-id="@(servicePromotion?.PromotionId.ToString() ?? "0")"
                               for="@serviceCheckboxId">

                                    @if (servicePromotion != null)
                                    {
                                        <span class="target-promotion-badge is-service">
                                            <i class="bi bi-fire"></i>
                                            @servicePromotion.OfferDisplay
                                        </span>
                                    }

                                    <input id="@serviceCheckboxId"
                                   class="addon-checkbox"
                                   type="checkbox"
                                   value="@service.Price"
                                   data-service-id="@service.ServiceId"
                                   data-name="@service.ServiceName"
                                   data-img="@serviceImage" />

                                    <span class="service-image-button"
                                  role="button"
                                  tabindex="0"
                                  onclick="openServiceGallery(
                                              event,
                                              this
                                          )"
                                  onkeydown="
                                              if (
                                                  event.key === 'Enter' ||
                                                  event.key === ' '
                                              ) {
                                                  openServiceGallery(
                                                      event,
                                                      this
                                                  );
                                              }
                                          "
                                  data-title="@service.ServiceName"
                                  data-images='@serviceImagesJson'
                                  aria-label="عرض صور @service.ServiceName">

                                        <img src="@serviceImage"
                                     alt="@service.ServiceName"
                                     loading="lazy"
                                     onerror="
                                                 this.onerror = null;
                                                 this.src = '/images/bg1.jpg';
                                             " />

                                        <span>
                                            <i class="bi bi-arrows-fullscreen"></i>
                                        </span>
                                    </span>

                                    <span class="service-choice-content">

                                        <span class="service-name">
                                            @service.ServiceName
                                        </span>

                                        <span class="service-price">

                                            @if (
                                           servicePromotion != null &&
                                           servicePromotion.HasEstimatedPrice &&
                                           !string.Equals(
                                               servicePromotion.RewardType,
                                               "ServiceSpecialPrice",
                                               StringComparison.OrdinalIgnoreCase) &&
                                           !string.Equals(
                                               servicePromotion.RewardType,
                                               "FreeService",
                                               StringComparison.OrdinalIgnoreCase)
                                           )
                                            {
                                                <del class="target-old-price">
                                                    @servicePromotion.DisplayOriginalPriceText
