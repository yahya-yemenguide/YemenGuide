@using System.Globalization
@inject Microsoft.Extensions.Localization.IStringLocalizer<YemenGuide.Web.SharedResource> L

@{
    var modalDirection =
        CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft
            ? "rtl"
            : "ltr";
}

<div class="employee-password-gate"
     id="employeePasswordGate"
     role="dialog"
     aria-modal="true"
     aria-labelledby="employeePasswordGateTitle"
     aria-describedby="employeePasswordGateDescription"
     dir="@modalDirection">

    <div class="employee-password-gate__backdrop" aria-hidden="true"></div>

    <section class="employee-password-gate__dialog">
        <div class="employee-password-gate__glow employee-password-gate__glow--one"></div>
        <div class="employee-password-gate__glow employee-password-gate__glow--two"></div>

        <header class="employee-password-gate__header">
            <div class="employee-password-gate__icon" aria-hidden="true">
                <i class="bi bi-shield-lock-fill"></i>
            </div>

            <div class="employee-password-gate__heading">
                <span class="employee-password-gate__eyebrow">
                    @L["Admin_Password_Protection"]
                </span>

                <h2 id="employeePasswordGateTitle">
                    @L["Admin_Password_CreateOwn"]
                </h2>

                <p id="employeePasswordGateDescription">
                    @L["Admin_Password_TemporaryIntro"]
                </p>
            </div>
        </header>

        <div class="employee-password-gate__notice">
            <span class="employee-password-gate__notice-icon">
                <i class="bi bi-info-circle-fill"></i>
            </span>

            <div>
                <strong>@L["Admin_Password_RequiredStep"]</strong>
                <span>@L["Admin_Password_CannotContinue"]</span>
            </div>
        </div>

        <form id="employeePasswordGateForm"
              class="employee-password-gate__form"
              autocomplete="off"
              novalidate>

            @Html.AntiForgeryToken()

            <div class="employee-password-gate__field">
                <label for="employeeNewPassword">
                    @L["Admin_Password_New"]
                </label>

                <div class="employee-password-gate__input-wrap">
                    <i class="bi bi-lock-fill employee-password-gate__leading-icon"
                       aria-hidden="true"></i>

                    <input type="password"
                           id="employeeNewPassword"
                           name="newPassword"
                           autocomplete="new-password"
                           placeholder="@L["Admin_Password_Min8"]"
                           minlength="8"
                           required />

                    <button type="button"
                            class="employee-password-gate__toggle"
                            data-password-toggle="employeeNewPassword"
                            aria-label="@L["Admin_Password_Toggle"]">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <div class="employee-password-gate__field">
                <label for="employeeConfirmPassword">
                    @L["Admin_Password_Confirm"]
                </label>

                <div class="employee-password-gate__input-wrap">
                    <i class="bi bi-shield-check employee-password-gate__leading-icon"
                       aria-hidden="true"></i>

                    <input type="password"
                           id="employeeConfirmPassword"
                           name="confirmPassword"
                           autocomplete="new-password"
                           placeholder="@L["Admin_Password_Reenter"]"
                           minlength="8"
                           required />

                    <button type="button"
                            class="employee-password-gate__toggle"
                            data-password-toggle="employeeConfirmPassword"
                            aria-label="@L["Admin_Password_ToggleConfirm"]">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <div class="employee-password-gate__rules" aria-live="polite">
                <div class="employee-password-gate__rule" data-rule="length">
                    <span><i class="bi bi-check2"></i></span>
                    @L["Admin_Password_Min8"]
                </div>

                <div class="employee-password-gate__rule" data-rule="letter">
                    <span><i class="bi bi-check2"></i></span>
                    @L["Admin_Password_EnglishLetter"]
                </div>

                <div class="employee-password-gate__rule" data-rule="number">
                    <span><i class="bi bi-check2"></i></span>
                    @L["Admin_Password_Number"]
                </div>

                <div class="employee-password-gate__rule" data-rule="match">
                    <span><i class="bi bi-check2"></i></span>
                    @L["Admin_Password_Match"]
                </div>
            </div>

            <div id="employeePasswordGateError"
                 class="employee-password-gate__error"
                 role="alert"
                 hidden></div>

            <button type="submit"
                    id="employeePasswordGateSubmit"
                    class="employee-password-gate__submit"
                    disabled>
                <span class="employee-password-gate__submit-icon">
                    <i class="bi bi-shield-check"></i>
                </span>

                <span class="employee-password-gate__submit-text">
                    @L["Admin_Password_SecureContinue"]
                </span>

                <span class="spinner-border spinner-border-sm employee-password-gate__spinner"
                      role="status"
                      aria-hidden="true"
                      hidden></span>
            </button>

            <div class="employee-password-gate__footer-note">
                <i class="bi bi-lock-fill"></i>
                @L["Admin_Password_EncryptedNote"]
            </div>
        </form>
    </section>
</div>
