@model YemenGuide.Core.DTOs.Customer.PlaceSearchViewModel
@{
    ViewData["Title"] = "البحث واستكشاف الأماكن";
    ViewData["HideFooter"] = true;

    var searchAds = Model?.Advertisements ?? new List<YemenGuide.Core.DTOs.Customer.CustomerAdvertisementDto>();
    bool hasSearchAds = searchAds.Count > 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/customer/Search.css" asp-append-version="true" />
}

    <div class="search-luxury-page" dir="rtl">
        <div class="search-ambient search-ambient-one"></div>
        <div class="search-ambient search-ambient-two"></div>
        <div class="search-ambient search-ambient-three"></div>

        <main class="container search-page-container">
            @* ============================================================= *@
            @* 1. مقدمة الصفحة *@
            @* ============================================================= *@
            <div id="searchHeroSlot">
            @if (hasSearchAds)
            {
                <section class="search-ad-signature search-reveal-item"
                     data-search-ad-slider
                     data-autoplay-ms="6200"
                     data-swipe-threshold="52"
                     tabindex="0"
                     aria-roledescription="carousel"
                     aria-label="إعلانات ممولة">

                    <div class="search-ad-signature__viewport">
                        @for (int adIndex = 0; adIndex < searchAds.Count; adIndex++)
                        {
                            var ad = searchAds[adIndex];
                            bool activeAd = adIndex == 0;

                            <article class="search-ad-signature__slide @(activeAd ? "is-active" : "")"
                             data-search-ad-slide
                             data-search-ad-open
                             data-customer-ad
                             data-customer-ad-click
                             data-advertisement-id="@ad.AdvertisementId"
                             data-placement-type="@ad.PlacementType"
                             data-fallback-url="@ad.FallbackUrl"
                             role="link"
                             tabindex="@(activeAd ? "0" : "-1")"
                             aria-label="فتح منشأة @ad.PlaceName"
                             aria-hidden="@(activeAd ? "false" : "true")">

                                <div class="search-ad-signature__media" aria-hidden="true">
                                    @if (ad.IsVideo)
                                    {
                                        if (!string.IsNullOrWhiteSpace(ad.ThumbnailPath))
                                        {
                                            <img src="@ad.ThumbnailPath"
                                 alt=""
                                 decoding="async"
                                 fetchpriority="@(activeAd ? "high" : "auto")"
                                 onerror="this.onerror=null;this.src='/images/bg1.jpg';" />
                                        }
                                        else
                                        {
                                            <video src="@ad.MediaPath"
                                   muted
                                   loop
                                   playsinline
                                   preload="metadata"></video>
                                        }
                                    }
                                    else
                                    {
                                        <img src="@ad.MediaPath"
                                 alt=""
                                 decoding="async"
                                 fetchpriority="@(activeAd ? "high" : "auto")"
                                 onerror="this.onerror=null;this.src='/images/bg1.jpg';" />
                                    }
                                </div>

                                <span class="search-ad-signature__shade" aria-hidden="true"></span>
                                <span class="search-ad-signature__aurora search-ad-signature__aurora--cyan" aria-hidden="true"></span>
                                <span class="search-ad-signature__aurora search-ad-signature__aurora--coral" aria-hidden="true"></span>
                                <span class="search-ad-signature__light-sweep" aria-hidden="true"></span>

                                <div class="search-ad-signature__stage">
                                    <div class="search-ad-signature__content"
                                 data-search-ad-tilt>
                                        <span class="search-ad-signature__mist search-ad-signature__mist--deep" aria-hidden="true"></span>
                                        <span class="search-ad-signature__mist search-ad-signature__mist--cyan" aria-hidden="true"></span>
                                        <span class="search-ad-signature__mist search-ad-signature__mist--soft" aria-hidden="true"></span>

                                        <div class="search-ad-signature__top">
                                            <span class="search-ad-signature__sponsored">
                                                <span class="search-ad-signature__pulse"></span>
                                                <i class="bi bi-stars"></i>
                                                إعلان ممول
                                            </span>

                                            <span class="search-ad-signature__place" title="@ad.PlaceName">
                                                <i class="bi bi-patch-check-fill"></i>
                                                <span>@ad.PlaceName</span>
                                            </span>
                                        </div>

                                        <div class="search-ad-signature__copy">
                                            <span class="search-ad-signature__kicker">
                                                <i class="bi bi-compass-fill"></i>
                                                اختيار مميز لك
                                            </span>

                                            <h1>@ad.AdvertisementTitle</h1>

                                            @if (!string.IsNullOrWhiteSpace(ad.ShortDescription))
                                            {
                                                <p>@ad.ShortDescription</p>
                                            }
                                        </div>

                                        <div class="search-ad-signature__chips">
                                            @if (!string.IsNullOrWhiteSpace(ad.CategoryName))
                                            {
                                                <span>
                                                    <i class="bi bi-grid-fill"></i>
                                                    @ad.CategoryName
                                                </span>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(ad.CityName))
                                            {
                                                <span>
                                                    <i class="bi bi-geo-alt-fill"></i>
                                                    @ad.CityName
                                                </span>
                                            }
                                        </div>

                                        <div class="search-ad-signature__actions">
                                            <a href="@ad.FallbackUrl"
                                       class="search-ad-signature__cta"
                                       data-search-ad-click
                                       data-customer-ad-click
                                       data-advertisement-id="@ad.AdvertisementId"
                                       data-placement-type="@ad.PlacementType"
                                       data-fallback-url="@ad.FallbackUrl">
                                                <span>@ad.ButtonText</span>
                                                <span class="search-ad-signature__cta-icon">
                                                    <i class="bi bi-arrow-left"></i>
                                                </span>
                                            </a>

                                            <span class="search-ad-signature__micro">
                                                <i class="bi bi-mouse2-fill"></i>
                                                اضغط على الإعلان لعرض المنشأة
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>

                    @if (searchAds.Count > 1)
                    {
                        <button type="button"
                        class="search-ad-signature__nav search-ad-signature__nav--prev"
                        data-search-ad-prev
                        aria-label="الإعلان السابق">
                            <i class="bi bi-chevron-right"></i>
                        </button>

                        <button type="button"
                        class="search-ad-signature__nav search-ad-signature__nav--next"
                        data-search-ad-next
                        aria-label="الإعلان التالي">
                            <i class="bi bi-chevron-left"></i>
                        </button>

                        <div class="search-ad-signature__pager" aria-label="التنقل بين الإعلانات">
                            <div class="search-ad-signature__counter" aria-live="polite">
                                <strong data-search-ad-current>01</strong>
                                <span>/</span>
                                <small>@searchAds.Count.ToString("D2")</small>
                            </div>

                            <div class="search-ad-signature__dots" role="tablist" aria-label="الإعلانات">
                                @for (int dotIndex = 0; dotIndex < searchAds.Count; dotIndex++)
                                {
                                    <button type="button"
                                class="search-ad-signature__dot @(dotIndex == 0 ? "is-active" : "")"
                                data-search-ad-dot="@dotIndex"
                                aria-label="الانتقال إلى الإعلان رقم @(dotIndex + 1)"
                                aria-selected="@(dotIndex == 0 ? "true" : "false")">
                                        <span></span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </section>
            }
            else
            {
                <section class="search-hero-panel search-reveal-item">
                    <div class="search-hero-lines" aria-hidden="true"></div>

                    <div class="search-hero-copy">
                        <div class="search-hero-eyebrow">
                            <span class="search-hero-eyebrow-icon"><i class="bi bi-compass-fill"></i></span>
                            <span>وجهتك القادمة أقرب مما تتخيل</span>
                        </div>

                        <h1 class="search-hero-title">
                            استكشف <span>الأماكن</span>
                            <small>بطريقتك</small>
                        </h1>

                        <p class="search-hero-subtitle">
                            ابحث بين الوجهات، قارن الخيارات، وشاهد العروض المتاحة في تجربة واحدة مرتبة وفخمة.
                        </p>
                    </div>

                    <div class="search-hero-stat" aria-label="عدد النتائج">
                        <span class="search-hero-stat-orbit"></span>
                        <span class="search-hero-stat-icon"><i class="bi bi-stars"></i></span>
                        <strong id="resultsCount">@Model.TotalItems</strong>
                        <small>نتيجة متاحة</small>
                    </div>
                </section>
            }
        </div>
        @if (hasSearchAds)
        {
            <span id="resultsCount" class="visually-hidden">@Model.TotalItems</span>
        }

        @* ============================================================= *@
        @* 2. شريط الفئات *@
        @* ============================================================= *@
        <section class="search-category-dock search-reveal-item">
            <div class="search-section-mini-title">
                <span><i class="bi bi-grid-1x2-fill"></i></span>
                <div>
                    <strong>اختر الفئة</strong>
                    <small>انتقل مباشرة لما يناسبك</small>
                </div>
            </div>

            <div class="categories-wrapper" id="categoriesWrapper">
                <button type="button"
                        class="category-item @(Model.SelectedCategoryId == null ? "active-category" : "")"
                        onclick="selectCategory('', this)"
                        data-cat-id=""
                        aria-label="كل الفئات">
                    <span class="category-icon-wrapper">
                        <i class="bi bi-grid"></i>
                    </span>
                    <small>الكل</small>
                </button>

                @if (Model.Categories != null)
                {
                    foreach (var cat in Model.Categories)
                    {
                        string dbIcon = string.IsNullOrWhiteSpace(cat.IconClass)
                        ? "bi-geo-alt"
                        : cat.IconClass;

                        <button type="button"
                        class="category-item @(Model.SelectedCategoryId == cat.Id ? "active-category" : "")"
                        onclick="selectCategory('@cat.Id', this)"
                        data-cat-id="@cat.Id"
                        aria-label="@cat.Name">
                            <span class="category-icon-wrapper">
                                <i class="bi @dbIcon"></i>
                            </span>
                            <small>@cat.Name</small>
                        </button>
                    }
                }
            </div>
        </section>

        @* ============================================================= *@
        @* 3. لوحة البحث والفلاتر *@
        @* ============================================================= *@
        <section class="search-command-center search-reveal-item">
            <form action="/Places/Search" method="get" id="searchForm">
                <input type="hidden" name="page" id="currentPage" value="@Model.CurrentPage" />
                <input type="hidden" name="categoryId" id="selectedCategoryId" value="@Model.SelectedCategoryId" />

                <div class="search-command-grid">
                    <label class="search-control search-control-main">
                        <span class="search-control-icon"><i class="bi bi-search"></i></span>
                        <span class="search-control-copy">
                            <small>ابحث عن وجهتك</small>
                            <input type="text"
                                   name="q"
                                   value="@Model.SearchQuery"
                                   placeholder="مثال: فندق، شاليه، قاعة..."
                                   autocomplete="off"
                                   oninput="debounceSearch(this)" />
                        </span>
                        <span class="search-control-focus-ring"></span>
                    </label>

                    <label class="search-control search-control-city">
                        <span class="search-control-icon"><i class="bi bi-geo-alt-fill"></i></span>
                        <span class="search-control-copy">
                            <small>المدينة</small>
                            <select name="cityId" onchange="resetPageAndSearch()">
                                <option value="">كل المدن</option>
                                @if (Model.Cities != null)
                                {
                                    foreach (var city in Model.Cities)
                                    {
                                        <option value="@city.Id" selected="@(Model.SelectedCityId == city.Id)">@city.Name</option>
                                    }
                                }
                            </select>
                        </span>
                        <i class="bi bi-chevron-down search-select-arrow"></i>
                    </label>

                    <button type="button"
                            class="search-filter-toggle"
                            data-bs-toggle="collapse"
                            data-bs-target="#advancedSearchPanel"
                            aria-expanded="false"
                            title="فلاتر متقدمة">
                        <span class="search-filter-toggle-icon">
                            <i class="bi bi-sliders2"></i>
                            <span class="search-filter-active-count" id="activeFilterCount" hidden>0</span>
                        </span>
                        <span class="search-filter-toggle-copy">
                            <strong>فلاتر متقدمة</strong>
                            <small>فلترة وترتيب حقيقي للنتائج</small>
                        </span>
                        <i class="bi bi-chevron-down search-filter-toggle-arrow"></i>
                    </button>
                </div>

                <div class="collapse" id="advancedSearchPanel">
                    <div class="search-filter-deck">
                        <div class="search-filter-deck-head">
                            <div class="search-filter-deck-title">
                                <span><i class="bi bi-stars"></i></span>
                                <div>
                                    <strong>تصفية ذكية</strong>
                                    <small>يمكنك جمع أكثر من خيار، والأقل/الأعلى سعراً متعاكسان فقط</small>
                                </div>
                            </div>

                            <button type="button"
                                    class="search-filter-reset"
                                    onclick="resetAdvancedFilters()"
                                    title="مسح الفلاتر المتقدمة">
                                <i class="bi bi-arrow-counterclockwise"></i>
                                <span>مسح</span>
                            </button>
                        </div>

                        <div class="custom-chip-container">
                            <div class="filter-chip-wrapper filter-chip-offer">
                                <input type="checkbox"
                                       class="btn-check filter-checkbox"
                                       name="onlyWithOffers"
                                       id="only_offers"
                                       value="true"
                                       @(Model.OnlyWithOffers ? "checked" : "")
                                       onchange="resetPageAndSearch()" />
                                <label class="filter-chip" for="only_offers">
                                    <span class="filter-chip-icon"><i class="bi bi-fire"></i></span>
                                    <span>
                                        <strong>لديها عروض</strong>
                                        <small>خصومات فعّالة الآن</small>
                                    </span>
                                </label>
                            </div>

                            <div class="filter-chip-wrapper filter-chip-bookable">
                                <input type="checkbox"
                                       class="btn-check filter-checkbox"
                                       name="onlyBookable"
                                       id="only_bookable"
                                       value="true"
                                       @(Model.OnlyBookable ? "checked" : "")
                                       onchange="resetPageAndSearch()" />
                                <label class="filter-chip" for="only_bookable">
                                    <span class="filter-chip-icon"><i class="bi bi-calendar2-check-fill"></i></span>
                                    <span>
                                        <strong>قابلة للحجز</strong>
                                        <small>لديها خيار حجز فعّال</small>
                                    </span>
                                </label>
                            </div>

                            <div class="filter-chip-wrapper">
                                <input type="checkbox"
                                       class="btn-check filter-checkbox"
                                       name="sortOptions"
                                       id="sort_rec"
                                       value="recommended"
                                       @(Model.SortOptions != null && Model.SortOptions.Contains("recommended") ? "checked" : "")
                                       onchange="resetPageAndSearch()" />
                                <label class="filter-chip" for="sort_rec">
                                    <span class="filter-chip-icon"><i class="bi bi-award-fill"></i></span>
                                    <span>
                                        <strong>الموصى بها</strong>
                                        <small>تقييمات موثقة بالحجوزات</small>
                                    </span>
                                </label>
                            </div>

                            <div class="filter-chip-wrapper">
                                <input type="checkbox"
                                       class="btn-check filter-checkbox"
                                       name="sortOptions"
                                       id="sort_cheap"
                                       value="price_asc"
                                       @(Model.SortOptions != null && Model.SortOptions.Contains("price_asc") ? "checked" : "")
                                       onchange="togglePriceFilter('sort_cheap', 'sort_exp')" />
                                <label class="filter-chip" for="sort_cheap">
                                    <span class="filter-chip-icon"><i class="bi bi-arrow-down-short"></i></span>
                                    <span>
                                        <strong>الأقل سعراً</strong>
                                        <small>ترتيب تصاعدي</small>
                                    </span>
                                </label>
                            </div>

                            <div class="filter-chip-wrapper">
                                <input type="checkbox"
                                       class="btn-check filter-checkbox"
                                       name="sortOptions"
                                       id="sort_exp"
                                       value="price_desc"
                                       @(Model.SortOptions != null && Model.SortOptions.Contains("price_desc") ? "checked" : "")
                                       onchange="togglePriceFilter('sort_exp', 'sort_cheap')" />
                                <label class="filter-chip" for="sort_exp">
                                    <span class="filter-chip-icon"><i class="bi bi-arrow-up-short"></i></span>
                                    <span>
                                        <strong>الأعلى سعراً</strong>
                                        <small>ترتيب تنازلي</small>
                                    </span>
                                </label>
                            </div>

                            <div class="filter-chip-wrapper">
                                <input type="checkbox"
                                       class="btn-check filter-checkbox"
                                       name="sortOptions"
                                       id="sort_rate"
                                       value="top_rated"
                                       @(Model.SortOptions != null && Model.SortOptions.Contains("top_rated") ? "checked" : "")
                                       onchange="resetPageAndSearch()" />
                                <label class="filter-chip" for="sort_rate">
                                    <span class="filter-chip-icon"><i class="bi bi-star-fill"></i></span>
                                    <span>
                                        <strong>الأعلى تقييماً</strong>
                                        <small>حسب آراء العملاء</small>
                                    </span>
                                </label>
                            </div>

                            <div class="filter-chip-wrapper">
                                <input type="checkbox"
                                       class="btn-check filter-checkbox"
                                       name="sortOptions"
                                       id="sort_new"
                                       value="newest"
                                       @(Model.SortOptions != null && Model.SortOptions.Contains("newest") ? "checked" : "")
                                       onchange="resetPageAndSearch()" />
                                <label class="filter-chip" for="sort_new">
                                    <span class="filter-chip-icon"><i class="bi bi-stars"></i></span>
                                    <span>
                                        <strong>المضافة حديثاً</strong>
                                        <small>أحدث الوجهات</small>
                                    </span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </section>


        @* ============================================================= *@
        @* 4. رأس النتائج *@
        @* ============================================================= *@
        <section class="search-results-heading search-reveal-item" id="searchResultsAnchor">
            <div>
                <span class="search-results-kicker"><i class="bi bi-stars"></i> اكتشف ما يناسبك</span>
                <h2>وجهات تستحق <span>التجربة</span></h2>
            </div>

            <div class="search-results-legend">
                <span><i class="bi bi-hand-index-thumb"></i> مرّر على البطاقة لتجربة 3D</span>
                <span class="search-results-legend-mobile"><i class="bi bi-phone"></i> مصممة للمس بسلاسة</span>
            </div>
        </section>

        @* ============================================================= *@
        @* 5. النتائج *@
        @* ============================================================= *@
        <div class="row g-4 search-results-grid" id="resultsContainer">
            @if (Model.Results != null && Model.Results.Any())
            {
                int cardIndex = 0;

                foreach (var place in Model.Results)
                {
                    string detailsUrl = place.HasActivePromotion && place.ActivePromotionId.HasValue
                    ? $"/Places/Details/{place.PlaceId}?promotionId={place.ActivePromotionId.Value}"
                    : $"/Places/Details/{place.PlaceId}";

                    string categoryName = string.IsNullOrWhiteSpace(place.CategoryName)
                    ? "عام"
                    : place.CategoryName!;

                    string cityName = string.IsNullOrWhiteSpace(place.CityName)
                    ? "اليمن"
                    : place.CityName!;

                    string footerTitle = place.HasBooking
                    ? "جاهز للحجز"
                    : "جاهز للاستكشاف";

                    string footerSubtitle = place.HasBooking
                    ? "التفاصيل وخيارات الحجز"
                    : "التفاصيل والخدمات المتاحة";

                    var extraImages = place.GalleryImages != null
                    ? place.GalleryImages
                    .Where(image => !string.IsNullOrWhiteSpace(image) && image != place.MainImage)
                    .Distinct()
                    .ToList()
                    : new List<string>();

                    var displayImages = new List<string>();
                    displayImages.AddRange(extraImages.Take(3));
                    while (displayImages.Count < 3)
                    {
                        displayImages.Add(string.Empty);
                    }

                    <div class="col-12 col-md-6 col-xl-4 featured-wow-stage search-featured-stage"
                 data-search-stage
                 style="--featured-delay:@(cardIndex * 70)ms;">

                        <article class="app-card-vip luxury-edition featured-wow-card search-featured-card"
                         data-search-card>

                            <span class="featured-wow-depth" aria-hidden="true"></span>
                            <span class="featured-wow-spotlight" aria-hidden="true"></span>
                            <span class="featured-wow-shine" aria-hidden="true"></span>

                            <div class="featured-wow-media">
                                <a href="@detailsUrl"
                           class="featured-wow-main-link"
                           aria-label="عرض تفاصيل @place.Name">

                                    <div class="luxury-grid featured-wow-gallery"
                                 data-images="@System.Text.Json.JsonSerializer.Serialize(extraImages)">

                                        <div class="grid-img-large featured-wow-main-image">
                                            @if (!string.IsNullOrWhiteSpace(place.MainImage) &&
                                           place.MainImage != "/images/places/default-main.jpg")
                                            {
                                                <img src="@place.MainImage"
                                         class="featured-main-photo"
                                         alt="@place.Name"
                                         loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="featured-wow-placeholder search-featured-placeholder">
                                                    <i class="bi bi-image"></i>
                                                </div>
                                            }
                                        </div>

                                        <div class="grid-img-small-group featured-wow-thumbs"
                                     aria-label="صور إضافية لـ @place.Name">
                                            @for (int i = 0; i < 3; i++)
                                            {
                                                <div class="grid-img-small featured-wow-thumb" style="--thumb-index:@i;">
                                                    @if (!string.IsNullOrWhiteSpace(displayImages[i]))
                                                    {
                                                        <img src="@displayImages[i]"
                                             class="magic-image"
                                             alt="صورة إضافية لـ @place.Name"
                                             loading="lazy"
                                             data-original="@displayImages[i]" />
                                                    }
                                                    else
                                                    {
                                                        <div class="featured-wow-thumb-empty">
                                                            <i class="bi bi-image"></i>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </a>

                                @* لا توجد شارة "مميز" هنا: هذه بطاقة نتيجة بحث عادية *@
                                <div class="featured-wow-topbar search-featured-topbar">
                                    <button class="btn-favorite-app featured-wow-favorite @(place.IsFavorited ? "active" : "")"
                                    type="button"
                                    data-search-favorite
                                    data-place-id="@place.PlaceId"
                                    aria-pressed="@(place.IsFavorited ? "true" : "false")"
                                    title="@(place.IsFavorited ? "إزالة من المفضلة" : "إضافة للمفضلة")"
                                    aria-label="@(place.IsFavorited ? "إزالة من المفضلة" : "إضافة للمفضلة")">
                                        <i class="bi @(place.IsFavorited ? "bi-heart-fill" : "bi-heart")"></i>
                                    </button>
                                </div>

                                <div class="featured-wow-rating" aria-label="التقييم @place.Rating من 5">
                                    <span class="featured-wow-rating-star"><i class="bi bi-star-fill"></i></span>
                                    <span class="featured-wow-rating-copy">
                                        <strong>@place.Rating.ToString("0.0")</strong>
                                        <small>@place.ReviewsCount تقييم</small>
                                    </span>
                                </div>

                                <div class="featured-wow-identity">
                                    <a href="@detailsUrl" class="featured-wow-identity-main">
                                        <div class="featured-wow-name-row">
                                            <h3>@place.Name</h3>
                                            <i class="bi bi-patch-check-fill"></i>
                                        </div>

                                        <div class="featured-wow-meta">
                                            <span><i class="bi bi-grid-fill"></i>@categoryName</span>
                                            <span><i class="bi bi-geo-alt-fill"></i>@cityName</span>
                                        </div>
                                    </a>

                                    @if (place.HasActivePromotion && place.ActivePromotionId.HasValue)
                                    {
                                        <a class="featured-wow-offer-inline"
                               href="@detailsUrl"
                               title="@place.ActivePromotionTitle"
                               aria-label="عرض متاح في @place.Name">
                                            <span class="featured-wow-offer-inline-glow" aria-hidden="true"></span>
                                            <span class="featured-wow-offer-inline-icon" aria-hidden="true">
                                                <i class="bi bi-fire"></i>
                                            </span>
                                            <span class="featured-wow-offer-inline-copy">
                                                <strong>عرض متاح</strong>
                                                <small>@place.PromotionDiscountText · @place.PromotionTargetLabel</small>
                                            </span>
                                            <i class="bi bi-arrow-left featured-wow-offer-inline-arrow" aria-hidden="true"></i>
                                        </a>
                                    }
                                </div>
                            </div>

                            <div class="featured-wow-footer search-featured-footer">
                                <div class="featured-wow-trust search-featured-info">
                                    <span class="featured-wow-trust-icon">
                                        <i class="bi @(place.HasBooking ? "bi-calendar2-check" : "bi-compass")"></i>
                                    </span>
                                    <span>
                                        <strong>@footerTitle</strong>
                                        <small>@footerSubtitle</small>
                                    </span>
                                </div>

                                <a href="@detailsUrl" class="featured-wow-action">
                                    <span>اكتشف المكان</span>
                                    <i class="bi bi-arrow-left"></i>
                                </a>
                            </div>
                        </article>
                    </div>

                    cardIndex++;
                }

                @if (Model.TotalPages > 1)
                {
                    <div class="col-12 search-pagination-wrap">
                        <nav aria-label="التنقل بين صفحات النتائج">
                            <ul class="pagination custom-pagination">
                                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                    <button type="button"
                                    class="page-link nav-btn"
                                    onclick="changePage(@(Model.CurrentPage - 1))">
                                        <i class="bi bi-chevron-right"></i>
                                        <span>السابق</span>
                                    </button>
                                </li>

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                        <button type="button" class="page-link num-btn" onclick="changePage(@i)">@i</button>
                                    </li>
                                }

                                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                    <button type="button"
                                    class="page-link nav-btn"
                                    onclick="changePage(@(Model.CurrentPage + 1))">
                                        <span>التالي</span>
                                        <i class="bi bi-chevron-left"></i>
                                    </button>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="search-empty-state">
                        <div class="search-empty-orbit" aria-hidden="true"></div>
                        <span class="search-empty-icon"><i class="bi bi-search-heart"></i></span>
                        <h3>لم نجد نتيجة مطابقة</h3>
                        <p>جرّب تغيير الفلاتر أو اختر مدينة أو فئة أخرى، وقد تجد وجهتك التالية مباشرة.</p>
                        <button type="button" class="search-empty-reset" onclick="resetSearchFilters()">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            <span>إعادة ضبط البحث</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    </main>
</div>

@if (hasSearchAds)
{
    <div id="customerAdvertisementTracking"
     data-impression-url="@Url.Action("Impression", "CustomerAdvertisements")"
     data-click-url="@Url.Action("Click", "CustomerAdvertisements")"
     hidden>
        @Html.AntiForgeryToken()
    </div>
}

@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.js"></script>
    @* تسجيل المشاهدة والنقرة الفعلية للإعلان قبل منطق سلايدر البحث. *@
    <script src="~/js/customer/advertisements.js" asp-append-version="true"></script>
    <script src="~/js/customer/Search.js" asp-append-version="true"></script>
}
