       لا يغيّر أي ID أو أسماء حقول أو منطق حفظ.
       ================================================================ */
    .communication-settings-v2 {
        --comm-cyan: #00a6da;
        --comm-cyan-dark: #008fbd;
        --comm-green: #18a875;
        --comm-amber: #e7a51a;
        --comm-navy: #05203c;
        --comm-text: #26323d;
        --comm-muted: #71808f;
        --comm-line: #e4edf2;
        --comm-soft: #f8fbfd;
        --comm-cyan-soft: #effbff;
        --comm-green-soft: #effbf7;
        --comm-amber-soft: #fff9ec;
        gap: 8px;
    }

    .communication-settings-v2 .communication-top-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        align-items: stretch;
    }

    .communication-settings-v2 .communication-top-grid .communication-chat-card {
        grid-column: 2;
        grid-row: 1;
    }

    .communication-settings-v2 .communication-top-grid .communication-contact-card {
