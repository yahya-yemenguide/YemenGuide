<div class="royal-policies-wrapper policy-section-stack fade-in-up" dir="rtl">

    <section class="policy-experience-banner policy-experience-banner--booking" data-policy-reveal>
        <div class="policy-experience-banner__icon" aria-hidden="true">
            <i class="bi bi-stars"></i>
        </div>
        <div class="policy-experience-banner__copy">
            <span class="policy-experience-banner__eyebrow">رحلة حجز أكثر وضوحًا</span>
            <h2>رحلة حجز واحدة وواضحة</h2>
            <p>اضبط العربون ومهلة السداد؛ وبعد إكمال العميل للخطوات المطلوبة يراجع المالك الحجز ويؤكده.</p>
        </div>
        <div class="policy-experience-pills" aria-hidden="true">
            <span><i class="bi bi-shield-check"></i> مراجعة المالك</span>
            <span><i class="bi bi-wallet2"></i> عربون</span>
            <span><i class="bi bi-hourglass-split"></i> مهلة</span>
        </div>
    </section>

    <!--
        لم يعد BookingApprovalMode خيارًا للمستخدم.
        تبقى هذه القيمة مخفية فقط للتوافق مع DTO وقاعدة البيانات الحالية.
        منطق الحجز الفعلي أصبح موحدًا داخل BookingFlowController.
    -->
    <input type="radio"
           name="bookingApprovalMode"
           value="Instant"
           checked
           hidden
           aria-hidden="true" />




    <div class="policy-two-column-grid">
        <section class="royal-card policy-card policy-card--green emerald-theme">
            <header class="policy-card__header policy-card__header--compact">
                <span class="icon-glow-wrapper policy-card__icon" aria-hidden="true">
                    <i class="bi bi-cash-coin"></i>
                </span>
                <div>
                    <span class="policy-card__kicker">التزامات الدفع</span>
                    <h2>سياسات العربون والدفع</h2>
                    <p>أضف نسبة أو مبلغ العربون المطلوب لتأكيد الحجز.</p>
                </div>
            </header>

            <div id="depositPoliciesContainer"
                 class="policy-builder-list d-flex flex-column gap-3 mb-3">
                <div class="luxury-list-item policy-builder-item">
                    <span class="item-icon policy-builder-item__icon" aria-hidden="true">
                        <i class="bi bi-check2"></i>
                    </span>

                    <div class="input-group input-group-sm policy-builder-item__value">
                        <input type="number"
                               class="form-control text-center fw-bold policy-val"
                               value="50"
                               aria-label="قيمة العربون"
                               readonly />
                        <select class="form-select fw-bold policy-type"
                                aria-label="نوع قيمة العربون"
                                disabled>
                            <option value="%" selected>%</option>
                            <option value="fixed">ريال</option>
                        </select>
                    </div>

                    <input type="text"
                           class="form-control policy-desc"
                           value="كعربون مبدئي لتأكيد الحجز."
                           aria-label="وصف سياسة العربون"
                           readonly />

                    <div class="actions-wrapper policy-builder-item__actions">
                        <button type="button"
                                class="btn-action text-primary btn-edit"
                                onclick="toggleEditMode(this)"
                                aria-label="تعديل سياسة العربون">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button type="button"
                                class="btn-action text-danger btn-delete"
                                onclick="this.closest('.luxury-list-item').remove()"
                                aria-label="حذف سياسة العربون">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </div>
                </div>
            </div>

            <button type="button"
                    class="btn-royal-add emerald-add w-100"
                    onclick="addCompositePolicy()">
                <i class="bi bi-plus-circle"></i>
                <span>إضافة شرط مالي آخر</span>
            </button>
        </section>

        <section class="royal-card policy-card policy-card--amber gold-theme">
            <header class="policy-card__header policy-card__header--compact">
                <span class="icon-glow-wrapper policy-card__icon" aria-hidden="true">
                    <i class="bi bi-shield-lock-fill"></i>
                </span>
                <div>
                    <span class="policy-card__kicker">حماية المنشأة</span>
                    <h2>ضمانات السلامة</h2>
                    <p>أضف المتطلبات التي يجب على الزبون الالتزام بها.</p>
                </div>
            </header>

            <div id="securityPoliciesContainer"
                 class="policy-builder-list d-flex flex-column gap-3 mb-3">
                <div class="luxury-list-item policy-builder-item">
                    <span class="item-icon policy-builder-item__icon" aria-hidden="true">
                        <i class="bi bi-shield-check"></i>
                    </span>

                    <input type="text"
                           class="form-control policy-desc"
                           value="تسليم البطاقة الشخصية الأصلية عند الدخول."
                           aria-label="وصف ضمان السلامة"
                           readonly />

                    <div class="actions-wrapper policy-builder-item__actions">
                        <button type="button"
                                class="btn-action text-primary btn-edit"
                                onclick="toggleEditMode(this)"
                                aria-label="تعديل ضمان السلامة">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button type="button"
                                class="btn-action text-danger btn-delete"
                                onclick="this.closest('.luxury-list-item').remove()"
                                aria-label="حذف ضمان السلامة">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </div>
                </div>
            </div>

            <button type="button"
                    class="btn-royal-add gold-add w-100"
                    onclick="addSimplePolicy()">
                <i class="bi bi-plus-circle"></i>
                <span>إضافة ضمان آخر</span>
            </button>
        </section>
    </div>

    <div class="policy-two-column-grid policy-two-column-grid--balanced">
        <section class="royal-card policy-card policy-card--coral ruby-theme">
            <header class="policy-card__header policy-card__header--compact">
                <span class="icon-glow-wrapper policy-card__icon" aria-hidden="true">
                    <i class="bi bi-hourglass-split"></i>
                </span>
                <div>
                    <span class="policy-card__kicker">مهلة الدفع</span>
                    <h2>مؤقت السداد</h2>
                    <p>الوقت المتاح للدفع قبل إلغاء الحجز آليًا.</p>
                </div>
            </header>

            <div class="policy-number-field border">
                <label for="paymentTimeout">مهلة السداد</label>
                <div class="input-group">
                    <input type="number"
                           class="form-control text-center fw-bold show-spinners"
                           id="paymentTimeout"
                           value=""
                           min="1"
                           max="72" />
                    <span class="input-group-text">ساعة</span>
                </div>
                <small>من ساعة واحدة وحتى 72 ساعة.</small>
            </div>
        </section>

        <section class="royal-card policy-card policy-card--cyan azure-theme">
            <header class="policy-card__header policy-card__header--compact">
                <span class="icon-glow-wrapper policy-card__icon" aria-hidden="true">
                    <i class="bi bi-currency-exchange"></i>
                </span>
                <div>
                    <span class="policy-card__kicker">خيارات السداد</span>
                    <h2>العملات المعتمدة</h2>
                    <p>حدد العملات التي تقبلها منشأتك بجانب الريال اليمني.</p>
                </div>
            </header>

            <div class="policy-currency-list">
                <div class="currency-card policy-currency-item active-currency">
                    <span class="currency-flag" aria-hidden="true">
                        <i class="bi bi-cash-stack"></i>
                    </span>
                    <span class="policy-currency-item__copy">
                        <strong>ريال يمني (YER)</strong>
                        <small>العملة الأساسية</small>
                    </span>
                    <span class="policy-status-badge policy-status-badge--success">
                        <i class="bi bi-check-lg"></i>
                        مفعل دائمًا
                    </span>
                </div>

                <label class="currency-card policy-currency-item toggleable-currency">
                    <span class="currency-flag" aria-hidden="true">
                        <i class="bi bi-wallet2"></i>
                    </span>
                    <span class="policy-currency-item__copy">
                        <strong>ريال سعودي (SAR)</strong>
                        <small>عملة إضافية اختيارية</small>
                    </span>
                    <span class="form-check form-switch m-0">
                        <input class="form-check-input"
                               type="checkbox"
                               id="isSarSupported"
                               checked />
                    </span>
                </label>

                <label class="currency-card policy-currency-item toggleable-currency">
                    <span class="currency-flag" aria-hidden="true">
                        <i class="bi bi-globe2"></i>
                    </span>
                    <span class="policy-currency-item__copy">
                        <strong>دولار أمريكي (USD)</strong>
                        <small>عملة إضافية اختيارية</small>
                    </span>
                    <span class="form-check form-switch m-0">
                        <input class="form-check-input"
                               type="checkbox"
                               id="isUsdSupported"
                               checked />
                    </span>
                </label>
            </div>
        </section>
    </div>

    <section class="royal-card policy-card policy-card--neutral silver-theme">
        <header class="policy-card__header">
            <span class="icon-glow-wrapper policy-card__icon" aria-hidden="true">
                <i class="bi bi-receipt"></i>
            </span>
            <div>
                <span class="policy-card__kicker">تفاصيل السعر</span>
                <h2>الرسوم والسعر غير المسترد</h2>
                <p>أضف الرسوم والضرائب وفعّل الخصم مقابل الحجز غير القابل للاسترداد.</p>
            </div>
        </header>

        <div class="policy-fees-grid">
            <div class="luxury-floating-input policy-field">
                <label for="cleaningFee">رسوم الخدمة أو التنظيف</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-plus-slash-minus" aria-hidden="true"></i>
                    <input type="number"
                           class="form-control show-spinners"
                           id="cleaningFee"
                           value="0"
                           min="0" />
                </div>
            </div>

            <div class="luxury-floating-input policy-field">
                <label for="taxPercentage">نسبة الضريبة (%)</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-percent" aria-hidden="true"></i>
                    <input type="number"
                           class="form-control show-spinners"
                           id="taxPercentage"
                           value="0"
                           min="0"
                           max="100" />
                </div>
            </div>

            <div class="policy-refundless-panel">
                <label class="policy-inline-toggle" for="nonRefundableRate">
                    <span class="policy-inline-toggle__copy">
                        <strong>السعر غير المسترد</strong>
                        <small>خصم مقابل الدفع الفوري دون إمكانية الاسترجاع.</small>
                    </span>
                    <span class="form-check form-switch m-0">
                        <input class="form-check-input"
                               type="checkbox"
                               id="nonRefundableRate" />
                    </span>
                </label>

                <div class="luxury-floating-input policy-field">
                    <label for="nonRefundableDiscount">نسبة الخصم المقدمة للزبون (%)</label>
                    <div class="input-icon-wrapper">
                        <i class="bi bi-tag-fill" aria-hidden="true"></i>
                        <input type="number"
                               class="form-control fw-bold text-primary show-spinners"
                               id="nonRefundableDiscount"
                               value="10"
                               min="1"
                               max="100"
                               disabled />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <footer class="policy-save-bar">
        <div class="policy-save-bar__copy">
            <i class="bi bi-info-circle"></i>
            <span>راجع القيم قبل الحفظ لضمان احتساب الحجز بشكل صحيح.</span>
        </div>
        <button type="button" class="btn-royal-save">
            <i class="bi bi-check2-all"></i>
            <span>حفظ سياسات الحجز والدفع</span>
        </button>
    </footer>
</div>
