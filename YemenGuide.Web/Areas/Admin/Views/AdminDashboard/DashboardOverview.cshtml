@model YemenGuide.Core.DTOs.Admin.DashboardDto
@using System.Globalization
@using System.Text.Json
@inject Microsoft.Extensions.Localization.IStringLocalizer<YemenGuide.Web.SharedResource> L

@{
    bool isRtl =
        CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;

    string locale =
        isRtl ? "ar-YE" : "en-US";

    ViewData["Title"] =
        L["Admin_Dashboard_Title"].Value;

    Layout =
        "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    string StatusLabel(string? status) =>
        (status ?? "")
        .Trim()
        .ToLowerInvariant()
        switch
        {
            "active" => L["Admin_Dashboard_Status_Active"].Value,
            "approved" => L["Admin_Dashboard_Status_Approved"].Value,
            "pending" => L["Admin_Dashboard_Status_Pending"].Value,
            "rejected" => L["Admin_Dashboard_Status_Rejected"].Value,
            "inactive" => L["Admin_Dashboard_Status_Inactive"].Value,
            _ => string.IsNullOrWhiteSpace(status)
                ? L["Admin_Dashboard_Status_Unknown"].Value
                : status
        };

    string StatusTone(string? status) =>
        (status ?? "")
        .Trim()
        .ToLowerInvariant()
        switch
        {
            "active" => "success",
            "approved" => "success",
            "pending" => "warning",
            "rejected" => "danger",
            _ => "neutral"
        };

    string FinanceLabel(string? status) =>
        (status ?? "")
        .Trim()
        .ToLowerInvariant()
        switch
        {
            "charged" => L["Admin_Dashboard_Finance_Charged"].Value,
            "held" => L["Admin_Dashboard_Finance_Held"].Value,
            "calculated" => L["Admin_Dashboard_Finance_Calculated"].Value,
            "debt" => L["Admin_Dashboard_Finance_Debt"].Value,
            "released" => L["Admin_Dashboard_Finance_Released"].Value,
            "notapplicable" => L["Admin_Dashboard_Finance_NotApplicable"].Value,
            _ => string.IsNullOrWhiteSpace(status)
                ? L["Admin_Dashboard_Status_Unknown"].Value
                : status
        };

    string FinanceTone(string? status) =>
        (status ?? "")
        .Trim()
        .ToLowerInvariant()
        switch
        {
            "charged" => "green",
            "held" => "orange",
            "calculated" => "blue",
            "debt" => "red",
            "released" => "purple",
            _ => "neutral"
        };

    string NormalizeCurrencyForEnglish(string? value)
    {
        var text = value ?? "";

        if (isRtl)
        {
            return text;
        }

        return text
            .Replace("ر.ي", "YER")
            .Replace("ر.س", "SAR")
            .Replace("د.إ", "AED");
    }

    string displayCurrencySymbol =
        !isRtl &&
        new[] { "YER", "SAR", "AED", "USD" }
            .Contains(
                Model.CurrencyCode,
                StringComparer.OrdinalIgnoreCase)
            ? Model.CurrencyCode.ToUpperInvariant()
            : Model.CurrencySymbol;

    // الاسم بيانات مستخدم ديناميكية: نعرضه كما هو ولا نترجمه.
    string adminDisplayName = Model.AdminName ?? "";

    // القيم المالية من النظام؛ نغيّر فقط رمز العملة عند الإنجليزية.
    string todayRevenueText =
        NormalizeCurrencyForEnglish(Model.TodayRevenueText);

    string totalRevenueText =
        NormalizeCurrencyForEnglish(Model.TotalRevenueText);

    string pendingRevenueText =
        NormalizeCurrencyForEnglish(Model.PendingRevenueText);
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin/dashboard-overview.css"
          asp-append-version="true" />
}

<div id="adminDashboardData"
     hidden
     data-locale="@locale"
     data-is-rtl="@isRtl.ToString().ToLowerInvariant()"
     data-currency="@(isRtl ? Model.DisplayCurrency : Model.CurrencyCode)"
     data-currency-code="@Model.CurrencyCode"
     data-currency-symbol="@displayCurrencySymbol"
     data-admin-name="@adminDisplayName"
     data-generated-at="@Model.GeneratedAt.ToString("O")"
     data-greeting-morning="@L["Admin_Dashboard_Morning"]"
     data-greeting-afternoon="@L["Admin_Dashboard_Afternoon"]"
     data-greeting-evening="@L["Admin_Dashboard_Evening"]"
     data-booking-created-name="@L["Admin_Dashboard_BookingsCreated"]"
     data-booking-starting-name="@L["Admin_Dashboard_BookingsStarting"]"
     data-revenue-name="@L["Admin_Dashboard_Revenue"]"
     data-booking-labels='@Html.Raw(JsonSerializer.Serialize(Model.BookingTrend.Select(x => x.Label)))'
     data-booking-created='@Html.Raw(JsonSerializer.Serialize(Model.BookingTrend.Select(x => x.Count)))'
     data-booking-starting='@Html.Raw(JsonSerializer.Serialize(Model.BookingTrend.Select(x => (int)x.Amount)))'
     data-revenue-labels='@Html.Raw(JsonSerializer.Serialize(Model.RevenueTrend.Select(x => x.Label)))'
     data-revenue-values='@Html.Raw(JsonSerializer.Serialize(Model.RevenueTrend.Select(x => x.Amount)))'
     data-place-status-keys='@Html.Raw(JsonSerializer.Serialize(Model.PlaceStatusDistribution.Select(x => x.Status)))'
     data-place-status-labels='@Html.Raw(JsonSerializer.Serialize(Model.PlaceStatusDistribution.Select(x => StatusLabel(x.Status))))'
     data-place-status-values='@Html.Raw(JsonSerializer.Serialize(Model.PlaceStatusDistribution.Select(x => x.Count)))'
     data-finance-keys='@Html.Raw(JsonSerializer.Serialize(Model.FinanceDistribution.Select(x => x.Status)))'
     data-finance-labels='@Html.Raw(JsonSerializer.Serialize(Model.FinanceDistribution.Select(x => FinanceLabel(x.Status))))'
     data-finance-values='@Html.Raw(JsonSerializer.Serialize(Model.FinanceDistribution.Select(x => x.Amount)))'
     data-category-labels='@Html.Raw(JsonSerializer.Serialize(Model.CategoryDistribution.Select(x => x.CategoryName)))'
     data-category-values='@Html.Raw(JsonSerializer.Serialize(Model.CategoryDistribution.Select(x => x.PlaceCount)))'>
</div>

<div class="admin-command-center">

    <section class="acc-hero acc-reveal">
        <div class="acc-hero__aurora" aria-hidden="true"></div>

        <div class="acc-hero__copy">
            <span class="acc-eyebrow">
                <i class="bi bi-activity"></i>
                <b></b>
                @L["Admin_Dashboard_CommandCenter"]
            </span>

            <h1>
                <span data-greeting>@L["Admin_Dashboard_Hello"]</span>,
                <strong data-admin-i18n-skip>@adminDisplayName</strong>
            </h1>

            <p>@L["Admin_Dashboard_Intro"]</p>
        </div>

        <div class="acc-hero__live">
            <span class="acc-live-pill">
                <i class="bi bi-broadcast-pin"></i>
                @L["Admin_Dashboard_Live"]
            </span>

            <strong data-live-clock>--:--</strong>

            <small>
                @Model.GeneratedAt.ToString(
                    "yyyy/MM/dd",
                    CultureInfo.CurrentCulture)
            </small>
        </div>

        <div class="acc-hero__pulse">
            <article>
                <span class="is-blue">
                    <i class="bi bi-calendar2-plus"></i>
                </span>
                <div>
                    <strong data-count="@Model.TodayBookingsCreated">0</strong>
                    <small>@L["Admin_Dashboard_NewBookingsToday"]</small>
                </div>
            </article>

            <article>
                <span class="is-orange">
                    <i class="bi bi-calendar2-event"></i>
                </span>
                <div>
                    <strong data-count="@Model.TodayBookingsStarting">0</strong>
                    <small>@L["Admin_Dashboard_BookingsStartingToday"]</small>
                </div>
            </article>

            <article>
                <span class="is-green">
                    <i class="bi bi-cash-stack"></i>
                </span>
                <div>
                    <strong>@todayRevenueText</strong>
                    <small>@L["Admin_Dashboard_RevenueToday"]</small>
                </div>
            </article>
        </div>
    </section>

    @if (Model.AttentionItems.Count > 0)
    {
        <section class="acc-attention acc-reveal"
                 aria-label="@L["Admin_Dashboard_NeedsAttention"]">
            <header>
                <span>
                    <i class="bi bi-lightning-charge-fill"></i>
                    @L["Admin_Dashboard_NeedsAttentionNow"]
                </span>

                <small>
                    @Model.AttentionItems.Count
                    @L["Admin_Dashboard_ImportantActions"]
                </small>
            </header>

            <div class="acc-attention__rail">
                @foreach (var item in Model.AttentionItems)
                {
                    <a href="@item.Url"
                       class="acc-attention-item tone-@item.Tone">
                        <span class="acc-attention-item__icon">
                            <i class="@item.IconClass"></i>
                        </span>

                        <div>
                            <strong>@item.Title</strong>
                            <small>@item.Description</small>
                        </div>

                        <b>@NormalizeCurrencyForEnglish(item.ValueText)</b>
                        <i class="bi bi-arrow-left-short acc-attention-item__arrow"></i>
                    </a>
                }
            </div>
        </section>
    }

    <section class="acc-kpis acc-reveal">
        <article class="acc-kpi kpi-revenue">
            <div class="acc-kpi__head">
                <span><i class="bi bi-wallet2"></i></span>
                <small>@L["Admin_Dashboard_PlatformRevenue"]</small>
            </div>

            <strong>@totalRevenueText</strong>
            <div class="acc-spark" data-spark="revenue"></div>

            <footer>
                <i class="bi bi-check2-circle"></i>
                @L["Admin_Dashboard_CommissionsCollected"]
            </footer>
        </article>

        <article class="acc-kpi kpi-bookings">
            <div class="acc-kpi__head">
                <span><i class="bi bi-calendar2-check"></i></span>
                <small>@L["Admin_Dashboard_Bookings"]</small>
            </div>

            <strong data-count="@Model.TotalBookings">0</strong>
            <div class="acc-spark" data-spark="bookings"></div>

            <footer>
                <b>
                    @Model.ThisMonthBookings.ToString(
                        "N0",
                        CultureInfo.CurrentCulture)
                </b>
                @L["Admin_Dashboard_ThisMonth"]
            </footer>
        </article>

        <article class="acc-kpi kpi-users">
            <div class="acc-kpi__head">
                <span><i class="bi bi-people-fill"></i></span>
                <small>@L["Admin_Dashboard_Users"]</small>
            </div>

            <strong data-count="@Model.TotalUsers">0</strong>
            <div class="acc-spark" data-spark="users"></div>
            <footer>@L["Admin_Dashboard_RegisteredUsers"]</footer>
        </article>

        <article class="acc-kpi kpi-places">
            <div class="acc-kpi__head">
                <span><i class="bi bi-buildings-fill"></i></span>
                <small>@L["Admin_Dashboard_Places"]</small>
            </div>

            <strong data-count="@Model.TotalPlaces">0</strong>
            <div class="acc-spark" data-spark="places"></div>

            <footer>
                <b>
                    @Model.ActivePlaces.ToString(
                        "N0",
                        CultureInfo.CurrentCulture)
                </b>
                @L["Admin_Dashboard_ActiveApprovedPlaces"]
            </footer>
        </article>
    </section>

    <section class="acc-analytics acc-reveal">
        <article class="acc-panel acc-panel--wide">
            <header class="acc-panel__head">
                <div>
                    <span class="is-blue">
                        <i class="bi bi-graph-up-arrow"></i>
                    </span>
                    <div>
                        <small>@L["Admin_Dashboard_Last7Days"]</small>
                        <h2>@L["Admin_Dashboard_PlatformBookings"]</h2>
                    </div>
                </div>

                <span class="acc-chart-legend"
                      aria-label="@L["Admin_Dashboard_BookingLegend"]">
                    <span>
                        <i class="legend-dot is-blue"></i>
                        @L["Admin_Dashboard_BookingsCreated"]
                    </span>
                    <span>
                        <i class="legend-dot is-orange"></i>
                        @L["Admin_Dashboard_BookingsStarting"]
                    </span>
                </span>
            </header>

            <div class="acc-chart acc-chart--main">
                <canvas id="adminBookingsChart"></canvas>
            </div>
        </article>

        <article class="acc-panel acc-panel--status">
            <header class="acc-panel__head">
                <div>
                    <span class="is-orange">
                        <i class="bi bi-pie-chart-fill"></i>
                    </span>
                    <div>
                        <small>@L["Admin_Dashboard_ListingQuality"]</small>
                        <h2>@L["Admin_Dashboard_PlaceStatus"]</h2>
                    </div>
                </div>
            </header>

            <div class="acc-status-layout">
                <div class="acc-chart acc-chart--donut">
                    <canvas id="adminPlacesChart"></canvas>
                </div>

                <div class="acc-chart-key acc-chart-key--status"
                     aria-label="@L["Admin_Dashboard_PlaceStatusLegend"]">
                    @foreach (var item in Model.PlaceStatusDistribution)
                    {
                        <span>
                            <i class="legend-dot status-@StatusTone(item.Status)"></i>
                            <b>@StatusLabel(item.Status)</b>
                            <small>@item.Count</small>
                        </span>
                    }
                </div>
            </div>
        </article>
    </section>

    <section class="acc-analytics acc-analytics--secondary acc-reveal">
        <article class="acc-panel">
            <header class="acc-panel__head">
                <div>
                    <span class="is-green">
                        <i class="bi bi-currency-exchange"></i>
                    </span>
                    <div>
                        <small>@L["Admin_Dashboard_Last7Days"]</small>
                        <h2>@L["Admin_Dashboard_PlatformRevenue"]</h2>
                    </div>
                </div>

                <span class="acc-chart-legend">
                    <span>
                        <i class="legend-dot is-green"></i>
                        @L["Admin_Dashboard_CollectedCommission"]
                    </span>
                </span>
            </header>

            <div class="acc-chart acc-chart--small">
                <canvas id="adminRevenueChart"></canvas>
            </div>
        </article>

        <article class="acc-panel">
            <header class="acc-panel__head">
                <div>
                    <span class="is-purple">
                        <i class="bi bi-wallet-fill"></i>
                    </span>
                    <div>
                        <small>@L["Admin_Dashboard_CommissionCycle"]</small>
                        <h2>@L["Admin_Dashboard_FinancialStatus"]</h2>
                    </div>
                </div>

                <small class="acc-muted-money">
                    @L["Admin_Dashboard_Pending"]
                    @pendingRevenueText
                </small>
            </header>

            <div class="acc-chart acc-chart--small">
                <canvas id="adminFinanceChart"></canvas>
            </div>

            <div class="acc-chart-key acc-chart-key--finance"
                 aria-label="@L["Admin_Dashboard_FinancialStatusLegend"]">
                @foreach (var item in Model.FinanceDistribution)
                {
                    <span>
                        <i class="legend-dot finance-@FinanceTone(item.Status)"></i>
                        <b>@FinanceLabel(item.Status)</b>
                    </span>
                }
            </div>
        </article>

        <article class="acc-panel">
            <header class="acc-panel__head">
                <div>
                    <span class="is-cyan">
                        <i class="bi bi-grid-fill"></i>
                    </span>
                    <div>
                        <small>@L["Admin_Dashboard_ListingDistribution"]</small>
                        <h2>@L["Admin_Dashboard_TopCategories"]</h2>
                    </div>
                </div>
            </header>

            <div class="acc-category-list">
                @foreach (var category in Model.CategoryDistribution.Take(5))
                {
                    var percent =
                        Model.TotalPlaces > 0
                            ? Math.Round(
                                category.PlaceCount *
                                100m /
                                Model.TotalPlaces,
                                0)
                            : 0;

                    <div class="acc-category-row">
                        <span>
                            <b>@category.CategoryName</b>
                            <small>
                                @category.PlaceCount
                                @L["Admin_Dashboard_PlaceUnit"]
                            </small>
                        </span>

                        <div>
                            <i style="--w:@percent%"></i>
                        </div>

                        <strong>@percent%</strong>
                    </div>
                }

                @if (!Model.CategoryDistribution.Any())
                {
                    <div class="acc-empty-mini">
                        <i class="bi bi-inbox"></i>
                        <span>@L["Admin_Dashboard_NoCategoryData"]</span>
                    </div>
                }
            </div>
        </article>
    </section>

    <section class="acc-bottom acc-reveal">
        <article class="acc-panel acc-recent">
            <header class="acc-panel__head">
                <div>
                    <span class="is-blue">
                        <i class="bi bi-stars"></i>
                    </span>
                    <div>
                        <small>@L["Admin_Dashboard_LatestAdditions"]</small>
                        <h2>@L["Admin_Dashboard_NewestPlaces"]</h2>
                    </div>
                </div>

                <a asp-area="Admin"
                   asp-controller="Places"
                   asp-action="PlaceManagement">
                    @L["Admin_Dashboard_ViewAll"]
                    <i class="bi bi-arrow-left"></i>
                </a>
            </header>

            <div class="acc-recent-list">
                @foreach (var place in Model.RecentPlaces)
                {
                    <a asp-area="Admin"
                       asp-controller="Places"
                       asp-action="PlaceManagement"
                       class="acc-recent-item">
                        <span class="acc-recent-item__icon">
                            <i class="bi bi-building"></i>
                        </span>

                        <div class="acc-recent-item__copy">
                            <strong data-admin-i18n-skip>@place.PlaceName</strong>
                            <small>
                                <span>@place.CategoryName</span>
                                ·
                                <span data-admin-i18n-skip>@place.OwnerName</span>
                            </small>
                        </div>

                        <span class="acc-status-badge is-@StatusTone(place.Status)">
                            <i></i>
                            @StatusLabel(place.Status)
                        </span>

                        <i class="bi bi-chevron-left"></i>
                    </a>
                }

                @if (!Model.RecentPlaces.Any())
                {
                    <div class="acc-empty-mini">
                        <i class="bi bi-buildings"></i>
                        <span>@L["Admin_Dashboard_NoPlaces"]</span>
                    </div>
                }
            </div>
        </article>

        <aside class="acc-side-stack">
            <article class="acc-panel acc-quick acc-quick--full">
                <header>
                    <span>
                        <i class="bi bi-lightning-charge-fill"></i>
                        @L["Admin_Dashboard_Shortcuts"]
                    </span>
                    <small>@L["Admin_Dashboard_DirectAccess"]</small>
                </header>

                <div>
                    <a asp-area="Admin"
                       asp-controller="Places"
                       asp-action="PlaceManagement">
                        <i class="bi bi-buildings"></i>
                        <span>@L["Admin_Dashboard_ManagePlaces"]</span>
                    </a>

                    <a asp-area="Admin"
                       asp-controller="Users"
                       asp-action="UserManagement">
                        <i class="bi bi-people"></i>
                        <span>@L["Admin_Dashboard_ManageUsers"]</span>
                    </a>

                    <a asp-area="Admin"
                       asp-controller="Reports"
                       asp-action="ReportsCenter">
                        <i class="bi bi-flag-fill"></i>
                        <span>@L["Admin_Dashboard_ReportsComplaints"]</span>
                    </a>

                    <a href="~/Admin/Financials/Manage">
                        <i class="bi bi-wallet2"></i>
                        <span>@L["Admin_Dashboard_FinancialOperations"]</span>
                    </a>

                    <a asp-area="Admin"
                       asp-controller="Advertisements"
                       asp-action="AdvertisementManagement">
                        <i class="bi bi-megaphone-fill"></i>
                        <span>@L["Admin_Dashboard_ManageAds"]</span>
                    </a>

                    <a asp-area="Admin"
                       asp-controller="MasterEntities"
                       asp-action="MasterEntitiesManagement">
                        <i class="bi bi-grid-1x2"></i>
                        <span>@L["Admin_Dashboard_SystemCategories"]</span>
                    </a>
                </div>
            </article>
        </aside>
    </section>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js"></script>
    <script src="~/js/admin/dashboard-overview.js"
            asp-append-version="true"></script>
}
