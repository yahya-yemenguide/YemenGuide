﻿@{
    ViewData["Title"] = "إدارة منشآتي";
    Layout = "~/Areas/Owner/Views/Shared/_OwnerLayout.cshtml";
    bool isAdmin = User.IsInRole("Admin");
}

@section Styles {
    <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.4/build/css/intlTelInput.css" />

    <link rel="stylesheet"
      href="~/css/owner/places/manage-places-shell.css"
      asp-append-version="true" />

    <link rel="stylesheet"
      href="~/css/owner/places/place-list.css"
      asp-append-version="true" />

    <link rel="stylesheet"
      href="~/css/owner/places/add-place.css"
      asp-append-version="true" />

    <link rel="stylesheet"
      href="~/css/owner/places/calendar-manager.css"
      asp-append-version="true" />

    <link rel="stylesheet"
      href="~/css/owner/places/promotions-manager.css"
      asp-append-version="true" />

    <link rel="stylesheet"
      href="~/css/owner/places/details-manager.css"
      asp-append-version="true" />

    <link rel="stylesheet"
      href="~/css/owner/places/place-editor.css"
      asp-append-version="true" />

    <style>
        /* زر الإجراء العلوي: مستقل عن CSS التبويبات الداخلية حتى لا يفقد لونه أو نصه عند نقله للهيدر */
        .manage-places-page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .manage-places-page-heading {
            flex: 1 1 520px;
            min-width: 0;
        }

        .manage-places-page-actions {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex: 0 1 auto;
            min-width: 0;
            margin-inline-start: auto;
        }

        .manage-places-page-actions[hidden],
        .manage-places-page-actions:empty,
        .manage-places-header-action[hidden] {
            display: none !important;
        }

        .manage-places-header-action {
            appearance: none;
            -webkit-appearance: none;
            display: inline-flex !important;
            align-items: center;
            justify-content: center;
            gap: 0.65rem;
            min-width: 180px;
            min-height: 52px;
            margin: 0 !important;
            padding: 0.65rem 1.05rem;
            color: #ffffff !important;
            background: linear-gradient(135deg, #FF5A5F 0%, #F26A6E 100%) !important;
            border: 0 !important;
            border-radius: 15px !important;
            box-shadow: 0 12px 25px rgba(255, 90, 95, 0.24) !important;
            font: inherit;
            font-size: 0.88rem;
            font-weight: 900;
            line-height: 1.2;
            white-space: nowrap;
            opacity: 1 !important;
            visibility: visible !important;
            cursor: pointer;
            transition: transform 0.22s ease, box-shadow 0.22s ease;
        }

        .manage-places-header-action:hover {
            color: #ffffff !important;
            background: linear-gradient(135deg, #F64F55 0%, #EA6267 100%) !important;
            transform: translateY(-1px);
            box-shadow: 0 16px 30px rgba(255, 90, 95, 0.30) !important;
        }

        .manage-places-header-action > span,
        .manage-places-header-action > i,
        .manage-places-header-action .manage-places-header-action__icon,
        .manage-places-header-action .manage-places-header-action__icon i {
            color: #ffffff !important;
            opacity: 1 !important;
            visibility: visible !important;
        }

        .manage-places-header-action .manage-places-header-action__icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 32px;
            width: 32px;
            height: 32px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.18);
        }

        /* قائمة منشآتي: مسافة إضافية أسفل البطاقات حتى لا تلتصق الأزرار بحد الديف الأبيض. */
        .place-list-tab .owner-places-list {
            padding-bottom: 1.5rem;
        }
    </style>
}

    <div class="container-fluid manage-places-page animate-fade-in"
     dir="rtl"
     data-place-editor-mode="owner">

        <header class="manage-places-page-header">
            <div class="manage-places-page-heading">
                <span class="manage-places-page-icon" aria-hidden="true">
                    <i class="bi bi-buildings"></i>
                </span>

                <div class="manage-places-page-copy">
                    <h2 class="manage-places-page-title">إدارة منشآتي</h2>
                    <p class="manage-places-page-subtitle">
                        مركز واحد لإدارة منشآتك وبياناتها وخدماتها وعروضها بسهولة
                    </p>
                </div>
            </div>

            <div class="manage-places-page-actions"
                 id="managePlacesPageActions"
                 aria-label="إجراء التبويب الحالي">
                @if (!isAdmin)
                {
                    <button type="button"
                            class="manage-places-header-action"
                            id="managePlacesHeaderAddPlace">
                        <span class="manage-places-header-action__icon" aria-hidden="true">
                            <i class="bi bi-plus-lg"></i>
                        </span>
                        <span>إضافة منشأة</span>
                    </button>
                }

                <button type="button"
                        class="manage-places-header-action"
                        id="managePlacesHeaderAddPromotion"
                        hidden>
                    <span class="manage-places-header-action__icon" aria-hidden="true">
                        <i class="bi bi-plus-lg"></i>
                    </span>
                    <span>إضافة عرض جديد</span>
                </button>
            </div>
        </header>

        <nav class="custom-tabs-container yg-unified-tabs" data-yg-tabs role="tablist" aria-label="تبويبات إدارة المنشآت">

            <button type="button"
                class="tab-btn active"
                id="placeListTabButton"
                role="tab"
                aria-selected="true"
                aria-controls="placeListTabPanel"
                data-target="place-list-tab"
                data-url="/Owner/Place/PlaceList">
                <span class="tab-icon" aria-hidden="true">
                    <i class="bi bi-list-ul"></i>
                </span>
                <span class="tab-label">قائمة منشآتي</span>
            </button>

            @if (!isAdmin)
            {
                <button type="button"
                    class="tab-btn"
                    id="addPlaceTabButton"
                    role="tab"
                    aria-selected="false"
                    aria-controls="addPlaceTabPanel"
                    data-target="add-place-tab"
                    data-url="/Owner/Place/AddPlace">
                    <span class="tab-icon" aria-hidden="true">
                        <i class="bi bi-plus-circle"></i>
                    </span>
                    <span class="tab-label">إضافة منشأة جديدة</span>
                </button>
            }


            <button type="button"
                class="tab-btn"
                id="promotionsManagerTabButton"
                role="tab"
                aria-selected="false"
                aria-controls="promotionsManagerTabPanel"
                data-target="promotions-manager-tab"
                data-url="/Owner/Place/PromotionsManager">
                <span class="tab-icon" aria-hidden="true">
                    <i class="bi bi-tags"></i>
                </span>
                <span class="tab-label">العروض والخصومات</span>
            </button>

            <button type="button"
                class="tab-btn"
                id="detailsManagerTabButton"
                role="tab"
                aria-selected="false"
                aria-controls="detailsManagerTabPanel"
                data-target="details-manager-tab"
                data-url="/Owner/Place/DetailsManager">
                <span class="tab-icon" aria-hidden="true">
                    <i class="bi bi-box-seam"></i>
                </span>
                <span class="tab-label">الخدمات والباقات</span>
            </button>

        </nav>

        <section class="main-content-card-holder" aria-live="polite">

            <div class="tab-pane-content place-list-tab" id="placeListTabPanel" role="tabpanel" aria-labelledby="placeListTabButton" style="display: block;">
                <div class="tab-loading-state">
                    <div class="spinner-border tab-loading-spinner" role="status">
                        <span class="visually-hidden">جاري التحميل...</span>
                    </div>
                    <h6 class="tab-loading-title">جاري تحميل المنشآت...</h6>
                </div>
            </div>

            @if (!isAdmin)
            {
                <div class="tab-pane-content add-place-tab" id="addPlaceTabPanel" role="tabpanel" aria-labelledby="addPlaceTabButton" style="display: none;"></div>
            }
            <div class="tab-pane-content calendar-manager-tab" id="calendarManagerTabPanel" role="tabpanel" aria-labelledby="calendarManagerTabButton" style="display: none;"></div>
            <div class="tab-pane-content promotions-manager-tab" id="promotionsManagerTabPanel" role="tabpanel" aria-labelledby="promotionsManagerTabButton" style="display: none;"></div>
            <div class="tab-pane-content details-manager-tab" id="detailsManagerTabPanel" role="tabpanel" aria-labelledby="detailsManagerTabButton" style="display: none;"></div>

        </section>
    </div>

    @section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.4/build/js/intlTelInput.min.js"></script>

    <script src="~/lib/fullcalendar/index.global.min.js"></script>
    <script src="~/lib/fullcalendar/ar.global.min.js"></script>

    <script src="~/lib/sweetalert2/sweetalert2.js"></script>

    <script src="~/js/owner/places/place-list.js"
        asp-append-version="true"></script>

    <script src="~/js/owner/places/add-place.js"
        asp-append-version="true"></script>

    <script src="~/js/owner/places/calendar-manager.js"
        asp-append-version="true"></script>

    <script src="~/js/owner/places/promotions-manager.js"
        asp-append-version="true"></script>

    <script src="~/js/owner/places/details-manager.js"
        asp-append-version="true"></script>

    <script src="~/js/owner/places/manage-places-shell.js"
        asp-append-version="true"></script>

    <script src="~/js/owner/places/place-editor.js"
        asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var autoOpen = '@(ViewBag.AutoOpenWizard?.ToString().ToLower())';
            var isAdmin = @(isAdmin ? "true" : "false");

            if (!isAdmin && autoOpen === 'true') {
                const addPlaceTabBtn = document.querySelector(
                    '.tab-btn[data-target="add-place-tab"]'
                );

                if (addPlaceTabBtn) {
                    addPlaceTabBtn.click();
                }
            }
        });
    </script>
}
