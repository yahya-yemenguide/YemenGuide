                z-index: 2147483000;
                width: min(340px, calc(100vw - 24px));
                padding: 14px;
                direction: ltr;
                text-align: left;
                color: #2d4658;
                background: #fff;
                border: 1px solid #d9e7ee;
                border-radius: 16px;
                box-shadow: 0 18px 48px rgba(17, 55, 78, .18);
