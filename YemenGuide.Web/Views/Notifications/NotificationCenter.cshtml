@model YemenGuide.Core.DTOs.Notifications.NotificationCenterDto
@using YemenGuide.Core.Constants

@{
    ViewData["Title"] = "مركز الإشعارات";
    ViewData["HideFooter"] = true;
    Layout = "~/Views/Shared/_Layout.cshtml";

    string FilterUrl(string filter, int page = 1)
    {
        return Url.Action(
            "NotificationCenter",
            "Notifications",
            new
            {
                filter,
                page,
                pageSize = Model.PageSize
            }) ?? "/Notifications/NotificationCenter";
    }

    string TypeIcon(string? type)
    {
        return (type ?? string.Empty) switch
        {
            NotificationTypes.BookingCreated => "bi-calendar-plus",
            NotificationTypes.BookingAccepted => "bi-calendar-check",
            NotificationTypes.BookingConfirmed => "bi-patch-check-fill",
            NotificationTypes.BookingRejected => "bi-calendar-x",
            NotificationTypes.BookingCancelled => "bi-x-octagon",
            NotificationTypes.BookingExpired => "bi-hourglass-split",

            NotificationTypes.PaymentRequired => "bi-wallet2",
            NotificationTypes.PaymentReceived => "bi-receipt",
            NotificationTypes.PaymentApproved => "bi-check2-circle",
            NotificationTypes.PaymentRejected => "bi-exclamation-circle",
            NotificationTypes.RefundRequested => "bi-arrow-counterclockwise",
            NotificationTypes.RefundReadyForTransfer => "bi-lightning-charge",
            NotificationTypes.RefundTransferred => "bi-send-check",
            NotificationTypes.RefundCompleted => "bi-cash-coin",

            NotificationTypes.ReviewCreated => "bi-star",
            NotificationTypes.ReviewReply => "bi-chat-square-quote",

            NotificationTypes.Message => "bi-chat-dots",

            NotificationTypes.ReportCreated => "bi-shield-exclamation",
            NotificationTypes.ReportReply => "bi-shield-check",
            NotificationTypes.ReportEscalated => "bi-arrow-up-circle",
            NotificationTypes.ReportWithdrawn => "bi-arrow-return-left",
            NotificationTypes.ReportResolved => "bi-check-circle",
            NotificationTypes.ReportRejected => "bi-shield-x",

            NotificationTypes.Promotion => "bi-percent",
            NotificationTypes.Advertisement => "bi-megaphone",
            NotificationTypes.Account => "bi-person",
            NotificationTypes.Security => "bi-shield-lock",
            _ => "bi-bell"
        };
    }

    string TypeTone(string? type)
    {
        var value = type ?? string.Empty;

        if (value.Equals(NotificationTypes.BookingRejected, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.BookingCancelled, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.BookingExpired, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.PaymentRejected, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.ReportRejected, StringComparison.OrdinalIgnoreCase))
            return "coral";

        if (value.Equals(NotificationTypes.BookingAccepted, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.BookingConfirmed, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.PaymentApproved, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.RefundReadyForTransfer, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.RefundCompleted, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.ReportResolved, StringComparison.OrdinalIgnoreCase))
            return "green";

        if (value.Equals(NotificationTypes.RefundTransferred, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.Account, StringComparison.OrdinalIgnoreCase))
            return "cyan";

        if (value.Equals(NotificationTypes.Security, StringComparison.OrdinalIgnoreCase))
            return "amber";

        if (value.StartsWith("Payment", StringComparison.OrdinalIgnoreCase) ||
            value.StartsWith("Refund", StringComparison.OrdinalIgnoreCase))
            return "amber";

        if (value.StartsWith("Review", StringComparison.OrdinalIgnoreCase))
            return "coral";

        if (value.StartsWith("Report", StringComparison.OrdinalIgnoreCase) ||
            value.StartsWith("Booking", StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.Message, StringComparison.OrdinalIgnoreCase) ||
            value.Equals("ChatMessage", StringComparison.OrdinalIgnoreCase))
            return "cyan";

        return "slate";
    }

    string TypeLabel(string? type)
    {
        var value = type ?? string.Empty;

        if (value.StartsWith("Booking", StringComparison.OrdinalIgnoreCase)) return "حجز";
        if (value.StartsWith("Refund", StringComparison.OrdinalIgnoreCase)) return "استرداد";
        if (value.StartsWith("Payment", StringComparison.OrdinalIgnoreCase)) return "دفع";
        if (value.StartsWith("Review", StringComparison.OrdinalIgnoreCase)) return "تقييم";
        if (value.StartsWith("Report", StringComparison.OrdinalIgnoreCase)) return "بلاغ";
        if (value.Equals(NotificationTypes.Message, StringComparison.OrdinalIgnoreCase) || value.Equals("ChatMessage", StringComparison.OrdinalIgnoreCase)) return "رسالة";
        if (value.Equals(NotificationTypes.Promotion, StringComparison.OrdinalIgnoreCase)) return "عرض";
        if (value.Equals(NotificationTypes.Advertisement, StringComparison.OrdinalIgnoreCase)) return "إعلان";
        if (value.Equals(NotificationTypes.Security, StringComparison.OrdinalIgnoreCase)) return "أمان";
        if (value.Equals(NotificationTypes.Account, StringComparison.OrdinalIgnoreCase)) return "الحساب";
        return "إشعار";
    }

    string DateText(DateTime? date)
    {
        return date.HasValue
            ? date.Value.ToString("yyyy/MM/dd - hh:mm tt")
            : "الآن";
    }

    string ActiveClass(string filter)
    {
        return string.Equals(Model.Filter, filter, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
    }
}

@section Styles {
    <link rel="stylesheet"
      href="~/css/customer/notification-center.css"
      asp-append-version="true" />
}

    <main class="notification-center-page"
      id="notificationCenterPage"
      data-focus-notification="@Model.FocusNotificationId"
      data-mark-all-endpoint="/Notifications/MarkAllAsRead"
      data-center-data-endpoint="/Notifications/CenterData"
      data-page-size="@Model.PageSize"
      data-current-filter="@Model.Filter"
      data-current-page="@Model.CurrentPage">

        <form class="notification-center-token-form" aria-hidden="true">
            @Html.AntiForgeryToken()
        </form>

        <div class="notification-center-shell">

            <section class="notification-center-intro">
                <div class="notification-center-intro__copy">
                    <span class="notification-center-intro__icon" aria-hidden="true">
                        <i class="bi bi-bell"></i>
                    </span>

                    <div>
                        <span class="notification-center-kicker">مركز الإشعارات</span>
                        <h1>كل جديد يخص حسابك، مرتب وواضح</h1>
                        <p>
                            تابع الحجوزات والدفع والتقييمات والرسائل والبلاغات،
                            واضغط على أي إشعار للوصول مباشرة إلى الحدث المرتبط به.
                        </p>
                    </div>
                </div>

                <div class="notification-center-intro__stats">
                    <div class="notification-center-stat">
                        <span>إجمالي الإشعارات</span>
                        <strong>@Model.TotalCount</strong>
                    </div>

                    <div class="notification-center-stat is-unread-stat">
                        <span>غير المقروء</span>
                        <strong id="notificationCenterUnreadHero">@Model.UnreadCount</strong>
                    </div>

                    <button type="button"
                        class="notification-center-mark-all @(Model.UnreadCount <= 0 ? "is-disabled" : "")"
                        id="notificationCenterMarkAll"
                        data-unread-count="@Model.UnreadCount">
                        <i class="bi bi-check2-all"></i>
                        <span>تعليم الكل كمقروء</span>
                    </button>
                </div>
            </section>

            <section class="notification-center-tabs-wrap" aria-label="تصفية الإشعارات">
                <div class="notification-center-tabs"
                 aria-label="تصنيفات الإشعارات"
                 data-notification-tabs>
                    <a href="@FilterUrl("all")"
                   class="notification-center-tab @ActiveClass("all")"
                   data-notification-tab
                   data-filter="all">
                        <i class="bi bi-grid"></i>
                        <span>الكل</span>
                        <b id="notificationCenterAllCount">@Model.TotalCount</b>
                    </a>

                    <a href="@FilterUrl("unread")"
                   class="notification-center-tab @ActiveClass("unread")"
                   data-notification-tab
                   data-filter="unread">
                        <i class="bi bi-circle-fill"></i>
                        <span>غير المقروء</span>
                        <b id="notificationCenterUnreadTab">@Model.UnreadCount</b>
                    </a>

                    <a href="@FilterUrl("booking")"
                   class="notification-center-tab @ActiveClass("booking")"
                   data-notification-tab
                   data-filter="booking">
                        <i class="bi bi-calendar2-check"></i>
                        <span>الحجوزات</span>
                        <b id="notificationCenterBookingCount">@Model.BookingCount</b>
                    </a>

                    <a href="@FilterUrl("payment")"
                   class="notification-center-tab @ActiveClass("payment")"
                   data-notification-tab
                   data-filter="payment">
                        <i class="bi bi-wallet2"></i>
                        <span>الدفع والاسترداد</span>
                        <b id="notificationCenterPaymentCount">@Model.PaymentCount</b>
                    </a>

                    <a href="@FilterUrl("review")"
                   class="notification-center-tab @ActiveClass("review")"
                   data-notification-tab
                   data-filter="review">
                        <i class="bi bi-star"></i>
                        <span>التقييمات</span>
                        <b id="notificationCenterReviewCount">@Model.ReviewCount</b>
                    </a>

                    <a href="@FilterUrl("message")"
                   class="notification-center-tab @ActiveClass("message")"
                   data-notification-tab
                   data-filter="message">
                        <i class="bi bi-chat-dots"></i>
                        <span>الرسائل</span>
                        <b id="notificationCenterMessageCount">@Model.MessageCount</b>
                    </a>

                    <a href="@FilterUrl("report")"
                   class="notification-center-tab @ActiveClass("report")"
                   data-notification-tab
                   data-filter="report">
                        <i class="bi bi-shield-check"></i>
                        <span>البلاغات</span>
                        <b id="notificationCenterReportCount">@Model.ReportCount</b>
                    </a>
                </div>
            </section>

            <section class="notification-center-panel">
                <div class="notification-center-panel__head">
                    <div>
                        <span>الإشعارات</span>
                        <h2 id="notificationCenterSectionTitle">
                        @switch (Model.Filter)
                        {
                            case "unread":
                                <text>غير المقروءة</text>
                                break;
                            case "booking":
                                <text>الحجوزات</text>
                                break;
                            case "payment":
                                <text>الدفع والاسترداد</text>
                                break;
                            case "review":
                                <text>التقييمات</text>
                                break;
                            case "message":
                                <text>الرسائل</text>
                                break;
                            case "report":
                                <text>البلاغات والشكاوى</text>
                                break;
                            default:
                                <text>جميع الإشعارات</text>
                                break;
                        }
                    </h2>
                </div>

                <span class="notification-center-result-count" id="notificationCenterResultCount">
                    <i class="bi bi-collection"></i>
                    @Model.FilteredCount نتيجة
                </span>
            </div>

            <div class="notification-center-list"
                 id="notificationCenterList"
                 aria-live="polite">

                @if (Model.Items.Count > 0)
                {
                    @for (int itemIndex = 0; itemIndex < Model.Items.Count; itemIndex++)
                    {
                        var item = Model.Items[itemIndex];
                        var tone = TypeTone(item.NotificationType);
                        var isFocused = Model.FocusNotificationId > 0 &&
                        Model.FocusNotificationId == item.NotificationId;

                        <a href="@item.OpenUrl"
                   class="notification-center-item @(!item.IsRead ? "is-unread" : "") @(isFocused ? "is-focused" : "")"
                   data-notification-center-item
                   data-notification-id="@item.NotificationId"
                   data-tone="@tone"
                   style="--notification-center-delay:@(Math.Min(itemIndex * 36, 250))ms">

                            <span class="notification-center-item__icon" aria-hidden="true">
                                <i class="bi @TypeIcon(item.NotificationType)"></i>
                            </span>

                            <span class="notification-center-item__content">
                                <span class="notification-center-item__top">
                                    <span class="notification-center-item__title-wrap">
                                        <strong>@item.NotificationTitle</strong>

                                        @if (!item.IsRead)
                                        {
                                            <span class="notification-center-item__unread-dot"
                                      aria-label="غير مقروء"></span>
                                        }
                                    </span>

                                    <span class="notification-center-item__type">
                                        @TypeLabel(item.NotificationType)
                                    </span>
                                </span>

                                <span class="notification-center-item__text">
                                    @item.NotificationText
                                </span>

                                <span class="notification-center-item__meta">
                                    <span>
                                        <i class="bi bi-clock"></i>
                                        @DateText(item.CreatedAt)
                                    </span>
                                </span>
                            </span>

                            <span class="notification-center-item__arrow" aria-hidden="true">
                                <i class="bi bi-chevron-left"></i>
                            </span>
                        </a>
                    }
                }
                else
                {
                    <div class="notification-center-empty notification-center-empty--inside-list">
                        <span class="notification-center-empty__icon">
                            <i class="bi bi-bell-slash"></i>
                        </span>

                        <h3>لا توجد إشعارات هنا حاليًا</h3>
                        <p>اختر قسمًا آخر أو ارجع إلى جميع الإشعارات.</p>

                        @if (Model.Filter != "all")
                        {
                            <a href="@FilterUrl("all")"
                       class="notification-center-empty__all-link">
                                <i class="bi bi-grid"></i>
                                عرض جميع الإشعارات
                            </a>
                        }
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="notification-center-pagination" id="notificationCenterPagination" aria-label="صفحات الإشعارات">
                    <a href="@(Model.HasPreviousPage ? FilterUrl(Model.Filter, Model.CurrentPage - 1) : "#")"
                   class="notification-center-pagination__arrow @(!Model.HasPreviousPage ? "is-disabled" : "")"
                   aria-disabled="@(!Model.HasPreviousPage)">
                        <i class="bi bi-chevron-right"></i>
                    </a>

                    <div class="notification-center-pagination__pages">
                        @for (int pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                        {
                            if (pageNumber == 1 ||
                            pageNumber == Model.TotalPages ||
                            Math.Abs(pageNumber - Model.CurrentPage) <= 1)
                            {
                                <a href="@FilterUrl(Model.Filter, pageNumber)"
                       class="notification-center-pagination__page @(pageNumber == Model.CurrentPage ? "active" : "")">
                                    @pageNumber
                                </a>
                            }
                            else if (pageNumber == Model.CurrentPage - 2 ||
                            pageNumber == Model.CurrentPage + 2)
                            {
                                <span>…</span>
                            }
                        }
                    </div>

                    <a href="@(Model.HasNextPage ? FilterUrl(Model.Filter, Model.CurrentPage + 1) : "#")"
                   class="notification-center-pagination__arrow @(!Model.HasNextPage ? "is-disabled" : "")"
                   aria-disabled="@(!Model.HasNextPage)">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </nav>
            }
        </section>
    </div>
</main>
