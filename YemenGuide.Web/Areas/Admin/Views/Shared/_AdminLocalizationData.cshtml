    void AddDynamicTranslation(string? arabicValue, string? englishValue)
    {
        if (language != "en" ||
            string.IsNullOrWhiteSpace(arabicValue) ||
            string.IsNullOrWhiteSpace(englishValue))
        {
            return;
        }

        exact[arabicValue.Trim()] = englishValue.Trim();
    }

    // نفس قاعدة العميل: لا نترجم ما كتبه المستخدم من عندنا.
    // نستخدم الإنجليزية فقط عندما يكون للبيان حقل English فعلي في قاعدة البيانات.
    if (language == "en")
    {
        var categories = await _context.Categories
            .AsNoTracking()
            .Select(c => new { c.CategoryName, c.CategoryNameEn })
            .ToListAsync();

        foreach (var category in categories)
        {
            AddDynamicTranslation(category.CategoryName, category.CategoryNameEn);
        }

        var cities = await _context.Cities
            .AsNoTracking()
            .Select(c => new { c.CityName, c.CityNameEn })
            .ToListAsync();

        foreach (var city in cities)
        {
            AddDynamicTranslation(city.CityName, city.CityNameEn);
        }

        var settings = await _context.SystemSettings
            .AsNoTracking()
            .OrderBy(s => s.Id)
            .Select(s => new
            {
                s.SiteName,
                s.SiteNameEn,
                s.SiteDescription,
                s.SiteDescriptionEn
            })
            .FirstOrDefaultAsync();

        if (settings != null)
        {
            AddDynamicTranslation(settings.SiteName, settings.SiteNameEn);
            AddDynamicTranslation(settings.SiteDescription, settings.SiteDescriptionEn);
        }
    }

    var strings = new Dictionary<string, string>(StringComparer.Ordinal)
    {
        ["Admin_Currency_AED"] = L["Admin_Currency_AED"].Value,
        ["Admin_Currency_SAR"] = L["Admin_Currency_SAR"].Value,
        ["Admin_Currency_USD"] = L["Admin_Currency_USD"].Value,
        ["Admin_Currency_YER"] = L["Admin_Currency_YER"].Value,
        ["Admin_JS_AllMarkedRead"] = L["Admin_JS_AllMarkedRead"].Value,
        ["Admin_JS_ChangingLanguage"] = L["Admin_JS_ChangingLanguage"].Value,
        ["Admin_JS_CheckConnection"] = L["Admin_JS_CheckConnection"].Value,
        ["Admin_JS_Error"] = L["Admin_JS_Error"].Value,
        ["Admin_JS_MarkAllFailed"] = L["Admin_JS_MarkAllFailed"].Value,
        ["Admin_JS_NoAdminAlerts"] = L["Admin_JS_NoAdminAlerts"].Value,
        ["Admin_JS_NoNotificationsSection"] = L["Admin_JS_NoNotificationsSection"].Value,
        ["Admin_JS_NoSearchResults"] = L["Admin_JS_NoSearchResults"].Value,
        ["Admin_JS_NotificationWillAppear"] = L["Admin_JS_NotificationWillAppear"].Value,
        ["Admin_JS_NotificationsLoadFailed"] = L["Admin_JS_NotificationsLoadFailed"].Value,
        ["Admin_JS_NotificationsUnavailable"] = L["Admin_JS_NotificationsUnavailable"].Value,
        ["Admin_JS_Result"] = L["Admin_JS_Result"].Value,
        ["Admin_JS_Retry"] = L["Admin_JS_Retry"].Value,
        ["Admin_JS_ServerConnectionFailed"] = L["Admin_JS_ServerConnectionFailed"].Value,
        ["Admin_JS_TemporaryUpdateFailure"] = L["Admin_JS_TemporaryUpdateFailure"].Value,
        ["Admin_JS_UnexpectedError"] = L["Admin_JS_UnexpectedError"].Value,
        ["Admin_JS_Wait"] = L["Admin_JS_Wait"].Value,
        ["Admin_Notification_Account"] = L["Admin_Notification_Account"].Value,
        ["Admin_Notification_Ad"] = L["Admin_Notification_Ad"].Value,
        ["Admin_Notification_AdReview"] = L["Admin_Notification_AdReview"].Value,
        ["Admin_Notification_Booking"] = L["Admin_Notification_Booking"].Value,
        ["Admin_Notification_Case"] = L["Admin_Notification_Case"].Value,
        ["Admin_Notification_CaseAction"] = L["Admin_Notification_CaseAction"].Value,
        ["Admin_Notification_Finance"] = L["Admin_Notification_Finance"].Value,
        ["Admin_Notification_FinanceAction"] = L["Admin_Notification_FinanceAction"].Value,
        ["Admin_Notification_Message"] = L["Admin_Notification_Message"].Value,
        ["Admin_Notification_Notification"] = L["Admin_Notification_Notification"].Value,
