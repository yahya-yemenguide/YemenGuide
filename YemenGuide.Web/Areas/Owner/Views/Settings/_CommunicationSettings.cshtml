    .communication-settings-v2 #quickRepliesContainer .policy-toggle-card__copy {
        min-width: 0;
    }

    .communication-settings-v2 #quickRepliesContainer .policy-toggle-card__copy strong {
        margin-bottom: 2px;
        font-size: 0.76rem;
    }

    .communication-settings-v2 #quickRepliesContainer .policy-toggle-card__copy small {
        color: var(--comm-muted);
        font-size: 0.61rem;
        line-height: 1.4;
    }

    .communication-settings-v2 .quick-add-slot {
        width: 100%;
        min-height: 68px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 7px;
        border: 1px dashed rgba(0, 166, 218, 0.25);
        border-radius: 11px;
        background: linear-gradient(145deg, #fbfeff, var(--comm-cyan-soft));
    }

    .communication-settings-v2 .quick-add-button {
        width: auto !important;
        min-width: 145px;
        min-height: 34px !important;
        margin: 0 !important;
        padding: 6px 12px !important;
        gap: 7px;
        border-radius: 11px !important;
        font-size: 0.67rem !important;
        box-shadow: 0 6px 14px rgba(24, 168, 117, 0.08) !important;
    }

    .communication-settings-v2 .quick-add-button i {
        font-size: 0.9rem;
    }

    .communication-settings-v2 .custom-quick-zone {
        margin-top: 2px;
        padding: 10px;
        border: 1px solid #e7edf1;
        border-radius: 11px;
        background: linear-gradient(145deg, #fbfdfe, #f7fbfd);
    }

    .communication-settings-v2 .custom-quick-zone__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 7px;
    }

    .communication-settings-v2 .custom-quick-zone__title {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--comm-text);
        font-size: 0.78rem;
        font-weight: 900;
    }

    .communication-settings-v2 .custom-quick-zone__title i {
        display: grid;
        width: 25px;
        height: 25px;
        place-items: center;
        color: var(--comm-cyan-dark);
        border-radius: 9px;
        background: var(--comm-cyan-soft);
    }

    .communication-settings-v2 .custom-quick-zone__limit {
        padding: 4px 8px;
        color: var(--comm-muted);
        border: 1px solid #e1e9ee;
        border-radius: 999px;
        background: #ffffff;
        font-size: 0.62rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .communication-settings-v2 #customQuickRepliesContainer:empty::before {
        content: "لا توجد أسئلة خاصة مضافة حتى الآن.";
        display: block;
        padding: 7px 9px;
        color: #8a98a5;
        border: 1px dashed #dce7ec;
        border-radius: 11px;
        background: rgba(255, 255, 255, 0.65);
        text-align: center;
        font-size: 0.69rem;
        font-weight: 700;
    }

    .communication-settings-v2 #customQuickRepliesContainer .policy-builder-item--reply {
        margin: 0;
        border: 1px solid #e2ebef;
        border-radius: 12px;
        background: #ffffff;
        box-shadow: 0 4px 12px rgba(5, 32, 60, 0.035);
    }

    .communication-settings-v2 #customQuickRepliesContainer .policy-quick-reply-fields {
        min-width: 0;
    }

    .communication-settings-v2 .communication-quick-note {
