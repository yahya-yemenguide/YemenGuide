                                                        <i class="bi bi-check2-square"></i>
                                                        <span>
                                                            يشمل العرض تلقائيًا:
                                                            @packagePromotion.RewardServiceName.Replace(" + ", "، ")
                                                        </span>
                                                    </div>
                                                }
                                            </div>

                                            <div class="package-price-row">

                                                <small>السعر</small>

                                                @if (
                                               packagePromotion != null &&
                                               packagePromotion.HasEstimatedPrice &&
                                               !string.Equals(
                                                   packagePromotion.RewardType,
                                                   "ServiceSpecialPrice",
                                                   StringComparison.OrdinalIgnoreCase) &&
                                               !string.Equals(
                                                   packagePromotion.RewardType,
                                                   "FreeService",
                                                   StringComparison.OrdinalIgnoreCase)
                                               )
                                                {
                                                    <del class="target-old-price">
                                                        @packagePromotion.DisplayOriginalPriceText
                                                    </del>

                                                    <strong class="target-new-price">
                                                        @packagePromotion.DisplayEstimatedPriceAfterDiscountText
                                                    </strong>
                                                }
                                                else
                                                {
                                                    <strong>
                                                        @GetPackageDisplayPriceText(
                                        package.PackageId,
                                        package.Price)
                                                    </strong>
                                                }
                                            </div>

                                            <button type="button"
                                        class="package-select-button"
                                        data-package-id="@package.PackageId"
                                        data-package-name="@package.PackageName"
                                        data-package-price="@packageModalPriceText"
