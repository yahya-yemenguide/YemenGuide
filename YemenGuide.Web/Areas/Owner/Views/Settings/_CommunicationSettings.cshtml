        padding: 7px 9px;
        border-color: rgba(24, 168, 117, 0.15);
        border-radius: 12px;
        background: var(--comm-green-soft);
        color: #4f6d63;
        font-size: 0.62rem;
        line-height: 1.7;
    }

    .communication-settings-v2 .communication-contact-grid {
        grid-template-columns: minmax(0, 1fr);
    }

    .communication-settings-v2 .communication-contact-card .policy-form-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 8px;
    }

    .communication-settings-v2 .communication-contact-card {
        overflow: visible;
    }

    .communication-settings-v2 .communication-contact-card .policy-field {
        min-height: 0;
    }

    .communication-settings-v2 .communication-contact-card .premium-input-group-phone,
