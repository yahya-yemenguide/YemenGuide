        }

        #facilitySettingsPage .policy-builder-item > *,
        #facilitySettingsPage .policy-builder-item > .policy-desc,
        #facilitySettingsPage .policy-builder-item > .policy-shift-time,
        #facilitySettingsPage .policy-builder-item > .input-group:not(.policy-shift-time),
        #facilitySettingsPage .policy-builder-item__actions,
        #facilitySettingsPage .actions-wrapper {
            grid-column: 1 !important;
        }

        #facilitySettingsPage .policy-builder-item__icon,
        #facilitySettingsPage .item-icon {
            justify-self: center;
        }

        #facilitySettingsPage .policy-shift-time {
            grid-template-columns: auto minmax(0, 1fr) !important;
        }

        #facilitySettingsPage .policy-shift-time .input-group-text:nth-of-type(2) {
            grid-column: 1;
        }

        #facilitySettingsPage .policy-days-grid {
            grid-template-columns: minmax(0, 1fr) !important;
