@using System
@model YemenGuide.Core.DTOs.Customer.HomeViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = ViewBag.HeroTitleMain ?? "الرئيسية";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // سحب الثيم الحالي، وإذا كان فارغ نضع الافتراضي
    string currentTheme = ViewBag.SeasonTheme ?? "Normal";
    string platformSiteName = ViewBag.PlatformSiteName ?? "YemenGuide";
    string platformLogoPath = ViewBag.PlatformLogoPath ?? "/images/logo1.png";
    string googleMapsApiKey = Configuration["GoogleMaps:ApiKey"] ?? string.Empty;

    // توافق آمن مع النسخ التي لم تعد تحتوي Advertisements داخل HomeViewModel.
    // نقرأ الخاصية بالـ Reflection إن كانت موجودة، وإلا تبقى إعلانات الرئيسية فارغة
    // بدون كسر الـ Razor أثناء الـ Build.
    dynamic? homeAdvertisements =
        Model?.GetType()
              .GetProperty("Advertisements")
              ?.GetValue(Model);

    dynamic? homePrimaryAd =
        homeAdvertisements?.PrimaryAdvertisement;

    dynamic? homeSliderAd =
        homeAdvertisements?.HasHomeSlider == true
            ? homePrimaryAd
            : null;

    dynamic? homeBannerAd =
        homeAdvertisements?.HasHomeBanner == true
            ? homePrimaryAd
            : null;

    dynamic? homeFeaturedAd =
        homeAdvertisements?.FeaturedAdvertisement;
}

@section Styles {
    <link rel="stylesheet" href="~/css/customer/Index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/customer/advertisements.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />
}

    @* ✨ شريط التهنئة العائم ✨ *@
@if (ViewBag.IsBannerActive != null && (bool)ViewBag.IsBannerActive == true && !string.IsNullOrEmpty(ViewBag.BannerText))
{
    <div class="season-banner-floating" id="seasonBanner">
        <i class="bi bi-stars banner-icon"></i>
        <span>@ViewBag.BannerText</span>
        <button class="btn-close-banner" onclick="document.getElementById('seasonBanner').style.display='none'" title="إغلاق">
            <i class="bi bi-x"></i>
        </button>
    </div>
}

@{
    string heroV5MainTitle = ViewBag.HeroTitleMain ?? "دليلك اليمني بين يديك";
    string heroV5SubTitle = ViewBag.HeroTitleSub ?? "اكتشف";
    string heroV5InitialText = Model.HeroSlides?.FirstOrDefault()?.TypingText ?? "أجمل الوجهات";
}

@* ============================================================= *@
@* 1. القسم الأول: DALILAK EXPERIENCE V6 — ISOLATED BUILD       *@
@* الصورة/الفيديو/النص/الألوان تبقى ديناميكية من الأدمن. *@
@* ============================================================= *@
<section class="dlx-hero theme-@currentTheme"
         id="homeHeroV4"
         data-build="v6.11-integrated-holographic-compass"
         data-season="@currentTheme"
         aria-labelledby="dynamicMainTitle">

    <div class="dlx-media" id="dynamicHeroSlider" aria-hidden="true">
        @if (Model.HeroSlides != null && Model.HeroSlides.Any())
        {
            int dlxSlideIndex = 0;
            foreach (var slide in Model.HeroSlides)
            {
                string activeClass = dlxSlideIndex == 0 ? "active" : "";
                bool isVideo = slide.ImagePath?.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase) == true;

                if (isVideo)
                {
                    <video src="@slide.ImagePath"
               class="dlx-slide @activeClass"
               autoplay loop muted playsinline preload="metadata"
               data-text="@slide.TypingText"
               data-maincolor="@slide.MainTextColor"
               data-accentcolor="@slide.AccentColor"></video>
                }
                else
                {
                    <img src="@slide.ImagePath"
             class="dlx-slide @activeClass"
             alt=""
             loading="@(dlxSlideIndex == 0 ? "eager" : "lazy")"
             fetchpriority="@(dlxSlideIndex == 0 ? "high" : "auto")"
             data-text="@slide.TypingText"
             data-maincolor="@slide.MainTextColor"
             data-accentcolor="@slide.AccentColor">
                }
                dlxSlideIndex++;
            }
        }
        else
        {
            <img src="~/images/bg1.jpg" class="dlx-slide active" alt=""
             data-text="أجمل المطاعم" data-maincolor="#ffffff" data-accentcolor="#ff784d">
            <img src="~/images/bg2.jpg" class="dlx-slide" alt="" loading="lazy"
             data-text="أروع الشاليهات" data-maincolor="#ffffff" data-accentcolor="#ff784d">
            <img src="~/images/bg3.jpg" class="dlx-slide" alt="" loading="lazy"
             data-text="أجمل القاعات" data-maincolor="#ffffff" data-accentcolor="#ff784d">
            <img src="~/images/bg4.jpg" class="dlx-slide" alt="" loading="lazy"
             data-text="أفضل الفنادق" data-maincolor="#ffffff" data-accentcolor="#ff784d">
        }

        @* الإعلان الممول يندمج كشريحة داخل السلايدر الحالي ولا ينشئ Slider/Timer جديد. *@
        @if (homeSliderAd != null)
        {
            if (homeSliderAd.IsVideo)
            {
                <video src="@homeSliderAd.MediaPath"
               class="dlx-slide customer-ad-hero-media"
               muted loop playsinline preload="metadata"
               data-customer-ad-hero-slide="true"
               data-advertisement-id="@homeSliderAd.AdvertisementId"
               data-placement-type="@homeSliderAd.PlacementType"
               data-text="@homeSliderAd.AdvertisementTitle"
               data-maincolor="#ffffff"
               data-accentcolor="#ff9b58"></video>
            }
            else
            {
                <img src="@homeSliderAd.MediaPath"
             class="dlx-slide customer-ad-hero-media"
             alt="@homeSliderAd.AdvertisementTitle"
             loading="lazy"
             decoding="async"
             data-customer-ad-hero-slide="true"
             data-advertisement-id="@homeSliderAd.AdvertisementId"
             data-placement-type="@homeSliderAd.PlacementType"
             data-text="@homeSliderAd.AdvertisementTitle"
             data-maincolor="#ffffff"
             data-accentcolor="#ff9b58"
             onerror="this.onerror=null;this.src='/images/bg1.jpg';" />
            }
        }
    </div>

    <div class="dlx-shade" aria-hidden="true"></div>
    <div class="dlx-atmosphere" aria-hidden="true">
        <span class="dlx-contours"></span>
        <span class="dlx-pattern"></span>
        <span class="dlx-side-glass"></span>
        <span class="dlx-cinema" aria-hidden="true">
            <span class="dlx-cinema-aurora"></span>
            <span class="dlx-cinema-bloom"></span>
            <span class="dlx-cinema-sweep"></span>
            <span class="dlx-cinema-flare"></span>
            <i class="dlx-cinema-particle dlx-cinema-particle-1"></i>
            <i class="dlx-cinema-particle dlx-cinema-particle-2"></i>
            <i class="dlx-cinema-particle dlx-cinema-particle-3"></i>
            <i class="dlx-cinema-particle dlx-cinema-particle-4"></i>
        </span>
        <span class="dlx-arc dlx-arc-cyan"></span>
        <span class="dlx-arc dlx-arc-orange"></span>
    </div>

    <div class="dlx-season-field" id="heroSeasonField" aria-hidden="true"></div>

    <button type="button"
            class="dlx-compass-portal"
            id="dlxCompassPortal"
            onclick="scrollToNearby()"
            aria-label="اكتشف الأماكن الأقرب إليك"
            aria-describedby="dlxCompassStatus">
        <span class="dlx-compass-scene" aria-hidden="true">
            <span class="dlx-compass-halo"></span>
            <span class="dlx-compass-orbit dlx-compass-orbit-outer"></span>
            <span class="dlx-compass-orbit dlx-compass-orbit-middle"></span>
            <span class="dlx-compass-orbit dlx-compass-orbit-inner"></span>
            <span class="dlx-compass-radar dlx-compass-radar-a"></span>
            <span class="dlx-compass-radar dlx-compass-radar-b"></span>
            <span class="dlx-compass-disc">
                <span class="dlx-compass-rim"></span>
                <span class="dlx-compass-axis dlx-compass-axis-x"></span>
                <span class="dlx-compass-axis dlx-compass-axis-y"></span>
                <span class="dlx-compass-cardinal dlx-compass-n">N</span>
                <span class="dlx-compass-cardinal dlx-compass-e">E</span>
                <span class="dlx-compass-cardinal dlx-compass-s">S</span>
                <span class="dlx-compass-cardinal dlx-compass-w">W</span>
                <span class="dlx-compass-needle">
                    <i class="dlx-compass-needle-north"></i>
                    <i class="dlx-compass-needle-south"></i>
                </span>
                <span class="dlx-compass-core"></span>
                <span class="dlx-compass-glint"></span>
            </span>
        </span>
        <span class="dlx-compass-copy">
            <strong>اكتشف الأماكن القريبة منك</strong>
            <small id="dlxCompassStatus">اضغط لتحديد موقعك</small>
        </span>
    </button>

    <div class="dlx-stage">
        <div class="dlx-copy" data-hero-v5-copy>
            <div class="dlx-season-signature" id="heroV42SeasonSignature" hidden>
                <span class="hero-v42-season-mark"></span>
                <small id="heroV42SeasonText"></small>
            </div>

            <div class="dlx-eyebrow">
                <span class="dlx-eyebrow-spark" aria-hidden="true"></span>
                <span>وجهتك تبدأ من هنا</span>
            </div>

            <h1 class="dlx-title" id="dynamicMainTitle" data-hero-v5-fit>
                <span class="dlx-title-main" id="heroMainTitleRow">@heroV5MainTitle</span>
                <span class="dlx-title-accent" id="heroDynamicTitleRow">
                    <span class="dlx-title-helper">@heroV5SubTitle</span>
                    <span class="dlx-dynamic" id="dynamicAccentWrapper">
                        <span id="typed-text">@heroV5InitialText</span>
                        <span class="dlx-cursor cursor" aria-hidden="true">|</span>
                    </span>
                    <span class="dlx-title-line" aria-hidden="true"></span>
                </span>
            </h1>

            <div class="dlx-trust dlx-trust--hero" aria-label="ميزات المنصة">
                <span><i class="bi bi-shield-check"></i><b>+@Model.TotalTrustedPlaces</b> منشأة موثوقة</span>
                <em aria-hidden="true"></em>
                <span><i class="bi bi-patch-check"></i>تقييمات حقيقية</span>
                <em aria-hidden="true"></em>
                <span><i class="bi bi-shield-lock"></i>حجز آمن</span>
                <em class="dlx-clock-separator" aria-hidden="true"></em>
                <div class="dlx-clock" aria-label="الوقت والتاريخ الحالي">
                    <span class="dlx-live-dot" aria-hidden="true"></span>
                    <strong id="live-time">--:--</strong>
                    <span class="dlx-meta-dot" aria-hidden="true"></span>
                    <small id="live-date">جارِ التحميل...</small>
                </div>
            </div>

            <div class="dlx-discovery" id="searchBox">
                <span class="dlx-discovery-glow" aria-hidden="true"></span>
                <form action="/Places/Search" method="get" id="mainSearchForm" class="dlx-form">
                    <div class="dlx-searchbar">
                        <span class="dlx-search-icon" aria-hidden="true"><i class="bi bi-search"></i></span>
                        <label class="visually-hidden" for="dlxQuery">عن ماذا تبحث؟</label>
                        <input type="text" id="dlxQuery" name="q" autocomplete="off" placeholder="أين تريد أن تكون؟">
                        <button type="submit" class="dlx-search-submit" aria-label="ابحث الآن">
                            <i class="bi bi-arrow-left"></i>
                            <span class="dlx-button-shine" aria-hidden="true"></span>
                        </button>
                    </div>

                    <div class="dlx-filter-frame">
                        <div class="dlx-filter-row">
                            <div class="custom-dropdown dlx-filter" id="cityDropdown">
                                <input type="hidden" name="cityId" id="cityIdInput">
                                <div class="dropdown-header dlx-filter-trigger" role="button" tabindex="0" aria-label="اختر المدينة">
                                    <div class="dlx-selected" id="citySelectedContent">
                                        <i class="bi bi-geo-alt"></i><span>اختر المدينة</span>
                                    </div>
                                    <i class="bi bi-chevron-down dlx-chevron"></i>
                                </div>
                                <ul class="dropdown-list dlx-menu">
                                    <li data-value="" data-name="كل المدن" data-icon="bi-geo-alt" data-color="#7DE6FF">
                                        <i class="bi bi-geo-alt"></i>كل المدن
                                    </li>
                                    @foreach (var city in Model.Cities)
                                    {
                                        <li data-value="@city.Id" data-name="@city.Name" data-icon="bi-geo-alt-fill" data-color="#00A6DA">
                                            <i class="bi bi-geo-alt-fill"></i>@city.Name
                                        </li>
                                    }
                                </ul>
                            </div>

                            <div class="custom-dropdown dlx-filter" id="categoryDropdown">
                                <input type="hidden" name="categoryId" id="categoryIdInput">
                                <div class="dropdown-header dlx-filter-trigger" role="button" tabindex="0" aria-label="اختر الفئة">
                                    <div class="dlx-selected" id="categorySelectedContent">
                                        <i class="bi bi-grid"></i><span>اختر الفئة</span>
                                    </div>
                                    <i class="bi bi-chevron-down dlx-chevron"></i>
                                </div>
                                <ul class="dropdown-list dlx-menu">
                                    <li data-value="" data-name="كل الفئات" data-icon="bi-grid" data-color="#7DE6FF">
                                        <i class="bi bi-grid"></i>كل الفئات
                                    </li>
                                    @foreach (var cat in Model.Categories)
                                    {
                                        <li data-value="@cat.Id"
                                        data-name="@cat.Name"
                                        data-icon="@(string.IsNullOrEmpty(cat.IconClass) ? "bi-star" : cat.IconClass)"
                                        data-color="@(string.IsNullOrEmpty(cat.ThemeColor) ? "#00A6DA" : cat.ThemeColor)">
                                            <i class="bi @(string.IsNullOrEmpty(cat.IconClass) ? "bi-star" : cat.IconClass)"
                                           style="color: @(string.IsNullOrEmpty(cat.ThemeColor) ? "#00A6DA" : cat.ThemeColor);"></i>@cat.Name
                                        </li>
                                    }
                                </ul>
                            </div>

                            <button type="button" class="dlx-filter dlx-nearby" id="compassMagicBtn" onclick="scrollToNearby()">
                                <span class="dlx-nearby-orbit" aria-hidden="true"></span>
                                <span class="dlx-mini-compass" aria-hidden="true"><i></i></span><span>اكتشف القريب منك</span>
                            </button>
                        </div>
                        <span class="dlx-route" aria-hidden="true"><i></i></span>
                    </div>
                </form>
            </div>

            <p class="dlx-description dlx-description--lower">أماكن مختارة، تجارب موثوقة، وحجز أسهل في كل مدينة.</p>
        </div>
    </div>

    @if (homeSliderAd != null)
    {
        <aside class="customer-hero-ad-callout"
           data-customer-hero-ad-callout
           data-customer-ad
           data-advertisement-id="@homeSliderAd.AdvertisementId"
           data-placement-type="@homeSliderAd.PlacementType"
           hidden>
            <span class="customer-ad-sponsored-pill">
                <i class="bi bi-megaphone-fill"></i> ممول
            </span>
            <span class="customer-hero-ad-copy">
                <strong>@homeSliderAd.PlaceName</strong>
                <small>@homeSliderAd.AdvertisementTitle</small>
            </span>
            <a href="@homeSliderAd.FallbackUrl"
           class="customer-hero-ad-action"
           data-customer-ad-click
           data-advertisement-id="@homeSliderAd.AdvertisementId"
           data-placement-type="@homeSliderAd.PlacementType"
           data-fallback-url="@homeSliderAd.FallbackUrl">
                <span>@homeSliderAd.ButtonText</span>
                <i class="bi bi-arrow-left"></i>
            </a>
        </aside>
    }

    <div class="dlx-place-label" aria-hidden="true">
        <span></span>
        <strong id="heroV42ContextText">@heroV5InitialText</strong>
        <small>اكتشف وجهتك التالية</small>
    </div>

    <div class="dlx-slider" id="heroSliderNav">
        <span class="dlx-count" aria-hidden="true">
            <strong id="heroV42SlideCurrent">01</strong><small>/</small><span id="heroV42SlideTotal">01</span>
        </span>
        <div class="dlx-dots" id="heroSliderDots" aria-label="التنقل بين صور الواجهة"></div>
    </div>

    <div class="dlx-progress" aria-hidden="true"><span id="heroV42ProgressFill"></span></div>
</section>

@* تم حذف نسخ Hero القديمة غير المرسومة من الصفحة لتقليل حجم الـRazor والـCSS/JS المرتبط بها. *@

@* ============================================================= *@
@* 2. القسم الثاني: تاج القمريات للفئات — Categories V9.7 *@
@* ============================================================= *@
@{
    var qamariyaCategories = Model?.Categories?.ToList();
    int qamariyaCategoryTotal = qamariyaCategories?.Count ?? 0;
}

<section class="qamariya-categories" id="categories-section" aria-labelledby="qamariyaTitle">
    <svg class="qamariya-clip-defs" width="0" height="0" aria-hidden="true" focusable="false">
        <defs>
            <clipPath id="qamariyaOpeningClip" clipPathUnits="objectBoundingBox">
                <path d="M .5 0 C .22 .075 0 .29 0 .51 L 0 1 L 1 1 L 1 .51 C 1 .29 .78 .075 .5 0 Z"></path>
            </clipPath>
        </defs>
    </svg>

    <img class="qamariya-section-pattern"
         src="/images/qamariya-category-pattern.png"
         alt=""
         decoding="async"
         aria-hidden="true" />
    <span class="qamariya-pearl-light qamariya-pearl-light--one" aria-hidden="true"></span>
    <span class="qamariya-pearl-light qamariya-pearl-light--two" aria-hidden="true"></span>

    <div class="qamariya-container">
        <header class="qamariya-heading">
            <span class="qamariya-eyebrow">
                <i class="bi bi-stars" aria-hidden="true"></i>
                <span>بوابتك إلى الأفضل</span>
            </span>
            <h2 id="qamariyaTitle">ماذا تبحث عنه <span>اليوم؟</span></h2>
            <p>اختر الفئة واستكشف أفضل الخيارات المتاحة</p>
        </header>

        @if (qamariyaCategories != null && qamariyaCategories.Count > 0)
        {
            <div class="qamariya-carousel"
             data-qamariya-carousel
             data-total="@qamariyaCategoryTotal"
             dir="rtl">
                <div class="qamariya-stage" id="qamariyaStage" aria-live="polite">
                    <span class="qamariya-stage-aura" aria-hidden="true"></span>
                    <span class="qamariya-stage-floor" aria-hidden="true"></span>

                    @for (int i = 0; i < qamariyaCategories.Count; i++)
                    {
                        var cat = qamariyaCategories[i];
                        string categoryImage = string.IsNullOrWhiteSpace(cat.ImagePath)
                        ? "/images/default-category.jpg"
                        : cat.ImagePath;
                        string categoryAccent = string.IsNullOrWhiteSpace(cat.ThemeColor)
                        ? "var(--v4-accent, var(--color-orange))"
                        : cat.ThemeColor;
                        string categoryIcon = string.IsNullOrWhiteSpace(cat.IconClass)
                        ? "bi-star"
                        : cat.IconClass.Trim();

                        <article class="qamariya-card @(i == 0 ? "is-active" : "")"
                         data-qamariya-card="@i"
                         style="--qamariya-accent: @categoryAccent;"
                         aria-hidden="@(i == 0 ? "false" : "true")">
                            <a class="qamariya-card-link"
                       href="/Places/Search?categoryId=@cat.Id"
                       aria-label="استكشف فئة @cat.Name">
                                <span class="qamariya-photo">
                                    <img src="@categoryImage"
                                 alt="@cat.Name"
                                 decoding="async"
                                 loading="@(i < 3 ? "eager" : "lazy")"
                                 onerror="this.onerror=null;this.src='/images/default-category.jpg';" />
                                    <span class="qamariya-photo-shade" aria-hidden="true"></span>
                                </span>

                                <img class="qamariya-frame"
                             src="/images/qamariya-category-frame.png"
                             alt=""
                             decoding="async"
                             aria-hidden="true" />

                                <img class="qamariya-frame qamariya-frame--reinforce"
                             src="/images/qamariya-category-frame.png"
                             alt=""
                             decoding="async"
                             aria-hidden="true" />

                                <span class="qamariya-caption">
                                    <span class="qamariya-caption-icon" aria-hidden="true">
                                        <i class="bi @categoryIcon"></i>
                                    </span>
                                    <strong data-qamariya-name title="@cat.Name">@cat.Name</strong>
                                    <span class="qamariya-caption-line" aria-hidden="true"><i></i></span>
                                    <small>استكشف الفئة</small>
                                </span>
                            </a>
                        </article>
                    }

                    <button type="button"
                        class="qamariya-arrow qamariya-arrow--right"
                        id="qamariyaPrev"
                        aria-label="الفئة السابقة">
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                    <button type="button"
                        class="qamariya-arrow qamariya-arrow--left"
                        id="qamariyaNext"
                        aria-label="الفئة التالية">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    </button>
                </div>

                <footer class="qamariya-navigation">
                    <span class="qamariya-count" aria-hidden="true">
                        <b id="qamariyaCurrent">01</b>
                        <em>/ @qamariyaCategoryTotal.ToString("00")</em>
                    </span>

                    <div class="qamariya-progress" aria-hidden="true">
                        <span class="qamariya-progress-track">
                            <i id="qamariyaProgress"></i>
                            <b id="qamariyaTimer"></b>
                        </span>
                    </div>

                    <nav class="qamariya-dots" aria-label="اختيار الفئة">
                        @for (int i = 0; i < qamariyaCategories.Count; i++)
                        {
                            <button type="button"
                            class="qamariya-dot @(i == 0 ? "is-active" : "")"
                            data-qamariya-target="@i"
                            aria-label="عرض الفئة رقم @(i + 1)"
                            aria-current="@(i == 0 ? "true" : "false")"></button>
                        }
                    </nav>
                </footer>
            </div>
        }
        else
        {
            <div class="qamariya-empty">
                <i class="bi bi-grid" aria-hidden="true"></i>
                <strong>ستظهر الفئات هنا قريبًا</strong>
                <span>أضف الفئات من لوحة الإدارة لتظهر تلقائيًا.</span>
            </div>
        }
    </div>
</section>

@if (homeBannerAd != null)
{
    <section class="customer-home-banner-slot"
         aria-label="إعلان ممول"
         data-customer-ad
         data-advertisement-id="@homeBannerAd.AdvertisementId"
         data-placement-type="@homeBannerAd.PlacementType">
        <div class="container">
            <article class="customer-home-banner">
                <div class="customer-home-banner-media" aria-hidden="true">
                    @if (homeBannerAd.IsVideo)
                    {
                        <video src="@homeBannerAd.MediaPath" muted loop autoplay playsinline preload="metadata"></video>
                    }
                    else
                    {
                        <img src="@homeBannerAd.MediaPath"
                     alt=""
                     loading="lazy"
                     decoding="async"
                     onerror="this.onerror=null;this.src='/images/bg1.jpg';" />
                    }
                    <span class="customer-home-banner-shade"></span>
                </div>

                <div class="customer-home-banner-content">
                    <span class="customer-ad-sponsored-pill customer-ad-sponsored-pill--light">
                        <i class="bi bi-megaphone-fill"></i> إعلان ممول
                    </span>
                    <div class="customer-home-banner-copy">
                        <small>@homeBannerAd.PlaceName</small>
                        <h3>@homeBannerAd.AdvertisementTitle</h3>
                        @if (!string.IsNullOrWhiteSpace(homeBannerAd.ShortDescription))
                        {
                            <p>@homeBannerAd.ShortDescription</p>
                        }
                    </div>
                    <a href="@homeBannerAd.FallbackUrl"
                   class="customer-home-banner-action"
                   data-customer-ad-click
                   data-advertisement-id="@homeBannerAd.AdvertisementId"
                   data-placement-type="@homeBannerAd.PlacementType"
                   data-fallback-url="@homeBannerAd.FallbackUrl">
                        <span>@homeBannerAd.ButtonText</span>
                        <i class="bi bi-arrow-left"></i>
                    </a>
                </div>
            </article>
        </div>
    </section>
}

