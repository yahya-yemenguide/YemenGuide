    @section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.js"
        asp-append-version="true"></script>

    <script src="~/lib/fullcalendar/index.global.min.js"
        asp-append-version="true"></script>

    <script src="~/lib/fullcalendar/ar.global.min.js"
        asp-append-version="true"></script>

    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.4/build/js/intlTelInput.min.js"></script>

    <script src="~/js/owner/calendar-manager.js"
        asp-append-version="true"></script>

    <script src="~/js/owner/reservation-actions.js"
        asp-append-version="true"></script>

    <script>
        (() => {
            "use strict";

            const root = document.querySelector(".owner-reservations-page");
            if (!root) return;

            const currency = {
                name: root.dataset.displayCurrency || "ريال يمني",
                code: root.dataset.currencyCode || "YER",
                symbol: root.dataset.currencySymbol || "ر.ي"
            };

            window.YGOwnerReservationCurrency = currency;

            const isYer = currency.code === "YER";
            const formatNumber = value => {
                const number = Number(value || 0);
                return new Intl.NumberFormat("en-US", {
                    minimumFractionDigits: isYer ? 0 : 2,
                    maximumFractionDigits: isYer ? 0 : 2
                }).format(Number.isFinite(number) ? number : 0);
            };
            const money = value => `${formatNumber(value)} ${currency.symbol}`;

            // يحافظ على JS الحالي بلا مصدر مستقل لأسعار الصرف:
            // السيرفر يرسل القيم محوّلة، وهذه الطبقة تغيّر التنسيق/الرمز فقط.
            const normalizeCurrencyText = text => {
                if (isYer || !text) return text;
                return String(text)
                    .replace(/ريال\s+يمني/g, currency.symbol)
                    .replace(/(^|\s)ريال(?=\s|$|[.,،؛:!؟<])/g, `$1${currency.symbol}`);
            };

            const shouldProcess = node => {
                const parent = node.parentElement;
                return Boolean(parent?.closest(
                    ".owner-reservations-page, #premiumCenterModal, #ygCalendarManager, .yg-calendar-dialog-portal, .swal2-container"
                ));
            };

            const normalizeNode = node => {
                if (node.nodeType === Node.TEXT_NODE) {
                    if (shouldProcess(node)) {
                        const next = normalizeCurrencyText(node.nodeValue || "");
                        if (next !== node.nodeValue) node.nodeValue = next;
                    }
                    return;
                }

                if (!(node instanceof Element)) return;
                node.querySelectorAll("*").forEach(element => {
                    Array.from(element.childNodes)
                        .filter(child => child.nodeType === Node.TEXT_NODE)
                        .forEach(child => normalizeNode(child));
                });
            };

            const observer = new MutationObserver(records => {
                records.forEach(record => {
                    record.addedNodes.forEach(node => normalizeNode(node));
                });
            });
            observer.observe(document.body, { childList: true, subtree: true });

            let currentButton = null;
            let lastCollectionAmount = null;
            document.addEventListener("click", event => {
                const button = event.target.closest?.(".compact-details-button");
                if (button) currentButton = button;
            }, true);

            const repairRefundModal = button => {
                if (!button) return;
                const mappings = [
                    ["modalRefundDeposit", "refundDeposit"],
                    ["modalRefundFee", "refundFee"],
                    ["modalRefundAmount", "refundAmount"],
                    ["modalRefundOwnerShare", "refundOwnerShare"]
                ];
                mappings.forEach(([id, key]) => {
                    const element = document.getElementById(id);
                    if (!element) return;
                    const raw = button.dataset[key];
                    if (raw !== undefined && raw !== null && raw !== "") {
                        element.textContent = money(raw);
                    }
                });
            };

            let collectionRunning = false;

            const parseReservationRaw = value => {
                const parsed = Number(String(value ?? "0").replace(",", "."));
                return Number.isFinite(parsed) ? parsed : 0;
            };

            const setReservationActionContent = (button, iconClass, label) => {
                if (!button) return;
                const icon = button.querySelector("i");
                const text = button.querySelector("span");
                if (icon) icon.className = `bi ${iconClass}`;
                if (text) text.textContent = label;
            };

            const setReservationActionDisabled = (button, disabled, title = "") => {
                if (!button) return;
                button.disabled = Boolean(disabled);
                button.setAttribute("aria-disabled", disabled ? "true" : "false");
                if (title) button.title = title;
                else button.removeAttribute("title");
            };

            const syncConfirmedActionButtons = button => {
                if (!button || button.dataset.status !== "Confirmed") return;

                const container = document.getElementById("modalActionButtons");
                const buttons = container?.querySelectorAll("button");
                if (!buttons || buttons.length < 3) return;

                const mainAction = buttons[0];
                const noShowAction = buttons[1];
                const ownerCancelAction = buttons[2];

                const bookingId = Number(button.dataset.id || 0);
                const startAt = new Date(button.dataset.operationalStart || "").getTime();
                const endAt = new Date(button.dataset.operationalEnd || "").getTime();
                const configuredNoShowAt = new Date(button.dataset.noShowAvailableAt || "").getTime();
                const noShowAt = Number.isFinite(configuredNoShowAt)
                    ? configuredNoShowAt
                    : startAt;
                const now = Date.now();
                const remaining = Math.max(0, parseReservationRaw(button.dataset.propertyRaw));
                const collected = Math.max(0, parseReservationRaw(button.dataset.collectedRaw));

                if (Number.isFinite(endAt) && now >= endAt) {
                    setReservationActionContent(mainAction, "bi-check2-circle", "إنهاء الحجز");
                    setReservationActionDisabled(mainAction, false);
                    mainAction.setAttribute("onclick", `window.executeCompleteBooking(${bookingId})`);
                } else if (Number.isFinite(startAt) && now >= startAt) {
                    if (remaining > 0) {
                        setReservationActionContent(mainAction, "bi-cash-stack", "تحصيل المبلغ");
                        setReservationActionDisabled(mainAction, false);
                        mainAction.setAttribute("onclick", `window.executeCollectBooking(${bookingId})`);
                    } else {
                        setReservationActionContent(mainAction, "bi-check2-circle", "تم سداد كامل المبلغ");
                        setReservationActionDisabled(mainAction, true, "تم سداد كامل المبلغ، وسيصبح الإنهاء متاحًا بعد نهاية الفترة.");
                        mainAction.removeAttribute("onclick");
                    }
                } else {
                    setReservationActionContent(mainAction, "bi-cash-stack", "تحصيل المبلغ");
                    setReservationActionDisabled(mainAction, true, "التحصيل يتاح عند بداية فترة الحجز.");
                    mainAction.removeAttribute("onclick");
                }

                const canNoShow =
                    Number.isFinite(noShowAt) &&
                    Number.isFinite(endAt) &&
                    now >= noShowAt &&
                    now < endAt &&
                    collected <= 0;

                if (canNoShow) {
                    setReservationActionDisabled(noShowAction, false);
                } else if (collected > 0) {
                    setReservationActionDisabled(
                        noShowAction,
                        true,
                        "تم تسجيل تحصيل عند المنشأة؛ لذلك لا يمكن تسجيل عدم حضور لهذا الحجز."
                    );
                } else if (Number.isFinite(endAt) && now >= endAt) {
                    setReservationActionDisabled(
                        noShowAction,
                        true,
                        "انتهت فترة الحجز؛ لم يعد تسجيل عدم الحضور متاحًا."
                    );
                } else {
                    setReservationActionDisabled(
                        noShowAction,
                        true,
                        "عدم الحضور يتاح عند بداية فترة الحجز."
                    );
                }

                setReservationActionDisabled(
                    ownerCancelAction,
                    false
                );
            };

            window.executeCollectBooking = async bookingId => {
                if (collectionRunning) return;

                const button = currentButton;
                const id = Number(bookingId || button?.dataset.id || 0);

                if (!button || !Number.isInteger(id) || id <= 0) {
                    await window.Swal?.fire?.({
                        icon: "error",
                        title: "تعذر تسجيل التحصيل",
                        text: "تعذر تحديد الحجز المطلوب."
                    });
                    return;
                }

                const startAt = new Date(button.dataset.operationalStart || "").getTime();
                const endAt = new Date(button.dataset.operationalEnd || "").getTime();
                const now = Date.now();
                const remaining = Math.max(0, parseReservationRaw(button.dataset.propertyRaw));

                if (!Number.isFinite(startAt) || now < startAt) {
                    await window.Swal.fire({
                        icon: "warning",
                        title: "التحصيل غير متاح الآن",
                        text: "التحصيل يتاح عند بداية فترة الحجز."
                    });
                    return;
                }

                if (!Number.isFinite(endAt) || now >= endAt) {
                    await window.Swal.fire({
                        icon: "warning",
                        title: "انتهت فترة التحصيل",
                        text: "انتهت فترة الحجز. استخدم زر إنهاء الحجز."
                    });
                    return;
                }

                if (remaining <= 0) {
                    await window.Swal.fire({
                        icon: "info",
                        title: "لا يوجد مبلغ متبقٍ",
                        text: "تم سداد كامل المبلغ المتبقي لهذا الحجز."
                    });
                    return;
                }

                const result = await window.Swal.fire({
                    icon: "question",
                    title: "تحصيل المبلغ",
                    html: `
                        <div dir="rtl">
                            <p>أدخل المبلغ الذي تم تحصيله فعليًا عند المنشأة.</p>
                            <div class="reservation-collection-summary">
                                <span>المتبقي المسجل</span>
                                <strong>${money(remaining)}</strong>
                            </div>
                            <div class="reservation-danger-dialog-note" style="margin-top:12px;">
                                <i class="bi bi-info-circle"></i>
                                <span>يمكن التحصيل على دفعات حتى سداد المتبقي. أول تحصيل فعلي يمنع تسجيل عدم حضور فقط، ولا يمنع إلغاء المالك ولا ينهي الحجز.</span>
                            </div>
                        </div>
                    `,
                    input: "number",
                    inputLabel: "المبلغ المحصل فعليًا",
                    inputValue: remaining,
                    inputAttributes: {
                        min: "0.01",
                        max: String(remaining),
                        step: "0.01",
                        inputmode: "decimal",
                        dir: "ltr"
                    },
                    showCancelButton: true,
                    confirmButtonText: "تسجيل التحصيل",
                    cancelButtonText: "تراجع",
                    confirmButtonColor: "#10B981",
                    cancelButtonColor: "#64748B",
                    reverseButtons: true,
                    allowOutsideClick: false,
                    returnFocus: false,
                    inputValidator: value => {
                        const amount = Number(value);
                        if (!Number.isFinite(amount) || amount <= 0) {
                            return "أدخل مبلغًا صحيحًا أكبر من صفر.";
                        }
                        if (amount > remaining) {
                            return `المبلغ لا يمكن أن يتجاوز ${money(remaining)}.`;
                        }
                        return undefined;
                    }
                });

                if (!result.isConfirmed) return;

                const amount = Number(result.value);
                const formData = new FormData();
                formData.append("id", String(id));
                formData.append("collectedAmount", String(amount));

                const token = document.querySelector(
                    '#ownerReservationAntiForgeryForm input[name="__RequestVerificationToken"], input[name="__RequestVerificationToken"]'
                )?.value;
                if (token) formData.append("__RequestVerificationToken", token);

                collectionRunning = true;

                window.Swal.fire({
                    title: "جاري تسجيل التحصيل",
                    text: "يتم تحديث السجل المالي دون إنهاء الحجز.",
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    didOpen: () => window.Swal.showLoading()
                });

                try {
                    const response = await fetch(
                        "/Owner/Reservation/CollectBookingPayment",
                        {
                            method: "POST",
                            body: formData,
                            credentials: "same-origin",
                            headers: {
                                Accept: "application/json",
                                "X-Requested-With": "XMLHttpRequest"
                            }
                        }
                    );

                    const data = await response.json();
                    if (!response.ok || data?.success !== true) {
                        throw new Error(data?.message || "تعذر تسجيل التحصيل.");
                    }

                    await window.Swal.fire({
                        icon: "success",
                        title: "تم تسجيل التحصيل",
                        text: data.message || "تم تحديث السجل المالي بنجاح.",
                        confirmButtonText: "حسنًا",
                        confirmButtonColor: "#00A6DA",
                        returnFocus: false
                    });

                    window.location.reload();
                } catch (error) {
                    await window.Swal.fire({
                        icon: "error",
                        title: "تعذر تسجيل التحصيل",
                        text: error?.message || "حدث خطأ أثناء تسجيل التحصيل.",
                        confirmButtonText: "حسنًا",
                        confirmButtonColor: "#EF4444",
                        returnFocus: false
                    });
                } finally {
                    collectionRunning = false;
                }
            };

            if (typeof window.openPremiumCenterModal === "function") {
                const originalOpen = window.openPremiumCenterModal;
                window.openPremiumCenterModal = function (button) {
                    currentButton = button || currentButton;
                    const result = originalOpen.apply(this, arguments);
                    queueMicrotask(() => {
                        repairRefundModal(currentButton);
                        syncConfirmedActionButtons(currentButton);
                    });
                    window.setTimeout(() => {
                        repairRefundModal(currentButton);
                        syncConfirmedActionButtons(currentButton);
                    }, 50);
                    return result;
                };
            }

            // SweetAlert في الملف الحالي يكتب كلمة "ريال" في بعض رسائل التحصيل.
            // نصلح الرمز، ونحافظ على كسور USD/SAR في نافذة التحصيل.
            if (window.Swal && typeof window.Swal.fire === "function") {
                const nativeFire = window.Swal.fire.bind(window.Swal);
                window.Swal.fire = function (options, ...rest) {
                    if (!options || typeof options !== "object") {
                        return nativeFire(options, ...rest);
                    }

                    const patched = { ...options };
                    if (typeof patched.text === "string") {
                        patched.text = normalizeCurrencyText(patched.text);
                    }
                    if (typeof patched.html === "string") {
                        patched.html = normalizeCurrencyText(patched.html);
                    }

                    const collectionDialog =
                        (
                            patched.title === "تحصيل وإنهاء الحجز" ||
                            patched.title === "تحصيل المبلغ"
                        ) &&
                        patched.inputValue !== undefined;

                    if (collectionDialog) {
                        const precise = money(patched.inputValue);
                        patched.html = String(patched.html || "").replace(
                            /[\d٬,.]+\s*(?:ريال\s+يمني|ريال|ر\.ي|ر\.س|\$)/,
                            precise
                        );
                    }

                    if (patched.title === "يوجد مبلغ غير محصل" && currentButton && lastCollectionAmount !== null) {
                        const originalRemaining = Number(currentButton.dataset.propertyRaw || 0);
                        const remaining = Math.max(0, originalRemaining - Number(lastCollectionAmount || 0));
                        patched.html = String(patched.html || "").replace(
                            /[\d٬,.]+\s*(?:ريال\s+يمني|ريال|ر\.ي|ر\.س|\$)/,
                            money(remaining)
                        );
                    }

                    if (patched.title === "تم إنهاء الحجز" && currentButton && lastCollectionAmount !== null) {
                        const originalRemaining = Number(currentButton.dataset.propertyRaw || 0);
                        const collected = Math.max(0, Number(lastCollectionAmount || 0));
                        const remaining = Math.max(0, originalRemaining - collected);
                        const replacements = [money(collected), money(remaining)];
                        let index = 0;
                        patched.html = String(patched.html || "").replace(
                            /[\d٬,.]+\s*(?:ريال\s+يمني|ريال|ر\.ي|ر\.س|\$)/g,
                            match => replacements[index++] || normalizeCurrencyText(match)
                        );
                    }

                    if (patched.title === "إلغاء الحجز من جهة المالك" && currentButton) {
                        const raw = currentButton.dataset.totalCollectedRaw || currentButton.dataset.onlineRaw;
                        if (raw !== undefined) {
                            patched.html = String(patched.html || "").replace(
                                /[\d٬,.]+\s*(?:ريال\s+يمني|ريال|ر\.ي|ر\.س|\$)/,
                                money(raw)
                            );
                        }
                    }

                    const resultPromise = nativeFire(patched, ...rest);
                    if (!collectionDialog || !resultPromise || typeof resultPromise.then !== "function") {
                        return resultPromise;
                    }

                    return resultPromise.then(result => {
                        if (result?.isConfirmed) {
                            const entered = Number(result.value);
                            lastCollectionAmount = Number.isFinite(entered)
                                ? entered
                                : Number(patched.inputValue || 0);
                        }
                        return result;
                    });
                };
            }
        })();
    </script>


    <script>
(() => {
    "use strict";

    let lastDetailsButton = null;

    const token = () =>
        document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

    const postForm = async (url, data) => {
        const body = new URLSearchParams();

        Object.entries(data || {}).forEach(([key, value]) => {
            if (value !== undefined && value !== null) {
                body.set(key, String(value));
            }
        });

        const csrf = token();
        if (csrf) body.set("__RequestVerificationToken", csrf);

        const response = await fetch(url, {
            method: "POST",
            credentials: "same-origin",
            headers: {
                "Content-Type":
                    "application/x-www-form-urlencoded; charset=UTF-8",
                "X-Requested-With": "XMLHttpRequest"
            },
            body
        });

        return response.json();
    };

    const showMessage = async (icon, title, text) => {
        if (window.Swal?.fire) {
            return window.Swal.fire({
                icon,
                title,
                text,
                confirmButtonText: "حسنًا"
            });
        }

        window.alert(text || title);
    };

    const restoreNormalBookingActions = actions => {
        Array.from(actions?.children || []).forEach(child => {
            if (!(child instanceof HTMLButtonElement)) return;
            if (child.classList.contains("reservation-payment-extension")) return;
            if (child.dataset.additionalPaymentHidden !== "true") return;

            child.style.display = child.dataset.additionalPaymentDisplay || "";
            delete child.dataset.additionalPaymentHidden;
            delete child.dataset.additionalPaymentDisplay;
        });
    };

    const disableNormalBookingActions = actions => {
        Array.from(actions?.children || []).forEach(child => {
            if (!(child instanceof HTMLButtonElement)) return;
            if (child.classList.contains("reservation-payment-extension")) return;

            child.dataset.additionalPaymentHidden = "true";
            child.dataset.additionalPaymentDisplay = child.style.display || "";
            child.style.display = "none";
        });
    };

    const escapeHtml = value =>
        String(value ?? "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");

    async function approveAdditional(bookingId, paymentId, skipConfirmation = false) {
        const confirmed = skipConfirmation
            ? { isConfirmed: true }
            : window.Swal?.fire
                ? await window.Swal.fire({
                    icon: "question",
                    title: "اعتماد الدفعة الإضافية",
                    text:
                        "سيتم إضافة المبلغ إلى المدفوع إلكترونيًا وتخفيض المتبقي. هل أنت متأكد؟",
                    showCancelButton: true,
                    confirmButtonText: "اعتماد",
                    cancelButtonText: "إلغاء"
                })
                : {
                    isConfirmed: window.confirm("اعتماد الدفعة الإضافية؟")
                };

        if (!confirmed.isConfirmed) return;

        const result = await postForm(
            "/Owner/Reservation/ReviewAdditionalPayment",
            {
                id: bookingId,
                paymentId,
                isApproved: true
            });

        if (!result?.success) {
            await showMessage(
                "error",
                "تعذر الاعتماد",
                result?.message || "لم يتم تغيير البيانات.");
            return;
        }

        await showMessage(
            "success",
            "تم اعتماد الدفعة",
            result.message);

        window.location.reload();
    }

    async function reviewAdditionalPayment(bookingId, payment) {
        if (!payment?.paymentId) return;

        if (!window.Swal?.fire) {
            const accepted = window.confirm(
                `دفعة إضافية بقيمة ${Number(payment.amount || 0).toLocaleString("ar-YE")} ر.ي. هل تريد اعتمادها؟`);

            if (accepted) {
                await approveAdditional(bookingId, payment.paymentId, true);
            }
            return;
        }

        const proofLink = payment.proofPath
            ? `<a href="${escapeHtml(payment.proofPath)}" target="_blank" rel="noopener" class="btn btn-light btn-sm mt-2"><i class="bi bi-image"></i> عرض إثبات الدفع</a>`
            : `<div class="text-danger small mt-2">لا توجد صورة إثبات متاحة.</div>`;

        const result = await window.Swal.fire({
            icon: "info",
            title: "مراجعة الدفعة الإضافية",
            html: `
                <div dir="rtl" class="text-start">
                    <div class="mb-2">المبلغ: <strong>${Number(payment.amount || 0).toLocaleString("ar-YE")} ر.ي</strong></div>
                    ${payment.walletName ? `<div class="mb-2">المحفظة: <strong>${escapeHtml(payment.walletName)}</strong></div>` : ""}
                    ${payment.accountNumber ? `<div class="mb-2">حساب التحويل: <strong dir="ltr">${escapeHtml(payment.accountNumber)}</strong></div>` : ""}
                    ${payment.beneficiaryName ? `<div class="mb-2">المستفيد: <strong>${escapeHtml(payment.beneficiaryName)}</strong></div>` : ""}
                    ${payment.paymentReference ? `<div class="mb-2">مرجع الحوالة: <strong dir="ltr">${escapeHtml(payment.paymentReference)}</strong></div>` : ""}
                    ${payment.submittedAt ? `<div class="mb-2">وقت الإرسال: <strong>${new Date(payment.submittedAt).toLocaleString("ar-YE")}</strong></div>` : ""}
                    ${proofLink}
                    <div class="alert alert-warning py-2 mt-3 mb-0">
                        اعتماد الدفعة سيزيد المدفوع إلكترونيًا ويخفض المتبقي فقط، ولن ينهي الحجز.
                    </div>
                </div>`,
            showCancelButton: true,
            showDenyButton: true,
            confirmButtonText: "اعتماد الدفعة",
            denyButtonText: "رفض الدفعة",
            cancelButtonText: "إغلاق",
            confirmButtonColor: "#10B981",
            denyButtonColor: "#EF4444",
            reverseButtons: true
        });

        if (result.isConfirmed) {
            await approveAdditional(bookingId, payment.paymentId, true);
            return;
        }

        if (result.isDenied) {
            await rejectAdditional(bookingId, payment.paymentId);
        }
    }

    async function rejectAdditional(bookingId, paymentId) {
        let reason = "";

        if (window.Swal?.fire) {
            const result = await window.Swal.fire({
                icon: "warning",
                title: "رفض الدفعة الإضافية",
                input: "textarea",
                inputLabel: "سبب الرفض",
                inputPlaceholder: "اكتب سببًا واضحًا...",
                inputAttributes: { maxlength: "500" },
                showCancelButton: true,
                confirmButtonText: "رفض الدفعة",
                cancelButtonText: "إلغاء",
                preConfirm: value => {
                    const text = String(value || "").trim();
                    if (text.length < 5) {
                        window.Swal.showValidationMessage(
                            "اكتب سببًا لا يقل عن 5 أحرف.");
                        return false;
                    }
                    return text;
                }
            });

            if (!result.isConfirmed) return;
            reason = String(result.value || "").trim();
        } else {
            reason = String(
                window.prompt("اكتب سبب رفض الدفعة:") || "")
                .trim();

            if (reason.length < 5) return;
        }

        const result = await postForm(
            "/Owner/Reservation/ReviewAdditionalPayment",
            {
                id: bookingId,
                paymentId,
                isApproved: false,
                rejectionReason: reason
            });

        if (!result?.success) {
            await showMessage(
                "error",
                "تعذر الرفض",
                result?.message || "لم يتم تغيير البيانات.");
            return;
        }

        await showMessage(
            "success",
            "تم رفض الدفعة",
            result.message);

        window.location.reload();
    }

    async function collectLatePayment(button) {
        const bookingId = Number(button.dataset.id || 0);
        const remaining = Number(button.dataset.propertyRaw || 0);
        if (!bookingId || !(remaining > 0)) return;

        let amount = remaining;

        if (window.Swal?.fire) {
            const result = await window.Swal.fire({
                icon: "info",
                title: "تحصيل مبلغ متبقٍ",
                html:
                    `المتبقي على الحجز: <strong>${remaining.toLocaleString("ar-YE")} ر.ي</strong>`,
                input: "number",
                inputValue: remaining,
                inputAttributes: {
                    min: "0.01",
                    max: String(remaining),
                    step: "0.01"
                },
                showCancelButton: true,
                confirmButtonText: "تسجيل التحصيل",
                cancelButtonText: "إلغاء",
                preConfirm: value => {
                    const n = Number(value);
                    if (!Number.isFinite(n) ||
                        n <= 0 ||
                        n > remaining) {
                        window.Swal.showValidationMessage(
                            `أدخل مبلغًا أكبر من صفر ولا يتجاوز ${remaining.toLocaleString("ar-YE")}.`);
                        return false;
                    }
                    return n;
                }
            });

            if (!result.isConfirmed) return;
            amount = Number(result.value);
        } else {
            const value = Number(
                window.prompt("المبلغ المحصل:", String(remaining)));

            if (!Number.isFinite(value) ||
                value <= 0 ||
                value > remaining) return;

            amount = value;
        }

        const result = await postForm(
            "/Owner/Reservation/CollectLatePayment",
            {
                id: bookingId,
                amount
            });

        if (!result?.success) {
            await showMessage(
                "error",
                "تعذر تسجيل التحصيل",
                result?.message || "لم يتم تغيير البيانات.");
            return;
        }

        await showMessage(
            "success",
            "تم تسجيل التحصيل",
            result.message);

        window.location.reload();
    }

    function addLateCollection(actions, button) {
        const status = String(button.dataset.status || "").trim();
        const remaining = Number(button.dataset.propertyRaw || 0);

        if (status !== "Completed" || !(remaining > 0)) return;

        const late = document.createElement("button");
        late.type = "button";
        late.className =
            "btn btn-primary reservation-payment-extension";
        late.innerHTML =
            '<i class="bi bi-cash-coin"></i> تحصيل مبلغ متبقٍ';
        late.addEventListener(
            "click",
            () => collectLatePayment(button));
        actions.appendChild(late);
    }

    let additionalPaymentSyncGeneration = 0;

    async function addPendingReview(actions, button, syncGeneration) {
        const status = String(button.dataset.status || "").trim();
        if (status !== "Confirmed") return;

        const bookingId = Number(button.dataset.id || 0);
        if (!bookingId) return;

        try {
            const response = await fetch(
                `/Owner/Reservation/AdditionalPaymentStatus?id=${encodeURIComponent(bookingId)}`,
                {
                    credentials: "same-origin",
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });

            if (!response.ok) return;

            const data = await response.json();

            if (syncGeneration !== additionalPaymentSyncGeneration ||
                lastDetailsButton !== button ||
                !document.body.contains(actions)) {
                return;
            }

            if (!data?.success || !data.pending || !data.payment) return;

            restoreNormalBookingActions(actions);
            disableNormalBookingActions(actions);

            const payment = data.payment;

            actions
                .querySelectorAll(".reservation-payment-extension[data-additional-payment-review='true']")
                .forEach(item => item.remove());

            const reviewButton = document.createElement("button");
            reviewButton.type = "button";
            reviewButton.className =
                "btn btn-warning reservation-payment-extension";
            reviewButton.dataset.additionalPaymentReview = "true";
            reviewButton.innerHTML = `
                <i class="bi bi-wallet2"></i>
                مراجعة الدفعة الإضافية
                <strong>${Number(payment.amount || 0).toLocaleString("ar-YE")} ر.ي</strong>`;
            reviewButton.title =
                "افتح الدفعة لمشاهدة الإثبات ثم اعتمادها أو رفضها.";
            reviewButton.addEventListener(
                "click",
                () => reviewAdditionalPayment(bookingId, payment));

            actions.appendChild(reviewButton);

            const actionNotice =
                document.getElementById("modalActionNotice");

            if (actionNotice) {
                actionNotice.style.display = "flex";
                actionNotice.innerHTML = `
                    <i class="bi bi-exclamation-circle"></i>
                    <span>يوجد دفع إضافي بقيمة <strong>${Number(payment.amount || 0).toLocaleString("ar-YE")} ر.ي</strong> قيد المراجعة. راجعه أولًا قبل أي إجراء آخر على الحجز.</span>`;
            }
        } catch {
            // لا نؤثر على إجراءات الحجز الأصلية عند فشل الامتداد.
        }
    }

    async function syncExtensions(button) {
        const actions = document.querySelector("#modalActionButtons");
        if (!actions || !button) return;

        const syncGeneration = ++additionalPaymentSyncGeneration;

        restoreNormalBookingActions(actions);

        actions
            .querySelectorAll(".reservation-payment-extension")
            .forEach(item => item.remove());

        addLateCollection(actions, button);
        await addPendingReview(actions, button, syncGeneration);
    }

    document.addEventListener(
        "click",
        event => {
            const button = event.target.closest?.(
                ".compact-details-button");

            if (!button) return;

            lastDetailsButton = button;
            window.setTimeout(() => syncExtensions(button), 200);
            window.setTimeout(() => syncExtensions(button), 650);
        },
        true);

    document.addEventListener("shown.bs.modal", () => {
        if (lastDetailsButton) {
            syncExtensions(lastDetailsButton);
        }
    });
})();
    </script>
}
