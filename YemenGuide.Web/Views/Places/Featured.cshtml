@model IEnumerable<YemenGuide.Core.DTOs.Customer.FeaturedPlaceDto>

@{
    ViewData["Title"] = "الأماكن المميزة";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5" style="direction: rtl;">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-dark">كل الأماكن المميزة</h2>
        <p class="text-muted">استكشفي أفضل الخيارات والوجهات الحصرية الموصى بها في المنصة</p>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var place in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative" style="transition: transform 0.3s;">
                        <div class="position-absolute top-0 start-0 m-3 z-3">
                            <button class="btn btn-light rounded-circle shadow-sm p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-heart text-secondary"></i>
                            </button>
                        </div>

                        <div class="position-relative" style="height: 220px; overflow: hidden;">
                            <img src="@place.MainImage" class="w-100 h-100 object-fit-cover" alt="@place.Name">
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-light text-primary border rounded-pill px-3 py-1 small">@place.CategoryName</span>
                                <div class="text-warning small">
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                </div>
                            </div>

                            <h5 class="card-title fw-bold text-dark text-truncate mb-2">@place.Name</h5>

                            <p class="text-muted small mb-3">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i> @place.CityName - @place.Address
                            </p>

                            <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">تبدأ من</small>
                                    <span class="fw-bold text-primary fs-5">@(string.IsNullOrWhiteSpace(place.DisplayPriceText) ? $"{place.Price:N0} ر.ي" : place.DisplayPriceText)</span>
                                </div>
                                <a href="/Places/Details/@place.PlaceId" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">استكشف</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center my-5">
                <i class="bi bi-exclamation-circle text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-3 fs-5">لا توجد أماكن مميزة مضافة حالياً.</p>
            </div>
        }
    </div>
</div>

<style>
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
    }

    .object-fit-cover {
        object-fit: cover;
    }
</style>