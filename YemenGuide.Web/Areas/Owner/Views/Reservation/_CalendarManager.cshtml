@using System

<div id="ygCalendarManager"
     class="yg-calendar-shell"
     dir="rtl"
     data-calendar-version="v6-mobile-first-luxury">

    <section class="yg-calendar-hero" aria-labelledby="ygCalendarTitle">
        <div class="yg-hero-orb yg-hero-orb--one" aria-hidden="true"></div>
        <div class="yg-hero-orb yg-hero-orb--two" aria-hidden="true"></div>
        <div class="yg-hero-grid" aria-hidden="true"></div>

        <div class="yg-hero-copy">
            <div class="yg-hero-eyebrow">
                <span class="yg-live-dot"></span>
                <span>تشغيل ذكي · توفر مباشر · حجز سريع</span>
            </div>

            <h3 id="ygCalendarTitle" class="yg-hero-title">
                التقويم والحجوزات
                <span class="yg-hero-title-glow">المباشرة</span>
            </h3>

            <p class="yg-hero-description">
                مساحة تشغيل هادئة وواضحة لمتابعة التوفر والحجوزات، وإضافة الحجز المباشر،
                مع تطبيق نفس السياسات والمالية بدون ازدحام أو خطوات مربكة.
            </p>

            <div class="yg-active-place-pill" title="المنشأة المعتمدة من هيدر المالك">
                <span class="yg-active-place-icon">
                    <i class="bi bi-buildings-fill"></i>
                </span>
                <span class="yg-active-place-content">
                    <small>المنشأة الحالية من الهيدر</small>
                    <strong id="ygActivePlaceName">جاري تحميل المنشأة…</strong>
                </span>
                <span class="yg-active-place-state" id="ygActivePlaceCategory">—</span>
            </div>
        </div>

        <div class="yg-hero-visual" aria-hidden="true">
            <div class="yg-hero-calendar-cube">
                <div class="yg-cube-layer yg-cube-layer--back"></div>
                <div class="yg-cube-layer yg-cube-layer--mid"></div>
                <div class="yg-cube-layer yg-cube-layer--front">
                    <span class="yg-cube-month">YEMEN GUIDE</span>
                    <strong class="yg-cube-day" id="ygHeroTodayDay">--</strong>
                    <span class="yg-cube-label">اليوم</span>
                </div>
                <span class="yg-cube-spark yg-cube-spark--one"></span>
                <span class="yg-cube-spark yg-cube-spark--two"></span>
                <span class="yg-cube-spark yg-cube-spark--three"></span>
            </div>
        </div>
    </section>

    <section class="yg-calendar-commandbar" aria-label="أوامر التقويم">
        <div class="yg-command-group yg-command-group--primary">
            <button type="button" class="yg-command-btn yg-command-btn--primary" id="btnOpenManualBooking">
                <span class="yg-command-icon"><i class="bi bi-calendar2-plus-fill"></i></span>
                <span>
                    <strong>حجز مباشر جديد</strong>
                    <small>هاتف · حضور · واتساب</small>
                </span>
            </button>

            <button type="button" class="yg-command-btn" id="btnCalendarToday">
                <span class="yg-command-icon"><i class="bi bi-crosshair2"></i></span>
                <span>
                    <strong>اليوم</strong>
                    <small>العودة للتاريخ الحالي</small>
                </span>
            </button>
        </div>

        <div class="yg-command-group">
            <button type="button" class="yg-command-btn yg-command-btn--danger-soft" id="btnCloseCalendarRange">
                <span class="yg-command-icon"><i class="bi bi-calendar2-x-fill"></i></span>
                <span>
                    <strong>إغلاق فترة</strong>
                    <small>منع حجوزات جديدة</small>
                </span>
            </button>

            <button type="button" class="yg-command-btn yg-command-btn--success-soft" id="btnReopenCalendarRange">
                <span class="yg-command-icon"><i class="bi bi-calendar2-check-fill"></i></span>
                <span>
                    <strong>إعادة فتح</strong>
                    <small>إزالة إغلاق استثنائي</small>
                </span>
            </button>

            <button type="button" class="yg-icon-btn" id="btnSyncCalendar" title="تحديث التقويم" aria-label="تحديث التقويم">
                <i class="bi bi-arrow-repeat"></i>
            </button>
        </div>
    </section>
    <section class="yg-calendar-metrics" id="ygCalendarKpis" aria-label="ملخص تشغيل التقويم">
        <div class="yg-metric-grid">
            <article class="yg-metric-card yg-metric-card--bookings">
                <span class="yg-metric-icon"><i class="bi bi-journal-check"></i></span>
                <div><small>حجوزات الفترة</small><strong id="ygKpiTotal">0</strong></div>
            </article>

            <article class="yg-metric-card yg-metric-card--confirmed">
                <span class="yg-metric-icon"><i class="bi bi-patch-check-fill"></i></span>
                <div><small>مؤكد</small><strong id="ygKpiConfirmed">0</strong></div>
            </article>

            <article class="yg-metric-card yg-metric-card--awaiting">
                <span class="yg-metric-icon"><i class="bi bi-hourglass-split"></i></span>
                <div><small>انتظار دفع / مراجعة</small><strong id="ygKpiAwaiting">0</strong></div>
            </article>

            <article class="yg-metric-card yg-metric-card--occupied">
                <span class="yg-metric-icon"><i class="bi bi-door-closed-fill"></i></span>
                <div><small>مشغول اليوم</small><strong id="ygKpiOccupied">0</strong></div>
            </article>

            <article class="yg-metric-card yg-metric-card--available">
                <span class="yg-metric-icon"><i class="bi bi-door-open-fill"></i></span>
                <div><small>متاح اليوم</small><strong id="ygKpiAvailable">0</strong></div>
            </article>

            <article class="yg-metric-card yg-metric-card--occupancy">
                <span class="yg-metric-icon"><i class="bi bi-speedometer2"></i></span>
                <div><small>إشغال اليوم</small><strong id="ygKpiOccupancy">0%</strong></div>
            </article>
        </div>

        <div class="yg-metric-meta" aria-label="مؤشرات إضافية">
            <span><i class="bi bi-telephone-inbound-fill"></i> مباشر <b id="ygKpiManual">0</b></span>
            <span><i class="bi bi-globe2"></i> أونلاين <b id="ygKpiOnline">0</b></span>
            <span><i class="bi bi-lock-fill"></i> أيام مغلقة <b id="ygKpiClosed">0</b></span>
        </div>
    </section>

<section class="yg-policy-strip" id="ygPolicyStrip" aria-label="طبقة السياسات">
        <div class="yg-policy-strip-title">
            <span><i class="bi bi-shield-check"></i></span>
            <div>
                <strong>السياسات التشغيلية المطبقة تلقائيًا</strong>
                <small>هذه القواعد تُفحص على الخادم قبل تثبيت أي حجز مباشر.</small>
            </div>
        </div>
        <div class="yg-policy-chips">
            <span class="yg-policy-chip"><i class="bi bi-clock"></i> دخول <b id="ygPolicyCheckIn">--</b></span>
            <span class="yg-policy-chip"><i class="bi bi-clock-history"></i> خروج <b id="ygPolicyCheckOut">--</b></span>
            <span class="yg-policy-chip"><i class="bi bi-alarm"></i> إشعار مسبق <b id="ygPolicyNotice">0 س</b></span>
            <span class="yg-policy-chip"><i class="bi bi-hourglass"></i> تجهيز <b id="ygPolicyBuffer">0 س</b></span>
            <span class="yg-policy-chip"><i class="bi bi-calendar-range"></i> أفق الحجز <b id="ygPolicyHorizon">غير محدد</b></span>
        </div>
    </section>

    <section class="yg-calendar-main-card">
        <div class="yg-calendar-card-head">
            <div class="yg-calendar-heading">
                <span class="yg-section-kicker">LIVE AVAILABILITY</span>
                <h4><i class="bi bi-calendar3-week-fill"></i> التقويم والتوفر الحقيقي</h4>
                <p>عرض هادئ وواضح للتوفر؛ اضغط على اليوم لعرض الحجوزات أو إنشاء حجز مباشر.</p>
            </div>

            <div class="yg-calendar-legend" aria-label="دليل حالات التقويم">
                <span class="yg-legend-chip yg-legend-chip--confirmed"><i class="bi bi-patch-check-fill"></i><b>مؤكد</b></span>
                <span class="yg-legend-chip yg-legend-chip--awaiting"><i class="bi bi-hourglass-split"></i><b>انتظار عربون</b></span>
                <span class="yg-legend-chip yg-legend-chip--review"><i class="bi bi-receipt-cutoff"></i><b>مراجعة دفع</b></span>
                <span class="yg-legend-chip yg-legend-chip--pending"><i class="bi bi-calendar2-event"></i><b>طلب جديد</b></span>
                <span class="yg-legend-chip yg-legend-chip--completed"><i class="bi bi-check2-all"></i><b>مكتمل</b></span>
                <span class="yg-legend-chip yg-legend-chip--noshow"><i class="bi bi-person-x-fill"></i><b>عدم حضور</b></span>
                <span class="yg-legend-chip yg-legend-chip--cancelled"><i class="bi bi-x-circle-fill"></i><b>ملغي/مرفوض</b></span>
                <span class="yg-legend-chip yg-legend-chip--expired"><i class="bi bi-clock-history"></i><b>انتهت المهلة</b></span>
                <span class="yg-legend-chip yg-legend-chip--online"><i class="bi bi-globe2"></i><b>أونلاين</b></span>
                <span class="yg-legend-chip yg-legend-chip--manual"><i class="bi bi-telephone-inbound-fill"></i><b>مباشر</b></span>
                <span class="yg-legend-chip yg-legend-chip--closed"><i class="bi bi-lock-fill"></i><b>مغلق</b></span>
            </div>
        </div>

        <div class="yg-calendar-scope-filter" role="group" aria-label="فلترة حالات الحجوزات">
            <span class="yg-calendar-scope-filter__label"><i class="bi bi-funnel-fill"></i> عرض الحجوزات</span>
            <button type="button" class="is-active" data-calendar-scope="active" aria-pressed="true">
                <i class="bi bi-lightning-charge-fill"></i><span>النشطة</span>
            </button>
            <button type="button" data-calendar-scope="history" aria-pressed="false">
                <i class="bi bi-clock-history"></i><span>التاريخية</span>
            </button>
            <button type="button" data-calendar-scope="all" aria-pressed="false">
                <i class="bi bi-layers-fill"></i><span>الكل</span>
            </button>
        </div>

        <div class="yg-calendar-toolbar" aria-label="التنقل في التقويم">
            <div class="yg-calendar-nav">
                <button type="button" id="ygCalendarPrev" class="yg-cal-icon-btn" aria-label="السابق"><i class="bi bi-chevron-right"></i></button>
                <button type="button" id="ygCalendarNext" class="yg-cal-icon-btn" aria-label="التالي"><i class="bi bi-chevron-left"></i></button>
                <button type="button" id="ygCalendarTodayInline" class="yg-cal-today-btn"><i class="bi bi-crosshair2"></i><span>اليوم</span></button>
            </div>

            <div class="yg-calendar-period" aria-live="polite">
                <small id="ygCalendarPeriodEyebrow">عرض الشهر</small>
                <strong id="ygCalendarPeriodTitle">—</strong>
                <span id="ygCalendarPeriodSubtitle">اضغط على أي يوم لإدارة حجوزاته</span>
            </div>

            <div class="yg-calendar-view-switch" role="group" aria-label="طريقة عرض التقويم">
                <button type="button" data-calendar-view="dayGridWeek"><i class="bi bi-view-list"></i><span>أسبوع</span></button>
                <button type="button" class="is-active" data-calendar-view="dayGridMonth"><i class="bi bi-grid-3x3-gap-fill"></i><span>شهر</span></button>
                <button type="button" data-calendar-view="multiMonthYear"><i class="bi bi-calendar3"></i><span>سنة</span></button>
            </div>
        </div>

        <div class="yg-calendar-mobile-hint"><i class="bi bi-hand-index-thumb"></i><span>المؤشرات داخل اليوم مختصرة؛ اضغط اليوم لعرض التفاصيل كاملة.</span></div>

        <div class="yg-calendar-loading" id="ygCalendarLoading" hidden>
            <span class="yg-loader-orbit"><i></i><i></i><i></i></span>
            <strong>نحدّث التوفر من قاعدة البيانات…</strong>
        </div>

        <!-- Mobile-first calendar: تجربة مستقلة للهاتف بدل تصغير جدول الكمبيوتر. -->
        <section class="yg-mobile-calendar" id="ygMobileCalendar" aria-label="تقويم الهاتف">
            <div class="yg-mobile-calendar__top">
                <button type="button" class="yg-mobile-nav" id="ygMobilePrev" aria-label="الشهر السابق">
                    <i class="bi bi-chevron-right"></i>
                </button>

                <button type="button" class="yg-mobile-month-title" id="ygMobileMonthPickerBtn" aria-label="اختيار شهر">
                    <small id="ygMobileModeLabel">عرض الشهر</small>
                    <strong id="ygMobileMonthLabel">—</strong>
                    <i class="bi bi-chevron-down"></i>
                </button>

                <button type="button" class="yg-mobile-nav" id="ygMobileNext" aria-label="الشهر التالي">
                    <i class="bi bi-chevron-left"></i>
                </button>
            </div>

            <div class="yg-mobile-view-switch" role="group" aria-label="التنقل وطريقة عرض تقويم الهاتف">
                <button type="button" class="yg-mobile-today-action" id="ygMobileToday" data-mobile-calendar-action="today" aria-label="العودة إلى اليوم الحالي">
                    <i class="bi bi-crosshair2"></i><span>اليوم</span>
                </button>
                <button type="button" data-mobile-calendar-view="week"><i class="bi bi-view-list"></i><span>أسبوع</span></button>
                <button type="button" class="is-active" data-mobile-calendar-view="month"><i class="bi bi-grid-3x3-gap-fill"></i><span>شهر</span></button>
                <button type="button" data-mobile-calendar-view="year"><i class="bi bi-calendar3"></i><span>سنة</span></button>
            </div>

            <div class="yg-mobile-weekdays" aria-hidden="true">
                <span>سبت</span><span>أحد</span><span>اثن</span><span>ثلا</span><span>أرب</span><span>خمس</span><span>جمع</span>
            </div>

            <div class="yg-mobile-month-grid" id="ygMobileMonthGrid"></div>

            <div class="yg-mobile-agenda" id="ygMobileAgenda">
                <div class="yg-mobile-agenda__empty">
                    <span class="yg-mobile-agenda__icon"><i class="bi bi-hand-index-thumb"></i></span>
                    <div>
                        <strong>اختر يومًا</strong>
                        <small>ستظهر حجوزاته والتوفر هنا بدون مغادرة التقويم.</small>
                    </div>
                </div>
            </div>
        </section>

        <div id="premiumCalendar" class="premium-calendar-wrapper" aria-live="polite"></div>
    </section>

    <!-- ================================================================
         Day Details Sheet
         ================================================================ -->
    <div class="yg-overlay" id="ygDayOverlay" hidden></div>
    <aside class="yg-sheet yg-day-sheet" id="ygDaySheet" aria-hidden="true" aria-labelledby="ygDaySheetTitle">
        <div class="yg-sheet-handle" aria-hidden="true"></div>
        <header class="yg-sheet-header">
            <div>
                <span class="yg-sheet-kicker">تفاصيل اليوم</span>
                <h4 id="ygDaySheetTitle">--</h4>
                <p id="ygDaySheetSubtitle">جاري تحميل الحالة…</p>
            </div>
            <button type="button" class="yg-sheet-close" data-yg-close="day" aria-label="إغلاق">
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        <div class="yg-day-glance" id="ygDayGlance">
            <div><span>الحجوزات</span><strong id="ygDayBookingsCount">0</strong></div>
            <div><span>المشغول</span><strong id="ygDayOccupied">0</strong></div>
            <div><span>المتاح</span><strong id="ygDayAvailable">0</strong></div>
            <div><span>الإشغال</span><strong id="ygDayOccupancy">0%</strong></div>
        </div>

        <div class="yg-day-state-banner" id="ygDayStateBanner" hidden></div>

        <div class="yg-day-actions">
            <button type="button" class="yg-sheet-action yg-sheet-action--primary" id="ygDayCreateManual">
                <i class="bi bi-plus-circle-fill"></i><span>إضافة حجز مباشر</span>
            </button>
            <button type="button" class="yg-sheet-action" id="ygDayClose">
                <i class="bi bi-lock-fill"></i><span>إغلاق اليوم</span>
            </button>
            <button type="button" class="yg-sheet-action" id="ygDayReopen">
                <i class="bi bi-unlock-fill"></i><span>إعادة فتح</span>
            </button>
        </div>

        <div class="yg-day-bookings-head">
            <div>
                <strong>حجوزات اليوم</strong>
                <small>تتغير القائمة حسب فلتر الحالات أعلى التقويم</small>
            </div>
            <span class="yg-count-pill" id="ygDayListCount">0</span>
        </div>

        <div class="yg-day-bookings-list" id="ygDayBookingsList">
            <div class="yg-empty-state">
                <i class="bi bi-calendar2-heart"></i>
                <strong>اختر يومًا من التقويم</strong>
                <span>ستظهر هنا الحجوزات والتوفر.</span>
            </div>
        </div>
    </aside>

    <!-- ================================================================
         Manual Booking Studio — V9
         ================================================================ -->
    <div class="yg-overlay yg-overlay--deep" id="ygManualOverlay" hidden></div>
    <section class="yg-manual-studio yg-manual-studio--v8 yg-manual-studio--v9"
             id="ygManualBookingModal"
             aria-hidden="true"
             aria-labelledby="ygManualTitle"
             role="dialog"
             aria-modal="true"
             data-current-step="1">

        <header class="yg-mb9-head">
            <div class="yg-mb9-title-wrap">
                <span class="yg-mb9-title-icon"><i class="bi bi-calendar2-plus"></i></span>
                <div>
                    <span class="yg-mb9-kicker">حجز مباشر</span>
                    <h3 id="ygManualTitle">إضافة حجز مباشر</h3>
                    <p>حجز واحد مرتب خطوة بخطوة، حسب المنشأة المحددة من الهيدر.</p>
                </div>
            </div>

            <div class="yg-mb9-facility-pill">
                <i class="bi bi-buildings"></i>
                <span>
                    <small>المنشأة الحالية</small>
                    <strong id="ygManualFacilityName">المنشأة الحالية</strong>
                    <em id="ygManualFacilityTemplate">قالب الحجز</em>
                </span>
            </div>

            <button type="button" class="yg-mb9-close" data-yg-close="manual" aria-label="إغلاق">
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        <nav class="yg-mb9-stepper" aria-label="خطوات الحجز المباشر">
            <button type="button" class="is-active" data-yg-step-target="1" aria-current="step">
                <span class="yg-mb9-step-no">01</span>
                <span class="yg-mb9-step-icon"><i class="bi bi-person-vcard"></i></span>
                <span class="yg-mb9-step-text"><strong>العميل</strong><small>بيانات صاحب الحجز</small></span>
            </button>
            <button type="button" data-yg-step-target="2">
                <span class="yg-mb9-step-no">02</span>
                <span class="yg-mb9-step-icon"><i class="bi bi-calendar2-check"></i></span>
                <span class="yg-mb9-step-text"><strong>الحجز والتوفر</strong><small>الموعد والوحدة</small></span>
            </button>
            <button type="button" data-yg-step-target="3">
                <span class="yg-mb9-step-no">03</span>
                <span class="yg-mb9-step-icon"><i class="bi bi-stars"></i></span>
                <span class="yg-mb9-step-text"><strong>الإضافات والدفع</strong><small>الخدمات والعربون</small></span>
            </button>
            <button type="button" data-yg-step-target="4">
                <span class="yg-mb9-step-no">04</span>
                <span class="yg-mb9-step-icon"><i class="bi bi-shield-check"></i></span>
                <span class="yg-mb9-step-text"><strong>المراجعة</strong><small>فحص وتثبيت</small></span>
            </button>
        </nav>

        <div class="yg-mobile-step-caption" aria-live="polite">
            <div>
                <small id="ygMobileStepCounter">الخطوة 1 من 4</small>
                <strong id="ygMobileStepTitle">بيانات العميل</strong>
            </div>
            <span class="yg-mobile-step-progress"><i id="ygMobileStepProgress"></i></span>
        </div>

        <div class="yg-v8-form-alert yg-mb9-form-alert" id="ygManualFormAlert" hidden aria-live="polite">
            <i class="bi bi-exclamation-circle"></i>
            <span id="ygManualFormAlertText"></span>
        </div>

        <!-- يحفظ مراجع القالب التي يستخدمها JavaScript بدون إظهار قسم زائد للمستخدم -->
        <div id="ygManualTemplateBanner" hidden>
            <span id="ygManualTemplateIcon"></span>
            <strong id="ygManualTemplateName"></strong>
            <em id="ygManualTemplateCategory"></em>
        </div>

        <div class="yg-studio-body yg-v8-studio-body yg-mb9-body">
            <div class="yg-studio-form-column yg-v8-form-column yg-mb9-form-column">

                <!-- STEP 1 -->
                <section class="yg-form-section yg-v8-step-panel yg-mb9-step-panel is-active-step" data-yg-step="1">
                    <div class="yg-mb9-section-head">
                        <div class="yg-mb9-section-title">
                            <span><i class="bi bi-person-vcard"></i></span>
                            <div>
                                <small>01 · العميل</small>
                                <h5>من صاحب الحجز؟</h5>
                                <p>ابحث برقم الهاتف، وإذا لم يكن لديه حساب أكمل بيانات الضيف فقط.</p>
                            </div>
                        </div>
                    </div>

                    <div class="yg-mb9-search-card">
                        <div class="yg-v8-field yg-mb9-field" data-yg-field="phoneSearch">
                            <label for="ygManualPhoneSearch">رقم هاتف العميل</label>
                            <div class="yg-v8-input-shell yg-v8-input-shell--phone yg-mb9-input-shell">
                                <i class="bi bi-telephone"></i>
                                <input type="tel" id="ygManualPhoneSearch" class="yg-phone-input" autocomplete="tel" inputmode="tel" maxlength="18" dir="ltr" placeholder="777 123 456" />
                                <span class="yg-inline-loader" id="ygCustomerSearchLoader" hidden></span>
                            </div>
                            <small class="yg-field-feedback" id="ygPhoneSearchFeedback" aria-live="polite"></small>
                            <small class="yg-v8-field-error" data-yg-error="phoneSearch"></small>
                        </div>
                        <button type="button" class="yg-mb9-search-btn" id="ygSearchCustomerBtn"><i class="bi bi-search"></i><span>بحث</span></button>
                    </div>

                    <input type="hidden" id="ygManualCustomerId" />

