@using System.Linq
@using System.Text.Json
@model YemenGuide.Core.DTOs.Owner.OwnerDashboardDto
@{
    ViewData["Title"] = "لوحة التحكم";

    var isAdminPlaceAccount =
        (ViewData["IsAdministrationOwnedPlace"] is bool isAdminOwned && isAdminOwned) ||
        User.IsInRole("Admin");

    string Money(decimal value) => value.ToString("N0");
    string Number(long value) => value.ToString("N0");
    string Initial(string? value) => string.IsNullOrWhiteSpace(value) ? "؟" : value.Trim().Substring(0, 1);

    var attentionCount = Model.AttentionItems.Sum(item => item.Count);
    var todayBookings = Model.TodayOperation.Bookings.Take(4).ToList();
    var latestReviews = Model.Reviews.LatestReviews.Take(2).ToList();

    var dashboardJson = JsonSerializer.Serialize(
        new
        {
            bookingTrend = Model.BookingTrend,
            finance = Model.Finance,
            guarantee = Model.Guarantee,
            reviews = Model.Reviews,
            calendarEvents = Model.CalendarEvents,
            currency = Model.Currency,
            ownerName = Model.OwnerName,
            placeName = Model.PlaceName,
            kpis = Model.Kpis,
            bookingSummary = Model.BookingSummary,
            marketing = Model.Marketing,
            todayOperation = Model.TodayOperation,
            attentionCount,
            trialStatus = Model.TrialStatus
        },
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });
}

@section Styles {
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/owner/dashboard-owner.css" asp-append-version="true" />
}

<div class="owner-dashboard-page odc-dashboard"
     data-owner-dashboard
     data-place-id="@(Model.PlaceId?.ToString() ?? string.Empty)">

    @if (!Model.HasPlace)
    {
        <section class="odc-empty" aria-labelledby="odcEmptyTitle">
            <span class="odc-empty__icon"><i class="bi bi-buildings"></i></span>
            <div>
                <span class="odc-eyebrow">ابدأ من هنا</span>
                <h1 id="odcEmptyTitle">أضف منشأتك الأولى</h1>
                <p>بعد إضافة المنشأة ستظهر لك الحجوزات، التشغيل، المالية والتقييمات في لوحة واحدة مختصرة.</p>
            </div>
            <a class="odc-btn odc-btn--primary"
               href="@(isAdminPlaceAccount ? "/Admin/Places/PlaceManagement" : "/Owner/Place/ManagePlaces?placeTab=add-place-tab")">
                <i class="bi bi-building-add"></i>
                @(isAdminPlaceAccount ? "العودة إلى إدارة المنشآت" : "إضافة منشأة")
            </a>
        </section>
    }
    else
    {
        <header class="odc-hero">
            <div class="odc-hero__copy">
                <span class="odc-eyebrow"><i class="bi bi-speedometer2"></i> ملخص المنشأة</span>
                <h1><span data-live-greeting>أهلًا</span> @Model.OwnerName</h1>
                <p>أهم ما تحتاجه اليوم في <strong>@Model.PlaceName</strong> بدون تفاصيل زائدة.</p>

                <div class="odc-place-meta">
                    <span><i class="bi bi-building"></i>@Model.PlaceName</span>
                    @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
                    {
                        <span><i class="bi bi-grid"></i>@Model.CategoryName</span>
                    }
                    <span class="odc-status @(Model.IsPlaceAvailable ? "is-active" : "is-paused")">
                        <i></i>@Model.PlaceStatusLabel
                    </span>
                    <span><i class="bi bi-clock"></i>تحديث @Model.GeneratedAt.ToString("HH:mm")</span>
                </div>
            </div>

            <nav class="odc-quick-actions" aria-label="إجراءات سريعة">
                <a href="/Owner/Reservation/ManageReservations">
                    <i class="bi bi-calendar-check"></i>
                    <span>الحجوزات</span>
                </a>
                <a href="/Owner/Advertisements/AdvertisementManagement">
                    <i class="bi bi-megaphone"></i>
                    <span>الإعلانات</span>
                </a>
                <a href="/Owner/Financials?financeTab=overview&placeId=@Model.PlaceId">
                    <i class="bi bi-wallet2"></i>
                    <span>المالية</span>
                </a>
            </nav>
        </header>

        @if (!isAdminPlaceAccount &&
             Model.TrialStatus.HasTrialHistory &&
             Model.TrialStatus.StartedAt.HasValue &&
             Model.TrialStatus.EndsAt.HasValue &&
             (Model.TrialStatus.IsActive || Model.TrialStatus.IsExpired))
        {
            var trial = Model.TrialStatus;
            var trialBalanceUrl = Url.Action(
                "ManageOwnerFinancials",
                "OwnerFinancials",
                new { area = "Owner", financeTab = "balance", placeId = Model.PlaceId })
                ?? $"/Owner/Financials?financeTab=balance&placeId={Model.PlaceId}";

            var trialTone = trial.IsExpired
                ? (trial.NeedsTopUp ? "is-danger" : "is-success")
                : trial.IsEndingSoon
                    ? "is-warning"
                    : "is-info";

            <section class="odc-trial @trialTone"
                     data-trial-status
                     data-trial-active="@(trial.IsActive ? "true" : "false")"
                     data-trial-expired="@(trial.IsExpired ? "true" : "false")"
                     data-trial-ending-soon="@(trial.IsEndingSoon ? "true" : "false")"
                     data-trial-remaining-days="@trial.RemainingTrialDays"
                     data-trial-ends-at="@trial.EndsAt.Value.ToString("yyyy-MM-ddTHH:mm:ss")"
                     data-trial-reminder-key="@trial.ReminderKey"
                     data-trial-needs-topup="@(trial.NeedsTopUp ? "true" : "false")"
                     data-trial-missing="@trial.MissingGuaranteeBalance.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                     data-trial-currency="@trial.Currency"
                     data-trial-balance-url="@trialBalanceUrl">
                <span class="odc-trial__icon"><i class="bi @(trial.IsExpired ? "bi-hourglass-bottom" : "bi-gift")"></i></span>
                <div class="odc-trial__copy">
                    @if (trial.IsActive)
                    {
                        <strong>الفترة التجريبية: متبقي @trial.RemainingTrialDays @(trial.RemainingTrialDays == 1 ? "يوم" : "أيام")</strong>
                        <small>تنتهي في @trial.EndsAt.Value.ToString("dd MMMM yyyy")</small>
                    }
                    else if (trial.NeedsTopUp && !trial.CanAcceptNewBookings)
                    {
                        <strong>الحجوزات الجديدة متوقفة مؤقتًا</strong>
                        <small>ينقص رصيد الضمان @trial.MissingGuaranteeBalance.ToString("N0") @trial.Currency</small>
                    }
                    else
                    {
                        <strong>الحساب التشغيلي جاهز</strong>
                        <small>رصيد الضمان مستوفٍ ولا يوجد إجراء مطلوب.</small>
                    }
                </div>
                @if (trial.IsActive)
                {
                    <div class="odc-trial__countdown" data-trial-countdown>
                        <span>الوقت المتبقي</span>
                        <strong>جارٍ الحساب...</strong>
                    </div>
                }
                <a href="@trialBalanceUrl">@(trial.NeedsTopUp ? "شحن الرصيد" : "تفاصيل الرصيد") <i class="bi bi-arrow-left"></i></a>
            </section>
        }

        <section class="odc-kpis" aria-label="أهم مؤشرات المنشأة">
            <article class="odc-kpi">
                <span class="odc-kpi__icon is-cyan"><i class="bi bi-calendar-plus"></i></span>
                <div><small>حجوزات جديدة اليوم</small><strong data-counter-value="@Model.Kpis.NewBookingsToday">@Model.Kpis.NewBookingsToday.ToString("N0")</strong></div>
            </article>

            <article class="odc-kpi">
                <span class="odc-kpi__icon is-blue"><i class="bi bi-broadcast"></i></span>
                <div><small>نشط الآن</small><strong data-counter-value="@Model.TodayOperation.ActiveNow">@Model.TodayOperation.ActiveNow.ToString("N0")</strong></div>
            </article>

            <article class="odc-kpi">
                <span class="odc-kpi__icon is-green"><i class="bi bi-cash-stack"></i></span>
                <div>
                    <small>إيراد الشهر</small>
                    <strong>@Money(Model.Kpis.MonthlyRevenue)</strong>
                    <em>@Model.Currency · @(Model.Kpis.RevenueChangePercent >= 0 ? "+" : "")@Model.Kpis.RevenueChangePercent.ToString("0.#")%</em>
                </div>
            </article>

            <article class="odc-kpi">
                <span class="odc-kpi__icon is-orange"><i class="bi bi-star-fill"></i></span>
                <div><small>رضا العملاء</small><strong>@Model.Kpis.AverageRating.ToString("0.0")</strong><em>@Model.Kpis.ReviewsCount تقييم</em></div>
            </article>
        </section>

        <section class="odc-grid odc-grid--top">
            <article class="odc-card odc-card--chart">
                <header class="odc-card__head">
                    <div>
                        <span class="odc-eyebrow">اتجاه الحجوزات</span>
                        <h2>أداء آخر 30 يومًا</h2>
                    </div>
                    <div class="odc-range-switch" role="group" aria-label="نطاق الرسم">
                        <button type="button" data-booking-range="7">7 أيام</button>
                        <button type="button" data-booking-range="14">14 يوم</button>
                        <button type="button" class="is-active" data-booking-range="30">30 يوم</button>
                    </div>
                </header>

                <div class="odc-chart" id="ownerBookingChart" aria-label="رسم أداء الحجوزات"></div>

                <div class="odc-summary-chips">
                    <span><small>إجمالي الشهر</small><b>@Model.BookingSummary.TotalThisMonth</b></span>
                    <span><small>مؤكدة</small><b>@Model.BookingSummary.Confirmed</b></span>
                    <span><small>مكتملة</small><b>@Model.BookingSummary.Completed</b></span>
                    <span><small>الإلغاء</small><b>@Model.BookingSummary.CancellationRate.ToString("0.#")%</b></span>
                </div>
            </article>

            <aside class="odc-card odc-card--attention">
                <header class="odc-card__head">
                    <div>
                        <span class="odc-eyebrow">الأولوية الآن</span>
                        <h2>يحتاج انتباهك</h2>
                    </div>
                    <span class="odc-count @(attentionCount > 0 ? "has-items" : "")">@attentionCount</span>
                </header>

                @if (Model.AttentionItems.Count == 0)
                {
                    <div class="odc-all-good">
                        <span><i class="bi bi-check2-circle"></i></span>
                        <div><strong>كل شيء تحت السيطرة</strong><small>لا توجد إجراءات عاجلة الآن.</small></div>
                    </div>
                }
                else
                {
                    <div class="odc-attention-list">
                        @foreach (var item in Model.AttentionItems.Take(4))
                        {
                            <a class="odc-attention-item is-@item.Tone" href="@item.Url">
                                <span><i class="bi @item.Icon"></i></span>
                                <div><strong>@item.Title</strong><small>@item.Description</small></div>
                                <b>@item.Count</b>
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        }
                    </div>
                }
            </aside>
        </section>

        <section class="odc-grid odc-grid--middle">
            <article class="odc-card">
                <header class="odc-card__head">
                    <div>
                        <span class="odc-eyebrow">تشغيل اليوم</span>
                        <h2>@DateTime.Now.ToString("dddd، dd MMMM")</h2>
                    </div>
                    <a class="odc-link" href="/Owner/Reservation/ManageReservations">كل الحجوزات <i class="bi bi-arrow-left"></i></a>
                </header>

                <div class="odc-operation-strip">
                    <span><i class="bi bi-box-arrow-in-down-left"></i><small>وصول</small><b>@Model.TodayOperation.ArrivalsToday</b></span>
                    <span><i class="bi bi-broadcast"></i><small>نشطة</small><b>@Model.TodayOperation.ActiveNow</b></span>
                    <span><i class="bi bi-box-arrow-up-right"></i><small>مغادرة</small><b>@Model.TodayOperation.DeparturesToday</b></span>
                    @if (Model.TodayOperation.HasRoomUnits)
                    {
                        <span><i class="bi bi-door-open"></i><small>متاحة</small><b>@Model.TodayOperation.AvailableRoomUnits</b></span>
                    }
                </div>

                <div class="odc-booking-list">
                    @if (todayBookings.Count == 0)
                    {
                        <div class="odc-empty-inline"><i class="bi bi-calendar2-check"></i><span>لا توجد حركة حجز لهذا اليوم.</span></div>
                    }
                    else
                    {
                        @foreach (var booking in todayBookings)
                        {
                            <a class="odc-booking-row" href="@booking.Url">
                                <span class="odc-avatar">@Initial(booking.CustomerName)</span>
                                <div><strong>@booking.CustomerName</strong><small>#@booking.BookingId · @booking.ResourceName</small></div>
                                <span class="odc-mini-state">@booking.BookingStateLabel</span>
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        }
                    }
                </div>
            </article>

            <article class="odc-card">
                <header class="odc-card__head">
                    <div>
                        <span class="odc-eyebrow">المالية</span>
                        <h2>ملخص هذا الشهر</h2>
                    </div>
                    <a class="odc-link" href="/Owner/Financials?financeTab=overview&placeId=@Model.PlaceId">التفاصيل <i class="bi bi-arrow-left"></i></a>
                </header>

                <div class="odc-finance-main">
                    <div>
                        <small>صافي المحصل</small>
                        <strong>@Money(Model.Finance.NetCollectedRevenue)</strong>
                        <span>@Model.Currency</span>
                    </div>
                    <span class="odc-finance-main__icon"><i class="bi bi-wallet2"></i></span>
                </div>

                <div class="odc-finance-grid">
                    <span><small>قيمة الحجوزات</small><b>@Money(Model.Finance.GrossBookingValue)</b></span>
                    <span><small>مدفوع إلكترونيًا</small><b>@Money(Model.Finance.PaidOnline)</b></span>
                    <span><small>محصل في المنشأة</small><b>@Money(Model.Finance.CollectedAtProperty)</b></span>
                    <span><small>مستردات</small><b class="is-danger">-@Money(Model.Finance.RefundedAmount)</b></span>
                </div>

                @if (!isAdminPlaceAccount)
                {
                    <a class="odc-guarantee" href="/Owner/Financials?financeTab=balance&placeId=@Model.PlaceId">
                        <span><i class="bi bi-shield-check"></i></span>
                        <div>
                            <small>رصيد ضمان العمولات</small>
                            <strong>@Money(Model.Guarantee.AvailableBalance) @Model.Currency</strong>
                        </div>
                        <em>@Model.Guarantee.AccountStatusLabel</em>
                        <i class="bi bi-chevron-left"></i>
                    </a>
                }
                else
                {
                    <div class="odc-guarantee is-admin">
                        <span><i class="bi bi-shield-check"></i></span>
                        <div><small>ضمان العمولة</small><strong>غير مطلوب للمنشأة الإدارية</strong></div>
                        <em>معفاة</em>
                    </div>
                }
            </article>
        </section>

        <section class="odc-grid odc-grid--bottom">
            <article class="odc-card">
                <header class="odc-card__head">
                    <div>
                        <span class="odc-eyebrow">تجربة العميل</span>
                        <h2>رضا العملاء</h2>
                    </div>
                    <a class="odc-link" href="/Owner/Chat/ChatInterface?communicationTab=reviews">كل التقييمات <i class="bi bi-arrow-left"></i></a>
                </header>

                <div class="odc-rating-summary">
                    <strong>@Model.Reviews.AverageRating.ToString("0.0")</strong>
                    <div>
                        <span class="odc-stars" aria-label="التقييم من خمسة"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i></span>
                        <small>@Model.Reviews.TotalReviews تقييم · @Model.Reviews.AwaitingReply تنتظر ردك</small>
                    </div>
                </div>

                <div class="odc-review-list">
                    @if (latestReviews.Count == 0)
                    {
                        <div class="odc-empty-inline"><i class="bi bi-star"></i><span>لا توجد تقييمات حتى الآن.</span></div>
                    }
                    else
                    {
                        @foreach (var review in latestReviews)
                        {
                            <a href="@review.Url" class="odc-review-row">
                                <span class="odc-avatar">@Initial(review.CustomerName)</span>
                                <div>
                                    <span><strong>@review.CustomerName</strong><b>@review.Stars <i class="bi bi-star-fill"></i></b></span>
                                    <p>@(string.IsNullOrWhiteSpace(review.ReviewText) ? "تقييم بدون تعليق نصي." : review.ReviewText)</p>
                                </div>
                                <small class="@(review.HasOwnerReply ? "is-done" : "is-waiting")">@(review.HasOwnerReply ? "تم الرد" : "ينتظر ردك")</small>
                            </a>
                        }
                    }
                </div>
            </article>

            <article class="odc-card">
                <header class="odc-card__head">
                    <div>
                        <span class="odc-eyebrow">التسويق</span>
                        <h2>أداء الوصول</h2>
                    </div>
                    <a class="odc-link" href="/Owner/Advertisements/AdvertisementManagement">الإعلانات <i class="bi bi-arrow-left"></i></a>
                </header>

                <div class="odc-marketing-grid">
                    <span><i class="bi bi-megaphone"></i><small>إعلانات نشطة</small><b>@Model.Marketing.ActiveAdvertisements</b></span>
                    <span><i class="bi bi-eye"></i><small>المشاهدات</small><b>@Number(Model.Marketing.Impressions)</b></span>
                    <span><i class="bi bi-cursor"></i><small>النقرات</small><b>@Number(Model.Marketing.Clicks)</b></span>
                    <span><i class="bi bi-check2-circle"></i><small>التحويلات</small><b>@Number(Model.Marketing.Conversions)</b></span>
                </div>

                <div class="odc-marketing-foot">
                    <span><i class="bi bi-heart-fill"></i> @Model.Marketing.Favorites في المفضلة</span>
                    <span><i class="bi bi-graph-up-arrow"></i> معدل التحويل @Model.Marketing.ConversionRate.ToString("0.##")%</span>
                </div>
            </article>
        </section>
    }
</div>

<script id="ownerDashboardData" type="application/json">@Html.Raw(dashboardJson)</script>

@if (!isAdminPlaceAccount &&
     Model?.TrialWelcome?.ShouldShow == true &&
     Model.TrialWelcome.IsActive &&
     Model.TrialWelcome.StartedAt.HasValue &&
     Model.TrialWelcome.EndsAt.HasValue)
{
    var trial = Model.TrialWelcome;
    var balanceUrl = Url.Action(
        "ManageOwnerFinancials",
        "OwnerFinancials",
        new { area = "Owner", financeTab = "balance", placeId = trial.PlaceId })
        ?? "/Owner/Financials?financeTab=balance";

    <div class="owner-trial-welcome"
         id="ownerTrialWelcome"
         hidden
         aria-hidden="true"
         data-owner-trial-welcome
         data-show-trial-welcome="true"
         data-storage-key="@trial.StorageKey">
        <div class="owner-trial-welcome__backdrop" aria-hidden="true"></div>
        <section class="owner-trial-welcome__dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="ownerTrialWelcomeTitle"
                 tabindex="-1">
            <button type="button" class="owner-trial-welcome__close" data-owner-trial-dismiss aria-label="إغلاق">
                <i class="bi bi-x-lg"></i>
            </button>
            <div class="owner-trial-welcome__hero">
                <div class="owner-trial-welcome__gift"><i class="bi bi-gift-fill"></i></div>
                <div class="owner-trial-welcome__hero-copy">
                    <span class="owner-trial-welcome__eyebrow"><i class="bi bi-stars"></i> انطلاقة مجانية لمنشأتك</span>
                    <h2 id="ownerTrialWelcomeTitle">مرحبًا بك في فترتك التجريبية</h2>
                    <p>تم تفعيل <strong>@trial.PlaceName</strong>. يمكنك استقبال الحجوزات خلال الفترة الحالية بدون عمولة منصة.</p>
                </div>
            </div>
            <div class="owner-trial-welcome__metrics">
                <article class="owner-trial-welcome__metric is-days"><span><i class="bi bi-calendar2-week"></i></span><div><small>مدة التجربة</small><strong>@trial.TotalTrialDays يومًا</strong></div></article>
                <article class="owner-trial-welcome__metric is-commission"><span><i class="bi bi-percent"></i></span><div><small>عمولة المنصة</small><strong>0%</strong></div></article>
                <article class="owner-trial-welcome__metric is-booking"><span><i class="bi bi-calendar2-check"></i></span><div><small>الحجوزات</small><strong>@(trial.CanAcceptNewBookings ? "متاحة" : "قيد التحقق")</strong></div></article>
            </div>
            <div class="owner-trial-welcome__actions">
                <button type="button" class="owner-trial-welcome__primary" data-owner-trial-dismiss><i class="bi bi-check2"></i><span>فهمت</span></button>
                <a class="owner-trial-welcome__secondary" href="@balanceUrl" data-owner-trial-balance><i class="bi bi-wallet2"></i><span>الرصيد والعمولات</span></a>
            </div>
        </section>
    </div>
}

@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.js"></script>
    <script src="~/lib/apexcharts/apexcharts.min.js"></script>
    <script src="~/js/owner/dashboard-owner.js" asp-append-version="true"></script>
}
