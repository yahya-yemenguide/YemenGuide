        ["Admin_Type_Category"] = L["Admin_Type_Category"].Value,
        ["Admin_Type_Place"] = L["Admin_Type_Place"].Value,
        ["Admin_Type_User"] = L["Admin_Type_User"].Value,
    };

    var payload = new
    {
        language,
        locale = language == "en" ? "en-US" : "ar-YE",
        direction = language == "en" ? "ltr" : "rtl",
        exact,
