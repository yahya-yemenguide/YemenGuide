@{
    int systemId = ViewBag.BookingSystemId ?? 0;
    int categoryId = ViewBag.SelectedCategoryId ?? 0;
    string categoryName = ViewBag.CategoryName ?? "المنشأة";
    bool isBookingSystem = systemId > 0;

    // 🌟 استقبال بيانات المالك من الكنترولر للتعبئة التلقائية
    string currentOwnerName = ViewBag.CurrentOwnerName ?? "";
    string currentOwnerPhone = ViewBag.CurrentOwnerPhone ?? "";
}


<div class="place-wizard-workspace" data-wizard-system="@systemId">
    <aside class="place-wizard-sidebar" aria-label="خطوات إضافة المنشأة">
        <div class="place-wizard-sidebar__brand">
            <span class="place-wizard-sidebar__brand-icon" aria-hidden="true">
                <i class="bi bi-building-add"></i>
            </span>
            <div>
                <span class="place-wizard-sidebar__eyebrow">مساحة إعداد المنشأة</span>
                <h4 class="place-wizard-sidebar__title">@categoryName</h4>
                <p class="place-wizard-sidebar__subtitle">أكمل البيانات خطوة بخطوة، ثم أرسلها للإدارة للمراجعة.</p>
            </div>
        </div>

        <ol class="place-wizard-stepper" aria-label="مراحل النموذج">
            <li class="place-wizard-stepper__item" data-step-target="step_owner">
                <span class="place-wizard-stepper__marker" aria-hidden="true"><span>1</span><i class="bi bi-check-lg"></i></span>
                <span class="place-wizard-stepper__copy">
                    <strong>بيانات المسؤول</strong>
                    <small>الاسم والصفة وأرقام التواصل</small>
                </span>
            </li>
            <li class="place-wizard-stepper__item" data-step-target="step_general">
                <span class="place-wizard-stepper__marker" aria-hidden="true"><span>2</span><i class="bi bi-check-lg"></i></span>
                <span class="place-wizard-stepper__copy">
                    <strong>البيانات والموقع</strong>
                    <small>هوية المنشأة والصور والخريطة</small>
                </span>
            </li>

            @if (systemId == 1)
            {
                <li class="place-wizard-stepper__item" data-step-target="step_rooms">
                    <span class="place-wizard-stepper__marker" aria-hidden="true"><span>3</span><i class="bi bi-check-lg"></i></span>
                    <span class="place-wizard-stepper__copy"><strong>أنواع الغرف</strong><small>الأنواع والأسعار والسعات</small></span>
                </li>
                <li class="place-wizard-stepper__item" data-step-target="step_suites">
                    <span class="place-wizard-stepper__marker" aria-hidden="true"><span>4</span><i class="bi bi-check-lg"></i></span>
                    <span class="place-wizard-stepper__copy"><strong>الأجنحة</strong><small>الأجنحة والغرف الداخلية</small></span>
                </li>
                <li class="place-wizard-stepper__item" data-step-target="step_floors">
                    <span class="place-wizard-stepper__marker" aria-hidden="true"><span>5</span><i class="bi bi-check-lg"></i></span>
                    <span class="place-wizard-stepper__copy"><strong>الطوابق والوحدات</strong><small>الأرقام وربط كل وحدة بنوعها</small></span>
                </li>
                <li class="place-wizard-stepper__item" data-step-target="step_facilities">
                    <span class="place-wizard-stepper__marker" aria-hidden="true"><span>6</span><i class="bi bi-check-lg"></i></span>
                    <span class="place-wizard-stepper__copy"><strong>المرافق والوحدات</strong><small>الخدمات والمزايا الإضافية</small></span>
                </li>
            }
            else if (systemId == 2)
            {
                <li class="place-wizard-stepper__item" data-step-target="step_chalet_details">
                    <span class="place-wizard-stepper__marker" aria-hidden="true"><span>3</span><i class="bi bi-check-lg"></i></span>
                    <span class="place-wizard-stepper__copy"><strong>التفاصيل والباقات</strong><small>المبنى والأسعار والسعة</small></span>
                </li>
                <li class="place-wizard-stepper__item" data-step-target="step_chalet_facilities">
                    <span class="place-wizard-stepper__marker" aria-hidden="true"><span>4</span><i class="bi bi-check-lg"></i></span>
                    <span class="place-wizard-stepper__copy"><strong>الخدمات والمرافق</strong><small>الترفيه والتكييف والحوش</small></span>
                </li>
            }
            else if (systemId == 3 || systemId == 4)
            {
                <li class="place-wizard-stepper__item" data-step-target="step_hall_details">
                    <span class="place-wizard-stepper__marker" aria-hidden="true"><span>3</span><i class="bi bi-check-lg"></i></span>
                    <span class="place-wizard-stepper__copy"><strong>القاعة والباقات</strong><small>السعة والمناسبات والأسعار</small></span>
                </li>
                <li class="place-wizard-stepper__item" data-step-target="step_hall_facilities">
                    <span class="place-wizard-stepper__marker" aria-hidden="true"><span>4</span><i class="bi bi-check-lg"></i></span>
                    <span class="place-wizard-stepper__copy"><strong>التجهيزات والمرافق</strong><small>التكييف والصوت والخدمات</small></span>
                </li>
            }
            else
            {
                <li class="place-wizard-stepper__item" data-step-target="step_warnings">
                    <span class="place-wizard-stepper__marker" aria-hidden="true"><span>3</span><i class="bi bi-check-lg"></i></span>
                    <span class="place-wizard-stepper__copy"><strong>الإقرار والإرسال</strong><small>مراجعة شروط النشر والاعتماد</small></span>
                </li>
            }
        </ol>

        <div class="place-wizard-sidebar__assurance">
            <span class="place-wizard-sidebar__assurance-icon" aria-hidden="true"><i class="bi bi-shield-check"></i></span>
            <div><strong>إدخال آمن ومنظّم</strong><small>لن تُعرض المنشأة للعملاء قبل مراجعة الإدارة.</small></div>
        </div>
    </aside>

    <main class="place-wizard-main">
        <div class="place-wizard-mobile-steps" aria-label="خطوات النموذج على الهاتف">
            <div class="place-wizard-mobile-steps__track">
                <span class="place-wizard-mobile-step" data-step-target="step_owner"><b>1</b> المسؤول</span>
                <span class="place-wizard-mobile-step" data-step-target="step_general"><b>2</b> البيانات</span>
                @if (systemId == 1)
                {
                    <span class="place-wizard-mobile-step" data-step-target="step_rooms"><b>3</b> الغرف</span>
                    <span class="place-wizard-mobile-step" data-step-target="step_suites"><b>4</b> الأجنحة</span>
                    <span class="place-wizard-mobile-step" data-step-target="step_floors"><b>5</b> الطوابق</span>
                    <span class="place-wizard-mobile-step" data-step-target="step_facilities"><b>6</b> المرافق</span>
                }
                else if (systemId == 2)
                {
                    <span class="place-wizard-mobile-step" data-step-target="step_chalet_details"><b>3</b> التفاصيل</span>
                    <span class="place-wizard-mobile-step" data-step-target="step_chalet_facilities"><b>4</b> المرافق</span>
                }
                else if (systemId == 3 || systemId == 4)
                {
                    <span class="place-wizard-mobile-step" data-step-target="step_hall_details"><b>3</b> القاعة</span>
                    <span class="place-wizard-mobile-step" data-step-target="step_hall_facilities"><b>4</b> التجهيزات</span>
                }
                else
                {
                    <span class="place-wizard-mobile-step" data-step-target="step_warnings"><b>3</b> الإقرار</span>
                }
            </div>
        </div>

        <header class="place-wizard-hero" aria-label="معلومات الخطوة الحالية">
            <div class="place-wizard-hero__identity">
                <span class="place-wizard-hero__icon" aria-hidden="true">
                    <i class="bi bi-person-vcard" id="wizardCurrentStepIcon"></i>
                </span>
                <div class="place-wizard-hero__copy">
                    <span class="place-wizard-hero__eyebrow" id="wizardStepCounter">الخطوة 1</span>
                    <h4 class="place-wizard-hero__title" id="wizardCurrentStepLabel">بيانات مسؤول المنشأة</h4>
                    <p class="place-wizard-hero__subtitle" id="wizardCurrentStepHint">أدخل بيانات الشخص المسؤول وأرقام التواصل المعتمدة.</p>
                </div>
            </div>

            <div class="place-wizard-hero__progress-summary">
                <span class="place-wizard-hero__progress-value" id="wizardProgressPercent">20%</span>
                <span class="place-wizard-hero__progress-caption">نسبة الإنجاز</span>
            </div>

            <div class="progress place-wizard-progress__track" role="progressbar" aria-label="نسبة إكمال النموذج">
                <div class="progress-bar place-wizard-progress__bar" id="formProgressBar" style="width: 15%;"></div>
            </div>
        </header>

        <div class="place-wizard-content-scroll">
            <form id="fullPlaceSurveyForm" class="place-wizard-form text-start" dir="rtl" enctype="multipart/form-data" novalidate>
                <input type="hidden" name="CategoryId" value="@categoryId" />
                <input type="hidden" id="selectedSystemId" value="@systemId" />

                <!-- حاوية رسائل الخطأ -->
                <div id="wizardErrorContainer" class="wizard-error alert alert-danger d-none fw-bold small mb-4 rounded-3 border-0 shadow-sm" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i> <span id="wizardErrorText"></span></div>

                <!-- ========================================================================= -->
                <!-- 👑 الخطوة 1: معلومات المالك (مع التعبئة التلقائية وحقول الهاتف الدولية) -->
                <!-- ========================================================================= -->
                <div class="step-section wizard-step-card active" id="step_owner">
                    <h6 class="form-section-title"><i class="bi bi-person-vcard"></i> بيانات مسؤول المنشأة</h6>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">اسم المالك / المسؤول <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-person text-primary"></i></span>
                                <input type="text" class="form-control vip-input border-start-0 ps-0" name="OwnerName" value="@currentOwnerName" placeholder="الاسم الرباعي" required>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">المهنة أو الصفة الوظيفية <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-briefcase text-primary"></i></span>
                                <!-- 💡 تمت إزالة onchange من هنا ليعمل من الجافاسكريبت بشكل آمن -->
                                <select class="form-select vip-input border-start-0 ps-0" id="ownerRoleSelect" name="OwnerRole" required onchange="window.toggleCustomRole(this)">
                                    <option value="" disabled selected>-- يرجى اختيار صفتك --</option>
                                    <option value="صاحب المنشأة">صاحب المنشأة (المالك الفعلي)</option>
                                    <option value="المدير التنفيذي">المدير التنفيذي / الإدارة</option>
                                    <option value="other">أخرى (تحديد يدوي)...</option>
                                </select>

                            </div>
                            <!-- حقل الإدخال اليدوي يظهر فقط عند اختيار "أخرى" -->
                            <input type="text" id="customOwnerRoleInput" class="form-control vip-input mt-2 d-none animate-fade-in" placeholder="اكتب صفتك الوظيفية هنا...">
                            <input type="hidden" id="finalOwnerRole" name="FinalOwnerRole">
                        </div>

                        <!-- حقل رقم الهاتف للمالك (نفس بنية البروفايل) -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">رقم هاتف المالك (شخصي) <span class="text-danger">*</span></label>
                            <div class="premium-input-group-phone phone-wrapper-ltr" dir="ltr">
                                <input type="tel" id="ownerPhoneDisplay" class="form-control phone-input-vip w-100" value="@currentOwnerPhone" required>
                                <input type="hidden" name="OwnerPhone" id="ownerPhoneReal">
                            </div>
                            <span id="ownerPhoneMsg" class="small mt-1 text-end d-block fw-bold" dir="rtl"></span>
                        </div>

                        <!-- حقل رقم التواصل للمنشأة (نفس بنية البروفايل) -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">رقم هاتف الحجوزات (المنشأة) <span class="text-danger">*</span></label>
                            <div class="premium-input-group-phone phone-wrapper-ltr" dir="ltr">
                                <input type="tel" id="contactPhoneDisplay" class="form-control phone-input-vip w-100" required>
                                <input type="hidden" name="PhoneNumber" id="contactPhoneReal">
                            </div>
                            <span id="contactPhoneMsg" class="small mt-1 text-end d-block fw-bold" dir="rtl"></span>
                        </div>
                    </div>
                </div>

                <!-- ========================================================================= -->
                <!-- 🗺️ الخطوة 2: معلومات عامة والخريطة المزدوجة الذكية -->
                <!-- ========================================================================= -->
                <div class="step-section wizard-step-card" id="step_general">
                    <h6 class="form-section-title"><i class="bi bi-info-square"></i> الهوية البصرية والموقع لـ @categoryName</h6>
                    <div class="row g-4">
                        <div class="col-md-8">
                            <label class="form-label fw-bold small text-muted">الاسم التجاري للمنشأة <span class="text-danger">*</span></label>
                            <input type="text" class="form-control vip-input" name="Name" placeholder="مثال: فندق كورال عدن" required>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-muted">المدينة الجغرافية <span class="text-danger">*</span></label>
                            <select class="form-select vip-input" name="CityId" required>
                                <option value="" disabled selected>اختر المدينة</option>
                                @if (ViewBag.Cities != null)
                                {
                                    foreach (var city in ViewBag.Cities)
                                    {
                                        <option value="@city.CityId">@city.CityName</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- 🗺️ نظام الخريطة المزدوج VIP -->
                        <div class="col-md-12 mt-4">
                            <div class="vip-map-container">

                                <!-- 1. البانر الإرشادي الأنيق (مع زر مخفي للتعليمات) -->
                                <div class="alert map-instruction-banner p-3 mb-4 shadow-sm" style="background: linear-gradient(135deg, #f0fdfa 0%, #e0f2fe 100%); border-right: 4px solid #0284c7;">

                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="fw-black text-dark mb-0 d-flex align-items-center">
                                            <i class="bi bi-geo-alt-fill fs-4 text-info me-2"></i> تحديد موقع المنشأة
                                        </h6>
                                        <button class="btn btn-sm btn-outline-primary rounded-pill fw-bold px-3 py-1" type="button" data-bs-toggle="collapse" data-bs-target="#googleMapHelp" aria-expanded="false">
                                            <i class="bi bi-question-circle me-1"></i> تعليمات جوجل ماب
                                        </button>
                                    </div>

                                    <p class="small text-muted mb-0 ms-4 ps-2">حرك الدبوس الأحمر على الخريطة، أو أدخل الإحداثيات يدوياً.</p>

                                    <div class="collapse mt-3" id="googleMapHelp">
                                        <div class="bg-white p-3 rounded-3 border">
                                            <ol class="small text-muted mb-0 ps-3" style="line-height: 1.6;">
                                                <li>افتح تطبيق (خرائط جوجل) وابحث عن موقع منشأتك.</li>
                                                <li><strong>اضغط مطولاً</strong> على مكان المبنى حتى يظهر دبوس أحمر.</li>
                                                <li>ستظهر أرقام (مثال: <span dir="ltr" class="badge bg-light text-dark border">15.3694, 44.1910</span>).</li>
                                                <li>الرقم الأيسر هو <strong>خط العرض</strong>، والأيمن هو <strong>خط الطول</strong>.</li>
                                            </ol>
                                        </div>
                                    </div>
                                </div>

                                <!-- حقول الإدخال مع رسائل الخطأ المخصصة -->
                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label class="small fw-bold text-muted mb-1"><i class="bi bi-arrows-collapse text-primary me-1"></i> خط العرض (Latitude)</label>
                                        <input type="text" id="add-lat-display" class="form-control vip-input text-center fw-bold shadow-sm" placeholder="مثال: 15.3694" dir="ltr">

                                        <input type="hidden" id="add-lat" name="Latitude" required>

                                        <div class="form-text small text-muted mt-1"><i class="bi bi-info-circle-fill text-info me-1"></i> في اليمن: يبدأ بـ (12 إلى 19)</div>

                                        <div class="invalid-feedback fw-bold text-end" style="font-size: 0.85rem;">
                                            <i class="bi bi-exclamation-circle-fill me-1"></i> عذراً، خط العرض المدخل خارج حدود الجمهورية اليمنية (12 إلى 19)!
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="small fw-bold text-muted mb-1"><i class="bi bi-arrows-expand text-primary me-1"></i> خط الطول (Longitude)</label>
                                        <input type="text" id="add-lng-display" class="form-control vip-input text-center fw-bold shadow-sm" placeholder="مثال: 44.1910" dir="ltr">

                                        <input type="hidden" id="add-lng" name="Longitude" required>

                                        <div class="form-text small text-muted mt-1"><i class="bi bi-info-circle-fill text-info me-1"></i> في اليمن: يبدأ بـ (41 إلى 55)</div>

                                        <div class="invalid-feedback fw-bold text-end" style="font-size: 0.85rem;">
                                            <i class="bi bi-exclamation-circle-fill me-1"></i> عذراً، خط الطول المدخل خارج حدود الجمهورية اليمنية (41 إلى 55)!
                                        </div>
                                    </div>

                                </div>


                                <div id="addWizardMap" class="shadow-sm" style="height: 320px; width: 100%; border-radius: 12px; border: 2px solid #eef2f6; overflow: hidden;"></div>
                                <div class="text-center mt-2">
                                    <span id="mapSyncStatus" class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 d-none animate-fade-in"><i class="bi bi-check-circle-fill me-1"></i> تمت مزامنة الإحداثيات بنجاح</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold small text-muted">الموقع بالتفصيل الوصفي <span class="text-danger">*</span></label>
                            <textarea class="form-control vip-input" name="AddressDetail" rows="2" placeholder="مثال: شارع الستين، بجوار المستشفى الألماني..." required></textarea>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold small text-muted">نبذة تسويقية عامة عن المنشأة (وصف جذاب)</label>
                            <textarea class="form-control vip-input" name="Description" rows="3" placeholder="اكتب ما يميز منشأتك لتجذب العملاء..."></textarea>
                        </div>

                        <!-- صور المنشأة -->
                        <div class="col-md-12 mt-4">
                            <div class="p-4 bg-light rounded-4 border border-secondary border-opacity-10">
                                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-images text-primary me-2"></i> معرض الصور الاحترافي</h6>
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold text-primary small">صورة الغلاف الأساسية (الواجهة) <span class="text-danger">*</span></label>
                                        <input type="file" name="CoverImageUpload" class="form-control vip-input bg-white" accept="image/*" required>
                                        <small class="text-muted mt-1 d-block"><i class="bi bi-info-circle"></i> الواجهة الرئيسية للمنشأة في التطبيق.</small>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold text-dark small">صور الألبوم الداخلية (اختياري)</label>
                                        <input type="file" name="GalleryImages" class="form-control vip-input bg-white" multiple accept="image/*">
                                        <small class="text-muted mt-2 d-block" style="line-height: 1.6;">
                                            <i class="bi bi-info-circle text-primary"></i> حدد عدة صور معاً (كحد أقصى 10 ميجا).<br>
                                            <i class="bi bi-lightbulb text-warning"></i> <b>تلميحة:</b> لرفع مجلد كامل، افتحه واضغط <code>Ctrl + A</code> لتحديد جميع الصور.
                                        </small>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========================================================================= -->
                <!-- 🏨 الخطوات الديناميكية بحسب نوع المنشأة (غرف، شاليهات، قاعات) -->
                <!-- ========================================================================= -->
                @if (systemId == 1) // 🏨 الفنادق
                {
                    <div class="step-section wizard-step-card wizard-special-step wizard-special-step--rooms" id="step_rooms">
                        <h6 class="form-section-title"><i class="bi bi-door-open"></i> أنواع الغرف القابلة للحجز</h6>

                        <div class="hotel-structure-editor" id="hotelRoomTypesEditor">
                            <div class="hotel-editor-note">
                                <i class="bi bi-info-circle-fill"></i>
                                <div><strong>فعّل أنواع الغرف الموجودة في فندقك</strong><small>أدخل بيانات النوع مرة واحدة، ثم ستربط الغرف الفعلية بهذا النوع في خطوة الطوابق.</small></div>
                            </div>
                            <div id="hotelRoomTypesList" class="hotel-room-types-list" aria-live="polite"></div>

                            <div class="hotel-custom-type-box">
                                <div class="hotel-custom-type-box__copy">
                                    <i class="bi bi-plus-square"></i>
                                    <div><strong>نوع غرفة أخرى</strong><small>اكتب اسمها وسيتم إضافتها كسويتش بنفس حقول الغرف.</small></div>
                                </div>
                                <div class="hotel-custom-type-box__controls">
                                    <input type="text" id="customHotelRoomTypeName" class="form-control vip-input" maxlength="50" placeholder="مثال: غرفة ديلوكس">
