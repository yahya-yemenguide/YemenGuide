@using System
@using System.Linq
@using System.Text.Json
@model YemenGuide.Core.DTOs.Owner.OwnerDashboardDto
@{
    ViewData["Title"] = "لوحة التحكم";

    var isAdminPlaceAccount =
        (ViewData["IsAdministrationOwnedPlace"] is bool isAdminOwned && isAdminOwned) ||
        User.IsInRole("Admin");

    string Money(decimal value) => value.ToString("N0");
    string Number(long value) => value.ToString("N0");
    string Initial(string? value) => string.IsNullOrWhiteSpace(value) ? "؟" : value.Trim().Substring(0, 1);
    string CommissionMovement(decimal value) => value > 0m
        ? $"-{Math.Abs(value):N0}"
        : value < 0m
            ? $"+{Math.Abs(value):N0}"
            : "0";

    var attentionCount = Model.AttentionItems.Sum(item => item.Count);
    var todayBookings = Model.TodayOperation.Bookings.Take(4).ToList();
    var latestReviews = Model.Reviews.LatestReviews.Take(2).ToList();
    var recentActivities = Model.RecentActivities.Take(4).ToList();
    var roundedRating = Model.Reviews.TotalReviews > 0
        ? Math.Clamp((int)Math.Round(Model.Reviews.AverageRating, MidpointRounding.AwayFromZero), 0, 5)
        : 0;

    var dashboardJson = JsonSerializer.Serialize(
        new
        {
            bookingTrend = Model.BookingTrend,
            finance = Model.Finance,
            guarantee = Model.Guarantee,
            reviews = Model.Reviews,
            calendarEvents = Model.CalendarEvents,
            currency = Model.Currency,
            ownerName = Model.OwnerName,
            placeName = Model.PlaceName,
            kpis = Model.Kpis,
            bookingSummary = Model.BookingSummary,
            marketing = Model.Marketing,
            todayOperation = Model.TodayOperation,
            attentionCount,
            trialStatus = Model.TrialStatus
        },
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });
}

@section Styles {
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/owner/dashboard-owner-final-light.css" asp-append-version="true" />
}

<div class="odl-page"
     data-owner-dashboard
     data-place-id="@(Model.PlaceId?.ToString() ?? string.Empty)">

    @if (!Model.HasPlace)
    {
        <section class="odl-no-place">
            <span class="odl-no-place__icon"><i class="bi bi-building-add"></i></span>
            <div>
                <span class="odl-eyebrow">ابدأ من هنا</span>
                <h1>أضف منشأتك لبدء لوحة التحكم</h1>
                <p>بمجرد إضافة المنشأة ستظهر الحجوزات والمالية والتقييمات والأنشطة الفعلية تلقائيًا.</p>
            </div>
            <a class="odl-action odl-action--primary"
               href="@(isAdminPlaceAccount ? "/Admin/Places/PlaceManagement" : "/Owner/Place/ManagePlaces?placeTab=add-place-tab")">
                <i class="bi bi-plus-lg"></i>
                @(isAdminPlaceAccount ? "إدارة المنشآت" : "إضافة منشأة")
            </a>
        </section>
    }
    else
    {
        <section class="odl-hero">
            <div class="odl-hero__main">
                <div class="odl-hero__title-row">
                    <div>
                        <span class="odl-eyebrow"><i class="bi bi-stars"></i> <span data-live-greeting>مرحبًا</span>، @Model.OwnerName</span>
                        <h1>@Model.PlaceName</h1>
                    </div>
                    <span class="odl-status @(Model.IsPlaceAvailable ? "is-active" : "is-paused")">
                        <i></i>@Model.PlaceStatusLabel
                    </span>
                </div>

                <div class="odl-hero__meta">
                    @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
                    {
                        <span><i class="bi bi-grid"></i>@Model.CategoryName</span>
                    }
                    <span><i class="bi bi-database-check"></i>بيانات مباشرة</span>
                    <span><i class="bi bi-arrow-repeat"></i>آخر تحديث @Model.GeneratedAt.ToString("HH:mm")</span>
                </div>

                <div class="odl-hero__actions">
                    <a class="odl-action odl-action--primary" href="/Owner/Reservation/ManageReservations">
                        <i class="bi bi-calendar2-check"></i> إدارة الحجوزات
                    </a>
                    <a class="odl-action" href="/Owner/Financials?financeTab=overview&placeId=@Model.PlaceId">
                        <i class="bi bi-wallet2"></i> المالية
                    </a>
                    <a class="odl-action" href="/Owner/Advertisements/AdvertisementManagement">
                        <i class="bi bi-megaphone"></i> الإعلانات
                    </a>
                </div>
            </div>

            <div class="odl-hero__clock">
                <span>الآن</span>
                <strong data-live-clock>@DateTime.Now.ToString("hh:mm tt")</strong>
                <small data-live-date>@DateTime.Now.ToString("dddd، dd MMMM")</small>
            </div>
        </section>

        @if (!isAdminPlaceAccount &&
             Model.TrialStatus.HasTrialHistory &&
             Model.TrialStatus.StartedAt.HasValue &&
             Model.TrialStatus.EndsAt.HasValue &&
             (Model.TrialStatus.IsActive || Model.TrialStatus.IsExpired))
        {
            var trial = Model.TrialStatus;
            var trialBalanceUrl = Url.Action(
                "ManageOwnerFinancials",
                "OwnerFinancials",
                new { area = "Owner", financeTab = "balance", placeId = Model.PlaceId })
                ?? $"/Owner/Financials?financeTab=balance&placeId={Model.PlaceId}";

            var trialTone = trial.IsExpired
                ? (trial.NeedsTopUp ? "is-danger" : "is-success")
                : trial.IsEndingSoon
                    ? "is-warning"
                    : "";

            <section class="odl-trial @trialTone"
                     data-trial-status
                     data-trial-active="@(trial.IsActive ? "true" : "false")"
                     data-trial-expired="@(trial.IsExpired ? "true" : "false")"
                     data-trial-ending-soon="@(trial.IsEndingSoon ? "true" : "false")"
                     data-trial-remaining-days="@trial.RemainingTrialDays"
                     data-trial-ends-at="@trial.EndsAt.Value.ToString("yyyy-MM-ddTHH:mm:ss")"
                     data-trial-reminder-key="@trial.ReminderKey"
                     data-trial-needs-topup="@(trial.NeedsTopUp ? "true" : "false")"
                     data-trial-missing="@trial.MissingGuaranteeBalance.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                     data-trial-currency="@trial.Currency"
                     data-trial-balance-url="@trialBalanceUrl">
                <span class="odl-trial__icon"><i class="bi @(trial.IsExpired ? "bi-hourglass-bottom" : "bi-gift")"></i></span>
                <div class="odl-trial__copy">
                    @if (trial.IsActive)
                    {
                        <strong>الفترة التجريبية مستمرة</strong>
                        <small>متبقي @trial.RemainingTrialDays @(trial.RemainingTrialDays == 1 ? "يوم" : "أيام") · تنتهي @trial.EndsAt.Value.ToString("dd MMMM yyyy")</small>
                    }
                    else if (trial.NeedsTopUp && !trial.CanAcceptNewBookings)
                    {
                        <strong>استقبال الحجوزات الجديدة متوقف ماليًا</strong>
                        <small>الرصيد الناقص @trial.MissingGuaranteeBalance.ToString("N0") @trial.Currency</small>
                    }
                    else
                    {
                        <strong>الفترة التجريبية انتهت والحساب جاهز</strong>
                        <small>رصيد الضمان الحالي يسمح باستمرار التشغيل.</small>
                    }
                </div>
                @if (trial.IsActive)
                {
                    <div class="odl-trial__countdown" data-trial-countdown>
                        <span>الوقت المتبقي</span>
                        <strong>جارٍ الحساب...</strong>
                    </div>
                }
                <a href="@trialBalanceUrl">@(trial.NeedsTopUp ? "شحن الرصيد" : "تفاصيل الرصيد") <i class="bi bi-arrow-left"></i></a>
            </section>
        }

        <section class="odl-stats" aria-label="المؤشرات الرئيسية">
            <article class="odl-stat">
                <span class="odl-stat__icon is-cyan"><i class="bi bi-calendar-plus"></i></span>
                <div>
                    <small>طلبات اليوم</small>
                    <strong data-counter-value="@Model.Kpis.NewBookingsToday">@Model.Kpis.NewBookingsToday.ToString("N0")</strong>
                    <em>حجز جديد</em>
                </div>
            </article>
            <article class="odl-stat">
                <span class="odl-stat__icon is-navy"><i class="bi bi-broadcast"></i></span>
                <div>
                    <small>نشطة الآن</small>
                    <strong data-counter-value="@Model.TodayOperation.ActiveNow">@Model.TodayOperation.ActiveNow.ToString("N0")</strong>
                    <em>حجز جارٍ</em>
                </div>
            </article>
            <article class="odl-stat">
                <span class="odl-stat__icon is-green"><i class="bi bi-cash-stack"></i></span>
                <div>
                    <small>صافي الشهر</small>
                    <strong>@Money(Model.Kpis.MonthlyRevenue)</strong>
                    <em>@Model.Currency</em>
                </div>
            </article>
            <article class="odl-stat">
                <span class="odl-stat__icon is-orange"><i class="bi bi-star-fill"></i></span>
                <div>
                    <small>التقييم</small>
                    <strong>@(Model.Reviews.TotalReviews > 0 ? Model.Reviews.AverageRating.ToString("0.0") : "—")</strong>
                    <em>@Model.Reviews.TotalReviews تقييم</em>
                </div>
            </article>
        </section>

        <section class="odl-command-grid">
            <article class="odl-card odl-card--today">
                <header class="odl-card__head">
                    <div>
                        <span class="odl-eyebrow">تشغيل اليوم</span>
                        <h2>ما يحدث في منشأتك الآن</h2>
                    </div>
                    <a class="odl-card__link" href="/Owner/Reservation/ManageReservations">كل الحجوزات <i class="bi bi-arrow-left"></i></a>
                </header>

                <div class="odl-operation">
                    <div><span><i class="bi bi-box-arrow-in-down-left"></i> وصول</span><b>@Model.TodayOperation.ArrivalsToday</b></div>
                    <div><span><i class="bi bi-broadcast"></i> نشطة</span><b>@Model.TodayOperation.ActiveNow</b></div>
                    <div><span><i class="bi bi-box-arrow-up-right"></i> مغادرة</span><b>@Model.TodayOperation.DeparturesToday</b></div>
                    <div>
                        @if (Model.TodayOperation.HasRoomUnits)
                        {
                            <span><i class="bi bi-door-open"></i> متاحة</span><b>@Model.TodayOperation.AvailableRoomUnits</b>
                        }
                        else
                        {
                            <span><i class="bi bi-calendar2"></i> تبدأ اليوم</span><b>@Model.Kpis.TodayBookings</b>
                        }
                    </div>
                </div>

                @if (todayBookings.Count == 0)
                {
                    <div class="odl-empty"><i class="bi bi-calendar2-check"></i><span>لا توجد حركة حجوزات لهذا اليوم.</span></div>
                }
                else
                {
                    <div class="odl-booking-list">
                        @foreach (var booking in todayBookings)
                        {
                            <a class="odl-booking" href="@booking.Url">
                                <span class="odl-avatar">@Initial(booking.CustomerName)</span>
                                <div>
                                    <strong>@booking.CustomerName</strong>
                                    <small>#@booking.BookingId · @booking.ResourceName · @booking.StartDate.ToString("HH:mm")</small>
                                </div>
                                <span class="odl-state">@booking.BookingStateLabel</span>
                            </a>
                        }
                    </div>
                }
            </article>

            <aside class="odl-card odl-card--attention">
                <header class="odl-card__head">
                    <div>
                        <span class="odl-eyebrow">الأولوية</span>
                        <h2>يحتاج إجراء</h2>
                    </div>
                    <span class="odl-alert-count @(attentionCount > 0 ? "has-items" : "")">@attentionCount</span>
                </header>

                @if (Model.AttentionItems.Count == 0)
                {
                    <div class="odl-empty odl-empty--compact"><i class="bi bi-check2-circle"></i><span>كل شيء تحت السيطرة.</span></div>
                }
                else
                {
                    <div class="odl-attention-list">
                        @foreach (var item in Model.AttentionItems.Take(4))
                        {
                            <a class="odl-attention is-@item.Tone" href="@item.Url">
                                <span class="odl-attention__icon"><i class="bi @item.Icon"></i></span>
                                <div><strong>@item.Title</strong><small>@item.Description</small></div>
                                <b>@item.Count</b>
                            </a>
                        }
                    </div>
                }

                <div class="odl-mini-actions">
                    <a href="/Owner/Reservation/ManageReservations"><i class="bi bi-calendar-check"></i><span>الحجوزات</span></a>
                    <a href="/Owner/Financials?financeTab=overview&placeId=@Model.PlaceId"><i class="bi bi-wallet2"></i><span>المالية</span></a>
                    <a href="/Owner/Chat/ChatInterface"><i class="bi bi-chat-dots"></i><span>التواصل</span></a>
                </div>
            </aside>
        </section>

        <section class="odl-insight-grid">
            <article class="odl-card odl-card--trend">
                <header class="odl-card__head odl-card__head--chart">
                    <div>
                        <span class="odl-eyebrow">الحجوزات</span>
                        <h2>الحركة خلال آخر 30 يومًا</h2>
                    </div>
                    <div class="odl-range" role="group" aria-label="نطاق الرسم">
                        <button type="button" data-booking-range="7">7 أيام</button>
                        <button type="button" data-booking-range="14">14 يوم</button>
                        <button type="button" class="is-active" data-booking-range="30">30 يوم</button>
                    </div>
                </header>

                <div class="odl-chart" id="ownerBookingChart" aria-label="رسم حركة الحجوزات"></div>

                <div class="odl-summary">
                    <div><small>هذا الشهر</small><b>@Model.BookingSummary.TotalThisMonth</b></div>
                    <div><small>قيد المعالجة</small><b>@Model.BookingSummary.Pending</b></div>
                    <div><small>مؤكدة</small><b>@Model.BookingSummary.Confirmed</b></div>
                    <div><small>ملغاة</small><b>@Model.BookingSummary.Cancelled</b></div>
                </div>
            </article>

            <aside class="odl-card odl-card--finance">
                <header class="odl-card__head">
                    <div>
                        <span class="odl-eyebrow">المالية</span>
                        <h2>ملخص الشهر</h2>
                    </div>
                    <a class="odl-card__link" href="/Owner/Financials?financeTab=overview&placeId=@Model.PlaceId">التفاصيل <i class="bi bi-arrow-left"></i></a>
                </header>

                <div class="odl-finance-hero">
                    <small>صافي الحركة النقدية</small>
                    <strong>@Money(Model.Finance.NetCollectedRevenue)</strong>
                    <span>@Model.Currency</span>
                    <em class="@(Model.Kpis.RevenueChangePercent < 0 ? "is-down" : "")">
                        <i class="bi @(Model.Kpis.RevenueChangePercent < 0 ? "bi-arrow-down-left" : "bi-arrow-up-left")"></i>
                        @(Model.Kpis.RevenueChangePercent > 0 ? "+" : "")@Model.Kpis.RevenueChangePercent.ToString("0.#")% عن الشهر السابق
                    </em>
                </div>

                <div class="odl-finance-list">
                    <div><span><i class="bi bi-phone"></i> إلكتروني</span><b>@Money(Model.Finance.PaidOnline)</b></div>
                    <div><span><i class="bi bi-shop"></i> في المنشأة</span><b>@Money(Model.Finance.CollectedAtProperty)</b></div>
                    <div class="is-negative"><span><i class="bi bi-arrow-counterclockwise"></i> استردادات</span><b>-@Money(Model.Finance.RefundedAmount)</b></div>
                    <div class="@(Model.Finance.PlatformCommission > 0m ? "is-negative" : "")"><span><i class="bi bi-percent"></i> عمولة المنصة</span><b>@CommissionMovement(Model.Finance.PlatformCommission)</b></div>
                </div>

                @if (!isAdminPlaceAccount)
                {
                    <a class="odl-guarantee" href="/Owner/Financials?financeTab=balance&placeId=@Model.PlaceId">
                        <span><i class="bi bi-shield-check"></i></span>
                        <div><small>رصيد الضمان</small><strong>@Money(Model.Guarantee.AvailableBalance) @Model.Currency</strong></div>
                        <em>@Model.Guarantee.AccountStatusLabel</em>
                    </a>
                }
            </aside>
        </section>

        <section class="odl-bottom-grid">
            <article class="odl-card odl-card--reviews">
                <header class="odl-card__head">
                    <div>
                        <span class="odl-eyebrow">تجربة العملاء</span>
                        <h2>آخر التقييمات</h2>
                    </div>
                    <a class="odl-card__link" href="/Owner/Chat/ChatInterface?communicationTab=reviews">عرض الكل <i class="bi bi-arrow-left"></i></a>
                </header>

                <div class="odl-rating-line">
                    <strong>@(Model.Reviews.TotalReviews > 0 ? Model.Reviews.AverageRating.ToString("0.0") : "—")</strong>
                    <div>
                        <div class="odl-stars">
                            @for (var star = 1; star <= 5; star++)
                            {
                                var starClass = star <= roundedRating ? "bi-star-fill" : "bi-star";
                                <i class="bi @starClass"></i>
                            }
                        </div>
                        <small>@Model.Reviews.TotalReviews تقييم · @Model.Reviews.AwaitingReply بدون رد</small>
                    </div>
                </div>

                @if (latestReviews.Count == 0)
                {
                    <div class="odl-empty odl-empty--compact"><i class="bi bi-star"></i><span>لا توجد تقييمات بعد.</span></div>
                }
                else
                {
                    <div class="odl-review-list">
                        @foreach (var review in latestReviews)
                        {
                            <a class="odl-review" href="@review.Url">
                                <span class="odl-avatar">@Initial(review.CustomerName)</span>
                                <div><strong>@review.CustomerName</strong><p>@(string.IsNullOrWhiteSpace(review.ReviewText) ? "تقييم بدون تعليق نصي." : review.ReviewText)</p></div>
                                <span class="odl-review__score">@review.Stars <i class="bi bi-star-fill"></i></span>
                            </a>
                        }
                    </div>
                }
            </article>

            <article class="odl-card odl-card--pulse">
                <header class="odl-card__head">
                    <div>
                        <span class="odl-eyebrow">نبض المنشأة</span>
                        <h2>التسويق والنشاط</h2>
                    </div>
                </header>

                <div class="odl-pulse-metrics">
                    <div><i class="bi bi-megaphone"></i><small>إعلانات نشطة</small><b>@Model.Marketing.ActiveAdvertisements</b></div>
                    <div><i class="bi bi-eye"></i><small>مشاهدات</small><b>@Number(Model.Marketing.Impressions)</b></div>
                    <div><i class="bi bi-heart"></i><small>المفضلة</small><b>@Model.Marketing.Favorites</b></div>
                </div>

                @if (recentActivities.Count == 0)
                {
                    <div class="odl-empty odl-empty--compact"><i class="bi bi-activity"></i><span>لا توجد نشاطات حديثة.</span></div>
                }
                else
                {
                    <div class="odl-activity-list">
                        @foreach (var activity in recentActivities)
                        {
                            <a class="odl-activity" href="@activity.Url">
                                <span class="odl-activity__icon"><i class="bi @activity.Icon"></i></span>
                                <div><strong>@activity.Title</strong><small>@activity.Description</small></div>
                                <time datetime="@activity.OccurredAt.ToString("O")">@activity.OccurredAt.ToString("dd/MM HH:mm")</time>
                            </a>
                        }
                    </div>
                }
            </article>
        </section>
    }
</div>

<script id="ownerDashboardData" type="application/json">@Html.Raw(dashboardJson)</script>

@if (!isAdminPlaceAccount &&
   Model?.TrialWelcome?.ShouldShow == true &&
   Model.TrialWelcome.IsActive &&
   Model.TrialWelcome.StartedAt.HasValue &&
   Model.TrialWelcome.EndsAt.HasValue)
{
    var trial = Model.TrialWelcome;
    var balanceUrl = Url.Action(
        "ManageOwnerFinancials",
        "OwnerFinancials",
        new { area = "Owner", financeTab = "balance", placeId = trial.PlaceId })
        ?? "/Owner/Financials?financeTab=balance";

    <div class="owner-trial-welcome"
         id="ownerTrialWelcome"
         hidden
         aria-hidden="true"
         data-owner-trial-welcome
         data-show-trial-welcome="true"
         data-storage-key="@trial.StorageKey">
        <div class="owner-trial-welcome__backdrop" aria-hidden="true"></div>
        <section class="owner-trial-welcome__dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="ownerTrialWelcomeTitle"
                 tabindex="-1">
            <button type="button" class="owner-trial-welcome__close" data-owner-trial-dismiss aria-label="إغلاق">
                <i class="bi bi-x-lg"></i>
            </button>
            <div class="owner-trial-welcome__hero">
                <div class="owner-trial-welcome__gift"><i class="bi bi-gift-fill"></i></div>
                <div class="owner-trial-welcome__hero-copy">
                    <span class="owner-trial-welcome__eyebrow"><i class="bi bi-stars"></i> انطلاقة مجانية لمنشأتك</span>
                    <h2 id="ownerTrialWelcomeTitle">مرحبًا بك في فترتك التجريبية</h2>
                    <p>تم تفعيل <strong>@trial.PlaceName</strong>. يمكنك استقبال الحجوزات خلال الفترة الحالية بدون عمولة منصة.</p>
                </div>
            </div>
            <div class="owner-trial-welcome__metrics">
                <article class="owner-trial-welcome__metric is-days"><span><i class="bi bi-calendar2-week"></i></span><div><small>مدة التجربة</small><strong>@trial.TotalTrialDays يومًا</strong></div></article>
                <article class="owner-trial-welcome__metric is-commission"><span><i class="bi bi-percent"></i></span><div><small>عمولة المنصة</small><strong>0%</strong></div></article>
                <article class="owner-trial-welcome__metric is-booking"><span><i class="bi bi-calendar2-check"></i></span><div><small>الحجوزات</small><strong>@(trial.CanAcceptNewBookings ? "متاحة" : "قيد التحقق")</strong></div></article>
            </div>
            <div class="owner-trial-welcome__actions">
                <button type="button" class="owner-trial-welcome__primary" data-owner-trial-dismiss><i class="bi bi-check2"></i><span>فهمت</span></button>
                <a class="owner-trial-welcome__secondary" href="@balanceUrl" data-owner-trial-balance><i class="bi bi-wallet2"></i><span>الرصيد والعمولات</span></a>
            </div>
        </section>
    </div>
}

@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.js"></script>
    <script src="~/lib/apexcharts/apexcharts.min.js"></script>
    <script src="~/js/owner/dashboard-owner.js" asp-append-version="true"></script>
}
