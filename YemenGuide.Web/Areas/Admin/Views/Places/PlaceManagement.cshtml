@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.js"></script>
    <script src="~/js/admin/places-actions.js" asp-append-version="true"></script>
    <script src="~/js/shared/unified-tabs.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.4/build/js/intlTelInput.min.js"></script>

    <script>
        function switchTab(tabId, btn) {
            document.querySelectorAll('.tab-pane-content').forEach(tab => {
                tab.style.display = 'none';
                tab.classList.remove('is-active');
            });

            const tabButtons =
                Array.from(
                    document.querySelectorAll(
                        '.admin-places-tabs .tab-btn'
                    )
                );

            tabButtons.forEach(button => {
                button.classList.remove('active');
                button.setAttribute('aria-selected', 'false');
                button.setAttribute('tabindex', '-1');
            });

            const target = document.getElementById(tabId);
            if (!target || !btn) return;

            target.style.display = 'block';
            target.classList.add('is-active');
            btn.classList.add('active');
            btn.setAttribute('aria-selected', 'true');
            btn.setAttribute('tabindex', '0');

            btn.scrollIntoView({
                behavior: 'auto',
                block: 'nearest',
                inline: 'nearest'
            });

            localStorage.setItem('adminActiveTab', tabId);
        }

        document.addEventListener('DOMContentLoaded', function () {
            const tabs =
                Array.from(
                    document.querySelectorAll(
                        '.admin-places-tabs .tab-btn'
                    )
                );

            const savedTab =
                localStorage.getItem(
                    'adminActiveTab'
                );

            if (savedTab) {
                const targetBtn =
                    tabs.find(
                        button =>
                            button.dataset.target ===
                            savedTab
                    );

                if (targetBtn) {
                    switchTab(
                        savedTab,
                        targetBtn
                    );
                }
            }

            document
                .querySelector('.admin-places-tabs')
                ?.addEventListener(
                    'keydown',
                    event => {
                        if (
                            ![
                                'ArrowLeft',
                                'ArrowRight',
                                'Home',
                                'End'
                            ].includes(event.key)
                        ) {
                            return;
                        }

                        const current =
                            event.target.closest(
                                '.tab-btn'
                            );

                        if (!current) return;

                        const currentIndex =
                            Math.max(
                                0,
                                tabs.indexOf(current)
                            );

                        let nextIndex =
                            currentIndex;

                        if (event.key === 'Home') {
                            nextIndex = 0;
                        }
                        else if (
                            event.key === 'End'
                        ) {
                            nextIndex =
                                tabs.length - 1;
                        }
                        else {
                            const rtl =
                                document.documentElement
                                    .dir === 'rtl';

                            const direction =
                                rtl ? -1 : 1;

                            const delta =
                                event.key ===
                                    'ArrowRight'
                                    ? direction
                                    : -direction;

                            nextIndex =
                                (
                                    currentIndex +
                                    delta +
                                    tabs.length
                                ) %
                                tabs.length;
                        }

                        event.preventDefault();

                        const next =
                            tabs[nextIndex];

                        next.focus({
                            preventScroll: true
                        });

                        switchTab(
                            next.dataset.target,
                            next
                        );
                    }
                );
        });

                                // محرر البيانات والصور موجود داخل places-actions.js نفسه؛ لا يعتمد على ملف أو مسار جديد.
    </script>
}
