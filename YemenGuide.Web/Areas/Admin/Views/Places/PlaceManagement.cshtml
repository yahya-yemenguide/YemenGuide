@using System
@using System.Collections.Generic
@using System.Security.Claims
@using System.Globalization
@using YemenGuide.Core.Constants
@inject YemenGuide.Web.Services.Employees.IAdminPermissionService AdminPermissionService
@model YemenGuide.Core.DTOs.Admin.PlacesDto

@{
    bool isArabic =
        string.Equals(
            CultureInfo.CurrentUICulture.TwoLetterISOLanguageName,
            "ar",
            StringComparison.OrdinalIgnoreCase);

    string L(string ar, string en) =>
        isArabic ? ar : en;

    string locale =
        isArabic ? "ar-YE" : "en-US";

    string unspecified =
        L("غير محدد", "Unspecified");

    ViewData["Title"] =
        L("إدارة المنشآت", "Places management");

    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var currentAdminUserId =
        int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var parsedAdminUserId)
            ? parsedAdminUserId
            : 0;

    var currentPermissions =
        currentAdminUserId > 0
            ? await AdminPermissionService.GetPermissionKeysAsync(
                currentAdminUserId,
                Context.RequestAborted)
            : Array.Empty<string>();

    var permissionSet =
        new HashSet<string>(
            currentPermissions,
            StringComparer.OrdinalIgnoreCase);

    bool Can(string permissionKey) =>
        permissionSet.Contains(permissionKey);

    var canCreatePlaces = Can(AdminPermissionKeys.Places.Create);
    var canEditPlaces = Can(AdminPermissionKeys.Places.Edit);
    var canReviewPlaces = Can(AdminPermissionKeys.Places.Review);
    var canChangePlaceStatus = Can(AdminPermissionKeys.Places.ChangeStatus);
    var canDeletePlaces = Can(AdminPermissionKeys.Places.Delete);
    var canReassignPlaceOwner = Can(AdminPermissionKeys.Places.ReassignOwner);
}

@section Styles {
    @* نفس ملفات الهوية المشتركة المستخدمة عند المالك، لكن لهذه الصفحة فقط
       حتى لا نؤثر على Dashboard أو بقية صفحات الأدمن. *@
    <link rel="stylesheet" href="~/css/shared/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/unified-tabs.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.4/build/css/intlTelInput.css" />
    <link rel="stylesheet" href="~/css/admin/places-styles.css" asp-append-version="true" />
}

    <div class="admin-places-page"
     data-admin-places-page
     data-place-editor-mode="admin"
     data-language="@(isArabic ? "ar" : "en")"
     data-locale="@locale">
        <section class="admin-places-hero admin-places-hero--compact" aria-labelledby="adminPlacesTitle">
            <div class="admin-places-hero__copy">
                <span class="admin-places-hero__icon" aria-hidden="true">
                    <i class="bi bi-buildings"></i>
                </span>
                <div class="admin-places-hero__text">
                    <h1 id="adminPlacesTitle">@L("إدارة المنشآت", "Places management")</h1>
                    <p>@L("راجع المنشآت وتحكم بحالتها وبياناتها من مكان واحد.", "Review places and manage their status and data from one place.")</p>
                </div>
            </div>

            <div class="admin-places-hero__actions">
                <label class="admin-places-search" for="adminPlacesSearch">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input id="adminPlacesSearch"
                       type="search"
                       autocomplete="off"
                       placeholder="@L("ابحث بالاسم، المالك، الفئة أو المدينة", "Search by place, owner, category, or city")"
                       aria-label="@L("البحث في المنشآت", "Search places")" />
                    <button type="button" class="admin-places-search__clear" data-clear-admin-search aria-label="@L("مسح البحث", "Clear search")" hidden>
                        <i class="bi bi-x-lg"></i>
                    </button>
                </label>

            @if (canCreatePlaces)
            {
                <a asp-action="Create" class="admin-places-add-button">
                    <i class="bi bi-plus-lg"></i>
                    <span>@L("إضافة منشأة", "Add place")</span>
                </a>
            }
        </div>
    </section>
    <nav class="custom-tabs-container yg-unified-tabs admin-places-tabs" data-yg-tabs role="tablist" aria-label="@L("حالات المنشآت", "Place statuses")">
        <button class="tab-btn active"
                type="button"
                role="tab"
                aria-selected="true"
                aria-controls="admin-places-tab"
                data-target="admin-places-tab"
                onclick="switchTab('admin-places-tab', this)">
            <span class="tab-icon tab-btn__icon"><i class="bi bi-building-add"></i></span>
            <span class="tab-label tab-btn__label">@L("منشآت الإدارة", "Admin places")</span>
            <span class="tab-count tab-btn__count">@Model.AdminPlaces.Count()</span>
        </button>
        <button class="tab-btn"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="pending-tab"
                data-target="pending-tab"
                onclick="switchTab('pending-tab', this)">
            <span class="tab-icon tab-btn__icon"><i class="bi bi-clock-history"></i></span>
            <span class="tab-label tab-btn__label">@L("قيد المراجعة", "Pending review")</span>
            <span class="tab-count tab-btn__count">@Model.PendingPlaces.Count()</span>
        </button>
        <button class="tab-btn"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="waiting-owner-tab"
                data-target="waiting-owner-tab"
                onclick="switchTab('waiting-owner-tab', this)">
            <span class="tab-icon tab-btn__icon"><i class="bi bi-hourglass-split"></i></span>
            <span class="tab-label tab-btn__label">@L("بانتظار المالك", "Waiting for owner")</span>
            <span class="tab-count tab-btn__count">@Model.WaitingOwnerApprovalPlaces.Count()</span>
        </button>
        <button class="tab-btn"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="active-tab"
                data-target="active-tab"
                onclick="switchTab('active-tab', this)">
            <span class="tab-icon tab-btn__icon"><i class="bi bi-check2-circle"></i></span>
            <span class="tab-label tab-btn__label">@L("النشطة", "Active")</span>
            <span class="tab-count tab-btn__count">@Model.ActivePlaces.Count()</span>
        </button>
        <button class="tab-btn"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="rejected-tab"
                data-target="rejected-tab"
                onclick="switchTab('rejected-tab', this)">
            <span class="tab-icon tab-btn__icon"><i class="bi bi-x-circle"></i></span>
            <span class="tab-label tab-btn__label">@L("المرفوضة", "Rejected")</span>
            <span class="tab-count tab-btn__count">@Model.RejectedPlaces.Count()</span>
        </button>
        <button class="tab-btn"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="suspended-tab"
                data-target="suspended-tab"
                onclick="switchTab('suspended-tab', this)">
            <span class="tab-icon tab-btn__icon"><i class="bi bi-pause-circle"></i></span>
            <span class="tab-label tab-btn__label">@L("المعلّقة", "Suspended")</span>
            <span class="tab-count tab-btn__count">@Model.SuspendedPlaces.Count()</span>
        </button>
    </nav>

    <section class="admin-places-content-card">
        <div id="admin-places-tab" class="tab-pane-content is-active" style="display:block;" role="tabpanel">
            <header class="admin-places-pane-header">
                <div><h2>@L("منشآت الإدارة", "Admin places")</h2><p>@L("المنشآت التي أُنشئت أو تدار بواسطة حسابات الإدارة.", "Places created or managed by administration accounts.")</p></div>
                <span class="admin-places-pane-count">@Model.AdminPlaces.Count() @L("منشأة", "places")</span>
            </header>
            @if (Model.AdminPlaces.Any())
            {
                <div class="admin-places-table-wrap">
                    <table class="admin-places-table">
                        <thead><tr><th>@L("المنشأة", "Place")</th><th>@L("الفئة", "Category")</th><th>@L("المدينة", "City")</th><th>@L("الحالة", "Status")</th><th>@L("الإجراءات", "Actions")</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.AdminPlaces)
                            {
                                var adminPlaceNeedsPolicies = item.Category != null &&
                                item.Category.BookingSystemId >= 1 &&
                                item.Category.BookingSystemId <= 4 &&
                                item.PlacePolicy == null;

                                <tr data-place-row data-search="@($"{item.PlaceNameAndDesc} {item.Category?.CategoryName} {item.City?.CityName} {item.Owner?.FullName}")">
                                    <td data-label="@L("المنشأة", "Place")">
                                        <div class="admin-place-identity">
                                            <img src="@(string.IsNullOrWhiteSpace(item.CoverImage) ? "/images/placeholder.jpg" : item.CoverImage)" onerror="this.src='/images/placeholder.jpg'" alt="@L("صورة", "Photo") @item.PlaceNameAndDesc" />
                                            <span><strong>@item.PlaceNameAndDesc</strong><small>#@item.PlaceId</small></span>
                                        </div>
                                    </td>
                                    <td data-label="@L("الفئة", "Category")"><span class="admin-place-chip"><i class="bi bi-grid"></i>@(item.Category?.CategoryName ?? unspecified)</span></td>
                                    <td data-label="@L("المدينة", "City")"><span class="admin-place-muted"><i class="bi bi-geo-alt"></i>@(item.City?.CityName ?? unspecified)</span></td>
                                    <td data-label="@L("الحالة", "Status")">
                                        @if (adminPlaceNeedsPolicies)
                                        {
                                            <span class="admin-place-status admin-place-status--pending" title="المنشأة نشطة، لكن استقبال الحجوزات متوقف حتى إكمال السياسات.">
                                                <i class="bi bi-calendar2-x"></i>الحجز غير جاهز
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="admin-place-status admin-place-status--admin"><i class="bi bi-shield-check"></i>إدارية وجاهزة</span>
                                        }
                                    </td>
                                    <td data-label="@L("الإجراءات", "Actions")">
                                        <div class="admin-place-actions" data-place-action-root>

                                            <button class="action-btn action-btn--view view-btn" type="button" data-id="@item.PlaceId" title="عرض التفاصيل"><i class="bi bi-eye"></i><span>@L("التفاصيل", "Details")</span></button>

                                            @if (canEditPlaces || canDeletePlaces)

                                            {

                                                <div class="admin-place-action-menu-host">

                                                    <button class="action-btn admin-place-action-trigger"
                                                type="button"
                                                data-place-action-toggle
                                                aria-expanded="false"
                                                aria-haspopup="menu"
                                                aria-label="@L("فتح إجراءات المنشأة", "Open place actions")">

                                                        <i class="bi bi-three-dots" aria-hidden="true"></i>

                                                        <span>@L("إجراءات", "Actions")</span>

                                                        <i class="bi bi-chevron-down admin-place-action-trigger__chevron" aria-hidden="true"></i>

                                                    </button>

                                                    <div class="admin-place-action-menu" data-place-action-menu role="menu" hidden>

                                                        <div class="admin-place-action-menu__head">

                                                            <div>

                                                                <strong>إجراءات المنشأة</strong>

                                                                <span>@L("اختر الإجراء المطلوب", "Choose an action")</span>

                                                            </div>

                                                            <button type="button" class="admin-place-action-menu__close" data-place-action-close aria-label="@L("إغلاق قائمة الإجراءات", "Close action menu")">

                                                                <i class="bi bi-x-lg"></i>

                                                            </button>

                                                        </div>

                                                        @if (canEditPlaces)

                                                        {

                                                            <button class="action-btn action-btn--edit edit-btn" type="button" title="@L("تعديل بيانات المنشأة", "Edit place data")" onclick="window.openEditPlaceModal(@item.PlaceId)"><i class="bi bi-pencil-square"></i><span>@L("تعديل", "Edit")</span></button>

                                                            <button class="action-btn action-btn--view" type="button" title="@L("إدارة صور المنشأة", "Manage place photos")" onclick="window.openManagePlaceImagesModal(@item.PlaceId)"><i class="bi bi-images"></i><span>@L("الصور", "Photos")</span></button>

                                                        }

                                                        @if (canDeletePlaces)

                                                        {

                                                            <button class="action-btn action-btn--danger delete-btn" type="button" data-id="@item.PlaceId" title="@L("حذف المنشأة", "Delete place")"><i class="bi bi-trash3"></i><span>@L("حذف", "Delete")</span></button>

                                                        }


                                                    </div>

                                                </div>

                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="admin-place-empty"><span><i class="bi bi-building-add"></i></span><h3>@L("لا توجد منشآت إدارية", "No admin places")</h3><p>@L("ستظهر هنا المنشآت التي تنشئها الإدارة.", "Places created by the administration will appear here.")</p></div>
            }
            <div class="admin-place-search-empty" data-search-empty hidden><i class="bi bi-search"></i><strong>@L("لا توجد نتائج مطابقة", "No matching results")</strong><span>@L("جرّب كلمة بحث أخرى.", "Try a different search term.")</span></div>
        </div>

        <div id="pending-tab" class="tab-pane-content" style="display:none;" role="tabpanel">
            <header class="admin-places-pane-header">
                <div><h2>@L("طلبات قيد المراجعة", "Pending review requests")</h2><p>@L("راجع بيانات المنشأة والسياسات ثم اتخذ قرار الاعتماد.", "Review place data and policies, then make an approval decision.")</p></div>
                <span class="admin-places-pane-count">@Model.PendingPlaces.Count() @L("طلب", "requests")</span>
            </header>
            @if (Model.PendingPlaces.Any())
            {
                <div class="admin-places-table-wrap">
                    <table class="admin-places-table">
                        <thead><tr><th>@L("المنشأة", "Place")</th><th>@L("الفئة", "Category")</th><th>@L("المالك", "Owner")</th><th>@L("الحالة", "Status")</th><th>@L("الإجراءات", "Actions")</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.PendingPlaces)
                            {
                                <tr data-place-row data-search="@($"{item.PlaceNameAndDesc} {item.Category?.CategoryName} {item.City?.CityName} {item.Owner?.FullName}")">
                                    <td data-label="@L("المنشأة", "Place")"><div class="admin-place-identity"><img src="@(string.IsNullOrWhiteSpace(item.CoverImage) ? "/images/placeholder.jpg" : item.CoverImage)" onerror="this.src='/images/placeholder.jpg'" alt="@L("صورة", "Photo") @item.PlaceNameAndDesc" /><span><strong>@item.PlaceNameAndDesc</strong><small>#@item.PlaceId • @(item.City?.CityName ?? unspecified)</small></span></div></td>
                                    <td data-label="@L("الفئة", "Category")"><span class="admin-place-chip"><i class="bi bi-grid"></i>@(item.Category?.CategoryName ?? unspecified)</span></td>
                                    <td data-label="@L("المالك", "Owner")"><span class="admin-place-muted"><i class="bi bi-person"></i>@(item.Owner?.FullName ?? unspecified)</span></td>
                                    <td data-label="@L("الحالة", "Status")"><span class="admin-place-status admin-place-status--pending"><i class="bi bi-clock-history"></i>@L("قيد المراجعة", "Pending review")</span></td>
                                    <td data-label="@L("الإجراءات", "Actions")">
                                        <div class="admin-place-actions" data-place-action-root>

                                            <button class="action-btn action-btn--view view-btn" type="button" data-id="@item.PlaceId"><i class="bi bi-eye"></i><span>@L("التفاصيل", "Details")</span></button>

                                            @if (canEditPlaces || canReviewPlaces)

                                            {

                                                <div class="admin-place-action-menu-host">

                                                    <button class="action-btn admin-place-action-trigger"
                                                type="button"
                                                data-place-action-toggle
                                                aria-expanded="false"
                                                aria-haspopup="menu"
                                                aria-label="@L("فتح إجراءات المنشأة", "Open place actions")">

                                                        <i class="bi bi-three-dots" aria-hidden="true"></i>

                                                        <span>@L("إجراءات", "Actions")</span>

                                                        <i class="bi bi-chevron-down admin-place-action-trigger__chevron" aria-hidden="true"></i>

                                                    </button>

                                                    <div class="admin-place-action-menu" data-place-action-menu role="menu" hidden>

                                                        <div class="admin-place-action-menu__head">

                                                            <div>

                                                                <strong>إجراءات المنشأة</strong>

                                                                <span>@L("اختر الإجراء المطلوب", "Choose an action")</span>

                                                            </div>

                                                            <button type="button" class="admin-place-action-menu__close" data-place-action-close aria-label="@L("إغلاق قائمة الإجراءات", "Close action menu")">

                                                                <i class="bi bi-x-lg"></i>

                                                            </button>

                                                        </div>

                                                        @if (canEditPlaces)

                                                        {

                                                            <button class="action-btn action-btn--edit" type="button" onclick="window.openEditPlaceModal(@item.PlaceId)"><i class="bi bi-pencil-square"></i><span>@L("تعديل", "Edit")</span></button>

                                                            <button class="action-btn action-btn--view" type="button" onclick="window.openManagePlaceImagesModal(@item.PlaceId)"><i class="bi bi-images"></i><span>@L("الصور", "Photos")</span></button>

                                                        }

                                                        @if (canReviewPlaces)

                                                        {

                                                            <button class="action-btn action-btn--success approve-btn" type="button" data-id="@item.PlaceId"><i class="bi bi-check2"></i><span>@L("موافقة", "Approve")</span></button>

                                                            <button class="action-btn action-btn--danger reject-btn" type="button" data-id="@item.PlaceId"><i class="bi bi-x-lg"></i><span>@L("رفض", "Reject")</span></button>

                                                        }


                                                    </div>

                                                </div>

                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="admin-place-empty"><span><i class="bi bi-check2-all"></i></span><h3>@L("لا توجد طلبات مراجعة", "No pending review requests")</h3><p>@L("كل طلبات المنشآت تمت معالجتها حاليًا.", "All place requests are currently processed.")</p></div>
            }
            <div class="admin-place-search-empty" data-search-empty hidden><i class="bi bi-search"></i><strong>@L("لا توجد نتائج مطابقة", "No matching results")</strong><span>@L("جرّب كلمة بحث أخرى.", "Try a different search term.")</span></div>
        </div>

        <div id="waiting-owner-tab" class="tab-pane-content" style="display:none;" role="tabpanel">
            <header class="admin-places-pane-header"><div><h2>@L("بانتظار موافقة المالك", "Waiting for owner approval")</h2><p>@L("منشآت أرسلت إلى مالك موجود أو جديد لاستكمال الموافقة والسياسات.", "Places sent to an existing or new owner to complete approval and policies.")</p></div><span class="admin-places-pane-count">@Model.WaitingOwnerApprovalPlaces.Count() @L("منشأة", "places")</span></header>
            @if (Model.WaitingOwnerApprovalPlaces.Any())
            {
                <div class="admin-places-table-wrap">
                    <table class="admin-places-table">
                        <thead><tr><th>@L("المنشأة", "Place")</th><th>@L("الفئة", "Category")</th><th>@L("المالك المقترح", "Proposed owner")</th><th>@L("الحالة", "Status")</th><th>@L("الإجراءات", "Actions")</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.WaitingOwnerApprovalPlaces)
                            {
                                <tr data-place-row data-search="@($"{item.PlaceNameAndDesc} {item.Category?.CategoryName} {item.City?.CityName} {item.Owner?.FullName}")">
                                    <td data-label="@L("المنشأة", "Place")"><div class="admin-place-identity"><img src="@(string.IsNullOrWhiteSpace(item.CoverImage) ? "/images/placeholder.jpg" : item.CoverImage)" onerror="this.src='/images/placeholder.jpg'" alt="@L("صورة", "Photo") @item.PlaceNameAndDesc" /><span><strong>@item.PlaceNameAndDesc</strong><small>#@item.PlaceId • @(item.City?.CityName ?? unspecified)</small></span></div></td>
                                    <td data-label="@L("الفئة", "Category")"><span class="admin-place-chip"><i class="bi bi-grid"></i>@(item.Category?.CategoryName ?? unspecified)</span></td>
                                    <td data-label="@L("المالك", "Owner")"><span class="admin-place-muted"><i class="bi bi-person"></i>@(item.Owner?.FullName ?? unspecified)</span></td>
                                    <td data-label="@L("الحالة", "Status")"><span class="admin-place-status admin-place-status--waiting"><i class="bi bi-hourglass-split"></i>@L("بانتظار المالك", "Waiting for owner")</span></td>
                                    <td data-label="@L("الإجراءات", "Actions")">
                                        <div class="admin-place-actions" data-place-action-root>

                                            <button class="action-btn action-btn--view view-btn" type="button" data-id="@item.PlaceId"><i class="bi bi-eye"></i><span>@L("التفاصيل", "Details")</span></button>

                                            @if (canEditPlaces || canReassignPlaceOwner)

                                            {

                                                <div class="admin-place-action-menu-host">

                                                    <button class="action-btn admin-place-action-trigger"
                                                type="button"
                                                data-place-action-toggle
                                                aria-expanded="false"
                                                aria-haspopup="menu"
                                                aria-label="@L("فتح إجراءات المنشأة", "Open place actions")">

                                                        <i class="bi bi-three-dots" aria-hidden="true"></i>

                                                        <span>@L("إجراءات", "Actions")</span>

                                                        <i class="bi bi-chevron-down admin-place-action-trigger__chevron" aria-hidden="true"></i>

                                                    </button>

                                                    <div class="admin-place-action-menu" data-place-action-menu role="menu" hidden>

                                                        <div class="admin-place-action-menu__head">

                                                            <div>

                                                                <strong>إجراءات المنشأة</strong>

                                                                <span>@L("اختر الإجراء المطلوب", "Choose an action")</span>

                                                            </div>

                                                            <button type="button" class="admin-place-action-menu__close" data-place-action-close aria-label="@L("إغلاق قائمة الإجراءات", "Close action menu")">

                                                                <i class="bi bi-x-lg"></i>

                                                            </button>

                                                        </div>

                                                        @if (canEditPlaces)

                                                        {

                                                            <button class="action-btn action-btn--edit" type="button" onclick="window.openEditPlaceModal(@item.PlaceId)"><i class="bi bi-pencil-square"></i><span>@L("تعديل", "Edit")</span></button>

                                                            <button class="action-btn action-btn--view" type="button" onclick="window.openManagePlaceImagesModal(@item.PlaceId)"><i class="bi bi-images"></i><span>@L("الصور", "Photos")</span></button>

                                                        }

                                                        @if (canReassignPlaceOwner)

                                                        {

                                                            <button class="action-btn action-btn--secondary reassign-btn" type="button" data-id="@item.PlaceId"><i class="bi bi-arrow-repeat"></i><span>@L("تغيير المالك", "Change owner")</span></button>

                                                        }


                                                    </div>

                                                </div>

                                            }

                                        </div>
                                    </td>
                                </tr>
