@model YemenGuide.Core.Entities.City

@{
    var defaultColor = "#00A6DA";
}

<div class="offcanvas offcanvas-end entity-offcanvas city-entity-offcanvas"
     tabindex="-1"
     id="addCityOffcanvas"
     aria-labelledby="addCityLabel"
     data-bs-backdrop="true"
     data-bs-scroll="false">

    <div class="entity-sheet-handle" aria-hidden="true"><span></span></div>

    <div class="offcanvas-header entity-offcanvas-header">
        <div class="entity-offcanvas-heading">
            <div class="entity-heading-icon"><i class="bi bi-geo-alt-fill"></i></div>
            <div class="entity-heading-text">
                <div class="entity-heading-kicker">إدارة المدن</div>
                <h5 class="offcanvas-title" id="addCityLabel">إضافة مدينة جديدة</h5>
                <small class="entity-heading-description">
                    أضف مدينة جديدة وحدد اسمها وهويتها البصرية داخل المنصة.
                </small>
            </div>
        </div>

        <button type="button"
                class="btn-close btn-close-white entity-offcanvas-close"
                data-bs-dismiss="offcanvas"
                aria-label="إغلاق"></button>
    </div>

    <div class="offcanvas-body entity-offcanvas-body p-0">
        <form id="addCityForm" class="entity-offcanvas-form" autocomplete="off">
            <input type="hidden" id="cityId" value="0" />

            <div class="entity-form-scroll">
                <section class="preview-card city-preview-card" aria-label="معاينة المدينة">
                    <div class="preview-card-glow preview-card-glow--one"></div>
                    <div class="preview-card-glow preview-card-glow--two"></div>

                    <div class="preview-card-content">
                        <div class="preview-card-label">
                            <i class="bi bi-stars"></i>
                            معاينة مباشرة
                        </div>

                        <div class="city-preview-main">
                            <div class="preview-icon city-preview-icon">
                                <div class="city-preview-icon-circle">
                                    <i id="previewCityIcon"
                                       class="bi bi-geo-alt-fill"
                                       style="color:@defaultColor"></i>
                                </div>
                            </div>

                            <div class="city-preview-copy">
                                <h5 id="previewCityName" class="city-preview-name">مدينة جديدة</h5>
                                <p class="city-preview-hint">
                                    مدينة مدعومة داخل دليلك اليمني
                                </p>
                            </div>
                        </div>

                        <div class="city-preview-footer">
                            <span class="preview-access-badge preview-access-badge--open">
                                <i class="bi bi-check-circle-fill"></i>
                                متاحة بالمنصة
                            </span>

                            <span class="preview-system-badge">
                                <i class="bi bi-pin-map-fill"></i>
                                موقع معتمد
                            </span>
                        </div>
                    </div>
                </section>

                <section class="entity-form-section">
                    <div class="entity-section-heading">
                        <div class="entity-section-number">01</div>
                        <div class="entity-section-icon">
                            <i class="bi bi-info-circle-fill"></i>
                        </div>
                        <div class="entity-section-heading-text">
                            <h6 class="entity-section-title">المعلومات الأساسية</h6>
                            <p class="entity-section-description">
                                اكتب الاسم الرسمي والواضح للمدينة.
                            </p>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="entity-field-group h-100">
                                <label class="entity-field-label" for="cityNameInput">
                                    <span>اسم المدينة بالعربية</span>
                                    <span class="entity-required-mark">*</span>
                                </label>

                                <div class="entity-input-group">
                                    <span class="entity-input-icon">
                                        <i class="bi bi-pin-map-fill"></i>
                                    </span>

                                    <input type="text"
                                           class="form-control city-name-input"
                                           id="cityNameInput"
                                           name="CityName"
                                           placeholder="مثال: صنعاء"
                                           maxlength="50"
                                           required />
                                </div>

                                <small class="entity-field-help">
                                    <i class="bi bi-lightbulb"></i>
                                    الاسم الذي يظهر في الواجهة العربية.
                                </small>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="entity-field-group h-100">
                                <label class="entity-field-label" for="cityNameEnInput">
                                    <span>اسم المدينة بالإنجليزية</span>
                                    <span class="entity-required-mark">*</span>
                                </label>

                                <div class="entity-input-group" dir="ltr">
                                    <span class="entity-input-icon">
                                        <i class="bi bi-translate"></i>
                                    </span>

                                    <input type="text"
                                           class="form-control city-name-en-input"
                                           id="cityNameEnInput"
                                           name="CityNameEn"
                                           placeholder="e.g. Sana'a"
                                           maxlength="150"
                                           dir="ltr"
                                           required />
                                </div>

                                <small class="entity-field-help">
                                    <i class="bi bi-globe2"></i>
                                    الاسم الذي يظهر في واجهة English.
                                </small>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="entity-form-section">
                    <div class="entity-section-heading">
                        <div class="entity-section-number">02</div>
                        <div class="entity-section-icon">
                            <i class="bi bi-palette-fill"></i>
                        </div>
                        <div class="entity-section-heading-text">
                            <h6 class="entity-section-title">الهوية البصرية</h6>
                            <p class="entity-section-description">
                                اختر لونًا مميزًا لأيقونة المدينة وبعض عناصر العرض.
                            </p>
                        </div>
                    </div>

                    <div class="entity-field-group">
                        <label class="entity-field-label" for="cityColorPicker">
                            لون المدينة
                        </label>

                        <div class="city-color-panel">
                            <label class="city-color-selector"
                                   for="cityColorPicker"
                                   title="اختيار اللون">
                                <input type="color"
                                       class="city-color-picker"
                                       id="cityColorPicker"
                                       name="ThemeColor"
                                       value="@defaultColor" />

                                <span class="city-color-selector-icon">
                                    <i class="bi bi-eyedropper"></i>
                                </span>
                            </label>

                            <div class="city-color-details">
                                <span class="city-color-caption">اللون المختار</span>
                                <strong class="city-color-hex" dir="ltr">@defaultColor</strong>
                            </div>

                            <span class="city-color-status">
                                <i class="bi bi-check-circle-fill"></i>
                            </span>
                        </div>

                        <small class="entity-field-help">
                            <i class="bi bi-info-circle"></i>
                            سيستخدم هذا اللون في أيقونة المدينة والعناصر المرتبطة بها.
                        </small>
                    </div>
                </section>

                <section class="entity-form-section city-guidance-section">
                    <div class="city-guidance-card">
                        <span class="city-guidance-icon">
                            <i class="bi bi-shield-check"></i>
                        </span>

                        <div class="city-guidance-content">
                            <h6 class="city-guidance-title">قبل الحفظ</h6>
                            <p class="city-guidance-text">
                                تأكد من عدم وجود المدينة مسبقًا، لأن المدن ترتبط مباشرة بالمنشآت وعمليات البحث والتصفية.
                            </p>
                        </div>
                    </div>
                </section>
            </div>

            <div class="entity-form-footer">
                <div class="entity-footer-security">
                    <i class="bi bi-shield-check"></i>
                    <div>
                        <strong>حفظ آمن</strong>
                        <span>ستصبح المدينة متاحة للمنشآت فورًا.</span>
                    </div>
                </div>

                <button type="submit"
                        class="btn-save-entity btn-save-city"
                        id="saveCityBtn">
                    <span class="btn-save-entity-icon">
                        <i class="bi bi-floppy-fill"></i>
                    </span>
                    <span class="btn-save-entity-text">حفظ المدينة</span>
                </button>
            </div>
        </form>
    </div>
</div>
