                                                        if (!track) {
                                                            return;
                                                        }

                                                        const cards =
                                                            Array.from(
                                                                track.querySelectorAll(
                                                                    '.package-card'
                                                                )
                                                            );

                                                        if (!cards.length) {
                                                            return;
                                                        }

                                                        let currentIndex =
                                                            Number.parseInt(
                                                                track.dataset.currentIndex || '0',
                                                                10
                                                            ) || 0;

                                                        currentIndex =
                                                            Math.max(
                                                                0,
                                                                currentIndex - 1
                                                            );

                                                        track.dataset.currentIndex =
                                                            String(currentIndex);

                                                        cards[currentIndex]
                                                            .scrollIntoView({
                                                                behavior: 'smooth',
                                                                block: 'nearest',
                                                                inline: 'center'
