    var payload = new
    {
        language = homeLanguage,
        locale = homeLanguage == "en" ? "en-US" : "ar-YE",
        direction = homeLanguage == "en" ? "ltr" : "rtl",
        exact,
        formats
    };

    var json = JsonSerializer.Serialize(payload);
}

<script id="yemenGuideHomeI18nData">
    window.YemenGuideHomeI18n = @Html.Raw(json);
</script>
