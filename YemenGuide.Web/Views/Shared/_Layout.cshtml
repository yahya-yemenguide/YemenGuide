@using System.Globalization
@using System.Linq
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Caching.Memory
@inject YemenGuide.Data.AppDbContext _context
@inject IMemoryCache _cache

@{
    // --- جلب الإعدادات من Cache مشترك بدل Query جديد في كل تنقل ---
    var settings = await _cache.GetOrCreateAsync(
        "yg:customer-shell:settings",
        async entry =>
        {
            entry.AbsoluteExpirationRelativeToNow = TimeSpan.FromSeconds(30);
            return await _context.SystemSettings
                .AsNoTracking()
                .FirstOrDefaultAsync();
        });
    string siteName = settings?.SiteName ?? "YemenGuide";
    string siteDesc = settings?.SiteDescription ?? "دليلك السياحي اليمني";
    string favicon = settings?.FaviconPath ?? "/favicon.ico";

    // -------------------------------------------------------------
    // تحديد الصفحة الحالية.
    // -------------------------------------------------------------
    string currentController =
        ViewContext.RouteData.Values["Controller"]?.ToString() ?? string.Empty;

    string currentAction =
        ViewContext.RouteData.Values["Action"]?.ToString() ?? string.Empty;

    // الرئيسية تستخدم Google Maps فقط؛ لا داعي لتحميل Leaflet عليها.
    bool isHomeIndex =
        string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);

    // نفس محرك الترجمة المركزي لكل صفحات العميل التي تمت ترجمتها.
    // لا ننشئ محرك ترجمة منفصل لكل صفحة.
    bool useCustomerPageLocalization =
        isHomeIndex ||
        (
            string.Equals(currentController, "Places", StringComparison.OrdinalIgnoreCase) &&
            (
                string.Equals(currentAction, "Details", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(currentAction, "Search", StringComparison.OrdinalIgnoreCase)
            )
        );

    // -------------------------------------------------------------
    // اللغة والاتجاه:
    //
    // ar => RTL + Bootstrap RTL
    // en => LTR + Bootstrap العادي
    //
    // لا توجد أي صفحة مستثناة أو مجبرة على RTL.
    // -------------------------------------------------------------
    var currentUiCulture =
        CultureInfo.CurrentUICulture;

    var langCode =
        string.Equals(
            currentUiCulture.TwoLetterISOLanguageName,
            "en",
            StringComparison.OrdinalIgnoreCase)
            ? "en"
            : "ar";

    var isRtl =
        langCode == "ar";

    var direction =
        isRtl ? "rtl" : "ltr";

    var bootstrapCss =
        isRtl
            ? "bootstrap.rtl.min.css"
            : "bootstrap.min.css";

    // -------------------------------------------------------------
    // تحديد صفحات لوحة العميل آلياً دون تعديل كل View على حدة.
    // -------------------------------------------------------------

    var customerDashboardControllers =
        new HashSet<string>(StringComparer.OrdinalIgnoreCase)
                                                                                {
            "Overview",
            "Profile",
            "Messages",
            "Bookings",
            "Payments",
            "Favorites",
            "Reports",
            "Notifications"
                                                                                };

    bool isCustomerDashboardPage =
        User.Identity?.IsAuthenticated == true &&
        User.IsInRole("Customer") &&
        customerDashboardControllers.Contains(currentController);

    bool isAuthenticatedCustomer =
        User.Identity?.IsAuthenticated == true &&
        User.IsInRole("Customer");

    // المودل الإجباري لحسابات Google الجديدة يظهر في أي صفحة عميل،
    // حتى إذا وصل المستخدم لأول مرة إلى الصفحة الرئيسية العامة.
    bool showGooglePasswordSetup = false;

    if (isAuthenticatedCustomer)
    {
        var userIdText = User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (int.TryParse(userIdText, out var authenticatedUserId) && authenticatedUserId > 0)
        {
            showGooglePasswordSetup = await _context.Users
                .AsNoTracking()
                .Where(user => user.UserId == authenticatedUserId)
                .Select(user => user.MustChangePassword)
                .FirstOrDefaultAsync();
        }
    }

    // يقرأها هيدر العميل لتغيير سلوكه في الهاتف.
    ViewData["IsCustomerDashboardPage"] = isCustomerDashboardPage;

    string bodyClass = isCustomerDashboardPage
        ? "customer-dashboard-page has-customer-bottom-nav customer-signature-ui"
        : "customer-public-page customer-signature-ui";

    // كلاسات مساعدة سنستفيد منها لاحقًا أثناء الترجمة
    // وضبط CSS الخاص بكل اتجاه.
    bodyClass += $" lang-{langCode} dir-{direction}";
}

<!DOCTYPE html>
<html lang="@langCode" dir="@direction">
<head>

    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content" />

    <title>@ViewData["Title"] - @siteName | دليلك السياحي اليمني</title>

    <meta name="description" content="@siteDesc" />
    <link rel="icon" type="image/x-icon" href="@favicon" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/css/@bootstrapCss" />

    <link rel="stylesheet"
          href="~/lib/bootstrap-icons/bootstrap-icons.css" />

    <link rel="stylesheet"
          href="~/css/shared/fonts.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/shared/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/customer/customer-layout.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/customer/customer-language-switcher.css"
          asp-append-version="true" />

    @if (isAuthenticatedCustomer)
    {
        @*
    مكتبة الهاتف تبقى على CDN كما هي.
    هذا فقط يجهز DNS/TLS مبكراً ولا يحمل المكتبة.
    *@
        <link rel="preconnect"
          href="https://cdn.jsdelivr.net"
          crossorigin="anonymous" />
        <link rel="dns-prefetch"
          href="//cdn.jsdelivr.net" />
    }

    @if (showGooglePasswordSetup)
    {
        <link rel="stylesheet"
          href="~/css/shared/auth-security-modal.css"
          asp-append-version="true" />
    }

    @if (isCustomerDashboardPage)
    {
        <link rel="stylesheet"
          href="~/css/customer/customer-bottom-nav.css"
          asp-append-version="true" />
    }

    <link rel="stylesheet"
          href="~/css/shared/footer.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    @* إصلاح قائمة استكشف داخل لوحة العميل فقط: خلفية داكنة + نص واضح *@
    <style id="customerDashboardExploreDropdownFix">
        body.customer-dashboard-page #customerSignatureNav .dropdown-menu.modern-dropdown {
            background: rgba(5, 32, 60, 0.985) !important;
            border-color: rgba(0, 166, 218, 0.30) !important;
            box-shadow: 0 18px 45px rgba(5, 32, 60, 0.30) !important;
        }

            body.customer-dashboard-page #customerSignatureNav .dropdown-menu.modern-dropdown .dropdown-item,
            body.customer-dashboard-page #customerSignatureNav .dropdown-menu.modern-dropdown .dropdown-item span,
            body.customer-dashboard-page #customerSignatureNav .dropdown-menu.modern-dropdown .dropdown-item strong,
            body.customer-dashboard-page #customerSignatureNav .dropdown-menu.modern-dropdown .dropdown-item small {
                color: #ffffff !important;
            }

                body.customer-dashboard-page #customerSignatureNav .dropdown-menu.modern-dropdown .dropdown-item:hover,
                body.customer-dashboard-page #customerSignatureNav .dropdown-menu.modern-dropdown .dropdown-item:focus {
                    color: #ffffff !important;
                    background: rgba(0, 166, 218, 0.20) !important;
                    transform: translateX(-2px);
                }

                    body.customer-dashboard-page #customerSignatureNav .dropdown-menu.modern-dropdown .dropdown-item:hover span,
                    body.customer-dashboard-page #customerSignatureNav .dropdown-menu.modern-dropdown .dropdown-item:focus span {
                        color: #ffffff !important;
                    }
    </style>

    @*
    =============================================================
    CUSTOMER DIRECTION LAYER
    =============================================================
    يجب أن يبقى هذا الملف بعد Styles الخاصة بكل صفحة حتى تكون
    قواعد RTL/LTR هي آخر كلمة في الاتجاه، بدون تعديل تصاميم الصفحات.
    =============================================================
    *@
    <link rel="stylesheet"
          href="~/css/customer/customer-direction.css"
          asp-append-version="true" />

    @if (isHomeIndex)
    {
        <link rel="stylesheet"
              href="~/css/customer/home-localization.css"
              asp-append-version="true" />
    }

    @if (!isHomeIndex)
    {
        <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
        <script src="~/lib/leaflet/leaflet.js"></script>
    }

    @*
    =============================================================
    FAST CUSTOMER NAVIGATION — SPECULATION RULES
    =============================================================

    خارج لوحة العميل:
    نجهز صفحة Overview واحدة فقط لأن دائرة الحساب تفتحها.
    هذا يتم في الخلفية ولا يغيّر أي رابط.

    داخل لوحة العميل:
    المتصفح يجهز الصفحة المستهدفة عندما يظهر Intent حقيقي
    مثل Hover/Focus على رابط جانبي (eagerness = moderate).

    لا يوجد AJAX ولا SPA ولا تبديل DOM.
    التنقل يبقى Navigation عادي وآمن من ASP.NET Core.
    =============================================================
    *@
    @if (isAuthenticatedCustomer && !isCustomerDashboardPage)
    {
        <script type="speculationrules">
            {
                "prefetch": [
                    {
                        "source": "list",
                        "urls": [
                            "/Overview/Overview"
                        ],
                        "eagerness": "eager"
                    }
                ]
            }
        </script>
    }
    else if (isAuthenticatedCustomer && isCustomerDashboardPage)
    {
        <script type="speculationrules">
            {
                "prefetch": [
                    {
                        "source": "document",
                        "where": {
                            "selector_matches": ".custom-sidebar-nav a[data-customer-sidebar-link]"
                        },
                        "eagerness": "moderate"
                    }
                ]
            }
        </script>
    }

</head>

<body class="@bodyClass @(showGooglePasswordSetup ? "auth-security-locked" : "")"
      data-customer-dashboard="@(isCustomerDashboardPage ? "true" : "false")"
      data-customer-controller="@currentController"
      data-customer-action="@currentAction"
      data-language="@langCode"
      data-direction="@direction">

    @if (showGooglePasswordSetup)
    {
        <partial name="_GooglePasswordSetupModal" />
    }

    <div class="site-wrapper">

        <partial name="_HeaderCustomer" />

        <main role="main"
              class="site-main-content @(isCustomerDashboardPage ? "customer-dashboard-site-content" : "")">

            @RenderBody()
        </main>

        @if (!isCustomerDashboardPage &&
        (ViewData["HideFooter"] as bool? != true))
        {
            <partial name="_Footer" />
        }

        @if (isCustomerDashboardPage)
        {
            <partial name="_CustomerBottomNav" />
        }
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script src="~/js/customer/customer-layout.js"
            asp-append-version="true"></script>

    <script src="~/js/customer/customer-language-switcher.js"
            asp-append-version="true"></script>

    @if (showGooglePasswordSetup)
    {
        <script src="~/js/shared/auth-security-modal.js"
            asp-append-version="true"></script>
    }

    @if (isCustomerDashboardPage)
    {
        <script src="~/js/customer/customer-bottom-nav.js"
            asp-append-version="true"></script>
    }

    @if (useCustomerPageLocalization)
    {
        <partial name="_HomeLocalizationData" />

        <script src="~/js/customer/home-localization.js"
                asp-append-version="true"></script>
    }

    @await RenderSectionAsync("Scripts", required: false)

    @* =============================================================
       English live clock fix ONLY
       - index.js writes #live-time / #live-date using ar-YE every second.
       - We correct ONLY these two elements after page scripts load.
       - No Date/Intl prototypes, no Google Maps, no translation engine changes.
       ============================================================= *@
    @if (
        isHomeIndex &&
        string.Equals(
            langCode,
            "en",
            StringComparison.OrdinalIgnoreCase
        )
    )
    {
        <script>
            (() => {
                "use strict";

                const timeElement =
                    document.getElementById("live-time");

                const dateElement =
                    document.getElementById("live-date");

                if (!timeElement || !dateElement) {
                    return;
                }

                let applyingEnglishClock = false;

                const renderEnglishClock = () => {
                    if (applyingEnglishClock) {
                        return;
                    }

                    applyingEnglishClock = true;

                    try {
                        const now = new Date();

                        const timeText =
                            now.toLocaleTimeString(
                                "en-US",
                                {
                                    hour: "2-digit",
                                    minute: "2-digit",
                                    hour12: true
                                }
                            );

                        const dateText =
                            now.toLocaleDateString(
                                "en-US",
                                {
                                    weekday: "long",
                                    month: "long",
                                    day: "numeric"
                                }
                            );

                        if (
                            timeElement.textContent !==
                            timeText
                        ) {
                            timeElement.textContent =
                                timeText;
                        }

                        if (
                            dateElement.textContent !==
                            dateText
                        ) {
                            dateElement.textContent =
                                dateText;
                        }
                    }
                    finally {
                        applyingEnglishClock = false;
                    }
                };

                renderEnglishClock();

                const clockObserver =
                    new MutationObserver(() => {
                        renderEnglishClock();
                    });

                clockObserver.observe(
                    timeElement,
                    {
                        childList: true,
                        characterData: true,
                        subtree: true
                    }
                );

                clockObserver.observe(
                    dateElement,
                    {
                        childList: true,
                        characterData: true,
                        subtree: true
                    }
                );
            })();
        </script>
    }

    <button type="button"
            class="customer-back-to-top"
            id="btn-back-to-top"
            aria-label="العودة إلى أعلى الصفحة">
        <i class="bi bi-chevron-up" aria-hidden="true"></i>
    </button>

</body>
</html>
