@model YemenGuide.Core.DTOs.Owner.OwnerAdvertisementManagementPageDto
@using System
@using System.Linq
@using YemenGuide.Core.DTOs.Owner

@{
    ViewData["Title"] = "إدارة الإعلانات";
    Layout = "_OwnerLayout";

    var overview = Model.Overview;
    var ads = Model.Advertisements;
    var wizard = Model.Wizard;
    var availableWizardPlans = wizard.Plans.Where(item => item.IsAvailable).ToList();
}

@section PageStyles {
        <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />
        <link rel="stylesheet" href="~/css/owner/advertisements.css" asp-append-version="true" />
}

        <main class="oad-page"
      dir="rtl"
      data-owner-ads
      data-has-place="@Model.HasPlace.ToString().ToLowerInvariant()"
      data-admin-place="@false"
      data-place-id="@Model.PlaceId"
      data-overview-url="@Url.Action("OverviewTab", "Advertisements", new { area = "Owner" })"
      data-ads-url="@Url.Action("AdvertisementsTab", "Advertisements", new { area = "Owner" })"
      data-wizard-url="@Url.Action("Wizard", "Advertisements", new { area = "Owner" })"
      data-details-url="@Url.Action("Details", "Advertisements", new { area = "Owner" })"
      data-payment-url="@Url.Action("PaymentForm", "Advertisements", new { area = "Owner" })"
      data-quote-url="@Url.Action("PriceQuote", "Advertisements", new { area = "Owner" })"
      data-save-url="@Url.Action("SaveDraft", "Advertisements", new { area = "Owner" })"
      data-submit-url="@Url.Action("Submit", "Advertisements", new { area = "Owner" })"
      data-payment-save-url="@Url.Action("SavePaymentProof", "Advertisements", new { area = "Owner" })"
      data-upload-url="@Url.Action("UploadMedia", "Advertisements", new { area = "Owner" })"
      data-delete-media-url="@Url.Action("DeleteMedia", "Advertisements", new { area = "Owner" })"
      data-pause-url="@Url.Action("Pause", "Advertisements", new { area = "Owner" })"
      data-resume-url="@Url.Action("Resume", "Advertisements", new { area = "Owner" })"
      data-cancel-url="@Url.Action("Cancel", "Advertisements", new { area = "Owner" })"
      data-restore-url="@Url.Action("Restore", "Advertisements", new { area = "Owner" })"
      data-renew-url="@Url.Action("Renew", "Advertisements", new { area = "Owner" })">

        @Html.AntiForgeryToken()

            <header class="oad-head">
                <div class="oad-head__identity">
                    <span class="oad-head__icon"><i class="bi bi-megaphone-fill"></i></span>
                    <div>
                        <span class="oad-kicker">مساحة إعلانات منشأتك</span>
                        <h1>إدارة الإعلانات</h1>
                        <p>أنشئ إعلانك وتابع حالته ونتائجه من صفحة واحدة.</p>
                    </div>
                </div>

                <button type="button"
                class="oad-btn oad-btn--primary oad-create"
                data-open-create
                @(!Model.HasPlace ? "disabled" : null)>
                    <i class="bi bi-plus-lg"></i>
                    <span>إنشاء إعلان</span>
                </button>
            </header>

    @if (!Model.HasPlace)
    {
            <section class="oad-empty oad-empty--page">
                <i class="bi bi-buildings"></i>
                <h2>اختر منشأة من الهيدر أولًا</h2>
                <p>كل إعلان يجب أن يكون تابعًا لإحدى منشآتك.</p>
            </section>
    }
    else
    {
            <div class="oad-tabs-wrap">
                <nav class="oad-tabs" aria-label="تبويبات الإعلانات">
                    <button type="button" class="active" data-main-tab="overview">
                        <span class="oad-tab-icon"><i class="bi bi-grid-1x2-fill"></i></span>
                        <span class="oad-tab-label">نظرة عامة</span>
                    @if (Model.NeedsActionCount > 0)
                    {
                                <b>@Model.NeedsActionCount</b>
                    }
                    </button>
                    <button type="button" data-main-tab="ads">
                        <span class="oad-tab-icon"><i class="bi bi-collection-fill"></i></span>
                        <span class="oad-tab-label">إعلاناتي</span>
                        <b>@ads.TotalItems</b>
                    </button>
                </nav>
            </div>

            <section class="oad-tab-panel active" data-panel="overview">
                <div class="oad-section-title">
                    <div>
                        <span class="oad-kicker">المشهد الآن</span>
                        <h2>أداء إعلانات @Model.PlaceName</h2>
                        <p>الأرقام المهمة فقط، بدون تكرار.</p>
                    </div>
                </div>

                <div class="oad-stats">
                    <article class="is-live">
                        <i class="bi bi-broadcast-pin"></i>
                        <div><small>نشطة</small><strong data-overview-active>@overview.ActiveAdvertisements</strong></div>
                    </article>
                    <article class="is-attention">
                        <i class="bi bi-lightning-charge-fill"></i>
                        <div><small>تحتاج إجراء</small><strong data-overview-action>@(overview.DraftAdvertisements + overview.AwaitingPaymentAdvertisements + overview.PendingAdvertisements + overview.RejectedAdvertisements)</strong></div>
                    </article>
                    <article>
                        <i class="bi bi-eye-fill"></i>
                        <div><small>المشاهدات</small><strong data-overview-impressions>@overview.ImpressionsCount.ToString("N0")</strong></div>
                    </article>
                    <article>
                        <i class="bi bi-cursor-fill"></i>
                        <div><small>النقرات</small><strong data-overview-clicks>@overview.ClicksCount.ToString("N0")</strong></div>
                    </article>
                </div>

                <div class="oad-overview-grid">
                    <article class="oad-card">
                        <header class="oad-card__head">
                            <div>
                                <span class="oad-kicker">يحتاج انتباهك</span>
                                <h3>الإجراءات المطلوبة</h3>
                            </div>
                            <i class="bi bi-bell-fill"></i>
                        </header>

                        <div class="oad-attention-list" data-attention-list>
                        @{
                            var attention = overview.RecentAdvertisements
                            .Where(item => !string.IsNullOrWhiteSpace(item.AttentionText))
                            .Take(4)
                            .ToList();
                        }
                        @if (attention.Count == 0)
                        {
                                    <div class="oad-mini-empty">
                                        <i class="bi bi-check2-circle"></i>
                                        <span>لا يوجد شيء يحتاج إجراء الآن.</span>
                                    </div>
                        }
                        else
                        {
                            @foreach (var item in attention)
                            {
                                            <button type="button" data-details-id="@item.AdvertisementId">
                                                <span class="oad-attention-list__icon"><i class="bi bi-exclamation-circle"></i></span>
                                                <span><strong>@item.AdvertisementTitle</strong><small>@item.AttentionText</small></span>
                                                <i class="bi bi-chevron-left"></i>
                                            </button>
                            }
                        }
                        </div>
                    </article>

                    <article class="oad-card oad-performance-card">
                        <header class="oad-card__head">
                            <div>
                                <span class="oad-kicker">نتائج الحجز</span>
                                <h3>الحجوزات الناتجة عن الإعلان</h3>
                            </div>
                            <i class="bi bi-bar-chart-line-fill"></i>
                        </header>

                        <div class="oad-performance-chart" data-booking-performance-chart>
                            <div class="oad-performance-row"
                                 data-booking-performance-row
                                 data-metric="starts"
                                 data-value="@overview.BookingStartsCount">
                                <div class="oad-performance-row__head">
                                    <span>بدء الحجز من الإعلان</span>
                                    <strong data-booking-performance-value="starts">@overview.BookingStartsCount.ToString("N0")</strong>
                                </div>
                                <div class="oad-performance-track">
                                    <span data-booking-performance-bar></span>
                                </div>
                            </div>

                            <div class="oad-performance-row"
                                 data-booking-performance-row
                                 data-metric="conversions"
                                 data-value="@overview.ConversionsCount">
                                <div class="oad-performance-row__head">
                                    <span>الحجوزات المكتملة من الإعلان</span>
                                    <strong data-booking-performance-value="conversions">@overview.ConversionsCount.ToString("N0")</strong>
                                </div>
                                <div class="oad-performance-track">
                                    <span data-booking-performance-bar></span>
                                </div>
                            </div>
                        </div>
                    </article>

                </div>

                <article class="oad-card oad-how">
                    <header class="oad-card__head">
                        <div>
                            <span class="oad-kicker">إنشاء إعلان</span>
                            <h3>أربع خطوات فقط</h3>
                        </div>

                    </header>
                    <div class="oad-steps">
                        <div><b>1</b><span><strong>اختر طريقة الإعلان</strong><small>مدة محددة أو حسب الأداء</small></span></div>
                        <i class="bi bi-chevron-left"></i>
                        <div><b>2</b><span><strong>جهّز المحتوى</strong><small>عنوان وصورة ووصف</small></span></div>
                        <i class="bi bi-chevron-left"></i>
                        <div><b>3</b><span><strong>حدد الجمهور</strong><small>الجميع أو استهداف مخصص</small></span></div>
                        <i class="bi bi-chevron-left"></i>
                        <div><b>4</b><span><strong>راجع وأرسل</strong><small>ثم أكمل الدفع</small></span></div>
                    </div>
                </article>
            </section>

            <section class="oad-tab-panel" data-panel="ads" hidden>
                <div class="oad-section-title oad-section-title--actions">
                    <div>
                        <span class="oad-kicker">حملاتك</span>
                        <h2>إعلاناتي</h2>
                        <p>الحالة، الدفع، النتائج، والإجراء المطلوب.</p>
                    </div>
                </div>

                <div class="oad-groups" data-groups>
                    <button type="button" class="active" data-group="All"><span>الكل</span><b>@ads.AllCount</b></button>
                    <button type="button" data-group="Running"><span>نشطة</span><b>@ads.RunningCount</b></button>
                    <button type="button" data-group="Scheduled"><span>مجدولة</span><b>@ads.ScheduledCount</b></button>
                    <button type="button" data-group="NeedsAction"><span>تحتاج إجراء</span><b>@ads.NeedsActionCount</b></button>
                    <button type="button" data-group="Paused"><span>متوقفة</span><b>@ads.PausedCount</b></button>
                    <button type="button" data-group="Expired"><span>منتهية</span><b>@ads.ExpiredCount</b></button>
                    <button type="button" data-group="Cancelled"><span>ملغية</span><b>@ads.CancelledCount</b></button>
                </div>

                <form class="oad-filter" data-filter-form>
                    <label class="oad-search">
                        <i class="bi bi-search"></i>
                        <input type="search" name="Search" placeholder="بحث باسم الإعلان..." />
                    </label>
                    <select name="PaymentStatus" aria-label="حالة الدفع">
                        <option value="">كل حالات الدفع</option>
                    @foreach (var option in ads.PaymentStatusOptions)
                    {
                                <option value="@option.Value">@option.Label</option>
                    }
                    </select>
                    <select name="SortBy" aria-label="الترتيب">
                        <option value="Newest">الأحدث</option>
                        <option value="Oldest">الأقدم</option>
                        <option value="MostViewed">الأكثر مشاهدة</option>
                        <option value="NeedsAction">الأهم أولًا</option>
                    </select>
                    <button type="submit" class="oad-btn oad-btn--primary"><i class="bi bi-funnel-fill"></i><span>تطبيق</span></button>
                    <input type="hidden" name="Group" value="All" />
                    <input type="hidden" name="Page" value="1" />
                    <input type="hidden" name="PageSize" value="12" />
                </form>

                <div class="oad-results-line"><span data-results-count>@ads.TotalItems</span> إعلان</div>

                <div class="oad-ad-grid" data-ad-grid>
                @foreach (var item in ads.Items)
                {
                            <article class="oad-ad-card" data-ad-card="@item.AdvertisementId">
                                <div class="oad-ad-card__media">
                            @if (!string.IsNullOrWhiteSpace(item.PrimaryMediaPath))
                            {
                                            <img src="@item.PrimaryMediaPath" alt="@item.AdvertisementTitle" loading="lazy" />
                            }
                            else
                            {
                                            <span><i class="bi bi-image"></i></span>
                            }
                                    <em class="is-@item.Status.ToLowerInvariant()">@item.StatusLabel</em>
                                </div>
                                <div class="oad-ad-card__content">
                                    <div class="oad-ad-card__title">
                                        <div>
                                            <small>#@item.AdvertisementId</small>
                                            <h3>@item.AdvertisementTitle</h3>
                                        </div>
                                        <span class="oad-payment is-@item.PaymentStatus.ToLowerInvariant()">@item.PaymentStatusLabel</span>
                                    </div>
                            @if (!string.IsNullOrWhiteSpace(item.AttentionText))
                            {
                                            <div class="oad-card-alert"><i class="bi bi-exclamation-circle"></i><span>@item.AttentionText</span></div>
                            }
                                    <div class="oad-ad-metrics">
                                        <div class="is-strength">
                                            <small>أولوية العرض</small>
                                            <strong>@item.DisplayWeight%</strong>
                                        </div>
                                        <div><small>نقرات</small><strong>@item.ClicksCount.ToString("N0")</strong></div>
                                        <div><small>حجوزات</small><strong>@item.ConversionsCount.ToString("N0")</strong></div>
                                        <div class="is-unique-views">
                                            <small>عدد المشاهدات</small>
                                            <strong>@item.ImpressionsCount.ToString("N0")</strong>
                                        </div>
                                    </div>
                                    <div class="oad-ad-card__foot">
                                        <span><small>المصروف</small><strong>@item.SpentAmountText</strong></span>
                                        <span><small>المتبقي</small><strong>@item.RemainingBudgetText</strong></span>
                                        <button type="button" class="oad-btn oad-btn--soft" data-details-id="@item.AdvertisementId">
                                            التفاصيل <i class="bi bi-arrow-left"></i>
                                        </button>
                                    </div>
                                </div>
                            </article>
                }
                </div>

                <nav class="oad-pagination" data-pagination @((ads.TotalPages <= 1) ? "hidden" : null)>
                    <button type="button" data-page="@(Math.Max(1, ads.Page - 1))" @(ads.Page <= 1 ? "disabled" : null)><i class="bi bi-chevron-right"></i></button>
                    <span>صفحة <b data-current-page>@ads.Page</b> من <b data-total-pages>@ads.TotalPages</b></span>
                    <button type="button" data-page="@(Math.Min(ads.TotalPages, ads.Page + 1))" @(ads.Page >= ads.TotalPages ? "disabled" : null)><i class="bi bi-chevron-left"></i></button>
                </nav>
            </section>
    }

    <!-- Single-view templates. No partial Razor views are required. -->
    <template id="oad-wizard-template">
        <div class="oad-cb" data-campaign-builder>
            <header class="oad-cb-head">
                <div class="oad-cb-head__mark"><i class="bi bi-megaphone-fill"></i></div>
                <div class="oad-cb-head__text">
                    <span>حملة إعلانية</span>
                    <h2 data-wizard-title>إنشاء إعلان جديد</h2>
                    <p>أكمل الأربع خطوات، والنظام سيرشدك في كل خطوة.</p>
                </div>
            </header>

            <nav class="oad-cb-progress" aria-label="خطوات إنشاء الإعلان">
                <button type="button" class="active" data-step-go="1"><b>1</b><span><strong>الباقة</strong><small>التكلفة والمدة</small></span></button>
                <i></i>
                <button type="button" data-step-go="2"><b>2</b><span><strong>المحتوى</strong><small>النص والوسائط</small></span></button>
                <i></i>
                <button type="button" data-step-go="3"><b>3</b><span><strong>الجهاز</strong><small>مكان المشاهدة</small></span></button>
                <i></i>
                <button type="button" data-step-go="4"><b>4</b><span><strong>المراجعة</strong><small>تأكد ثم ادفع</small></span></button>
            </nav>

            <form class="oad-cb-form" data-wizard-form>
                <input type="hidden" name="AdvertisementId" />
                <input type="hidden" name="RowVersion" />
                <input type="hidden" name="TargetingMode" value="All" />

                <div class="oad-cb-scroll">
                    <div class="oad-wizard-error" data-wizard-error hidden>
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span data-wizard-error-text></span>
                    </div>

                    <section class="oad-cb-step active" data-step="1">
                        <div class="oad-cb-stephead">
                            <span>01</span>
                            <div>
                                <h3>اختر باقة الإعلان</h3>
                                <p>اختر الباقة ثم حدد عدد الأيام وموعد البداية. السعر والإجمالي يحسبهما النظام تلقائيًا.</p>
                            </div>
                        </div>

                        <div class="oad-cb-channel">
                            <i class="bi bi-search-heart-fill"></i>
                            <div>
                                <strong>مكان العرض ثابت</strong>
                                <p>الإعلان يظهر في مساحة الإعلانات داخل صفحة البحث. لا يحتاج المالك لاختيار مكان ظهور.</p>
                            </div>
                        </div>

                        <div class="oad-step1-error" data-step1-error hidden>
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span data-step1-error-text></span>
                        </div>

                        <div class="oad-cb-plans oad-cb-plans--owner" data-plan-grid>
                            @if (!availableWizardPlans.Any())
                            {
                                    <div class="oad-cb-empty-plan">
                                        <i class="bi bi-wallet2"></i>
                                        <strong>لا توجد باقات مفعلة حاليًا</strong>
                                        <span>يجب تفعيل باقة من الإدارة أولًا.</span>
                                    </div>
                            }

                            @for (var planIndex = 0; planIndex < availableWizardPlans.Count; planIndex++)
                            {
                                var plan = availableWizardPlans[planIndex];
                                var isExtraPlan = planIndex >= 6;

                                    <label class="oad-cb-plan oad-cb-plan--owner @(isExtraPlan ? "oad-cb-plan--extra" : "")"
                                       data-plan
                                       data-plan-id="@plan.AdvertisementPlanId"
                                       data-plan-name="@plan.PlanName"
                                       data-price="@plan.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       data-price-text="@plan.PriceText"
                                       data-weight="@plan.DisplayWeight">
                                        <input type="radio"
                                           name="AdvertisementPlanId"
                                           value="@plan.AdvertisementPlanId" />

                                        <span class="oad-cb-plan__check oad-cb-plan__check--corner">
                                            <i class="bi bi-check-lg"></i>
                                        </span>

                                        <div class="oad-cb-plan__top">
                                            <span class="oad-cb-plan__icon"><i class="bi bi-stars"></i></span>
                                        </div>

                                        <div class="oad-cb-plan__body">
                                            <strong data-plan-label>@plan.PlanName</strong>
                                        @if (!string.IsNullOrWhiteSpace(plan.Description))
                                        {
                                                    <p>@plan.Description</p>
                                        }
                                        </div>

                                        <div class="oad-plan-meta">
                                            <span>
                                                <small>أولوية العرض</small>
                                                <b>@plan.DisplayWeight%</b>
                                            </span>
                                            <span>
                                                <small>سعر اليوم</small>
                                                <b>@plan.PriceText</b>
                                            </span>
                                        </div>
                                    </label>
                            }
                        </div>

                        @if (availableWizardPlans.Count > 6)
                        {
                                <div class="oad-plan-more-wrap">
                                    <button type="button"
                                        class="oad-plan-more"
                                        data-plan-toggle
                                        data-expanded="false"
                                        data-hidden-count="@(availableWizardPlans.Count - 6)">
                                        <span>عرض المزيد (@(availableWizardPlans.Count - 6))</span>
                                        <i class="bi bi-chevron-down"></i>
                                    </button>
                                </div>
                        }

                        <div class="oad-cb-package" data-package-config>
                            <section class="oad-cb-packagebox" data-flat-panel hidden>
                                <header>
                                    <span><i class="bi bi-calendar3"></i></span>
                                    <div>
                                        <small>مدة الإعلان</small>
                                        <h4>كم يوم تريد أن يستمر الإعلان؟</h4>
                                    </div>
                                </header>

                                <div class="oad-cb-packagegrid">
                                    <label class="oad-duration-field">
                                        <span>عدد الأيام</span>
                                        <input type="number"
                                               name="DurationDays"
                                               min="1"
                                               max="365"
                                               value="1"
                                               inputmode="numeric"
                                               aria-describedby="oad-duration-help" />
                                        <small id="oad-duration-help" class="oad-duration-help">
                                            من يوم واحد إلى سنة كحد أقصى (365 يومًا).
                                        </small>
                                        <small class="oad-duration-error" data-duration-error hidden></small>
                                    </label>

                                    <div class="oad-cb-value">
                                        <small>سعر اليوم</small>
                                        <strong data-flat-unit>—</strong>
                                    </div>

                                    <div class="oad-cb-value">
                                        <small>أولوية العرض</small>
                                        <strong data-flat-weight>—</strong>
                                    </div>

                                    <div class="oad-cb-value is-highlight">
                                        <small>إجمالي الإعلان</small>
                                        <strong data-flat-total>—</strong>
                                    </div>
                                </div>
                            </section>
                        </div>

                        <section class="oad-cb-start">
                            <header>
                                <span><i class="bi bi-clock-history"></i></span>
                                <div>
                                    <small>موعد البداية</small>
                                    <h4>متى تريد بدء الإعلان؟</h4>
                                </div>
                            </header>

                            <div class="oad-cb-choices">
                                <label>
                                    <input type="radio" name="StartImmediately" value="true" checked />
                                    <span>
                                        <i class="bi bi-shield-check"></i>
                                        <b>ابدأ بعد اعتماد الإدارة</b>
                                        <small>يبدأ الإعلان بعد اعتماد الإدارة للدفع والمحتوى.</small>
                                    </span>
                                </label>

                                <label>
                                    <input type="radio" name="StartImmediately" value="false" />
                                    <span>
                                        <i class="bi bi-calendar-event"></i>
                                        <b>تاريخ مستقبلي</b>
                                        <small>اطلب تاريخًا محددًا إذا أردت البدء لاحقًا.</small>
                                    </span>
                                </label>
                            </div>

                            <div class="oad-cb-datewrap" data-start-date hidden>
                                <div class="oad-cb-date">
                                    <span>التاريخ والوقت المطلوب</span>
                                    <input type="hidden" name="RequestedStartAt" />
                                    <button type="button"
                                            class="oad-datetime-trigger"
                                            data-future-datetime-trigger
                                            lang="en-US"
                                            dir="ltr">
                                        <span data-future-datetime-text>Select date, hour &amp; minute</span>
                                        <i class="bi bi-calendar3"></i>
                                    </button>
                                    <div class="oad-future-picker"
                                         data-future-datetime-picker
                                         lang="en-US"
                                         dir="ltr"
                                         hidden></div>
                                    <small>إذا تم الاعتماد بعد هذا الموعد، يبدأ الإعلان عند الاعتماد الفعلي.</small>
                                </div>
                            </div>
                        </section>

                        <div class="oad-cb-summary is-step1-summary" data-quote>
                            <div><small>الباقة</small><strong data-quote-plan>اختر باقة</strong></div>
                            <div><small>أولوية العرض</small><strong data-quote-weight>—</strong></div>
                            <div><small>سعر اليوم</small><strong data-quote-daily>—</strong></div>
                            <div><small>عدد الأيام</small><strong data-quote-days>1 يوم</strong></div>
                            <div><small>الإجمالي</small><strong data-quote-total>—</strong></div>
                            <p data-quote-note>اختر الباقة أولًا لإظهار السعر والإجمالي.</p>
                        </div>
                    </section>

                    <section class="oad-cb-step" data-step="2" hidden>
                        <div class="oad-cb-stephead">
                            <span>02</span>
                            <div>
                                <h3>محتوى الإعلان</h3>
                                <p>اكتب محتوى واضحًا، ثم اختر وسيطًا واحدًا فقط للإعلان.</p>
                            </div>
                        </div>

                        <div class="oad-cb-content-layout">
                            <div class="oad-cb-editor">
                                <label class="wide">
                                    <span>عنوان الإعلان <b>*</b></span>
                                    <input type="text"
                                           name="AdvertisementTitle"
                                           maxlength="150"
                                           placeholder="مثال: إقامة مميزة في قلب صنعاء" />
                                </label>

                                <label class="wide">
                                    <span>الوصف المختصر</span>
                                    <textarea name="ShortDescription"
                                              maxlength="300"
                                              rows="4"
                                              placeholder="اكتب ميزة أو عرضًا واضحًا يجذب المستخدم..."></textarea>
                                </label>

                                <div class="oad-cb-two">
                                    <label>
                                        <span>نص الزر <b>*</b></span>
                                        <input type="text"
                                               name="ButtonText"
                                               maxlength="50"
                                               value="عرض المنشأة"
                                               placeholder="مثال: عرض المنشأة أو احجز الآن" />
                                    </label>

                                    <label>
                                        <span>العرض المرتبط <small>(اختياري)</small></span>
                                        <select name="PromotionId">
                                            <option value="">بدون عرض</option>
                                            @foreach (var promotion in wizard.Promotions)
                                            {
                                                    <option value="@promotion.Value">@promotion.Label</option>
                                            }
                                        </select>
                                    </label>
                                </div>

                                <div class="oad-media-choice" data-media-choice>
                                    <div class="oad-media-slot">
                                        <label class="oad-media-option is-image">
                                            <input type="file"
                                                   data-image-file
                                                   accept="image/jpeg,image/png,image/webp" />
                                            <span class="oad-media-option__icon"><i class="bi bi-image-fill"></i></span>
                                            <span class="oad-media-option__text">
                                                <strong>صورة الإعلان <b>*</b></strong>
                                                <small data-image-name>JPG / PNG / WebP حتى 10MB</small>
                                            </span>
                                            <span class="oad-media-option__check"><i class="bi bi-check2"></i></span>
                                        </label>
                                        <button type="button"
                                                class="oad-media-clear"
                                                data-clear-image
                                                hidden>
                                            <i class="bi bi-x-circle"></i>
                                            إلغاء تحديد الصورة
                                        </button>
                                    </div>

                                    <div class="oad-media-or"><span>أو</span></div>

                                    <div class="oad-media-slot">
                                        <label class="oad-media-option is-video">
                                            <input type="file"
                                                   data-video-file
                                                   accept="video/mp4,video/webm" />
                                            <span class="oad-media-option__icon"><i class="bi bi-camera-video-fill"></i></span>
                                            <span class="oad-media-option__text">
                                                <strong>فيديو بديل <em>اختياري</em></strong>
                                                <small data-video-name>MP4 / WebM حتى 25MB</small>
                                            </span>
                                            <span class="oad-media-option__check"><i class="bi bi-check2"></i></span>
                                        </label>
                                        <button type="button"
                                                class="oad-media-clear"
                                                data-clear-video
                                                hidden>
                                            <i class="bi bi-x-circle"></i>
                                            إلغاء تحديد الفيديو
                                        </button>
                                    </div>
                                </div>

                                <div class="oad-media-rule oad-media-rule--strong">
                                    <i class="bi bi-exclamation-circle-fill"></i>
                                    <span>
                                        اختر <strong>صورة أو فيديو واحدًا فقط</strong>.
                                        بعد اختيار أحدهما يجب إلغاء تحديده أولًا قبل اختيار النوع الآخر.
                                    </span>
                                </div>
                            </div>

                            <aside class="oad-cb-previewbox">
                                <span class="oad-cb-previewbox__label">معاينة الإعلان</span>
                                <div class="oad-cb-adpreview" data-live-preview>
                                    <div class="oad-cb-adpreview__media" data-preview-media><i class="bi bi-image"></i></div>
                                    <div class="oad-cb-adpreview__content">
                                        <small>إعلان ممول</small>
                                        <h4 data-preview-title>عنوان إعلانك</h4>
                                        <p data-preview-desc>سيظهر الوصف هنا.</p>
                                        <button type="button" data-preview-button>عرض المنشأة</button>
                                    </div>
                                </div>
                            </aside>
                        </div>
                    </section>

                    <section class="oad-cb-step" data-step="3" hidden>
                        <div class="oad-cb-stephead">
                            <span>03</span>
                            <div>
                                <h3>اختيار الجهاز</h3>
                                <p>الإعلان موجه لجميع المستخدمين. اختر فقط نوع الجهاز الذي يمكن أن يظهر عليه.</p>
                            </div>
                        </div>

                        <div class="oad-cb-channel">
                            <i class="bi bi-people-fill"></i>
                            <div>
                                <strong>الجمهور: جميع المستخدمين</strong>
                                <p>لا يوجد استهداف مدن أو فئات في نظام الإعلانات الحالي.</p>
                            </div>
                        </div>

                        <div class="oad-cb-device oad-cb-device--simple">
                            <span><i class="bi bi-phone"></i></span>
                            <div>
                                <small>الجهاز</small>
                                <strong>أين تريد أن يكون الإعلان مؤهلًا للظهور؟</strong>
                            </div>
                            <select name="DeviceTarget">
                                <option value="All">كل الأجهزة</option>
                                <option value="Mobile">الهاتف</option>
                                <option value="Desktop">الكمبيوتر</option>
                            </select>
                        </div>
                    </section>

                    <section class="oad-cb-step" data-step="4" hidden>
                        <div class="oad-cb-stephead">
                            <span>04</span>
                            <div>
                                <h3>المراجعة النهائية</h3>
                                <p>راجع بيانات الإعلان قبل تثبيتها والانتقال إلى الدفع.</p>
                            </div>
                        </div>

                        <div class="oad-cb-review-layout">
                            <aside class="oad-cb-previewbox">
                                <span class="oad-cb-previewbox__label">شكل الإعلان</span>
                                <div class="oad-cb-adpreview" data-review-preview>
                                    <div class="oad-cb-adpreview__media" data-review-media><i class="bi bi-image"></i></div>
                                    <div class="oad-cb-adpreview__content">
                                        <small>إعلان ممول</small>
                                        <h4 data-review-title>عنوان الإعلان</h4>
                                        <p data-review-desc>الوصف</p>
                                        <button type="button" data-review-button>عرض المنشأة</button>
                                    </div>
                                </div>
                            </aside>

                            <div class="oad-cb-reviewcard oad-cb-reviewcard--compact">
                                <header>
                                    <span><i class="bi bi-check2-circle"></i></span>
                                    <div>
                                        <small>ملخص الإعلان</small>
                                        <h4>راجع التفاصيل</h4>
                                    </div>
                                </header>

                                <dl>
                                    <div><dt>الباقة</dt><dd data-review-plan>—</dd></div>
                                    <div><dt>أولوية العرض</dt><dd data-review-weight>—</dd></div>
                                    <div><dt>سعر اليوم</dt><dd data-review-daily>—</dd></div>
                                    <div><dt>عدد الأيام</dt><dd data-review-days>—</dd></div>
                                    <div><dt>الإجمالي</dt><dd data-review-total>—</dd></div>
                                    <div><dt>البداية</dt><dd data-review-start>بعد اعتماد الإدارة</dd></div>
                                    <div><dt>النهاية المتوقعة</dt><dd data-review-end>تُحسب من وقت البدء الفعلي</dd></div>
                                    <div><dt>الجهاز</dt><dd data-review-device>كل الأجهزة</dd></div>
                                    <div><dt>زر الإعلان</dt><dd data-review-button-text>عرض المنشأة</dd></div>
                                    <div><dt>العرض المرتبط</dt><dd data-review-promotion>بدون عرض</dd></div>
                                </dl>
                            </div>
                        </div>

                        <div class="oad-cb-after-submit">
                            <div><b>1</b><span>تأكيد الطلب</span></div>
                            <i class="bi bi-arrow-left"></i>
                            <div><b>2</b><span>إكمال الدفع</span></div>
                            <i class="bi bi-arrow-left"></i>
                            <div><b>3</b><span>مراجعة الإدارة</span></div>
                            <i class="bi bi-arrow-left"></i>
                            <div><b>4</b><span>بدء العرض</span></div>
                        </div>
                    </section>
                </div>

                <div class="oad-wizard-confirm" data-wizard-confirm hidden>
                    <div class="oad-wizard-confirm__card">
                        <span class="oad-wizard-confirm__icon"><i class="bi bi-credit-card-2-front-fill"></i></span>
                        <h3>تأكيد الإعلان والانتقال للدفع</h3>
                        <p>سيتم تثبيت الباقة وأولوية العرض والسعر وعدد الأيام، ثم تنتقل لإدخال بيانات الدفع.</p>
                        <div class="oad-wizard-confirm__actions">
                            <button type="button" class="is-back" data-wizard-confirm-back>
                                <i class="bi bi-arrow-right"></i>
                                تراجع
                            </button>
                            <button type="button" class="is-confirm" data-wizard-confirm-pay>
                                <i class="bi bi-check2-circle"></i>
                                تأكيد والانتقال للدفع
                            </button>
                        </div>
                    </div>
                </div>

                <footer class="oad-cb-footer">
                    <button type="button" class="oad-cb-btn is-back" data-prev hidden><i class="bi bi-arrow-right"></i><span>السابق</span></button>
                    <div class="oad-cb-footer__spacer"></div>
                    <button type="button" class="oad-cb-btn is-next" data-next><span>التالي</span><i class="bi bi-arrow-left"></i></button>
                    <button type="button" class="oad-cb-btn is-submit" data-save-submit hidden><i class="bi bi-send-check-fill"></i><span>حفظ وإرسال</span></button>
                </footer>
            </form>
        </div>
    </template>

    <template id="oad-details-template">
        <div class="oad-details" data-details-shell>
            <header class="oad-modal-head oad-detail-head">
                <div class="oad-detail-head__identity">
                    <span class="oad-detail-head__icon"><i class="bi bi-megaphone-fill"></i></span>
                    <div>
                        <span class="oad-kicker">تفاصيل الإعلان</span>
                        <h2 data-d-title>—</h2>
                        <p data-d-place>—</p>
                    </div>
                </div>
                <div class="oad-detail-status">
                    <span data-d-status></span>
                    <span data-d-payment></span>
                </div>
            </header>

            <div class="oad-details-body">
                <section class="oad-detail-top">
                    <div class="oad-detail-media" data-d-media><i class="bi bi-image"></i></div>
                    <div class="oad-detail-summary">
                        <span class="oad-detail-summary__eyebrow">طريقة الإعلان</span>
                        <strong data-d-billing>—</strong>
                        <p data-d-description>—</p>
                        <div class="oad-detail-inline">
                            <span><i class="bi bi-calendar3"></i><b>المدة</b><em data-d-duration>—</em></span>
                            <span><i class="bi bi-people"></i><b>الاستهداف</b><em data-d-targeting>—</em></span>
                        </div>
                    </div>
                </section>

                <section class="oad-detail-metrics">
                    <article><i class="bi bi-eye"></i><span><small>المشاهدات</small><strong data-d-impressions>0</strong></span></article>
                    <article><i class="bi bi-cursor"></i><span><small>النقرات</small><strong data-d-clicks>0</strong></span></article>
                    <article><i class="bi bi-door-open"></i><span><small>بدء الحجز</small><strong data-d-starts>0</strong></span></article>
                    <article><i class="bi bi-check2-circle"></i><span><small>حجوزات مكتملة</small><strong data-d-conversions>0</strong></span></article>
                </section>

                <section class="oad-detail-panels">
                    <article>
                        <header><span><i class="bi bi-wallet2"></i></span><div><small>الجانب المالي</small><h3>التكلفة والميزانية</h3></div></header>
                        <dl>
                            <div><dt>المبلغ المطلوب</dt><dd data-d-expected>—</dd></div>
                            <div><dt>المصروف</dt><dd data-d-spent>—</dd></div>
                            <div><dt>المتبقي</dt><dd data-d-remaining>—</dd></div>
                        </dl>
                    </article>

                    <article>
                        <header><span><i class="bi bi-bullseye"></i></span><div><small>الجمهور والوقت</small><h3>الاستهداف والمواعيد</h3></div></header>
                        <dl>
                            <div><dt>الأجهزة</dt><dd data-d-device>—</dd></div>
                            <div><dt>تاريخ البداية</dt><dd data-d-start-date>—</dd></div>
                            <div><dt>وقت البداية</dt><dd data-d-start-time>—</dd></div>
                            <div><dt>تاريخ النهاية</dt><dd data-d-end-date>—</dd></div>
                            <div><dt>وقت النهاية</dt><dd data-d-end-time>—</dd></div>
                        </dl>
                    </article>
                </section>

                <section class="oad-detail-refund" data-d-refund hidden>
                    <header>
                        <span class="oad-detail-refund__icon"><i class="bi bi-arrow-counterclockwise"></i></span>
                        <div>
                            <small>استرداد الإعلان</small>
                            <h3 data-d-refund-status>بانتظار الاسترداد</h3>
                            <p>الوجهة التي اختارها المالك محفوظة مع طلب الإلغاء، وبعد التنفيذ يظهر مرجع وإثبات التحويل هنا.</p>
                        </div>
                    </header>
                    <dl>
                        <div><dt>المبلغ</dt><dd data-d-refund-amount>—</dd></div>
                        <div><dt>المحفظة</dt><dd data-d-refund-wallet>—</dd></div>
                        <div><dt>رقم الحساب</dt><dd data-d-refund-account>—</dd></div>
                        <div><dt>المستفيد</dt><dd data-d-refund-beneficiary>—</dd></div>
                        <div><dt>تاريخ طلب الاسترداد</dt><dd data-d-refund-requested-date>—</dd></div>
                        <div><dt>وقت طلب الاسترداد</dt><dd data-d-refund-requested-time>—</dd></div>
                        <div><dt>تاريخ التنفيذ</dt><dd data-d-refund-at-date>—</dd></div>
                        <div><dt>وقت التنفيذ</dt><dd data-d-refund-at-time>—</dd></div>
                        <div><dt>رقم المرجع</dt><dd data-d-refund-reference>—</dd></div>
                        <div><dt>ملاحظة الإدارة</dt><dd data-d-refund-note>—</dd></div>
                    </dl>
                    <div class="oad-detail-refund__proof" data-d-refund-proof></div>
                </section>

                <div class="oad-detail-notice" data-d-notice hidden></div>
            </div>

            <footer class="oad-detail-actions" data-d-actions></footer>
        </div>
    </template>

    <template id="oad-payment-template">
        <div class="oad-pm" data-payment-shell>
            <header class="oad-pm-head">
                <span class="oad-pm-head__icon"><i class="bi bi-receipt-cutoff"></i></span>
                <div class="oad-pm-head__text">
                    <span>إكمال الإعلان</span>
                    <h2>رفع إثبات الدفع</h2>
                    <p data-pay-title>—</p>
                </div>
            </header>

            <form class="oad-pm-form" data-payment-form enctype="multipart/form-data">
                <input type="hidden" name="AdvertisementId" />
                <input type="hidden" name="RowVersion" />

                <div class="oad-payment-error oad-payment-error--above"
                     data-payment-error
                     hidden>
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span data-payment-error-text></span>
                </div>

                <div class="oad-pm-scroll">
                    <section class="oad-pm-summary">
                        <article class="is-main">
                            <span><i class="bi bi-cash-stack"></i></span>
                            <div><small>المبلغ المطلوب</small><strong data-pay-amount>—</strong></div>
                        </article>
                        <article>
                            <span><i class="bi bi-wallet2"></i></span>
                            <div><small>طريقة الإعلان</small><strong data-pay-billing>—</strong></div>
                        </article>
                        <article>
                            <span><i class="bi bi-search-heart"></i></span>
                            <div><small>قناة العرض</small><strong>شريط الإعلانات في البحث</strong></div>
                        </article>
                    </section>

                    <div class="oad-pm-layout">
                        <section class="oad-pm-panel">
                            <header class="oad-pm-panel__head">
                                <span><i class="bi bi-wallet-fill"></i></span>
                                <div>
                                    <small>الخطوة الأولى</small>
                                    <h3>اختر محفظة التحويل</h3>
                                    <p>حوّل المبلغ إلى إحدى محافظ المنصة التالية.</p>
                                </div>
                            </header>
                            <div class="oad-pm-wallets" data-wallets></div>
                        </section>

                        <section class="oad-pm-panel">
                            <header class="oad-pm-panel__head">
                                <span><i class="bi bi-send-check-fill"></i></span>
                                <div>
                                    <small>الخطوة الثانية</small>
                                    <h3>أدخل بيانات الحوالة</h3>
                                    <p>اكتب نفس البيانات الموجودة في إيصال التحويل.</p>
                                </div>
                            </header>

                            <div class="oad-pm-fields">
                                <label>
                                    <span>المبلغ المحول <b>*</b></span>
                                    <div class="oad-pm-input"><i class="bi bi-cash"></i><input type="number" name="TransferredAmount" min="0.01" step="0.01" inputmode="decimal" lang="en-US" dir="ltr" class="oad-en-digits" /></div>
                                </label>
                                <label>
                                    <span>رقم الحوالة <b>*</b></span>
                                    <div class="oad-pm-input"><i class="bi bi-hash"></i><input type="text" name="ReferenceNumber" inputmode="numeric" pattern="[0-9]*" lang="en-US" dir="ltr" class="oad-en-digits" placeholder="Enter transfer number" /></div>
                                </label>
                                <label class="wide">
                                    <span>تاريخ الحوالة <b>*</b></span>
                                    <div class="oad-pm-input"><i class="bi bi-calendar3"></i><input type="date" name="TransferDate" lang="en-US" dir="ltr" class="oad-en-digits" /></div>
                                </label>

                                <label class="oad-pm-upload wide">
                                    <input type="file" name="receiptImage" accept="image/jpeg,image/png,image/webp" data-receipt-file />
                                    <span class="oad-pm-upload__icon"><i class="bi bi-cloud-arrow-up-fill"></i></span>
                                    <span class="oad-pm-upload__text">
                                        <strong>ارفع صورة الإيصال</strong>
                                        <small data-receipt-name>اضغط لاختيار JPG أو PNG أو WebP — حتى 8MB</small>
                                    </span>
                                    <span class="oad-pm-upload__action">اختيار صورة</span>
                                </label>
                            </div>
                        </section>
                    </div>

                    <div class="oad-pm-note">
                        <i class="bi bi-shield-check"></i>
                        <div>
                            <strong>ماذا يحدث بعد الإرسال؟</strong>
                            <span data-pay-policy-text>تراجع الإدارة إثبات الدفع، وتختلف سياسة الاسترداد حسب موعد بداية الإعلان.</span>
                        </div>
                    </div>
                </div>

                <div class="oad-payment-confirm" data-payment-confirm hidden>
                    <div class="oad-payment-confirm__card">
                        <span class="oad-payment-confirm__icon"><i class="bi bi-shield-check"></i></span>
                        <h3>تأكيد إرسال الدفع</h3>
                        <p data-payment-confirm-text>بعد التأكيد سيتم إرسال إثبات الدفع والإعلان إلى الإدارة للمراجعة.</p>
                        <div class="oad-payment-confirm__actions">
                            <button type="button" class="is-back" data-payment-confirm-back>تراجع</button>
                            <button type="button" class="is-confirm" data-payment-confirm-send>تأكيد وإرسال للإدارة</button>
                        </div>
                    </div>
                </div>

                <footer class="oad-pm-footer">
                    <div>
                        <small>المبلغ المطلوب</small>
                        <strong data-pay-footer-amount>—</strong>
                    </div>
                    <button type="button"
                            class="oad-pm-submit"
                            data-payment-review>
                        <i class="bi bi-cloud-arrow-up-fill"></i>
                        <span>مراجعة وإرسال الدفع</span>
                    </button>
                </footer>
            </form>
        </div>
    </template>

</main>

@section Scripts {
        <script src="~/lib/sweetalert2/sweetalert2.js"></script>
        <script src="~/js/owner/advertisements.js" asp-append-version="true"></script>
}
