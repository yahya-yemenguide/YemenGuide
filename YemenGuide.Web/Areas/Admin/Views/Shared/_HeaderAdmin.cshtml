@inject YemenGuide.Data.AppDbContext _context
@inject Microsoft.Extensions.Localization.IStringLocalizer<YemenGuide.Web.SharedResource> L
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using System.Collections.Generic
@using System.Linq
@using System.Globalization
@using System.Text.RegularExpressions

@{
    bool isEnglish =
        string.Equals(
            CultureInfo.CurrentUICulture.TwoLetterISOLanguageName,
            "en",
            StringComparison.OrdinalIgnoreCase);

    string siteName =
        ViewData["AdminSiteName"] as string ?? "YemenGuide";

    string logoPath =
        ViewData["AdminLogoPath"] as string ?? "/images/logo1.png";

    if (!(ViewData["AdminLayoutSettingsLoaded"] as bool? ?? false))
    {
        var headerSettings = _context.SystemSettings
            .AsNoTracking()
            .OrderBy(s => s.Id)
            .Select(s => new
            {
                s.SiteName,
                s.SiteNameEn,
                s.LogoPath
            })
            .FirstOrDefault();

        siteName =
            isEnglish
                ? !string.IsNullOrWhiteSpace(headerSettings?.SiteNameEn)
                    ? headerSettings!.SiteNameEn!
                    : "YemenGuide"
                : string.IsNullOrWhiteSpace(headerSettings?.SiteName)
                    ? "YemenGuide"
                    : headerSettings!.SiteName!;

        logoPath =
            string.IsNullOrWhiteSpace(headerSettings?.LogoPath)
                ? "/images/logo1.png"
                : headerSettings!.LogoPath!;
    }

    var uId =
        User.Identity?.IsAuthenticated == true
            ? User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "0"
            : "0";

    var isCompact =
        Context.Request.Cookies[$"compactMode_{uId}"] == "enabled";

    var userIdClaim =
        User.FindFirstValue(ClaimTypes.NameIdentifier);

    string displayImg = "";
    string initialLetter = "A";

    bool isSystemAdmin =
        User.IsInRole("SuperAdmin");

    var adminPermissionKeys =
        new HashSet<string>(
            StringComparer.OrdinalIgnoreCase);

    YemenGuide.Core.Entities.User? currentUser = null;

    if (
        !string.IsNullOrEmpty(userIdClaim) &&
        int.TryParse(userIdClaim, out int userId)
    )
    {
        currentUser =
            _context.Users
                .AsNoTracking()
                .FirstOrDefault(u => u.UserId == userId);

        if (currentUser != null)
        {
            displayImg =
                currentUser.ProfileImage ?? "";

            initialLetter =
                !string.IsNullOrWhiteSpace(currentUser.FullName)
                    ? currentUser.FullName.Trim().Substring(0, 1).ToUpper()
                    : "A";

            if (
                isEnglish &&
                Regex.IsMatch(
                    initialLetter,
                    @"[\u0600-\u06FF]")
            )
            {
                initialLetter = "A";
            }

            if (currentUser.AdminRoleId.HasValue)
            {
                var adminRole =
                    _context.AdminRoles
                        .AsNoTracking()
                        .FirstOrDefault(role =>
                            role.AdminRoleId ==
                            currentUser.AdminRoleId.Value);

                if (adminRole?.IsSystemRole == true)
                {
                    isSystemAdmin = true;
                }
                else
                {
                    var permissionKeys =
                        _context.AdminRolePermissions
                            .AsNoTracking()
                            .Where(link =>
                                link.AdminRoleId ==
                                    currentUser.AdminRoleId.Value &&
                                link.AdminPermission.IsActive == true)
                            .Select(link =>
                                link.AdminPermission.PermissionKey)
                            .ToList();

                    foreach (var key in permissionKeys)
                    {
                        if (!string.IsNullOrWhiteSpace(key))
                        {
                            adminPermissionKeys.Add(key.Trim());
                        }
                    }
                }
            }
        }
    }

    bool HasPermission(string key) =>
        isSystemAdmin ||
        adminPermissionKeys.Contains(key);

    bool HasPermissionPrefix(string prefix) =>
        isSystemAdmin ||
        adminPermissionKeys.Any(key =>
            key.StartsWith(
                prefix,
                StringComparison.OrdinalIgnoreCase));

    bool canDashboard = HasPermission("Dashboard.View");

    bool canEmployees =
        HasPermissionPrefix("Employees.") ||
        HasPermissionPrefix("Roles.") ||
        HasPermissionPrefix("AuditLogs.");

    bool canUsers = HasPermissionPrefix("Users.");
    bool canPlaces = HasPermissionPrefix("Places.");
    bool canAdvertisements = HasPermissionPrefix("Advertisements.");
    bool canCases = HasPermissionPrefix("Cases.");
    bool canFinance = HasPermissionPrefix("Finance.");

    bool canMasterData =
        HasPermissionPrefix("MasterData.") ||
        HasPermissionPrefix("Categories.") ||
        HasPermissionPrefix("Cities.");

    bool canSettings = HasPermissionPrefix("Settings.");

    bool canAddCategory =
        isSystemAdmin ||
        HasPermission("MasterData.ManageCategories");

    bool canAddPlace =
        isSystemAdmin ||
        HasPermission("Places.Create");

    bool showQuickActions =
        canAddCategory ||
        canUsers ||
        canAddPlace;
}

<aside class="dashboard-sidebar @(isCompact ? "sidebar-collapsed" : "")"
       id="dashboardSidebar"
       aria-label="@L["Admin_Sidebar_Aria"]">

    <div class="yg-admin-static-sidebar-scene" aria-hidden="true">
        <span class="yg-admin-static-sidebar-glow"></span>
    </div>

    <div class="sidebar-header">
        <a class="sidebar-brand"
           asp-area=""
           asp-controller="Home"
           asp-action="Index"
           title="@siteName">

            <span class="yg-platform-orb" aria-hidden="true">
                <span class="yg-platform-ring yg-platform-ring-a"></span>
                <span class="yg-platform-ring yg-platform-ring-b"></span>
                <span class="yg-platform-star"></span>
                <img src="@logoPath"
                     alt="@siteName"
                     class="sidebar-brand-logo"
                     data-fallback-src="/images/logo1.png"
                     height="35" />
            </span>

            <span class="brand-text">@siteName</span>
        </a>

        <button type="button"
                class="sidebar-close-mobile"
                id="mobileSidebarClose"
                aria-label="@L["Admin_Sidebar_Close"]"
                title="@L["Admin_Sidebar_CloseTitle"]">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
    </div>

    <div class="sidebar-menu">
        <ul class="sidebar-nav">
            <li class="nav-item @(!canDashboard ? "d-none" : "")">
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminDashboard" && ViewContext.RouteData.Values["Action"]?.ToString() != "SystemSettings" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="AdminDashboard"
                   asp-action="DashboardOverview">
                    <i class="bi bi-speedometer2" aria-hidden="true"></i>
                    <span class="nav-text">@L["Admin_Sidebar_Dashboard"]</span>
                </a>
            </li>

            <li class="nav-item @(!canEmployees ? "d-none" : "")">
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Employees" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Employees"
                   asp-action="EmployeeManagement">
                    <i class="bi bi-person-badge-fill" aria-hidden="true"></i>
                    <span class="nav-text">@L["Admin_Sidebar_Employees"]</span>
                </a>
            </li>

            <li class="nav-item @(!canUsers ? "d-none" : "")">
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Users"
                   asp-action="UserManagement">
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <span class="nav-text">@L["Admin_Sidebar_Users"]</span>
                </a>
            </li>

            <li class="nav-item @(!canPlaces ? "d-none" : "")">
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Places" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Places"
                   asp-action="PlaceManagement">
                    <i class="bi bi-buildings" aria-hidden="true"></i>
                    <span class="nav-text">@L["Admin_Sidebar_Places"]</span>
                </a>
            </li>

            <li class="nav-item @(!canAdvertisements ? "d-none" : "")">
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Advertisements" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Advertisements"
                   asp-action="AdvertisementManagement">
                    <i class="bi bi-megaphone-fill" aria-hidden="true"></i>
                    <span class="nav-text">@L["Admin_Sidebar_Advertisements"]</span>
                </a>
            </li>

            <li class="nav-item @(!canCases ? "d-none" : "")">
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reports" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Reports"
                   asp-action="ReportsCenter">
                    <i class="bi bi-flag-fill" aria-hidden="true"></i>
                    <span class="nav-text">@L["Admin_Sidebar_Cases"]</span>
                </a>
            </li>

            <li class="nav-item @(!canFinance ? "d-none" : "")">
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminFinancials" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="AdminFinancials"
                   asp-action="ManageAdminFinancials">
                    <i class="bi bi-wallet2" aria-hidden="true"></i>
                    <span class="nav-text">@L["Admin_Sidebar_Finance"]</span>
                </a>
            </li>

            <li class="nav-item @(!canMasterData ? "d-none" : "")">
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "MasterEntities" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="MasterEntities"
                   asp-action="MasterEntitiesManagement">
                    <i class="bi bi-grid-1x2" aria-hidden="true"></i>
                    <span class="nav-text">@L["Admin_Sidebar_MasterData"]</span>
                </a>
            </li>

            <li class="nav-item @(!canSettings ? "d-none" : "")">
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Settings" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Settings"
                   asp-action="SystemSettings">
                    <i class="bi bi-sliders" aria-hidden="true"></i>
                    <span class="nav-text">@L["Admin_Sidebar_Settings"]</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Profile" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Profile"
                   asp-action="AdminProfile">
                    <i class="bi bi-person-badge" aria-hidden="true"></i>
                    <span class="nav-text">@L["Admin_Sidebar_Profile"]</span>
                </a>
            </li>
        </ul>
    </div>

    <div class="sidebar-footer">
        <a class="nav-link text-danger"
           asp-area=""
           asp-controller="Account"
           asp-action="Logout">
            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
            <span class="nav-text">@L["Admin_Sidebar_Logout"]</span>
        </a>
    </div>

    <button type="button"
            class="sidebar-compact-toggle d-none d-lg-flex"
            id="desktopSidebarToggle"
            aria-label="@L["Admin_Sidebar_CollapseAria"]"
            title="@L["Admin_Sidebar_CollapseTitle"]">
        <i class="bi bi-chevron-right toggle-icon" aria-hidden="true"></i>
    </button>
</aside>

<div class="mobile-sidebar-backdrop d-lg-none"
     id="mobileSidebarBackdrop"
     aria-hidden="true"></div>

<header class="dashboard-topbar" id="adminGlobalTopbar">
    <div class="yg-admin-static-topbar-scene" aria-hidden="true">
        <span class="yg-admin-static-topbar-glow"></span>
    </div>

    <div class="topbar-left">
        <button type="button"
                class="sidebar-toggle-mobile d-lg-none"
                id="mobileSidebarToggle"
                aria-label="@L["Admin_Header_OpenSidebar"]"
                aria-controls="dashboardSidebar"
                aria-expanded="false">
            <i class="bi bi-list" aria-hidden="true"></i>
            <span class="yg-mobile-menu-glyph" aria-hidden="true">
                <span></span><span></span><span></span>
            </span>
        </button>
    </div>

    <div class="topbar-search">
        <div class="search-wrapper">
            <i class="bi bi-search search-icon" aria-hidden="true"></i>
            <input type="text"
                   class="form-control search-input"
                   id="globalSearch"
                   placeholder="@L["Admin_Header_SearchPlaceholder"]"
                   autocomplete="off"
                   aria-label="@L["Admin_Header_SearchAria"]" />
        </div>
    </div>

    <div class="topbar-right">
        <div class="dropdown quick-actions @(!showQuickActions ? "d-none" : "")">
            <button type="button"
                    class="btn btn-primary rounded-circle"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    aria-label="@L["Admin_Header_OpenQuickActions"]"
                    title="@L["Admin_Header_QuickActions"]">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
            </button>

            <ul class="dropdown-menu dropdown-menu-end">
                <li class="@(!canAddCategory ? "d-none" : "")">
                    <a class="dropdown-item"
                       href="/Admin/Category/CategoryManagement#add-category">
                        <i class="bi bi-tags" aria-hidden="true"></i>
                        <span>@L["Admin_Header_AddCategory"]</span>
                    </a>
                </li>

                <li class="@(!canUsers ? "d-none" : "")">
                    <a class="dropdown-item"
                       asp-area="Admin"
                       asp-controller="Users"
                       asp-action="UserManagement">
                        <i class="bi bi-person-plus" aria-hidden="true"></i>
                        <span>@L["Admin_Sidebar_Users"]</span>
                    </a>
                </li>

                <li class="@(!canAddPlace ? "d-none" : "")">
                    <a class="dropdown-item" href="#">
                        <i class="bi bi-building-add" aria-hidden="true"></i>
                        <span>@L["Admin_Header_AddPlace"]</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="dropdown notifications-dropdown admin-notification-center"
             id="adminNotificationCenter"
             data-header-endpoint="/Notifications/Header"
             data-unread-endpoint="/Notifications/UnreadCount"
             data-mark-read-endpoint="/Notifications/MarkAsRead"
             data-mark-all-endpoint="/Notifications/MarkAllAsRead">

            <form class="admin-notification-token-form" aria-hidden="true">
                @Html.AntiForgeryToken()
            </form>

            <button type="button"
                    class="admin-notification-toggle"
                    id="adminNotificationToggle"
                    data-bs-toggle="dropdown"
                    data-bs-auto-close="outside"
                    aria-expanded="false"
                    aria-label="@L["Admin_Header_OpenNotifications"]"
                    title="@L["Admin_Header_Notifications"]">
                <span class="admin-notification-toggle__halo" aria-hidden="true"></span>
                <i class="bi bi-bell-fill" aria-hidden="true"></i>
                <span class="admin-notification-live-dot"
                      id="adminNotificationLiveDot"
                      hidden
                      aria-hidden="true"></span>
                <span class="admin-notification-badge"
                      id="adminNotificationBadge"
                      hidden>0</span>
            </button>

            <div class="dropdown-menu dropdown-menu-end admin-notification-panel"
                 id="adminNotificationPanel"
                 aria-labelledby="adminNotificationToggle">

                <div class="admin-notification-panel__head">
                    <div class="admin-notification-panel__identity">
                        <span class="admin-notification-panel__mark" aria-hidden="true">
                            <i class="bi bi-bell"></i>
                        </span>
                        <div>
                            <span class="admin-notification-panel__eyebrow">@L["Admin_Header_AdminPanel"]</span>
                            <strong>@L["Admin_Header_Notifications"]</strong>
                        </div>
                    </div>

                    <div class="admin-notification-panel__actions">
                        <span class="admin-notification-unread-pill"
                              id="adminNotificationUnreadPill"
                              hidden>
                            <b id="adminNotificationUnreadText">0</b>
                            <span>@L["Admin_Header_New"]</span>
                        </span>

                        <button type="button"
                                class="admin-notification-icon-action"
                                id="adminNotificationRefresh"
                                aria-label="@L["Admin_Header_RefreshNotifications"]"
                                title="@L["Admin_Header_Refresh"]">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                </div>

                <div class="admin-notification-panel__toolbar">
                    <span>@L["Admin_Header_LatestUpdates"]</span>
                    <button type="button"
                            class="admin-notification-mark-all"
                            id="adminNotificationMarkAll"
                            hidden>
                        <i class="bi bi-check2-all"></i>
                        <span>@L["Admin_Header_ReadAll"]</span>
                    </button>
                </div>

                <div class="admin-notification-progress"
                     id="adminNotificationProgress"
                     aria-hidden="true">
                    <span></span>
                </div>

                <div class="admin-notification-body"
                     id="adminNotificationBody"
                     aria-live="polite"
                     aria-busy="true">
                    <div class="admin-notification-skeletons" aria-hidden="true">
                        @for (var skeletonIndex = 0; skeletonIndex < 4; skeletonIndex++)
                        {
                            <div class="admin-notification-skeleton">
                                <span class="admin-notification-skeleton__icon"></span>
                                <span class="admin-notification-skeleton__lines">
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                </span>
                            </div>
                        }
                    </div>
                </div>

                <div class="admin-notification-panel__foot">
                    <span id="adminNotificationFootText">@L["Admin_Header_AutoRefresh"]</span>
                    <a href="/Admin/Notifications"
                       class="admin-notification-view-all">
                        <span>@L["Admin_Header_ViewNotificationCenter"]</span>
                        <i class="bi bi-arrow-left"></i>
                    </a>
                </div>
            </div>
        </div>

        <span class="visually-hidden"
              id="adminNotificationLiveRegion"
              aria-live="polite"
              aria-atomic="true"></span>

        <div class="dropdown user-dropdown">
            <a href="#"
               class="d-flex align-items-center text-decoration-none dropdown-toggle"
               data-bs-toggle="dropdown"
               aria-expanded="false"
               aria-label="@L["Admin_Header_OpenAccount"]">

                <div class="header-avatar-circle d-flex align-items-center justify-content-center shadow-sm @(string.IsNullOrEmpty(displayImg) ? "is-initial" : "has-image")">
                    @if (!string.IsNullOrEmpty(displayImg))
                    {
                        <img src="@displayImg"
                             alt=""
                             class="header-avatar-image"
                             aria-hidden="true" />
                    }
                    <span class="header-avatar-initial text-white fw-bold small">
                        @initialLetter
                    </span>
                </div>
            </a>

            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item"
                       href="/Admin/Profile/AdminProfile#personal">
                        <i class="bi bi-person-lines-fill me-2" aria-hidden="true"></i>
                        <span>@L["Admin_Header_PersonalInfo"]</span>
                    </a>
                </li>

                <li>
                    <a class="dropdown-item"
                       href="/Admin/Profile/AdminProfile#settings">
                        <i class="bi bi-sliders me-2" aria-hidden="true"></i>
                        <span>@L["Admin_Header_Preferences"]</span>
                    </a>
                </li>

                <li>
                    <a class="dropdown-item text-danger-hover"
                       href="/Admin/Profile/AdminProfile#security">
                        <i class="bi bi-shield-lock me-2" aria-hidden="true"></i>
                        <span>@L["Admin_Header_Security"]</span>
                    </a>
                </li>

                <li class="@(!canSettings ? "d-none" : "")">
                    <hr class="dropdown-divider" />
                </li>

                <li class="@(!canSettings ? "d-none" : "")">
                    <a class="dropdown-item"
                       href="/Admin/Settings/SystemSettings">
                        <i class="bi bi-gear-fill me-2" aria-hidden="true"></i>
                        <span>@L["Admin_Sidebar_Settings"]</span>
                    </a>
                </li>

                <li><hr class="dropdown-divider" /></li>

                <li>
                    <a class="dropdown-item text-danger"
                       asp-area=""
                       asp-controller="Account"
                       asp-action="Logout">
                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                        <span>@L["Admin_Sidebar_Logout"]</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</header>
