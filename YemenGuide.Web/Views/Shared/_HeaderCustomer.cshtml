                                <i class="bi bi-box-arrow-in-right me-1"></i>
                                تسجيل الدخول
                            </a>

                            <a href="/Account/Login?role=owner"
                           class="btn btn-add-place btn-sm w-100">

                                <i class="bi bi-plus-lg me-1"></i>
