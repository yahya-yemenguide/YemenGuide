                    style="display: none;">
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                <span>الخطوة السابقة</span>
            </button>

            <div class="wizard-navigation__spacer" aria-hidden="true"></div>

            <button type="button"
                    class="btn wizard-navigation__button wizard-navigation__button--next"
                    id="btnNextStep">
                <span>الاستمرار</span>
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
            </button>

            <button type="submit"
                    class="btn wizard-navigation__button wizard-navigation__button--submit"
                    id="btnSubmitForm"
                    form="fullPlaceSurveyForm"
                    style="display: none;">
                <i class="bi bi-cloud-arrow-up-fill" aria-hidden="true"></i>
                <span>رفع واعتماد البيانات</span>
            </button>
        </div>
    </main>
</div>
