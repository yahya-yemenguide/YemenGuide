                                <div class="packages-track horizontal-scroll"
                             id="packagesContainer"
                             role="region"
                             tabindex="0"
                             aria-label="باقات المكان"
                             data-current-index="0"
                             onkeydown="
                                         if (
                                             event.key !== 'ArrowLeft' &&
                                             event.key !== 'ArrowRight'
                                         ) {
                                             return;
                                         }

                                         event.preventDefault();

                                         const cards =
                                             Array.from(
                                                 this.querySelectorAll(
                                                     '.package-card'
                                                 )
                                             );

                                         if (!cards.length) {
                                             return;
                                         }

                                         let currentIndex =
                                             Number.parseInt(
                                                 this.dataset.currentIndex || '0',
                                                 10
                                             ) || 0;

                                         currentIndex =
                                             event.key === 'ArrowLeft'
                                                 ? Math.min(
                                                     cards.length - 1,
                                                     currentIndex + 1
                                                 )
                                                 : Math.max(
                                                     0,
                                                     currentIndex - 1
                                                 );

                                         this.dataset.currentIndex =
                                             String(currentIndex);

                                         cards[currentIndex]
                                             .scrollIntoView({
                                                 behavior: 'smooth',
                                                 block: 'nearest',
                                                 inline: 'center'
                                             });
                                     ">

                                    @foreach (
