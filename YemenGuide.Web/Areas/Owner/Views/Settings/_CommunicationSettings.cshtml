    .communication-settings-v2 .communication-card .policy-card__header p {
        margin: 0;
        color: var(--comm-muted);
        font-size: 0.75rem;
        line-height: 1.6;
    }

    .communication-settings-v2 .communication-card .policy-card__kicker {
        margin-bottom: 2px;
        font-size: 0.68rem;
        letter-spacing: 0;
    }

    .communication-settings-v2 .communication-card .policy-card__icon {
