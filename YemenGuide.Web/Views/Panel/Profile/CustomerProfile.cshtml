@model YemenGuide.Core.DTOs.Customer.CustomerProfileDto
@inject YemenGuide.Web.Services.ExchangeRates.CurrencyDisplayService CurrencyDisplay

@{
    ViewData["Title"] = "الملف الشخصي - حسابي";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var bookingReturnUrl =
        ViewData["BookingReturnUrl"] as string
        ?? string.Empty;

    var bookingProfileIsComplete =
        ViewData["BookingProfileIsComplete"] is bool profileIsComplete
            ? profileIsComplete
            : true;

    var bookingProfileMissingFields =
        ViewData["BookingProfileMissingFields"]
            as System.Collections.Generic.List<string>
        ?? new System.Collections.Generic.List<string>();

    var hasBookingReturnUrl =
        !string.IsNullOrWhiteSpace(
            bookingReturnUrl);

    var activeCurrency =
        YemenGuide.Web.Services.ExchangeRates.CurrencyDisplayService.NormalizeCurrency(
            Model.PreferredCurrency);

    if (string.IsNullOrWhiteSpace(activeCurrency))
    {
        activeCurrency =
            await CurrencyDisplay.GetPreferredCurrencyAsync();
    }
}

@section Styles {
    <link rel="stylesheet"
      href="~/css/customer/customer-sidebar.css"
      asp-append-version="true" />

    <link rel="stylesheet"
      href="~/css/customer/customer-profile.css"
      asp-append-version="true" />

    <!-- توحيد بروفايل العميل مع تصميم المالك والأدمن -->
    <link rel="stylesheet"
      href="~/css/customer/customer-profile-admin-match.css"
      asp-append-version="true" />

    <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.4/build/css/intlTelInput.css">
}

    <div class="customer-dashboard-layout">

        <partial name="_CustomerSidebar" />

        <main class="customer-main-content">

            <div class="profile-container container-fluid px-4 px-lg-5 customer-profile-page"
             data-booking-profile-mode="@(hasBookingReturnUrl ? "true" : "false")"
             data-profile-email-verified="@(Model.IsEmailVerified ? "true" : "false")"
             style="margin-bottom: 80px;">

                <input type="hidden"
                   id="profileReturnUrl"
                   value="@bookingReturnUrl" />

            @if (hasBookingReturnUrl)
            {
                <div id="bookingProfileReturnNotice"
                 class="alert @(bookingProfileIsComplete ? "alert-success" : "alert-warning") border-0 shadow-sm rounded-4 mt-3 mb-4"
                 role="status">

                    <div class="d-flex align-items-start gap-3">
                        <span class="d-inline-flex align-items-center justify-content-center flex-shrink-0 rounded-circle bg-white shadow-sm"
                          style="width:48px;height:48px;">
                            <i class="bi @(bookingProfileIsComplete ? "bi-check-circle-fill text-success" : "bi-person-fill-exclamation text-warning") fs-4"></i>
                        </span>

                        <div class="flex-grow-1 min-w-0">
                            <small class="d-block fw-bold mb-1">
                                إكمال بيانات الحجز
                            </small>

                            <h2 class="h6 fw-bold mb-2">
                                @(bookingProfileIsComplete
                                    ? "بيانات حسابك مكتملة"
                                    : "أكمل البيانات المهمة ثم عد للحجز")
                            </h2>

                            @if (!bookingProfileIsComplete)
                            {
                                <p class="small mb-2">
                                    البيانات المطلوبة قبل إنشاء الحجز:
                                </p>

                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    @foreach (var field in bookingProfileMissingFields)
                                    {
                                        <span class="badge rounded-pill text-bg-light border text-dark">
                                            <i class="bi bi-exclamation-circle me-1"></i>
                                            @field
                                        </span>
                                    }
                                </div>

                                <p class="small mb-0">
                                    بعد الحفظ سيعيدك النظام تلقائيًا إلى صفحة إتمام الحجز عندما تصبح البيانات مكتملة.
                                </p>
                            }
                            else
                            {
                                <a href="@bookingReturnUrl"
                           class="btn btn-success btn-sm fw-bold rounded-pill px-3">
                                    <i class="bi bi-arrow-return-left me-1"></i>
                                    العودة لإتمام الحجز
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- =====================================================
                 البطاقة العلوية — نفس المالك والأدمن
                 تم حذف بطاقة "الرصيد المتاح" بالكامل
                 ===================================================== -->
            <div class="premium-glass-card hero-section p-4 p-lg-5 mb-4 mt-3">

                <div class="row align-items-center g-4">

                    <div class="col-12">

                        <div class="profile-identity-wrapper d-flex flex-column flex-md-row align-items-center align-items-md-start gap-4 text-center text-md-start">

                            <div class="avatar-wrapper position-relative flex-shrink-0">

                                <div class="avatar-circle-premium d-flex align-items-center justify-content-center shadow-lg"
                                     id="avatarPreview"
                                     title="اضغط لإدارة الصورة الشخصية"
                                     style="background: @(string.IsNullOrEmpty(Model.ProfileImage)
                                         ? "linear-gradient(135deg, #05203C 0%, #00A6DA 100%)"
                                         : $"url('{Model.ProfileImage}') center/cover no-repeat");">

                                    @if (string.IsNullOrEmpty(Model.ProfileImage))
                                    {
                                        <span class="avatar-initial text-white fw-bold display-4"
                                          id="mainAvatarInitial">
                                            @Model.InitialLetter
                                        </span>
                                    }

                                </div>

                                <button class="camera-floating-btn shadow-sm d-flex align-items-center justify-content-center"
                                        id="uploadCameraBtn"
                                        type="button"
                                        aria-label="رفع أو تغيير الصورة الشخصية">
                                    <i class="bi bi-camera-fill"
                                       aria-hidden="true"></i>
                                </button>

                                <input type="file"
                                       id="profileImageUpload"
                                       accept="image/*"
                                       hidden />

                            </div>

                            <div class="profile-identity-info flex-grow-1 pt-md-2">

                                <div class="profile-name-row d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-2 mb-2">

                                    <h2 class="fw-bold text-dark profile-name mb-0">
                                        @Model.FullName
                                    </h2>

                                    @if (Model.IsEmailVerified)
                                    {
                                        <i class="bi bi-patch-check-fill text-primary fs-5"
                                       title="حساب موثق"
                                       aria-label="حساب موثق"></i>
                                    }

                                </div>

                                <div class="user-meta-info customer-meta-info d-flex flex-wrap justify-content-center justify-content-md-start gap-3 mt-2">

                                    <span class="badge-premium customer-role-badge text-white">
                                        <i class="bi bi-person-check-fill"
                                           aria-hidden="true"></i>
                                        <span>عميل</span>
                                    </span>

                                    <span class="badge-premium">
                                        <i class="bi bi-hash"
                                           aria-hidden="true"></i>
                                        <span>العميل: @Model.UserId</span>
                                    </span>

                                    <span class="badge-premium">
                                        <i class="bi bi-at"
                                           aria-hidden="true"></i>
                                        <span dir="ltr">@Model.Username</span>
                                    </span>

                                    <span class="badge-premium">
                                        <i class="bi bi-calendar3"
                                           aria-hidden="true"></i>
                                        <span>انضم: @Model.CreatedAt.ToString("yyyy/MM")</span>
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 التبويبات — نفس تصميم المالك والأدمن بالضبط
                 ===================================================== -->
            <div class="profile-tabs-scroll mb-4"
                 role="region"
                 aria-label="تبويبات الملف الشخصي">

                <div class="profile-premium-tabs"
                     id="profileTab"
                     role="tablist"
                     aria-orientation="horizontal">

                    <button class="profile-tab-btn active"
                            id="personal-tab"
                            data-bs-toggle="pill"
                            data-bs-target="#personal"
                            type="button"
                            role="tab"
                            aria-controls="personal"
                            aria-selected="true"
                            tabindex="0">

                        <span class="profile-tab-icon">
                            <i class="bi bi-person-lines-fill"
                               aria-hidden="true"></i>
                        </span>

                        <span class="profile-tab-copy">
                            <strong>البيانات الشخصية</strong>
                            <small>الهوية والتواصل</small>
                        </span>

                    </button>

                    <button class="profile-tab-btn"
                            id="settings-tab"
                            data-bs-toggle="pill"
                            data-bs-target="#settings"
                            type="button"
                            role="tab"
                            aria-controls="settings"
                            aria-selected="false"
                            tabindex="-1">

                        <span class="profile-tab-icon">
                            <i class="bi bi-sliders2"
                               aria-hidden="true"></i>
                        </span>

                        <span class="profile-tab-copy">
                            <strong>إعدادات العرض</strong>
                            <small>الواجهة والعملة واللغة</small>
                        </span>

                    </button>

                    <button class="profile-tab-btn profile-tab-btn--security"
                            id="security-tab"
                            data-bs-toggle="pill"
                            data-bs-target="#security"
                            type="button"
                            role="tab"
                            aria-controls="security"
                            aria-selected="false"
                            tabindex="-1">

                        <span class="profile-tab-icon">
                            <i class="bi bi-shield-lock"
                               aria-hidden="true"></i>
                        </span>

                        <span class="profile-tab-copy">
                            <strong>الأمان</strong>
                            <small>كلمة المرور والحماية</small>
                        </span>

                    </button>

                </div>

            </div>


            <!-- =====================================================
                 محتوى التبويبات
                 ===================================================== -->
            <div class="tab-content profile-tab-content"
                 id="profileTabContent">


                <!-- البيانات الشخصية -->
                <div class="tab-pane show active"
                     id="personal"
                     role="tabpanel"
                     aria-labelledby="personal-tab"
                     tabindex="0">

                    <div class="premium-glass-card profile-content-card p-4 p-lg-5">

                        <div class="premium-section-title mb-4">
                            <h4>
                                <i class="bi bi-person-badge text-primary me-2"></i>
                                الهوية والمعلومات الأساسية
                            </h4>
                            <p class="text-muted small mb-0">
                                قم بتحديث بياناتك لتجربة حجوزات أكثر سلاسة.
                            </p>
                        </div>

                        <form id="personalInfoForm">
                            <div class="row g-4">

                                <div class="col-md-6">
                                    <label class="premium-label">الاسم الكامل</label>
                                    <div class="premium-input-group">
                                        <i class="bi bi-person input-icon"></i>
                                        <input type="text"
                                               class="form-control"
                                               id="fullName"
                                               value="@Model.FullName"
                                               required>
                                        <button class="edit-btn-inset edit-icon"
                                                type="button"
                                                data-target="fullName">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="premium-label">اسم المستخدم (Unique)</label>
                                    <div class="premium-input-group">
                                        <i class="bi bi-at input-icon"></i>
                                        <input type="text"
                                               class="form-control"
                                               id="username"
                                               value="@Model.Username"
                                               required>
                                        <button class="edit-btn-inset edit-icon"
                                                type="button"
                                                data-target="username">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                    </div>
                                    <div id="profileUsernameError"
                                         class="premium-error-text mt-1"
                                         style="display: none;"></div>
                                </div>

                                <div class="col-md-6">
                                    <label class="premium-label">البريد الإلكتروني</label>

                                    <div class="premium-input-group">
                                        <i class="bi bi-envelope input-icon"></i>

                                        <input type="email"
                                               class="form-control"
                                               id="contactInfo"
                                               value="@Model.ContactInfo"
                                               required>

                                        <div class="inset-badges d-flex align-items-center">
                                            <span class="verify-badge @(Model.IsEmailVerified ? "" : "d-none")"
                                                  id="emailVerifiedBadge"
                                                  title="موثق">
                                                <i class="bi bi-check-circle-fill"></i>
                                            </span>

                                            <button class="edit-btn-inset edit-icon ms-1"
                                                    type="button"
                                                    data-target="contactInfo">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div id="emailVerificationWarning"
                                         class="premium-inline-alert @(Model.IsEmailVerified ? "d-none" : "") mt-2">

                                        <div class="d-flex justify-content-between align-items-center gap-3 w-100">
                                            <span>
                                                <i class="bi bi-info-circle-fill me-1"></i>
                                                @(Model.IsEmailVerified
                                                    ? "يتطلب تغيير البريد التحقق الأمني."
                                                    : "يجب توثيق البريد الإلكتروني قبل إنشاء الحجز.")
                                            </span>

                                            <button type="button"
                                                    class="btn-verify-now flex-shrink-0"
                                                    id="inlineVerifyEmailBtn">
                                                تحقق
                                                <i class="bi bi-arrow-left-short"></i>
                                            </button>
                                        </div>

                                    </div>

                                    <div id="profileEmailError"
                                         class="premium-error-text mt-1"
                                         style="display: none;"></div>
                                </div>

                                <div class="col-md-6">
                                    <label class="premium-label">رقم الهاتف (واتساب)</label>

                                    <div class="premium-input-group-phone phone-wrapper-ltr"
                                         dir="ltr">
                                        <input type="tel"
                                               class="form-control"
                                               id="phoneNumber"
                                               value="@Model.PhoneNumber"
                                               required>
                                    </div>

                                    <div id="profilePhoneError"
                                         class="premium-error-text mt-1"
                                         style="display: none;"></div>
                                </div>

                                <div class="col-md-4">
                                    <label class="premium-label">المدينة</label>

                                    <div class="premium-input-group">
                                        <i class="bi bi-geo-alt input-icon"></i>

                                        <input type="text"
                                               class="form-control"
                                               id="city"
                                               value="@Model.City"
                                               placeholder="مثال: صنعاء"
                                               required>

                                        <button class="edit-btn-inset edit-icon"
                                                type="button"
                                                data-target="city">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="premium-label">الجنس</label>

                                    <div class="premium-input-group">
                                        <i class="bi bi-gender-ambiguous input-icon"></i>

                                        <select class="form-select premium-select"
                                                id="gender">
                                            <option value=""
                                                    selected="@(string.IsNullOrEmpty(Model.Gender))">
                                                -- اختر --
                                            </option>

                                            <option value="ذكر"
                                                    selected="@(Model.Gender == "ذكر")">
                                                👨🏻 ذكر
                                            </option>

                                            <option value="أنثى"
                                                    selected="@(Model.Gender == "أنثى")">
                                                👩🏻 أنثى
                                            </option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="premium-label">تاريخ الميلاد</label>

                                    <div class="premium-input-group">
                                        <i class="bi bi-calendar-event input-icon text-primary"></i>

                                        <input type="date"
                                               class="form-control fw-bold premium-date"
                                               id="dateOfBirth"
                                               value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))">
                                    </div>
                                </div>

                                <div class="col-12">
                                    <label class="premium-label">نبذة عني (Bio)</label>

                                    <div class="premium-input-group align-items-start">
                                        <i class="bi bi-card-text input-icon pt-3"></i>

                                        <textarea class="form-control"
                                                  id="bio"
                                                  rows="3"
                                                  placeholder="أخبرنا قليلاً عن اهتماماتك...">@Model.Bio</textarea>

                                        <button class="edit-btn-inset edit-icon pt-3"
                                                type="button"
                                                data-target="bio">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                    </div>
                                </div>

                            </div>


                            <div class="premium-section-title mt-5 mb-4">
                                <h4>
                                    <i class="bi bi-share text-primary me-2"></i>
                                    الروابط الاجتماعية
                                </h4>
                            </div>

                            <div class="row g-4">

                                <div class="col-md-4">
                                    <div class="premium-input-group">
                                        <i class="bi bi-facebook input-icon text-primary"></i>

                                        <input type="url"
                                               class="form-control text-start"
                                               dir="ltr"
                                               id="facebookUrl"
                                               value="@Model.FacebookUrl"
                                               placeholder="facebook.com/...">
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="premium-input-group">
                                        <i class="bi bi-twitter-x input-icon text-dark"></i>

                                        <input type="url"
                                               class="form-control text-start"
                                               dir="ltr"
                                               id="twitterUrl"
                                               value="@Model.TwitterUrl"
                                               placeholder="x.com/...">
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="premium-input-group">
                                        <i class="bi bi-instagram input-icon text-danger"></i>

                                        <input type="url"
                                               class="form-control text-start"
                                               dir="ltr"
                                               id="instagramUrl"
                                               value="@Model.InstagramUrl"
                                               placeholder="instagram.com/...">
                                    </div>
                                </div>

                            </div>

                            <div class="form-actions mt-5 pt-4 border-top d-flex gap-3 justify-content-end">
                                <button type="reset"
                                        class="btn-premium-cancel"
                                        id="cancelEditBtn">
                                    إلغاء
                                </button>

                                <button type="submit"
                                        class="btn-premium-save">
                                    <i class="bi bi-floppy-fill me-2"></i>
                                    حفظ التحديثات
                                </button>
                            </div>

                        </form>

                    </div>

                </div>


                <!-- إعدادات العرض -->
                <div class="tab-pane"
                     id="settings"
                     role="tabpanel"
                     aria-labelledby="settings-tab"
                     tabindex="0">

                    <div class="premium-glass-card profile-content-card p-4 p-lg-5">

                        <div class="premium-section-title mb-4">
                            <h4>
                                <i class="bi bi-sliders2 text-primary me-2"></i>
                                تفضيلات الواجهة والنظام
                            </h4>
                        </div>

                        <div class="row g-4 mb-5">

                            <div class="col-md-6">
                                <div class="premium-toggle-card">

                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="icon-box-glass text-warning">
                                                <i class="bi @(Model.DarkModeEnabled ? "bi-sun-fill" : "bi-moon-stars-fill")"
                                                   id="profileDarkModeIcon"></i>
                                            </div>
                                            <span class="fw-bold text-dark">
                                                الوضع الليلي
                                            </span>
                                        </div>

                                        <div class="form-switch ios-switch">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="profileDarkModeSwitch"
                                                   @(Model.DarkModeEnabled ? "checked" : "")>
                                        </div>
                                    </div>

                                </div>
                            </div>


                            <div class="col-md-6">
                                <div class="premium-toggle-card">

                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="icon-box-glass text-primary">
                                                <i class="bi bi-grid-1x2-fill"></i>
                                            </div>
                                            <span class="fw-bold text-dark">
                                                القائمة المدمجة
                                            </span>
                                        </div>

                                        <div class="form-switch ios-switch">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="compactModeToggle">
                                        </div>
                                    </div>

                                </div>
                            </div>


                            <div class="col-md-6">
                                <div class="premium-toggle-card">

                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="icon-box-glass text-info">
                                                <i class="bi bi-translate"></i>
                                            </div>
                                            <span class="fw-bold text-dark">
                                                لغة العرض
                                            </span>
                                        </div>

                                        @{
                                            var currentCulture =
                                            System.Globalization.CultureInfo.CurrentCulture.Name;
                                        }

                                        <select class="premium-select-inline"
                                                id="languageSelect">

                                            @if (currentCulture.StartsWith("ar"))
                                            {
                                                <option value="ar" selected>
                                                    🌐 العربية
                                                </option>
                                                <option value="en">
                                                    🌐 English
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="ar">
                                                    🌐 العربية
                                                </option>
                                                <option value="en" selected>
                                                    🌐 English
                                                </option>
                                            }

                                        </select>
                                    </div>

                                </div>
                            </div>


                            <!-- =================================================
                                 اختيار العملة — نفس المالك والأدمن
                                 ================================================= -->
                            <div class="col-12">

                                <div class="premium-toggle-card profile-currency-card">

                                    <div class="profile-currency-head">

                                        <div class="profile-toggle-label d-flex align-items-center gap-3">

                                            <div class="icon-box-glass text-success">
                                                <i class="bi bi-currency-exchange"
                                                   aria-hidden="true"></i>
                                            </div>

                                            <div class="profile-currency-copy">
                                                <span class="fw-bold text-dark d-block">
                                                    عملة عرض الأسعار
                                                </span>

                                                <small class="text-muted">
                                                    اختر العملة التي تريد مشاهدة أسعار المنصة بها.
                                                    التحويل يعتمد على أسعار الصرف المعتمدة في النظام.
                                                </small>
                                            </div>

                                        </div>

                                        <span class="profile-currency-status"
                                              id="preferredCurrencyStatus"
                                              aria-live="polite">
                                            العملة الحالية:
                                            <strong>@activeCurrency</strong>
                                        </span>

                                    </div>

                                    <div class="profile-currency-options"
                                         role="radiogroup"
                                         aria-label="اختيار عملة عرض الأسعار">

                                        <label class="profile-currency-option">
                                            <input type="radio"
                                                   name="preferredCurrencyUi"
                                                   value="ريال يمني"
                                                   @(activeCurrency == "ريال يمني" ? "checked" : null)>

                                            <span class="profile-currency-option__symbol">
                                                ر.ي
                                            </span>

                                            <span class="profile-currency-option__copy">
                                                <strong>الريال اليمني</strong>
                                                <small>YER</small>
                                            </span>

                                            <i class="bi bi-check-circle-fill profile-currency-option__check"
                                               aria-hidden="true"></i>
                                        </label>


                                        <label class="profile-currency-option">
                                            <input type="radio"
