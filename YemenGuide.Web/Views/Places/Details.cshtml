                        aria-label="إغلاق">

                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-body premium-place-modal-body">

                <div class="premium-date-grid">

                    <div class="premium-field-group">

                        <label for="startDate"
                               class="premium-field-label">

                            <span>
                                <i class="bi bi-box-arrow-in-left"></i>
                            </span>

                            <span>تاريخ الدخول</span>
                        </label>

                        <div class="premium-date-input-shell">

                            <input type="text"
                                   id="startDate"
                                   class="form-control my-datepicker premium-date-input"
                                   placeholder="YYYY-MM-DD"
                                   autocomplete="off"
                                   readonly />

                            <i class="bi bi-calendar3"></i>
                        </div>
                    </div>

                    <div class="premium-field-group">

                        <label for="endDate"
                               class="premium-field-label">

                            <span>
                                <i class="bi bi-box-arrow-right"></i>
                            </span>

                            <span>تاريخ الخروج</span>
                        </label>

                        <div class="premium-date-input-shell">

                            <input type="text"
                                   id="endDate"
                                   class="form-control my-datepicker premium-date-input"
                                   placeholder="YYYY-MM-DD"
                                   autocomplete="off"
                                   readonly />

                            <i class="bi bi-calendar3"></i>
                        </div>
                    </div>
                </div>

                <div class="premium-modal-tip">

                    <i class="bi bi-moon-stars-fill"></i>

                    <span>
                        يجب أن يفصل بين تاريخ الدخول والخروج ليلة واحدة
                        على الأقل.
                    </span>
                </div>

                <div id="dateWarning"
                     class="premium-inline-alert is-danger d-none">

                    <i class="bi bi-exclamation-triangle-fill"></i>

                    <span>
                        تاريخ الخروج يجب أن يكون بعد تاريخ الدخول بليلة
                        واحدة.
                    </span>
                </div>
            </div>

            <div class="modal-footer premium-place-modal-footer">

                <button type="button"
                        id="btnSaveDates"
                        onclick="goToAvailableRooms()"
                        class="btn btn-secondary premium-modal-primary"
                        disabled>

                    <span>حفظ ومتابعة</span>
                    <i class="bi bi-arrow-left"></i>
                </button>
            </div>
        </div>
    </div>
</div>

