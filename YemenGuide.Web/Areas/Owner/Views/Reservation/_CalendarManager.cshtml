    <!-- ================================================================
         Range Action Dialog
         ================================================================ -->
    <div class="yg-overlay yg-overlay--deep" id="ygRangeOverlay" hidden></div>
    <section class="yg-range-dialog" id="ygRangeModal" aria-hidden="true" aria-labelledby="ygRangeTitle" role="dialog" aria-modal="true">
        <header>
            <span class="yg-range-icon" id="ygRangeIcon"><i class="bi bi-calendar2-x-fill"></i></span>
            <div><small id="ygRangeKicker">إدارة التوفر</small><h4 id="ygRangeTitle">إغلاق فترة</h4><p id="ygRangeDescription">لن تتغير الحجوزات الموجودة مسبقًا.</p></div>
            <button type="button" class="yg-sheet-close" data-yg-close="range"><i class="bi bi-x-lg"></i></button>
        </header>
        <div class="yg-range-body">
            <div class="yg-form-grid yg-form-grid--2">
                <label class="yg-field"><span>من تاريخ</span><input type="date" id="ygRangeStart" /></label>
                <label class="yg-field"><span>إلى تاريخ</span><input type="date" id="ygRangeEnd" /></label>
            </div>
            <label class="yg-field" id="ygRangeReasonField"><span>سبب الإغلاق</span><textarea id="ygRangeReason" maxlength="255" rows="3" placeholder="مثال: صيانة دورية"></textarea></label>
            <div class="yg-range-notice" id="ygRangeNotice"><i class="bi bi-info-circle-fill"></i><span>الإغلاق يمنع الحجوزات الجديدة فقط ولا يلغي حجوزات سابقة.</span></div>
        </div>
        <footer>
            <button type="button" class="yg-secondary-btn" data-yg-close="range">تراجع</button>
            <button type="button" class="yg-range-submit" id="ygRangeSubmit"><i class="bi bi-check2-circle"></i><span>تأكيد</span></button>
        </footer>
    </section>

    <div class="yg-overlay yg-overlay--deep" id="ygMonthPickerOverlay" hidden></div>
    <section class="yg-month-picker" id="ygMonthPickerModal" aria-hidden="true" aria-labelledby="ygMonthPickerTitle" role="dialog" aria-modal="true">
        <header class="yg-month-picker__head">
            <div>
                <small>انتقال سريع</small>
                <h4 id="ygMonthPickerTitle">اختر الشهر</h4>
            </div>
            <button type="button" class="yg-sheet-close" data-yg-close="month-picker" aria-label="إغلاق">
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        <div class="yg-month-picker__year">
            <button type="button" id="ygMonthPickerPrevYear" aria-label="السنة السابقة"><i class="bi bi-chevron-right"></i></button>
            <strong id="ygMonthPickerYear">2026</strong>
            <button type="button" id="ygMonthPickerNextYear" aria-label="السنة التالية"><i class="bi bi-chevron-left"></i></button>
        </div>

        <div class="yg-month-picker__grid" id="ygMonthPickerMonths"></div>
    </section>

    <div class="yg-toast-stack" id="ygCalendarToasts" aria-live="polite" aria-atomic="true"></div>
</div>
