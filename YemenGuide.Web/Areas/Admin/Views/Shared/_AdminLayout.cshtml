@using System.Globalization
@using System.Linq
@using Microsoft.EntityFrameworkCore
@inject YemenGuide.Data.AppDbContext _context
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    var settings = _context.SystemSettings
        .AsNoTracking()
        .OrderBy(s => s.Id)
        .FirstOrDefault();

    string siteName = settings?.SiteName ?? "YemenGuide";
    string siteDesc = settings?.SiteDescription
        ?? "الدليل السياحي والتجاري الأول في اليمن";
    string favicon = settings?.FaviconPath ?? "/favicon.ico";

    ViewData["AdminLayoutSettingsLoaded"] = true;
    ViewData["AdminSiteName"] = siteName;
    ViewData["AdminLogoPath"] = settings?.LogoPath ?? "/images/logo1.png";

    var isRtl = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    var direction = isRtl ? "rtl" : "ltr";
    var langCode = CultureInfo.CurrentCulture.Name;
    var bootstrapCss = isRtl ? "bootstrap.rtl.min.css" : "bootstrap.min.css";

    var uId = User.Identity?.IsAuthenticated == true
        ? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0"
        : "0";

    var darkModeEnabled = Context.Request.Cookies["darkMode"] == "enabled";

    bool showEmployeePasswordGate = false;
    if (
        User.Identity?.IsAuthenticated == true &&
        User.IsInRole("Admin") &&
        int.TryParse(uId, out var currentAdminUserId)
    )
    {
        showEmployeePasswordGate = _context.Users
            .Where(user =>
                user.UserId == currentAdminUserId &&
                user.Role == "Admin")
            .Select(user => user.MustChangePassword)
            .FirstOrDefault();
    }
}

<!DOCTYPE html>
<html lang="@langCode" dir="@direction">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - لوحة التحكم | @siteName</title>
    <meta name="description" content="@siteDesc" />

    <link rel="icon" type="image/x-icon" href="@favicon" />
    <link rel="shortcut icon" type="image/x-icon" href="@favicon" />

    <link rel="stylesheet" href="~/lib/bootstrap/css/@bootstrapCss" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.css" />

    <link rel="stylesheet"
          href="~/lib/fonts/fonts.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/shared/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin/admin-layout.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin/admin-dark-theme.css"
          asp-append-version="true" />

    @if (showEmployeePasswordGate)
    {
        <link rel="stylesheet"
          href="~/css/admin/admin-employee-password-modal.css"
          asp-append-version="true" />
    }

    @if (!isRtl)
    {
        <link rel="stylesheet"
          href="~/css/shared/_Admin_OwnerLayout.ltr.css"
          asp-append-version="true" />
    }

    @await RenderSectionAsync("Styles", required: false)

    <!-- آخر ملف في الهيدر ليضمن توحيد الوضع الليلي للـLayout والهيدر والقائمة -->
    <link rel="stylesheet"
          href="~/css/admin/admin-dark-unified.css"
          asp-append-version="true" />
</head>

<body class="dashboard-body yg-living-luxe-v4 yg-performance-mode @(darkModeEnabled ? "dark-mode" : "")"
      data-current-user-id="@uId">
    <div class="dashboard-wrapper">
        <partial name="~/Areas/Admin/Views/Shared/_HeaderAdmin.cshtml" />

        <div class="dashboard-main">
            <main class="dashboard-content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    @if (showEmployeePasswordGate)
    {
        <partial name="~/Areas/Admin/Views/Shared/_EmployeePasswordModal.cshtml" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin/_AdminLayout.js" asp-append-version="true"></script>

    @if (showEmployeePasswordGate)
    {
        <script src="~/js/admin/admin-employee-password-modal.js"
            asp-append-version="true"></script>
    }

    <!-- إصلاح مودال الصورة بدون ملف JavaScript إضافي -->
    <script>
        (function () {
            'use strict';

            const avatarModalElement =
                document.getElementById('avatarManageModal');

            if (!avatarModalElement) {
                return;
            }

            // إخراج المودال من stacking context الخاص بمحتوى لوحة التحكم.
            if (avatarModalElement.parentElement !== document.body) {
                document.body.appendChild(avatarModalElement);
            }

            avatarModalElement.addEventListener('show.bs.modal', function () {
                avatarModalElement.style.setProperty(
                    'z-index',
                    '20020',
                    'important'
                );
            });

            avatarModalElement.addEventListener('shown.bs.modal', function () {
                const backdrops =
                    document.querySelectorAll('.modal-backdrop');

                const currentBackdrop =
                    backdrops.length
                        ? backdrops[backdrops.length - 1]
                        : null;

                if (currentBackdrop) {
                    currentBackdrop.style.setProperty(
                        'z-index',
                        '20010',
                        'important'
                    );
                }
            });

            avatarModalElement.addEventListener('hidden.bs.modal', function () {
                avatarModalElement.style.removeProperty('z-index');
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    @if (!(ViewData["DisableGoogleMaps"] as bool? ?? false))
    {
        <script src="https://maps.googleapis.com/maps/api/js?key=@Configuration["GoogleMaps:ApiKey"]"></script>
    }
</body>
</html>
