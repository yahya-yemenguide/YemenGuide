@{
    bool isOwnerPasswordSetup = User.IsInRole("Owner");
    string setupTitle = isOwnerPasswordSetup
        ? "أمّن حسابك قبل توثيق منشأتك"
        : "أمّن حسابك قبل بدء رحلتك";
    string setupDescription = isOwnerPasswordSetup
        ? "أنشئ كلمة مرور خاصة بحساب دليلك اليمني، ثم أكمل خطوات إثبات الملكية ورفع الوثائق مباشرة دون أي خطوة إضافية."
        : "أنشئ كلمة مرور خاصة بحساب دليلك اليمني. بعدها يمكنك الدخول بالبريد وكلمة المرور، وسيبقى تسجيل Google متاحاً لحسابك.";
    string setupButtonText = isOwnerPasswordSetup
        ? "تأمين الحساب وبدء التوثيق"
        : "تأمين الحساب والمتابعة";
    string setupRequiredNote = isOwnerPasswordSetup
        ? "هذه الخطوة مطلوبة لحماية حسابك ولا تغيّر حالة طلب التوثيق أو مراجعته."
        : "هذه الخطوة مطلوبة لحماية حسابك، وبعدها يمكنك متابعة استخدام المنصة مباشرة.";
}

<div class="auth-security-modal is-open"
     id="googlePasswordSetupModal"
     data-auth-security-modal
     data-required="true"
     role="dialog"
     aria-modal="true"
     aria-labelledby="googlePasswordSetupTitle">

    <div class="auth-security-backdrop" aria-hidden="true"></div>

    <section class="auth-security-dialog" tabindex="-1">
        <div class="auth-security-glow" aria-hidden="true"></div>

        <header class="auth-security-dialog-brand">
            <span class="security-brand-mark"><i class="bi bi-compass-fill"></i></span>
            <div>
                <strong>دليلك اليمني</strong>
                <small>تأمين الحساب</small>
            </div>
        </header>

        <div class="security-visual security-visual--modal" aria-hidden="true">
            <span class="security-visual-ring"></span>
            <span class="security-visual-core"><i class="bi bi-google"></i></span>
            <span class="security-visual-badge"><i class="bi bi-check-lg"></i></span>
        </div>

        <div class="security-heading security-heading--modal">
            <span class="security-kicker"><i class="bi bi-shield-check"></i> خطوة أمان مطلوبة</span>
            <h2 id="googlePasswordSetupTitle">@setupTitle</h2>
            <p>@setupDescription</p>
        </div>

        <form id="googlePasswordSetupForm"
              class="security-form"
              method="post"
              action="/Account/SetGooglePassword"
              novalidate
              data-auth-password-form
              data-endpoint="/Account/SetGooglePassword"
              data-modal-form="true">
            @Html.AntiForgeryToken()

            <div class="security-field">
                <label for="googleNewPassword">كلمة المرور الجديدة</label>
                <div class="security-input-wrap">
                    <i class="bi bi-lock-fill"></i>
                    <input type="password"
                           name="newPassword"
                           id="googleNewPassword"
                           placeholder="8 أحرف على الأقل"
                           autocomplete="new-password"
                           required />
                    <button type="button" class="security-password-toggle" data-password-toggle="#googleNewPassword" aria-label="إظهار كلمة المرور">
                        <i class="bi bi-eye-slash-fill"></i>
                    </button>
                </div>
            </div>

            <div class="security-field">
                <label for="googleConfirmPassword">تأكيد كلمة المرور</label>
                <div class="security-input-wrap">
                    <i class="bi bi-shield-check"></i>
                    <input type="password"
                           name="confirmPassword"
                           id="googleConfirmPassword"
                           placeholder="أعد كتابة كلمة المرور"
                           autocomplete="new-password"
                           required />
                    <button type="button" class="security-password-toggle" data-password-toggle="#googleConfirmPassword" aria-label="إظهار كلمة المرور">
                        <i class="bi bi-eye-slash-fill"></i>
                    </button>
                </div>
            </div>

            <div class="security-meter" data-password-meter hidden>
                <div class="security-meter-top">
                    <span>قوة كلمة المرور</span>
                    <strong data-strength-text>—</strong>
                </div>
                <div class="security-meter-track"><span data-strength-bar></span></div>
                <div class="security-rules">
                    <span data-rule="length"><i class="bi bi-circle"></i> 8 أحرف على الأقل</span>
                    <span data-rule="letter"><i class="bi bi-circle"></i> حرف إنجليزي</span>
                    <span data-rule="number"><i class="bi bi-circle"></i> رقم واحد</span>
                </div>
            </div>

            <div class="security-message security-message--error" data-form-message role="alert" aria-live="polite" hidden></div>

            <button type="submit" class="security-primary-btn" data-submit-button>
                <span>@setupButtonText</span>
                <i class="bi bi-arrow-left-short"></i>
            </button>
        </form>

        <p class="auth-security-required-note">
            <i class="bi bi-lock-fill"></i>
            @setupRequiredNote
        </p>
    </section>
</div>
