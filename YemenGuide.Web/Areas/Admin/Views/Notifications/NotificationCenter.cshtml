@model YemenGuide.Core.DTOs.Notifications.NotificationCenterDto
@using YemenGuide.Core.Constants

@{
    ViewData["Title"] = "مركز إشعارات الإدارة";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    string FilterUrl(string filter, int page = 1)
    {
        return $"/Admin/Notifications?filter={Uri.EscapeDataString(filter)}&page={page}&pageSize={Model.PageSize}";
    }

    string TypeIcon(string? type)
    {
        return (type ?? string.Empty) switch
        {
            NotificationTypes.ReportCreated => "bi-shield-exclamation",
            NotificationTypes.ReportReply => "bi-chat-left-text",
            NotificationTypes.ReportEscalated => "bi-arrow-up-circle-fill",
            NotificationTypes.ReportWithdrawn => "bi-arrow-return-left",
            NotificationTypes.ReportResolved => "bi-check2-circle",
            NotificationTypes.ReportRejected => "bi-shield-x",
            NotificationTypes.AdminCaseActionRequired => "bi-shield-exclamation",

            NotificationTypes.PaymentRequired => "bi-wallet2",
            NotificationTypes.PaymentReceived => "bi-receipt-cutoff",
            NotificationTypes.PaymentApproved => "bi-check-circle-fill",
            NotificationTypes.PaymentRejected => "bi-exclamation-circle-fill",
            NotificationTypes.RefundRequested => "bi-arrow-counterclockwise",
            NotificationTypes.RefundReadyForTransfer => "bi-lightning-charge-fill",
            NotificationTypes.RefundTransferred => "bi-send-check-fill",
            NotificationTypes.RefundCompleted => "bi-cash-coin",
            NotificationTypes.AdminFinanceActionRequired => "bi-cash-stack",

            NotificationTypes.Advertisement => "bi-megaphone-fill",
            NotificationTypes.Promotion => "bi-percent",
            NotificationTypes.AdminAdvertisementActionRequired => "bi-megaphone-fill",

            NotificationTypes.AdminPlaceActionRequired => "bi-buildings-fill",
            NotificationTypes.AdminAccountActionRequired => "bi-person-gear",
            NotificationTypes.Account => "bi-person-circle",

            NotificationTypes.Security => "bi-shield-lock-fill",
            NotificationTypes.AdminSystemAlert => "bi-gear-wide-connected",

            NotificationTypes.BookingCreated => "bi-calendar-plus-fill",
            NotificationTypes.BookingAccepted => "bi-calendar-check-fill",
            NotificationTypes.BookingConfirmed => "bi-patch-check-fill",
            NotificationTypes.BookingRejected => "bi-x-circle-fill",
            NotificationTypes.BookingCancelled => "bi-calendar-x-fill",
            NotificationTypes.BookingExpired => "bi-hourglass-split",
            NotificationTypes.ReviewCreated => "bi-star-fill",
            NotificationTypes.ReviewReply => "bi-chat-square-quote-fill",
            NotificationTypes.Message => "bi-chat-dots-fill",
            _ => "bi-bell-fill"
        };
    }

    string TypeTone(string? type)
    {
        var value = type ?? string.Empty;

        if (value.Equals(NotificationTypes.ReportRejected, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.PaymentRejected, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.Security, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.AdminSystemAlert, StringComparison.OrdinalIgnoreCase))
        {
            return "coral";
        }

        if (value.Equals(NotificationTypes.ReportResolved, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.PaymentApproved, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.RefundCompleted, StringComparison.OrdinalIgnoreCase))
        {
            return "green";
        }

        if (value.Equals(NotificationTypes.AdminFinanceActionRequired, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.AdminAdvertisementActionRequired, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.Advertisement, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.Promotion, StringComparison.OrdinalIgnoreCase) ||
            value.StartsWith("Payment", StringComparison.OrdinalIgnoreCase) ||
            value.StartsWith("Refund", StringComparison.OrdinalIgnoreCase))
        {
            return "amber";
        }

        if (value.StartsWith("Report", StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.AdminCaseActionRequired, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.AdminPlaceActionRequired, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.AdminAccountActionRequired, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.Account, StringComparison.OrdinalIgnoreCase))
        {
            return "cyan";
        }

        return "slate";
    }

    string TypeLabel(string? type)
    {
        var value = type ?? string.Empty;

        if (value.StartsWith("Report", StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.AdminCaseActionRequired, StringComparison.OrdinalIgnoreCase))
        {
            return "قضية";
        }

        if (value.StartsWith("Payment", StringComparison.OrdinalIgnoreCase) ||
            value.StartsWith("Refund", StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.AdminFinanceActionRequired, StringComparison.OrdinalIgnoreCase))
        {
            return "مالية";
        }

        if (value.Equals(NotificationTypes.Advertisement, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.Promotion, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.AdminAdvertisementActionRequired, StringComparison.OrdinalIgnoreCase))
        {
            return "إعلان";
        }

        if (value.Equals(NotificationTypes.AdminPlaceActionRequired, StringComparison.OrdinalIgnoreCase))
        {
            return "منشأة";
        }

        if (value.Equals(NotificationTypes.Account, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.AdminAccountActionRequired, StringComparison.OrdinalIgnoreCase))
        {
            return "حساب";
        }

        if (value.Equals(NotificationTypes.Security, StringComparison.OrdinalIgnoreCase) ||
            value.Equals(NotificationTypes.AdminSystemAlert, StringComparison.OrdinalIgnoreCase))
        {
            return "النظام والأمان";
        }

        return "إشعار";
    }

    string DateText(DateTime? date)
    {
        return date.HasValue
            ? date.Value.ToString("yyyy/MM/dd - hh:mm tt")
            : "الآن";
    }

    string ActiveClass(string filter)
    {
        return string.Equals(Model.Filter, filter, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
    }

    string SectionTitle()
    {
        return Model.Filter switch
        {
            "unread" => "غير المقروءة",
            "case" => "البلاغات والقضايا",
            "finance" => "المالية",
            "advertisement" => "الإعلانات",
            "management" => "المنشآت والحسابات",
            _ => "جميع الإشعارات"
        };
    }
}

@section Styles {
    <link rel="stylesheet"
      href="~/css/admin/admin-notification-center.css"
      asp-append-version="true" />
}

    <section class="admin-notification-center-page"
         id="adminNotificationCenterPage"
         data-focus-notification="@Model.FocusNotificationId"
         data-mark-all-endpoint="/Notifications/MarkAllAsRead"
         data-center-data-endpoint="/Admin/Notifications/Data"
         data-page-size="@Model.PageSize"
         data-current-filter="@Model.Filter"
         data-current-page="@Model.CurrentPage">

        <form class="admin-notification-center-token-form" aria-hidden="true">
            @Html.AntiForgeryToken()
        </form>

        <div class="admin-notification-center-shell">

            <section class="admin-notification-center-intro">
                <div class="admin-notification-center-intro__copy">
                    <span class="admin-notification-center-intro__icon" aria-hidden="true">
                        <i class="bi bi-bell-fill"></i>
                    </span>

                    <div>
                        <span class="admin-notification-center-kicker">مركز إشعارات الإدارة</span>
                        <h1>ما يحتاج تدخلك، يصل إليك حسب صلاحياتك</h1>
                        <p>
                            يعرض هذا المركز التنبيهات الإدارية المخصصة لمهامك فقط.
                            كل إشعار مرتبط بحدث حقيقي، والضغط عليه ينقلك إلى المسار الإداري المناسب.
                        </p>
                    </div>
                </div>

                <div class="admin-notification-center-intro__stats">
                    <div class="admin-notification-center-stat">
                        <span>إجمالي الإشعارات</span>
                        <strong id="adminNotificationCenterTotalHero">@Model.TotalCount</strong>
                    </div>

                    <div class="admin-notification-center-stat is-unread-stat">
                        <span>غير المقروء</span>
                        <strong id="adminNotificationCenterUnreadHero">@Model.UnreadCount</strong>
                    </div>

                    <button type="button"
                        class="admin-notification-center-mark-all @(Model.UnreadCount <= 0 ? "is-disabled" : string.Empty)"
                        id="adminNotificationCenterMarkAll"
                        data-unread-count="@Model.UnreadCount">
                        <i class="bi bi-check2-all"></i>
                        <span>تعليم الكل كمقروء</span>
                    </button>
                </div>
            </section>

            <section class="admin-notification-center-tabs-wrap" aria-label="تصفية إشعارات الإدارة">
                <div class="admin-notification-center-tabs" data-admin-notification-tabs>

                    <a href="@FilterUrl("all")"
                   class="admin-notification-center-tab @ActiveClass("all")"
                   data-admin-notification-tab
                   data-filter="all">
                        <i class="bi bi-grid"></i>
                        <span>الكل</span>
                        <b id="adminNotificationCenterAllCount">@Model.TotalCount</b>
                    </a>

                    <a href="@FilterUrl("unread")"
                   class="admin-notification-center-tab @ActiveClass("unread")"
                   data-admin-notification-tab
                   data-filter="unread">
                        <i class="bi bi-circle-fill"></i>
                        <span>غير المقروء</span>
                        <b id="adminNotificationCenterUnreadTab">@Model.UnreadCount</b>
                    </a>

                    <a href="@FilterUrl("case")"
                   class="admin-notification-center-tab @ActiveClass("case")"
                   data-admin-notification-tab
                   data-filter="case">
                        <i class="bi bi-shield-check"></i>
                        <span>البلاغات والقضايا</span>
                        <b id="adminNotificationCenterCaseCount">@Model.CaseCount</b>
                    </a>

                    <a href="@FilterUrl("finance")"
                   class="admin-notification-center-tab @ActiveClass("finance")"
                   data-admin-notification-tab
                   data-filter="finance">
                        <i class="bi bi-cash-stack"></i>
                        <span>المالية</span>
                        <b id="adminNotificationCenterFinanceCount">@Model.FinanceCount</b>
                    </a>

                    <a href="@FilterUrl("advertisement")"
                   class="admin-notification-center-tab @ActiveClass("advertisement")"
                   data-admin-notification-tab
                   data-filter="advertisement">
                        <i class="bi bi-megaphone"></i>
                        <span>الإعلانات</span>
                        <b id="adminNotificationCenterAdvertisementCount">@Model.AdvertisementCount</b>
                    </a>

                    <a href="@FilterUrl("management")"
                   class="admin-notification-center-tab @ActiveClass("management")"
                   data-admin-notification-tab
                   data-filter="management">
                        <i class="bi bi-buildings"></i>
                        <span>المنشآت والحسابات</span>
                        <b id="adminNotificationCenterManagementCount">@Model.ManagementCount</b>
                    </a>
                </div>
            </section>

            <section class="admin-notification-center-panel">
                <div class="admin-notification-center-panel__head">
                    <div>
                        <span>الإشعارات المخصصة لصلاحياتك</span>
                        <h2 id="adminNotificationCenterSectionTitle">@SectionTitle()</h2>
                    </div>

                    <span class="admin-notification-center-result-count"
                      id="adminNotificationCenterResultCount">
                        <i class="bi bi-collection"></i>
                        @Model.FilteredCount نتيجة
                    </span>
                </div>

                <div class="admin-notification-center-list"
                 id="adminNotificationCenterList"
                 aria-live="polite">

                @if (Model.Items.Count > 0)
                {
                    @for (var itemIndex = 0; itemIndex < Model.Items.Count; itemIndex++)
                    {
                        var item = Model.Items[itemIndex];
                        var tone = TypeTone(item.NotificationType);
                        var isFocused =
                        Model.FocusNotificationId > 0 &&
                        Model.FocusNotificationId == item.NotificationId;

                        <a href="@item.OpenUrl"
                   class="admin-notification-center-item @(!item.IsRead ? "is-unread" : string.Empty) @(isFocused ? "is-focused" : string.Empty)"
                   data-admin-notification-center-item
                   data-notification-id="@item.NotificationId"
                   data-tone="@tone"
                   style="--admin-center-delay:@(Math.Min(itemIndex * 38, 260))ms">

                            <span class="admin-notification-center-item__icon" aria-hidden="true">
                                <i class="bi @TypeIcon(item.NotificationType)"></i>
                            </span>

                            <span class="admin-notification-center-item__content">
                                <span class="admin-notification-center-item__top">
                                    <span class="admin-notification-center-item__title-wrap">
                                        <strong>@item.NotificationTitle</strong>

                                        @if (!item.IsRead)
                                        {
                                            <span class="admin-notification-center-item__unread-dot"
                                      aria-label="غير مقروء"></span>
                                        }
                                    </span>

                                    <span class="admin-notification-center-item__type">
                                        @TypeLabel(item.NotificationType)
                                    </span>
                                </span>

                                <span class="admin-notification-center-item__text">
                                    @item.NotificationText
                                </span>

                                <span class="admin-notification-center-item__meta">
                                    <i class="bi bi-clock"></i>
                                    @DateText(item.CreatedAt)
                                </span>
                            </span>

                            <span class="admin-notification-center-item__arrow" aria-hidden="true">
                                <i class="bi bi-chevron-left"></i>
                            </span>
                        </a>
                    }
                }
                else
                {
                    <div class="admin-notification-center-empty">
                        <span class="admin-notification-center-empty__icon">
                            <i class="bi bi-bell-slash"></i>
                        </span>
                        <h3>لا توجد إشعارات في هذا القسم</h3>
                        <p>عندما يصل حدث مرتبط بصلاحياتك سيظهر هنا مباشرة.</p>

                        @if (Model.Filter != "all")
                        {
                            <a href="@FilterUrl("all")"
                       class="admin-notification-center-empty__all-link">
                                <i class="bi bi-grid"></i>
                                عرض جميع الإشعارات
                            </a>
                        }
                    </div>
                }
            </div>

            <nav class="admin-notification-center-pagination @(Model.TotalPages <= 1 ? "is-hidden" : string.Empty)"
                 id="adminNotificationCenterPagination"
                 aria-label="صفحات الإشعارات">

                @if (Model.TotalPages > 1)
                {
                    <a href="@(Model.HasPreviousPage ? FilterUrl(Model.Filter, Model.CurrentPage - 1) : "#")"
                   class="admin-notification-center-pagination__arrow @(!Model.HasPreviousPage ? "is-disabled" : string.Empty)"
                   aria-disabled="@(!Model.HasPreviousPage)">
                        <i class="bi bi-chevron-right"></i>
                    </a>

                    <div class="admin-notification-center-pagination__pages">
                        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                        {
                            if (pageNumber == 1 ||
                            pageNumber == Model.TotalPages ||
                            Math.Abs(pageNumber - Model.CurrentPage) <= 1)
                            {
                                <a href="@FilterUrl(Model.Filter, pageNumber)"
                       class="admin-notification-center-pagination__page @(pageNumber == Model.CurrentPage ? "active" : string.Empty)">
                                    @pageNumber
                                </a>
                            }
                            else if (pageNumber == Model.CurrentPage - 2 ||
                            pageNumber == Model.CurrentPage + 2)
                            {
                                <span class="admin-notification-center-pagination__dots">…</span>
                            }
                        }
                    </div>

                    <a href="@(Model.HasNextPage ? FilterUrl(Model.Filter, Model.CurrentPage + 1) : "#")"
                   class="admin-notification-center-pagination__arrow @(!Model.HasNextPage ? "is-disabled" : string.Empty)"
                   aria-disabled="@(!Model.HasNextPage)">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                }
            </nav>
        </section>
    </div>
</section>
