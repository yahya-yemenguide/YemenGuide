@model YemenGuide.Core.Entities.SystemSetting
@{
    ViewData["Title"] = "إعدادات النظام";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/settings.css" asp-append-version="true" />
}


    @Html.AntiForgeryToken()

<div class="container-fluid px-4 py-3 system-settings-page" dir="rtl">
        <div class="d-flex justify-content-between align-items-center mb-4 settings-page-header">
            <div class="settings-title-block">
                <h2 class="fw-bold mb-1 settings-page-title"><i class="bi bi-gear-wide-connected text-primary me-2"></i> إعدادات النظام</h2>
                <p class="text-muted">تحكم كامل في هوية المنصة وسياساتها وإعلاناتها والمنظومة المالية.</p>
            </div>
        </div>

        <div class="settings-tabs-scroll mb-4" role="region" aria-label="تبويبات إعدادات النظام">
            <div class="custom-tabs-container d-flex justify-content-start border-bottom gap-3" role="tablist">
            <button type="button" class="tab-btn active d-flex align-items-center gap-2" data-target="branding-tab" role="tab" aria-selected="true">
                    <i class="bi bi-globe2"></i>
                    <span class="tab-label">هوية وماركة</span>
                </button>
            <button type="button" class="tab-btn d-flex align-items-center gap-2" data-target="policies-tab" role="tab" aria-selected="false">
                    <i class="bi bi-sliders2"></i>
                    <span class="tab-label">سياسات التشغيل</span>
                </button>
            <button type="button" class="tab-btn d-flex align-items-center gap-2" data-target="contact-tab" role="tab" aria-selected="false">
                    <i class="bi bi-headset"></i>
                    <span class="tab-label">التواصل والروابط</span>
                </button>
            <button type="button" class="tab-btn d-flex align-items-center gap-2" data-target="maintenance-tab" role="tab" aria-selected="false">
                    <i class="bi bi-cone-striped"></i>
                    <span class="tab-label">الصيانة والطوارئ</span>
                </button>
            <button type="button" class="tab-btn d-flex align-items-center gap-2" data-target="wallets-tab" role="tab" aria-selected="false">
                    <i class="bi bi-wallet2"></i>
                    <span class="tab-label">شبكات الدفع</span>
                </button>
            </div>
        </div>

        <div class="glass-card p-4 shadow-sm border-0 rounded-4 settings-main-panel">
            @* ============================================================================== *@
            @* 💎 1. تبويب الهوية والماركة والمواسم (تصميم VIP فائق الترتيب) 💎 *@
            @* ============================================================================== *@
            <div class="tab-pane-content branding-tab settings-tab-panel" style="display: block;">

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="settings-card p-4 h-100 rounded-4 shadow-sm border-0 settings-bilingual-card">
                            <h6 class="fw-bold text-navy mb-4">
                                <i class="bi bi-info-square me-2 text-primary"></i>
                                البيانات الأساسية
                            </h6>

                            <div class="settings-bilingual-pair">
                                <div class="settings-language-field settings-language-field--ar" dir="rtl">
                                    <span class="settings-language-badge">AR</span>
                                    <div class="form-floating">
                                        <input type="text"
                                               class="form-control rounded-3"
                                               id="siteName"
                                               placeholder="اسم المنصة"
                                               value="@Model.SiteName">
                                        <label for="siteName">اسم المنصة الرسمي</label>
                                    </div>
                                </div>

                                <div class="settings-language-field settings-language-field--en" dir="ltr">
                                    <span class="settings-language-badge">EN</span>
                                    <div class="form-floating">
                                        <input type="text"
                                               class="form-control rounded-3"
                                               id="siteNameEn"
                                               placeholder="Platform name"
                                               value="@Model.SiteNameEn"
                                               required>
                                        <label for="siteNameEn">Platform name</label>
                                    </div>
                                </div>
                            </div>

                            <div class="settings-bilingual-pair settings-bilingual-pair--textarea mt-3">
                                <div class="settings-language-field settings-language-field--ar" dir="rtl">
                                    <span class="settings-language-badge">AR</span>
                                    <div class="form-floating">
                                        <textarea class="form-control rounded-3"
                                                  id="siteDescription"
                                                  placeholder="وصف المنصة"
                                                  style="height: 112px">@Model.SiteDescription</textarea>
                                        <label for="siteDescription">الوصف لمحركات البحث (SEO)</label>
                                    </div>
                                </div>

                                <div class="settings-language-field settings-language-field--en" dir="ltr">
                                    <span class="settings-language-badge">EN</span>
                                    <div class="form-floating">
                                        <textarea class="form-control rounded-3"
                                                  id="siteDescriptionEn"
                                                  placeholder="Platform description"
                                                  style="height: 112px">@Model.SiteDescriptionEn</textarea>
                                        <label for="siteDescriptionEn">Platform description (SEO)</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="settings-card p-4 h-100 rounded-4 shadow-sm border-0">
                            <h6 class="fw-bold text-navy mb-4"><i class="bi bi-images me-2 text-primary"></i> الهوية البصرية (الشعارات)</h6>

                            <label for="logoFile" class="d-flex align-items-center p-3 mb-3 border rounded-3 settings-upload-label" style="cursor: pointer; background: #f8f9fa; transition: all 0.3s;">
                                <div class="bg-white p-2 rounded-3 shadow-sm border me-3">
                                    <i class="bi bi-image fs-4 text-primary"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <span class="d-block fw-bold text-dark">شعار المنصة الرئيسي (Logo)</span>
                                    <small class="text-muted">اضغط لاختيار صورة جديدة</small>
                                </div>
                            @if (!string.IsNullOrEmpty(Model.LogoPath))
                            {
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2"><i class="bi bi-check-circle me-1"></i> محفوظ</span>
                            }
                        </label>
                        <input type="file" id="logoFile" accept="image/*" class="d-none">

                        <label for="faviconFile" class="d-flex align-items-center p-3 border rounded-3 settings-upload-label" style="cursor: pointer; background: #f8f9fa; transition: all 0.3s;">
                            <div class="bg-white p-2 rounded-3 shadow-sm border me-3">
                                <i class="bi bi-browser-chrome fs-4 text-primary"></i>
                            </div>
                            <div class="flex-grow-1">
                                <span class="d-block fw-bold text-dark">أيقونة المتصفح (Favicon)</span>
                                <small class="text-muted">مربع صغير (مثال: 64x64)</small>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.FaviconPath))
                            {
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2"><i class="bi bi-check-circle me-1"></i> محفوظ</span>
                            }
                        </label>
                        <input type="file" id="faviconFile" accept="image/*" class="d-none">
                    </div>
                </div>
            </div>

            <div class="mt-5 settings-section">
                <h5 class="fw-bold mb-3 text-primary settings-section-title"><i class="bi bi-stars me-2"></i> إعدادات المواسم والترحيب</h5>

                <div class="row g-4">
                    <div class="col-lg-7">
                        <div class="settings-card p-4 h-100 rounded-4 shadow-sm border-0">
                            <h6 class="fw-bold mb-4 text-navy">عناوين الواجهة الرئيسية والثيم</h6>

                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="settings-bilingual-pair">
                                        <div class="settings-language-field settings-language-field--ar" dir="rtl">
                                            <span class="settings-language-badge">AR</span>
                                            <div class="form-floating">
                                                <input type="text"
                                                       class="form-control rounded-3"
                                                       id="heroTitleMain"
                                                       value="@(string.IsNullOrEmpty(Model.HeroTitleMain) ? "دليلك اليمني بين يديك.." : Model.HeroTitleMain)"
                                                       placeholder="العنوان">
                                                <label for="heroTitleMain">العنوان الرئيسي</label>
                                            </div>
                                        </div>

                                        <div class="settings-language-field settings-language-field--en" dir="ltr">
                                            <span class="settings-language-badge">EN</span>
                                            <div class="form-floating">
                                                <input type="text"
                                                       class="form-control rounded-3"
                                                       id="heroTitleMainEn"
                                                       value="@Model.HeroTitleMainEn"
                                                       placeholder="Main hero title"
                                                       required>
                                                <label for="heroTitleMainEn">Main hero title</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="settings-bilingual-pair">
                                        <div class="settings-language-field settings-language-field--ar" dir="rtl">
                                            <span class="settings-language-badge">AR</span>
                                            <div class="form-floating">
                                                <input type="text"
                                                       class="form-control rounded-3"
                                                       id="heroTitleSub"
                                                       value="@(string.IsNullOrEmpty(Model.HeroTitleSub) ? "اكتشف" : Model.HeroTitleSub)"
                                                       placeholder="الكلمة المساعدة">
                                                <label for="heroTitleSub">الكلمة المساعدة</label>
                                            </div>
                                        </div>

                                        <div class="settings-language-field settings-language-field--en" dir="ltr">
                                            <span class="settings-language-badge">EN</span>
                                            <div class="form-floating">
                                                <input type="text"
                                                       class="form-control rounded-3"
                                                       id="heroTitleSubEn"
                                                       value="@Model.HeroTitleSubEn"
                                                       placeholder="Discover"
                                                       required>
                                                <label for="heroTitleSubEn">Hero helper text</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 mt-4">
                                    <label class="fw-bold small text-muted mb-2 d-block">تفعيل الثيم الموسمي (المؤثرات البصرية)</label>
                                    <div class="form-floating">
                                        <select class="form-select rounded-3 border-primary border-opacity-25" id="seasonTheme" style="background-color: rgba(0, 166, 218, 0.03);">
                                            <option value="Normal" selected="@(Model.SeasonTheme == "Normal" ? "selected" : null)">إيقاف المؤثرات (وضع كلاسيكي هادئ)</option>
                                            <option value="Ramadan" selected="@(Model.SeasonTheme == "Ramadan" ? "selected" : null)">🌙 ثيم الأجواء الرمضانية</option>
                                            <option value="Eid" selected="@(Model.SeasonTheme == "Eid" ? "selected" : null)">🎉 ثيم بهجة الأعياد</option>
                                            <option value="Rain" selected="@(Model.SeasonTheme == "Rain" ? "selected" : null)">🌧️ ثيم الطبيعة والأمطار</option>
                                            <option value="Snow" selected="@(Model.SeasonTheme == "Snow" ? "selected" : null)">❄️ ثيم الثلوج الناعمة</option>
                                            <option value="Spring" selected="@(Model.SeasonTheme == "Spring" ? "selected" : null)">🌸 ثيم بتلات الورد الربيعية</option>
                                            <option value="Autumn" selected="@(Model.SeasonTheme == "Autumn" ? "selected" : null)">🍂 ثيم أوراق الخريف الدافئة</option>
                                            <option value="Gold" selected="@(Model.SeasonTheme == "Gold" ? "selected" : null)">✨ ثيم غبار الذهب المضيء</option>
                                        </select>
                                        <label for="seasonTheme">اختر الموسم الحالي</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="settings-card p-4 h-100 rounded-4 shadow-sm border-0 settings-bilingual-card"
                             style="background: linear-gradient(145deg, #ffffff, #fcfcfc);">
                            <div class="d-flex justify-content-between align-items-center mb-4 settings-page-header">
                                <h6 class="fw-bold mb-0 text-navy">شريط التهنئة العائم (VIP)</h6>
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="isBannerActive"
                                           @(Model.IsBannerActive == true ? "checked" : "")>
                                </div>
                            </div>

                            <div class="settings-bilingual-pair settings-bilingual-pair--stack-at-lg">
                                <div class="settings-language-field settings-language-field--ar" dir="rtl">
                                    <span class="settings-language-badge">AR</span>
                                    <div class="form-floating">
                                        <textarea class="form-control rounded-3"
                                                  id="bannerText"
                                                  placeholder="التهنئة"
                                                  style="height: 125px;">@(string.IsNullOrEmpty(Model.BannerText) ? "إدارة منصة دليلك اليمني تهنئكم بحلول المناسبة السعيدة، كل عام وأنتم بخير! ✨" : Model.BannerText)</textarea>
                                        <label for="bannerText">نص البنر</label>
                                    </div>
                                </div>

                                <div class="settings-language-field settings-language-field--en" dir="ltr">
                                    <span class="settings-language-badge">EN</span>
                                    <div class="form-floating">
                                        <textarea class="form-control rounded-3"
                                                  id="bannerTextEn"
                                                  placeholder="Banner text"
                                                  style="height: 125px;">@Model.BannerTextEn</textarea>
                                        <label for="bannerTextEn">Banner text</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-5 settings-section">
                <h5 class="fw-bold mb-3 text-primary settings-section-title"><i class="bi bi-display me-2"></i> استوديو العرض السينمائي (السلايدر)</h5>

                <div class="settings-card p-4 mb-4 rounded-4 shadow-sm border-primary border-opacity-10" style="background: rgba(0, 166, 218, 0.02);">
                    <form id="addHeroSlideForm" onsubmit="addHeroSlideDynamically(event)">
                        <div class="row g-3 align-items-end settings-slider-form-row settings-slider-form-row--bilingual">
                            <div class="col-xl-2 col-lg-3 col-md-6">
                                <label class="fw-bold small text-muted mb-2 d-block">النص التفاعلي — عربي</label>
                                <input type="text"
                                       class="form-control rounded-3 p-3"
                                       id="newSlideText"
                                       placeholder="مثال: أرقى الفنادق"
                                       dir="rtl"
                                       required>
                            </div>

                            <div class="col-xl-2 col-lg-3 col-md-6" dir="ltr">
                                <label class="fw-bold small text-muted mb-2 d-block">Hero text — English</label>
                                <input type="text"
                                       class="form-control rounded-3 p-3"
                                       id="newSlideTextEn"
                                       placeholder="e.g. Finest Hotels"
                                       required>
                            </div>

                            <div class="col-xl-4 col-lg-6">
                                <label class="fw-bold small text-muted mb-2 d-block">صورة أو فيديو (HD)</label>
                                <label for="newSlideImage"
                                       class="d-flex align-items-center justify-content-center p-3 border rounded-3 bg-white w-100 settings-slide-upload-label"
                                       style="cursor: pointer; height: 58px;">
                                    <i class="bi bi-cloud-arrow-up text-primary me-2 fs-5"></i>
                                    <span class="fw-bold text-dark" id="fileNameDisplay">اختر ملفاً...</span>
                                </label>
                                <input type="file"
                                       id="newSlideImage"
                                       accept="image/*, video/mp4"
                                       class="d-none"
                                       required
                                       onchange="document.getElementById('fileNameDisplay').innerText = this.files[0].name">
                            </div>

                            <div class="col-xl-2 col-lg-6">
                                <label class="fw-bold small text-muted mb-2 d-block text-center">ألوان النصوص</label>
                                <div class="d-flex justify-content-center gap-3 settings-colors-row">
                                    <div class="text-center">
                                        <input type="color"
                                               class="form-control form-control-color p-1 rounded-3 border border-2 border-secondary mb-1"
                                               id="newSlideMainTextColor"
                                               value="#ffffff"
                                               title="اختر لون العنوان الثابت">
                                        <small class="text-navy fw-bold">العنوان</small>
                                    </div>
                                    <div class="text-center">
                                        <input type="color"
                                               class="form-control form-control-color p-1 rounded-3 border border-2 border-secondary mb-1"
                                               id="newSlideAccentColor"
                                               value="#ff5a5f"
                                               title="اختر لون الكلمة المتحركة">
                                        <small class="text-orange fw-bold">المتحرك</small>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-2 col-lg-6 settings-slider-submit-column">
                                <button type="submit"
                                        class="btn btn-primary w-100 rounded-3 shadow-sm settings-slider-add-btn"
                                        style="height: 58px;">
                                    <i class="bi bi-plus-lg me-1"></i>
                                    إدراج
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="settings-card p-0 rounded-4 shadow-sm border-0 overflow-hidden">
                    <div class="table-responsive settings-table-scroll">
                        <table class="table table-hover align-middle mb-0 text-center custom-admin-table slider-admin-table" style="min-width: 1040px;">
                            <thead class="bg-light text-muted">
                                <tr>
                                    <th style="width: 8%; padding: 15px;">الترتيب</th>
                                    <th style="width: 20%; padding: 15px;">المعاينة</th>
                                    <th style="width: 12%; padding: 15px;">نوع المرفق</th>
                                    <th style="width: 28%; padding: 15px; text-align: center;">النص التفاعلي — عربي / English</th>
                                    <th style="width: 15%; padding: 15px;">الألوان</th>
                                    <th style="width: 10%; padding: 15px;">الحالة</th>
                                    <th style="width: 10%; padding: 15px;">إجراءات</th>
                                </tr>
                            </thead>
                            <tbody id="heroSlidesTableBody">
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                        جاري تحميل السلايدرات...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-4 border-top text-end settings-save-actions">
                <button type="button" class="btn btn-primary btn-lg rounded-pill px-5 shadow btn-save-tab" onclick="saveAllSettings()">
                    <i class="bi bi-save2-fill me-2"></i> حفظ التعديلات
                </button>
            </div>
        </div>



        @* 2. تبويب السياسات والتسعيرة المزدوجة *@
        <div class="tab-pane-content policies-tab settings-tab-panel" style="display: none;">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="settings-card p-4">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="card-icon">
                                <i class="bi bi-check2-circle"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <label class="fw-bold mb-1">الموافقة التلقائية على الأماكن</label>
                                        <small class="text-muted d-block">نشر الأماكن دون مراجعة</small>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="autoApprovePlaces" @(Model.AutoApprovePlaces ? "checked" : null)>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="settings-card p-4">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="card-icon">
                                <i class="bi bi-person-plus"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <label class="fw-bold mb-1">السماح بتسجيل مستخدمين جدد</label>
                                        <small class="text-muted d-block">فتح باب التسجيل للزوار</small>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="allowRegistration" @(Model.AllowNewRegistrations == true ? "checked" : null)>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="settings-card p-4">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="card-icon">
                                <i class="bi bi-file-image"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="form-floating">
                                    <input type="number" class="form-control" id="maxImageSize" value="5">
                                    <label for="maxImageSize">الحد الأقصى لحجم الصورة (ميجابايت)</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="settings-card p-4">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="card-icon">
                                <i class="bi bi-images"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="form-floating">
                                    <input type="number" class="form-control" id="maxImageCount" value="10">
                                    <label for="maxImageCount">الحد الأقصى لعدد الصور لكل مكان</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 mt-4">
                    <hr class="text-muted my-2" />
                    <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-cash-stack me-2"></i> الإعدادات المالية وأسعار الصرف المزدوجة</h5>
                </div>

                <div class="col-md-6">
                    <div class="settings-card p-4">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="card-icon">
                                <i class="bi bi-percent"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="form-floating">
                                    <input type="number" step="0.01" class="form-control" id="commissionPercentage" value="@((Model.CommissionPercentage ?? 0).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))">
                                    <label for="commissionPercentage">نسبة عمولة المنصة (%)</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="settings-card p-4">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="card-icon">
                                <i class="bi bi-cash-coin"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="form-floating">
                                    <select class="form-select" id="defaultCurrency">
                                        <option value="ريال يمني" selected="@(Model.DefaultCurrency == "ريال يمني" ? "selected" : null)">ريال يمني (YER)</option>
                                        <option value="ريال سعودي" selected="@(Model.DefaultCurrency == "ريال سعودي" ? "selected" : null)">ريال سعودي (SAR)</option>
                                        <option value="دولار أمريكي" selected="@(Model.DefaultCurrency == "دولار أمريكي" ? "selected" : null)">دولار أمريكي (USD)</option>
                                    </select>
                                    <label for="defaultCurrency">العملة الافتراضية للنظام</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="settings-card p-4">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="card-icon">
                                <i class="bi bi-arrow-repeat text-success"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <label class="fw-bold mb-1">التحديث التلقائي لأسعار الصرف</label>
                                        <small class="text-muted d-block">مجهز للتفعيل المستقبلي عبر الـ API</small>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="autoUpdateExchangeRates" @(Model.AutoUpdateExchangeRates == true ? "checked" : null)>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ✨ التسعيرة المزدوجة للدولار -->
                <div class="col-md-6">
                    <div class="settings-card p-4 h-100">
                        <h6 class="fw-bold text-success mb-3"><i class="bi bi-currency-dollar me-2"></i> سعر صرف الدولار الأمريكي (USD)</h6>
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="form-floating border border-success border-opacity-25 rounded-3">
                                    <input type="number" step="0.01" class="form-control" id="sanaaUsdRate" value="@Model.SanaaUsdRate.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                                    <label for="sanaaUsdRate">مقابل الريال (المناطق الشمالية)</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating border border-primary border-opacity-25 rounded-3">
                                    <input type="number" step="0.01" class="form-control" id="adenUsdRate" value="@Model.AdenUsdRate.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                                    <label for="adenUsdRate">مقابل الريال (المناطق الجنوبية)</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ✨ التسعيرة المزدوجة للسعودي -->
                <div class="col-md-6">
                    <div class="settings-card p-4 h-100">
                        <h6 class="fw-bold text-warning mb-3"><i class="bi bi-currency-exchange me-2"></i> سعر صرف الريال السعودي (SAR)</h6>
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="form-floating border border-success border-opacity-25 rounded-3">
                                    <input type="number" step="0.01" class="form-control" id="sanaaSarRate" value="@Model.SanaaSarRate.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                                    <label for="sanaaSarRate">مقابل الريال (المناطق الشمالية)</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating border border-primary border-opacity-25 rounded-3">
                                    <input type="number" step="0.01" class="form-control" id="adenSarRate" value="@Model.AdenSarRate.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                                    <label for="adenSarRate">مقابل الريال (المناطق الجنوبية)</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="mt-4 pt-3 border-top settings-save-actions">
                <button type="button" class="btn btn-primary btn-save-tab" onclick="saveAllSettings()">
                    <i class="bi bi-save me-2"></i> حفظ جميع الإعدادات
                </button>
            </div>
        </div>

        @* 3. تبويب التواصل *@
        <div class="tab-pane-content contact-tab settings-tab-panel" style="display: none;">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="settings-card p-4">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="card-icon">
                                <i class="bi bi-envelope"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="form-floating">
                                    <input type="email" class="form-control" id="officialEmail" value="@Model.ContactEmail">
                                    <label for="officialEmail">البريد الإلكتروني الرسمي</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="settings-card p-4">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="card-icon">
                                <i class="bi bi-telephone"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="supportPhone" value="@Model.SupportPhone">
                                    <label for="supportPhone">رقم الهاتف لخدمة العملاء</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="settings-card p-4">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="card-icon">
                                <i class="bi bi-facebook text-primary"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="fbLink" value="@Model.FacebookLink" placeholder="">
                                    <label for="fbLink">فيسبوك</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="settings-card p-4">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="card-icon">
                                <i class="bi bi-twitter-x text-dark"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="xLink" value="@Model.TwitterLink" placeholder="">
                                    <label for="xLink">X</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="settings-card p-4">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="card-icon">
                                <i class="bi bi-instagram text-danger"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="instaLink" value="@Model.InstagramLink" placeholder="">
                                    <label for="instaLink">إنستقرام</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="settings-card p-4">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="card-icon">
                                <i class="bi bi-whatsapp text-success"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="waLink" value="@Model.WhatsAppNumber" placeholder="">
                                    <label for="waLink">واتساب</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mt-4 pt-3 border-top settings-save-actions">
                <button type="button" class="btn btn-primary btn-save-tab" onclick="saveAllSettings()">
                    <i class="bi bi-save me-2"></i> حفظ جميع الإعدادات
                </button>
            </div>
        </div>

        @* 4. تبويب الصيانة والعناية بالطوارئ *@
        <div class="tab-pane-content maintenance-tab settings-tab-panel" style="display: none;">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="settings-card emergency-card p-4">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="card-icon">
                                <i class="bi bi-shield-lock"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <label class="fw-bold mb-1 text-danger">وضع الصيانة العام</label>
                                        <small class="text-muted d-block">إغلاق الموقع أمام الزوار</small>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="maintenanceMode" @(Model.MaintenanceMode ? "checked" : null)>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="settings-card emergency-card p-4 settings-bilingual-card">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="card-icon">
                                <i class="bi bi-chat-dots"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-navy">رسالة الصيانة للزوار</h6>
                                <small class="text-muted">أدخل العربي والإنجليزي ليظهر النص الصحيح حسب لغة المستخدم.</small>
                            </div>
                        </div>

                        <div class="settings-bilingual-pair">
                            <div class="settings-language-field settings-language-field--ar" dir="rtl">
                                <span class="settings-language-badge">AR</span>
                                <div class="form-floating">
                                    <input type="text"
                                           class="form-control"
                                           id="maintenanceTitle"
                                           value="@Model.MaintenanceTitle"
                                           placeholder="عنوان الصيانة">
                                    <label for="maintenanceTitle">عنوان الصيانة</label>
                                </div>
                            </div>

                            <div class="settings-language-field settings-language-field--en" dir="ltr">
                                <span class="settings-language-badge">EN</span>
                                <div class="form-floating">
                                    <input type="text"
                                           class="form-control"
                                           id="maintenanceTitleEn"
                                           value="@Model.MaintenanceTitleEn"
                                           placeholder="Maintenance title">
                                    <label for="maintenanceTitleEn">Maintenance title</label>
                                </div>
                            </div>
                        </div>

                        <div class="settings-bilingual-pair settings-bilingual-pair--textarea mt-3">
                            <div class="settings-language-field settings-language-field--ar" dir="rtl">
                                <span class="settings-language-badge">AR</span>
                                <div class="form-floating">
                                    <textarea class="form-control"
                                              id="maintenanceMessage"
                                              placeholder="رسالة الصيانة"
                                              style="height: 110px">@Model.MaintenanceMessage</textarea>
                                    <label for="maintenanceMessage">رسالة الصيانة</label>
                                </div>
                            </div>

                            <div class="settings-language-field settings-language-field--en" dir="ltr">
                                <span class="settings-language-badge">EN</span>
                                <div class="form-floating">
                                    <textarea class="form-control"
                                              id="maintenanceMessageEn"
                                              placeholder="Maintenance message"
                                              style="height: 110px">@Model.MaintenanceMessageEn</textarea>
                                    <label for="maintenanceMessageEn">Maintenance message</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mt-4 pt-3 border-top settings-save-actions">
                <button type="button" class="btn btn-primary btn-save-tab" onclick="saveAllSettings()">
                    <i class="bi bi-save me-2"></i> حفظ جميع الإعدادات
                </button>
            </div>
        </div>

        @* ✨ 5. تبويب شبكات الدفع *@
        <div class="tab-pane-content wallets-tab settings-tab-panel" style="display: none;">
            <div class="row g-4">

                <div class="col-12">
                    <div class="settings-card p-4">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="card-icon">
                                <i class="bi bi-plus-circle"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">إضافة شبكة معتمدة جديدة</h5>
                                <small class="text-muted">إدراج قناة دفع للنظام</small>
                            </div>
                        </div>

                        <form id="addSupportedWalletForm" onsubmit="createPlatformWallet(event)">
                            <div class="row g-3 align-items-end settings-wallet-form-row settings-wallet-form-row--bilingual">
                                <div class="col-lg-3 col-md-6">
                                    <div class="form-floating">
                                        <input type="text"
                                               class="form-control"
                                               id="newWalletName"
                                               placeholder="اسم الشبكة"
                                               dir="rtl"
                                               required>
                                        <label for="newWalletName">اسم البنك أو المحفظة — عربي</label>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6" dir="ltr">
                                    <div class="form-floating">
                                        <input type="text"
                                               class="form-control"
                                               id="newWalletNameEn"
                                               placeholder="Wallet or bank name"
                                               required>
                                        <label for="newWalletNameEn">Wallet / bank name — English</label>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-8">
                                    <div class="custom-file-upload-group">
                                        <label for="newWalletLogo"
                                               class="form-label small text-muted fw-bold mb-2 d-block">
                                            <i class="bi bi-image me-1 text-primary"></i>
                                            شعار الشبكة (Logo)
                                        </label>
                                        <input type="file"
                                               class="form-control m-0"
                                               id="newWalletLogo"
                                               accept="image/*"
                                               required>
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-4">
                                    <button type="submit"
                                            class="btn btn-primary w-100 py-3 rounded-3 settings-wallet-add-btn"
                                            style="height: calc(3.5rem + 2px);">
                                        <i class="bi bi-plus-lg me-2"></i>
                                        إضافة
                                    </button>
                                </div>
                            </div>
                        </form>

                    </div>
                </div>

                <div class="col-12">
                    <div class="settings-card p-4">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="card-icon text-success">
                                <i class="bi bi-shield-check"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">القنوات الفعالة في النظام</h5>
                                <small class="text-muted">إدارة الشبكات المتاحة</small>
                            </div>
                        </div>

                        <div class="table-responsive settings-table-scroll">
                            <table class="table table-hover align-middle mb-0 custom-admin-table">
                                <thead>
                                    <tr>
                                        <th scope="col" class="text-center" style="width: 60px;">#</th>
                                        <th scope="col">الشعار</th>
                                        <th scope="col">اسم المحفظة</th>
                                        <th scope="col" class="text-center">الحالة</th>
                                        <th scope="col" class="text-center">إجراء</th>
                                    </tr>
                                </thead>
                                <tbody id="supportedWalletsTableBody">
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">
                                            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                            جاري جلب البيانات...
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/admin/settings-actions.js" asp-append-version="true"></script>
}
